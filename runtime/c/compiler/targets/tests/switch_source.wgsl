@group(0) @binding(0) var<storage,read_write> out:array<u32>;var<private> calls:u32;fn selector(x:u32)->u32 {calls+=1u;return x;}fn choose(x:u32)->u32 {switch x {default:{return 99u;}case 0u,1u:{return 11u;}case 2u:{var v=0u;loop {v=20u;break;}switch x+1u {case 3u:{v+=3u;}default:{v=24u;}}return v;}case 3u:{var v=0u;for(var i=0u;i<4u;i++){switch i {case 0u:{continue;}case 1u:{v+=5u;}default:{break;}}v+=1u;}return v;}}}@compute @workgroup_size(1) fn main(@builtin(global_invocation_id) id:vec3u){out[id.x]=choose(selector(id.x));out[id.x+8u]=calls;}
