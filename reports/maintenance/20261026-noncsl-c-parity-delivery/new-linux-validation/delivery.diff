diff --git a/runtime/c/compiler/src/dxil/dxil_source.c b/runtime/c/compiler/src/dxil/dxil_source.c
new file mode 100644
index 000000000..0964a4737
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source.c
@@ -0,0 +1,305 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "dxil_source.h"
+#include "../../include/doe_compiler_specialization.h"
+#include "../../include/doe_compiler_pool_growth.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define DXIL_SOURCE_LIMIT (2u * 1024u * 1024u)
+#define DXIL_WORKSPACE_LIMIT (256u * 1024u * 1024u)
+
+typedef struct SourceStorage {
+    void *workspace;
+    DoeCompilerValidationOutputs validation;
+    DoeCompilerSpecializationOutputs output;
+} SourceStorage;
+
+static DoeCompilerSpecializationCapacities initial_capacities(void) {
+    const DoeCompilerTypedCapacities typed = {
+        .source_bytes = DXIL_SOURCE_LIMIT, .tokens = 2048u, .statements = 256u,
+        .expressions = 1024u, .types = 128u, .members = 256u,
+        .resources = 32u, .access_steps = 2048u, .constants = 1024u,
+        .constant_edges = 2048u, .ir_instructions = 8192u,
+        .ir_operands = 4096u, .target_declarations = 4096u,
+        .traversal_items = 256u, .words = 0u,
+        .expression_depth = 32u, .control_depth = 16u, .type_syntax_depth = 32u
+    };
+    return (DoeCompilerSpecializationCapacities){.target = {.stages = {
+        .module = {.typed = typed, .entries = 64u, .entry_inputs = 256u,
+            .entry_references = 8192u},
+        .interface_attributes = 256u, .stage_interfaces = 256u}},
+        .overrides = 256u};
+}
+
+static bool grow(DoeCompilerSpecializationCapacities *caps,
+    DoeCompilerStatus status, uint32_t pool, size_t minimum) {
+    if (pool == DOE_COMPILER_POOL_OVERRIDES)
+        return (status == DOE_COMPILER_INPUT_ERROR || status == DOE_COMPILER_OUTPUT_TOO_SMALL) &&
+            doe_compiler_grow_pool_capacity(&caps->overrides, minimum);
+    return doe_compiler_grow_stage_pool(&caps->target.stages, status, pool, minimum);
+}
+
+static void release(SourceStorage *storage) {
+    DoeCompilerHlslOutputs *h = &storage->output.hlsl;
+    DoeCompilerModuleOutputs *m = &h->stages.resources.module;
+    free(storage->workspace);
+    free(storage->validation.overrides);
+    free(storage->validation.entries);
+    free(storage->validation.names);
+    free(m->types); free(m->members); free(m->resources); free(m->workgroups);
+    free(m->entries); free(m->entry_references); free(m->names);
+    free(h->stages.resources.handles); free(h->stages.interfaces);
+    free(h->bindings); free(h->entries); free(h->text);
+}
+
+static bool set_error(DxilDiagnostic *diagnostic, DxilDiagKind *out_error,
+    DxilDiagnosticStage stage, DxilDiagKind kind, const char *detail) {
+    dxil_diagnostic_set_detail(diagnostic, stage, kind, detail);
+    if (out_error != NULL) *out_error = kind;
+    return false;
+}
+
+static bool compiler_error(const char *source, size_t length,
+    const DoeCompilerDiagnostic *error, uint32_t pool, DxilDiagnostic *diagnostic,
+    DxilDiagKind *out_error) {
+    DxilDiagKind kind = DXIL_DIAG_INVALID_WGSL;
+    DxilDiagnosticStage stage = DXIL_DIAG_STAGE_SEMA;
+    switch (error->status) {
+        case DOE_COMPILER_OK: case DOE_COMPILER_ABI_MISMATCH:
+            kind = DXIL_DIAG_INVALID_IR;
+            break;
+        case DOE_COMPILER_INPUT_ERROR:
+            if (pool != DOE_COMPILER_POOL_NONE) kind = DXIL_DIAG_OUTPUT_TOO_LARGE;
+            break;
+        case DOE_COMPILER_PARSE_ERROR:
+            kind = DXIL_DIAG_UNEXPECTED_TOKEN;
+            stage = DXIL_DIAG_STAGE_PARSER;
+            break;
+        case DOE_COMPILER_UNSUPPORTED:
+            kind = DXIL_DIAG_UNSUPPORTED_CONSTRUCT;
+            break;
+        case DOE_COMPILER_SEMANTIC_ERROR:
+            break;
+        case DOE_COMPILER_OUTPUT_TOO_SMALL:
+            kind = DXIL_DIAG_OUTPUT_TOO_LARGE;
+            break;
+    }
+    DxilDiagnostic location = {0};
+    dxil_diagnostic_set(&location, stage, kind, source, length, error->offset);
+    /* Keep the canonical first semantic message and original source context;
+     * do not infer a narrower error kind by parsing diagnostic strings. */
+    dxil_diagnostic_set_detail(diagnostic, stage, kind, error->message);
+    if (diagnostic != NULL) {
+        diagnostic->line = error->line;
+        diagnostic->column = error->column;
+        diagnostic->context_len = location.context_len;
+        memcpy(diagnostic->context, location.context, sizeof(diagnostic->context));
+    }
+    if (out_error != NULL) *out_error = kind;
+    return false;
+}
+
+static bool workspace(SourceStorage *storage,
+    const DoeCompilerSpecializationCapacities *caps, uint32_t target,
+    size_t *bytes, DxilDiagnostic *diagnostic, DxilDiagKind *out_error) {
+    DoeCompilerWorkspaceRequirements required;
+    if (doe_compiler_specialization_requirements(DOE_COMPILER_SPECIALIZATION_ABI_VERSION,
+            target, caps, sizeof(*caps), &required, sizeof(required)) != DOE_COMPILER_OK ||
+        required.size_bytes > DXIL_WORKSPACE_LIMIT)
+        return set_error(diagnostic, out_error, DXIL_DIAG_STAGE_IR_BUILDER,
+            DXIL_DIAG_OUTPUT_TOO_LARGE, "DXIL host compiler workspace exceeds its checked budget");
+    free(storage->workspace);
+    storage->workspace = malloc(required.size_bytes);
+    if (storage->workspace == NULL)
+        return set_error(diagnostic, out_error, DXIL_DIAG_STAGE_IR_BUILDER,
+            DXIL_DIAG_OUT_OF_MEMORY, "DXIL host compiler workspace allocation failed");
+    *bytes = required.size_bytes;
+    return true;
+}
+
+static bool validation_storage(SourceStorage *s, const DoeCompilerValidationResult *r) {
+    s->validation = (DoeCompilerValidationOutputs){
+        .override_capacity = r->required_overrides,
+        .override_record_size = sizeof(DoeCompilerOverrideV13),
+        .entry_capacity = r->required_entries,
+        .entry_record_size = sizeof(DoeCompilerModuleEntryV13),
+        .name_capacity = r->required_name_bytes};
+    if (r->required_overrides != 0u)
+        s->validation.overrides = calloc(r->required_overrides, sizeof(*s->validation.overrides));
+    if (r->required_entries != 0u)
+        s->validation.entries = calloc(r->required_entries, sizeof(*s->validation.entries));
+    if (r->required_name_bytes != 0u)
+        s->validation.names = malloc(r->required_name_bytes);
+    return (r->required_overrides == 0u || s->validation.overrides != NULL) &&
+        (r->required_entries == 0u || s->validation.entries != NULL) &&
+        (r->required_name_bytes == 0u || s->validation.names != NULL);
+}
+
+static bool output_storage(SourceStorage *s, const DoeCompilerTextResult *r) {
+    DoeCompilerHlslOutputs *h = &s->output.hlsl;
+    DoeCompilerModuleOutputs *m = &h->stages.resources.module;
+    const DoeCompilerModuleOutputCounts *n = &r->stages.resources.module.required;
+    *m = (DoeCompilerModuleOutputs){
+        .type_capacity = n->types, .type_record_size = sizeof(DoeCompilerTypeV4),
+        .member_capacity = n->members, .member_record_size = sizeof(DoeCompilerMemberV4),
+        .resource_capacity = n->resources, .resource_record_size = sizeof(DoeCompilerResourceV4),
+        .workgroup_capacity = n->workgroups, .workgroup_record_size = sizeof(DoeCompilerWorkgroupV5),
+        .entry_capacity = n->entries, .entry_record_size = sizeof(DoeCompilerEntryV5),
+        .entry_reference_capacity = n->entry_references, .name_capacity = n->name_bytes};
+    h->stages.resources.handle_capacity = r->stages.resources.required_handles;
+    h->stages.resources.handle_record_size = sizeof(DoeCompilerHandleV6);
+    h->stages.interface_capacity = r->stages.required_interfaces;
+    h->stages.interface_record_size = sizeof(DoeCompilerStageInterfaceV7);
+    h->text_capacity = r->required_text_bytes;
+    h->binding_capacity = r->required_bindings;
+    h->binding_record_size = sizeof(DoeCompilerHlslBindingV11);
+    h->entry_capacity = r->required_entries;
+    h->entry_record_size = sizeof(DoeCompilerHlslEntryV11);
+    if (n->types != 0u) m->types = calloc(n->types, sizeof(*m->types));
+    if (n->members != 0u) m->members = calloc(n->members, sizeof(*m->members));
+    if (n->resources != 0u) m->resources = calloc(n->resources, sizeof(*m->resources));
+    if (n->workgroups != 0u) m->workgroups = calloc(n->workgroups, sizeof(*m->workgroups));
+    if (n->entries != 0u) m->entries = calloc(n->entries, sizeof(*m->entries));
+    if (n->entry_references != 0u) m->entry_references = calloc(n->entry_references, sizeof(*m->entry_references));
+    if (n->name_bytes != 0u) m->names = malloc(n->name_bytes);
+    if (h->stages.resources.handle_capacity != 0u)
+        h->stages.resources.handles = calloc(h->stages.resources.handle_capacity, sizeof(*h->stages.resources.handles));
+    if (h->stages.interface_capacity != 0u)
+        h->stages.interfaces = calloc(h->stages.interface_capacity, sizeof(*h->stages.interfaces));
+    if (h->binding_capacity != 0u) h->bindings = calloc(h->binding_capacity, sizeof(*h->bindings));
+    if (h->entry_capacity != 0u) h->entries = calloc(h->entry_capacity, sizeof(*h->entries));
+    if (h->text_capacity != 0u) h->text = malloc(h->text_capacity);
+    return (n->types == 0u || m->types != NULL) && (n->members == 0u || m->members != NULL) &&
+        (n->resources == 0u || m->resources != NULL) && (n->workgroups == 0u || m->workgroups != NULL) &&
+        (n->entries == 0u || m->entries != NULL) && (n->entry_references == 0u || m->entry_references != NULL) &&
+        (n->name_bytes == 0u || m->names != NULL) &&
+        (h->stages.resources.handle_capacity == 0u || h->stages.resources.handles != NULL) &&
+        (h->stages.interface_capacity == 0u || h->stages.interfaces != NULL) &&
+        (h->binding_capacity == 0u || h->bindings != NULL) &&
+        (h->entry_capacity == 0u || h->entries != NULL) &&
+        (h->text_capacity == 0u || h->text != NULL);
+}
+
+bool dxil_source_hlsl(const char *source, size_t length, DxilSourceHlsl *out,
+    DxilDiagnostic *diagnostic, DxilDiagKind *out_error) {
+    const int saved_errno = errno;
+    SourceStorage storage = {0};
+    DoeCompilerSpecializationCapacities caps = initial_capacities();
+    DoeCompilerValidationResult validation = {0};
+    DoeCompilerTextResult compiled = {0};
+    size_t bytes = 0u;
+    bool success = false;
+    dxil_diagnostic_clear(diagnostic);
+    if (out == NULL) {
+        const bool failed = set_error(diagnostic, out_error, DXIL_DIAG_STAGE_PARSER,
+            DXIL_DIAG_INVALID_WGSL, "DXIL source output is required");
+        errno = saved_errno;
+        return failed;
+    }
+    memset(out, 0, sizeof(*out));
+    if ((source == NULL && length != 0u) || length > DXIL_SOURCE_LIMIT) {
+        (void)set_error(diagnostic, out_error, DXIL_DIAG_STAGE_PARSER,
+            DXIL_DIAG_INVALID_WGSL, "invalid or oversized DXIL source span");
+        goto finish;
+    }
+    for (;;) {
+        if (!workspace(&storage, &caps, DOE_COMPILER_TARGET_SPIRV, &bytes, diagnostic, out_error)) goto finish;
+        const DoeCompilerStatus status = doe_compiler_validate_module(
+            DOE_COMPILER_SPECIALIZATION_ABI_VERSION, &caps, sizeof(caps), storage.workspace,
+            bytes, source, length, 0u, NULL, 0u, &validation, sizeof(validation));
+        if (status == DOE_COMPILER_OK) break;
+        if (!grow(&caps, status, validation.exhausted_pool, validation.minimum_pool_capacity)) {
+            (void)compiler_error(source, length, &validation.diagnostic,
+                validation.exhausted_pool, diagnostic, out_error);
+            goto finish;
+        }
+    }
+    if (validation.required_entries == 0u) {
+        (void)set_error(diagnostic, out_error, DXIL_DIAG_STAGE_DXIL_EMIT,
+            DXIL_DIAG_INVALID_IR, "DXIL source has no shader entry point");
+        goto finish;
+    }
+    if (!validation_storage(&storage, &validation)) goto allocation_failure;
+    if (doe_compiler_validate_module(DOE_COMPILER_SPECIALIZATION_ABI_VERSION,
+            &caps, sizeof(caps), storage.workspace, bytes, source, length, 0u,
+            &storage.validation, sizeof(storage.validation), &validation, sizeof(validation)) != DOE_COMPILER_OK) {
+        (void)compiler_error(source, length, &validation.diagnostic,
+            validation.exhausted_pool, diagnostic, out_error);
+        goto finish;
+    }
+    const DoeCompilerNameV4 name = storage.validation.entries[0].name;
+    const DoeCompilerEntrySelectionV5 selected = {.mode = DOE_COMPILER_SELECT_NAME,
+        .name = storage.validation.names + name.offset, .name_length = name.length};
+    for (;;) {
+        if (!workspace(&storage, &caps, DOE_COMPILER_TARGET_HLSL, &bytes, diagnostic, out_error)) goto finish;
+        const DoeCompilerStatus status = doe_compiler_specialize(
+            DOE_COMPILER_SPECIALIZATION_ABI_VERSION, DOE_COMPILER_TARGET_HLSL,
+            &caps, sizeof(caps), storage.workspace, bytes, source, length,
+            &selected, sizeof(selected), NULL, 0u, sizeof(DoeCompilerOverrideValueV13),
+            DOE_COMPILER_TEXT_CODE | DOE_COMPILER_TEXT_REFLECTION | DOE_COMPILER_TEXT_MEASURE,
+            NULL, 0u, &compiled, sizeof(compiled));
+        if (status == DOE_COMPILER_OK) break;
+        if (!grow(&caps, status, compiled.stages.resources.module.exhausted_pool,
+                compiled.stages.resources.module.minimum_pool_capacity)) {
+            (void)compiler_error(source, length, &compiled.stages.resources.module.diagnostic,
+                compiled.stages.resources.module.exhausted_pool, diagnostic, out_error);
+            goto finish;
+        }
+    }
+    caps.target.text_bytes = compiled.required_text_bytes;
+    if (!workspace(&storage, &caps, DOE_COMPILER_TARGET_HLSL, &bytes, diagnostic, out_error)) goto finish;
+    if (!output_storage(&storage, &compiled)) goto allocation_failure;
+    if (doe_compiler_specialize(DOE_COMPILER_SPECIALIZATION_ABI_VERSION, DOE_COMPILER_TARGET_HLSL,
+            &caps, sizeof(caps), storage.workspace, bytes, source, length,
+            &selected, sizeof(selected), NULL, 0u, sizeof(DoeCompilerOverrideValueV13),
+            DOE_COMPILER_TEXT_CODE | DOE_COMPILER_TEXT_REFLECTION,
+            &storage.output, sizeof(storage.output), &compiled, sizeof(compiled)) != DOE_COMPILER_OK) {
+        (void)compiler_error(source, length, &compiled.stages.resources.module.diagnostic,
+            compiled.stages.resources.module.exhausted_pool, diagnostic, out_error);
+        goto finish;
+    }
+    const DoeCompilerHlslEntryV11 *entry = &storage.output.hlsl.entries[0];
+    const DoeCompilerModuleOutputs *module = &storage.output.hlsl.stages.resources.module;
+    if (compiled.published_entries != 1u || entry->entry_index >= module->entry_capacity) {
+        (void)set_error(diagnostic, out_error, DXIL_DIAG_STAGE_HLSL_EMIT,
+            DXIL_DIAG_INVALID_IR, "HLSL entry publication does not match its selected source entry");
+        goto finish;
+    }
+    switch (entry->stage) {
+        case DOE_COMPILER_STAGE_COMPUTE: out->entry.stage = DXIL_STAGE_COMPUTE; break;
+        case DOE_COMPILER_STAGE_VERTEX: out->entry.stage = DXIL_STAGE_VERTEX; break;
+        case DOE_COMPILER_STAGE_FRAGMENT: out->entry.stage = DXIL_STAGE_FRAGMENT; break;
+        default:
+            (void)set_error(diagnostic, out_error, DXIL_DIAG_STAGE_HLSL_EMIT,
+                DXIL_DIAG_INVALID_IR, "unknown stage in typed HLSL entry metadata");
+            goto finish;
+    }
+    memcpy(out->entry_name, entry->name, sizeof(out->entry_name));
+    out->entry.name = out->entry_name;
+    memcpy(out->entry.workgroup_size, module->entries[entry->entry_index].workgroup_size,
+        sizeof(out->entry.workgroup_size));
+    out->entry.shader_model_major = 6u;
+    out->entry.native16 = (entry->flags & DOE_COMPILER_HLSL_ENTRY_NATIVE16) != 0u;
+    out->entry.shader_model_minor = out->entry.native16 ? 2u : 0u;
+    out->text = storage.output.hlsl.text;
+    out->text_length = compiled.published_text_bytes;
+    storage.output.hlsl.text = NULL;
+    success = true;
+    goto finish;
+allocation_failure:
+    (void)set_error(diagnostic, out_error, DXIL_DIAG_STAGE_IR_BUILDER,
+        DXIL_DIAG_OUT_OF_MEMORY, "DXIL host metadata allocation failed");
+finish:
+    release(&storage);
+    if (!success) memset(out, 0, sizeof(*out));
+    errno = saved_errno;
+    return success;
+}
+
+void dxil_source_hlsl_free(DxilSourceHlsl *result) {
+    if (result == NULL) return;
+    free(result->text);
+    memset(result, 0, sizeof(*result));
+}
diff --git a/runtime/c/compiler/src/dxil/dxil_source.h b/runtime/c/compiler/src/dxil/dxil_source.h
new file mode 100644
index 000000000..c402e86e8
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#ifndef DOE_DXIL_SOURCE_H
+#define DOE_DXIL_SOURCE_H
+#include "dxil_emit.h"
+
+/* Allocating host adapter over the canonical C semantic/specialization/HLSL
+ * owners. The first source entry is selected, matching retained DXIL lowering.
+ * Source is borrowed only during the call. On success text is caller-owned,
+ * exact bytes (not terminated); entry.name points into this result. Release via
+ * dxil_source_hlsl_free before reusing the result. On failure the result is zero
+ * and the first source or allocation diagnostic is retained. No Zig fallback.
+ * Explicit host limits: 2 MiB source and 256 MiB individual workspace.
+ * This is not the allocation-free public compiler ABI or device qualification. */
+typedef struct DxilSourceHlsl {
+    char *text;
+    size_t text_length;
+    DxilLoweredModule entry;
+    char entry_name[64];
+} DxilSourceHlsl;
+
+bool dxil_source_hlsl(const char *source, size_t length, DxilSourceHlsl *out,
+    DxilDiagnostic *diagnostic, DxilDiagKind *out_error);
+void dxil_source_hlsl_free(DxilSourceHlsl *result);
+#endif
diff --git a/runtime/c/compiler/src/dxil/dxil_source_native_bounds.c b/runtime/c/compiler/src/dxil/dxil_source_native_bounds.c
new file mode 100644
index 000000000..046be4404
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source_native_bounds.c
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "dxil_source_native_bounds.h"
+#include "../../targets/ir_view.h"
+#include "../../targets/source_facts.h"
+
+static bool local_space(const DxilSourceBridge *bridge, const DxilIrFunction *function,
+    uint32_t expression) {
+    for (uint32_t depth = 0u; depth < DXIL_IR_MAX_EXPRS && expression < function->expr_count; ++depth) {
+        const DxilIrExpr *node = &function->exprs[expression];
+        if (node->kind == DXIL_IR_EXPR_LOAD) { expression = node->inner; continue; }
+        if (node->kind == DXIL_IR_EXPR_MEMBER || node->kind == DXIL_IR_EXPR_INDEX) {
+            expression = node->base; continue;
+        }
+        DxilIrAddressSpace space;
+        if (node->kind == DXIL_IR_EXPR_GLOBAL_REF && node->index < bridge->module->global_count) {
+            const DxilIrGlobal *global = &bridge->module->globals[node->index];
+            if (!global->has_addr_space) return false;
+            space = global->addr_space;
+        } else if ((node->kind == DXIL_IR_EXPR_LOCAL_REF || node->kind == DXIL_IR_EXPR_PARAM_REF) &&
+            node->ty < bridge->module->type_count) {
+            const DxilIrType *type = &bridge->module->types[node->ty];
+            if (type->kind == DXIL_IR_TYPE_REF) space = type->addr_space;
+            else if (node->kind == DXIL_IR_EXPR_LOCAL_REF) space = DXIL_IR_ADDR_FUNCTION;
+            else return false;
+        } else return false;
+        return space == DXIL_IR_ADDR_FUNCTION || space == DXIL_IR_ADDR_PRIVATE || space == DXIL_IR_ADDR_WORKGROUP;
+    }
+    return false;
+}
+
+static bool guard_constant(DxilSourceBridge *bridge, DxilSourceFunction *function,
+    uint32_t expression, ConstantValue *value, bool *known) {
+    /* A guard is evaluated outside its body: later shadowing declarations in
+     * the currently projected body must not rebind the original guard name. */
+    DxilSourceFunction lexical = *function;
+    lexical.scope_count = 0u;
+    const uint32_t offset = bridge->compiler->expressions[expression].source_offset;
+    for (uint32_t i = 0u; i < function->scope_count; ++i) {
+        uint32_t local = function->scope[i];
+        if (function->bindings[local].declaration_offset < offset)
+            lexical.scope[lexical.scope_count++] = local;
+    }
+    return dxil_source_native_constant_if_known(bridge, &lexical, expression, value, known);
+}
+
+static bool guarded_index(DxilSourceBridge *bridge, DxilSourceFunction *function,
+    uint32_t source_index, uint32_t count) {
+    const Expression *index = &bridge->compiler->expressions[source_index];
+    if (index->kind != EXPRESSION_NAME || index->resolved_type != IR_U32 || function->syntax == NULL) return false;
+    const LocalBinding *binding = NULL;
+    for (uint32_t n = function->scope_count; n != 0u; --n) {
+        const LocalBinding *candidate = &function->bindings[function->scope[n - 1u]];
+        if (target_source_same_name(&bridge->source, candidate->name, index->value.name)) {
+            binding = candidate; break;
+        }
+    }
+    if (binding == NULL || binding->type != IR_U32) return false;
+    for (uint32_t cursor = function->syntax->statement_start; cursor < function->syntax->statement_end; ++cursor) {
+        TargetSourceLoopGuard fact;
+        if (!target_source_loop_guard(&bridge->source, function->syntax, bridge->source_statement,
+                binding->name, binding->declaration_offset, cursor, &fact)) continue;
+        ConstantValue limit, step;
+        bool known;
+        if (!guard_constant(bridge, function, fact.limit, &limit, &known)) return false;
+        if (!known || (limit.flags & CONSTANT_AGGREGATE) != 0u ||
+            (fact.inclusive ? limit.bits >= count : limit.bits == 0u || limit.bits > count)) continue;
+        if (fact.step != NO_ID) {
+            if (!guard_constant(bridge, function, fact.step, &step, &known)) return false;
+            if (!known || (step.flags & CONSTANT_AGGREGATE) != 0u || step.bits == 0u || step.bits > UINT32_MAX) continue;
+        }
+        return true;
+    }
+    return false;
+}
+
+static bool arguments(DxilSourceBridge *bridge, DxilSourceFunction *function,
+    const uint32_t *values, uint32_t count, DxilIrRange *range) {
+    DxilIrFunction *view = function->view;
+    if (bridge->status != DXIL_OK) return false;
+    if (count > DXIL_IR_MAX_EXPR_ARGS - view->expr_arg_count)
+        return dxil_source_native_fail(bridge, 0u, DXIL_OUTPUT_TOO_LARGE,
+            "native DXIL bounds argument capacity exceeded");
+    *range = (DxilIrRange){view->expr_arg_count, count};
+    for (uint32_t i = 0u; i < count; ++i) view->expr_args[view->expr_arg_count++] = values[i];
+    return true;
+}
+
+uint32_t dxil_source_native_bound_index(DxilSourceBridge *bridge,
+    DxilSourceFunction *function, uint32_t index_expression, uint32_t source_index) {
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    DxilIrFunction *view = function->view;
+    if (index_expression >= view->expr_count || view->exprs[index_expression].kind != DXIL_IR_EXPR_INDEX ||
+        source_index >= bridge->compiler->expression_count) {
+        (void)dxil_source_native_fail(bridge, 0u, DXIL_INVALID_IR,
+            "native DXIL index projection identity is invalid");
+        return DXIL_IR_INVALID_ID;
+    }
+    const DxilIrExpr original = view->exprs[index_expression];
+    if (original.base >= view->expr_count) {
+        (void)dxil_source_native_fail(bridge, 0u, DXIL_INVALID_IR,
+            "native DXIL index base identity is invalid");
+        return DXIL_IR_INVALID_ID;
+    }
+    const DxilIrTypeId type = view->exprs[original.base].ty;
+    uint32_t count;
+    bool runtime;
+    /* Canonical type IDs are retained by this view; generated packed-vector
+     * helper types never create source index expressions. */
+    if (!target_index_extent(bridge->compiler, type, &count, &runtime)) {
+        (void)dxil_source_native_fail(bridge, 0u, DXIL_INVALID_IR,
+            "native DXIL index has no canonical typed extent");
+        return DXIL_IR_INVALID_ID;
+    }
+    const DxilIrType *base = &bridge->module->types[type];
+    for (uint32_t depth = 0u; base->kind == DXIL_IR_TYPE_REF && depth < DXIL_IR_MAX_TYPES; ++depth) {
+        if (base->elem >= bridge->module->type_count) {
+            (void)dxil_source_native_fail(bridge, 0u, DXIL_INVALID_IR,
+                "native DXIL indexed pointer element identity is invalid");
+            return DXIL_IR_INVALID_ID;
+        }
+        base = &bridge->module->types[base->elem];
+    }
+    if (runtime) {
+        switch (view->exprs[original.base].kind) {
+            case DXIL_IR_EXPR_GLOBAL_REF: case DXIL_IR_EXPR_MEMBER: case DXIL_IR_EXPR_LOAD:
+            case DXIL_IR_EXPR_LOCAL_REF: case DXIL_IR_EXPR_PARAM_REF: case DXIL_IR_EXPR_INDEX:
+            case DXIL_IR_EXPR_CALL: break;
+            case DXIL_IR_EXPR_BOOL_LIT: case DXIL_IR_EXPR_INT_LIT: case DXIL_IR_EXPR_FLOAT_LIT:
+            case DXIL_IR_EXPR_ADDRESS_OF: case DXIL_IR_EXPR_DEREF: case DXIL_IR_EXPR_UNARY:
+            case DXIL_IR_EXPR_BINARY: case DXIL_IR_EXPR_CONSTRUCT: return index_expression;
+        }
+    }
+    if (!runtime && base->kind == DXIL_IR_TYPE_ARRAY && local_space(bridge, view, original.base)) {
+        ConstantValue value;
+        bool known = false;
+        if (!dxil_source_native_constant_if_known(bridge, function, source_index, &value, &known)) return DXIL_IR_INVALID_ID;
+        if (known && (value.flags & CONSTANT_AGGREGATE) == 0u && value.bits < count) return index_expression;
+        if (guarded_index(bridge, function, source_index, count)) return index_expression;
+        if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    }
+    const DxilIrTypeId unsigned_type = dxil_source_native_type(bridge, IR_U32);
+    uint32_t maximum;
+    if (runtime) {
+        DxilIrRange length_arguments;
+        if (!arguments(bridge, function, &original.base, 1u, &length_arguments)) return DXIL_IR_INVALID_ID;
+        uint32_t length = dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+            .kind = DXIL_IR_EXPR_CALL, .ty = unsigned_type, .category = DXIL_IR_EXPR_VALUE,
+            .name = dxil_source_native_text(bridge, "arrayLength"), .call_kind = DXIL_IR_CALL_BUILTIN,
+            .args = length_arguments});
+        uint32_t one = dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+            .kind = DXIL_IR_EXPR_INT_LIT, .ty = unsigned_type,
+            .category = DXIL_IR_EXPR_VALUE, .uint_value = 1u});
+        maximum = dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+            .kind = DXIL_IR_EXPR_BINARY, .ty = unsigned_type, .category = DXIL_IR_EXPR_VALUE,
+            .binary_op = DXIL_IR_BINARY_SUB, .lhs = length, .rhs = one});
+    } else maximum = dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+        .kind = DXIL_IR_EXPR_INT_LIT, .ty = unsigned_type,
+        .category = DXIL_IR_EXPR_VALUE, .uint_value = count - 1u});
+    uint32_t values[] = {original.index_expr, maximum};
+    DxilIrRange clamp_arguments;
+    if (!arguments(bridge, function, values, 2u, &clamp_arguments)) return DXIL_IR_INVALID_ID;
+    uint32_t clamp = dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+        .kind = DXIL_IR_EXPR_CALL, .ty = unsigned_type, .category = DXIL_IR_EXPR_VALUE,
+        .name = dxil_source_native_text(bridge, "min"), .call_kind = DXIL_IR_CALL_BUILTIN,
+        .args = clamp_arguments, .robustness_generated = true});
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    view->exprs[index_expression].index_expr = clamp;
+    return index_expression;
+}
diff --git a/runtime/c/compiler/src/dxil/dxil_source_native_bounds.h b/runtime/c/compiler/src/dxil/dxil_source_native_bounds.h
new file mode 100644
index 000000000..2bc44676a
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source_native_bounds.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#ifndef DOE_DXIL_SOURCE_NATIVE_BOUNDS_H
+#define DOE_DXIL_SOURCE_NATIVE_BOUNDS_H
+#include "dxil_source_native_internal.h"
+
+/* Project the baseline native clamp graph using canonical typed extents and
+ * known constants. Does not claim optional proof/dispatch-derived elision. */
+uint32_t dxil_source_native_bound_index(DxilSourceBridge *, DxilSourceFunction *,
+    uint32_t index_expression, uint32_t source_index);
+
+#endif
diff --git a/runtime/c/compiler/src/dxil/dxil_source_native_expr.c b/runtime/c/compiler/src/dxil/dxil_source_native_expr.c
new file mode 100644
index 000000000..fd635a7a5
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source_native_expr.c
@@ -0,0 +1,453 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "dxil_source_native_internal.h"
+#include "dxil_source_native_packed.h"
+#include "dxil_source_native_bounds.h"
+#include "../sema.h"
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+uint32_t dxil_source_native_push_expr(DxilSourceBridge *bridge,
+    DxilSourceFunction *function, DxilIrExpr expression) {
+    uint32_t result = DXIL_IR_INVALID_ID;
+    if (bridge->status != DXIL_OK) return result;
+    DxilStatus status = dxil_ir_append_expr(function->view, &expression, &result);
+    if (status != DXIL_OK) {
+        (void)dxil_source_native_fail(bridge, 0u, status,
+            "native DXIL expression projection capacity exceeded");
+    }
+    return result;
+}
+
+static uint32_t value_expr(DxilSourceBridge *bridge,
+    DxilSourceFunction *function, uint32_t id, bool reference) {
+    if (bridge->status != DXIL_OK || id == DXIL_IR_INVALID_ID) return DXIL_IR_INVALID_ID;
+    if (reference || function->view->exprs[id].category == DXIL_IR_EXPR_VALUE) return id;
+    return dxil_source_native_push_expr(bridge, function, (DxilIrExpr){
+        .kind = DXIL_IR_EXPR_LOAD, .ty = function->view->exprs[id].ty,
+        .category = DXIL_IR_EXPR_VALUE, .inner = id});
+}
+
+static bool name_equal(const Source *source, NameSpan name, const char *text) {
+    return text != NULL && name.offset <= source->length &&
+        name.length <= source->length - name.offset &&
+        strlen(text) == name.length &&
+        memcmp(source->source + name.offset, text, name.length) == 0;
+}
+
+uint32_t dxil_source_native_root(DxilSourceBridge *bridge,
+    DxilSourceFunction *function, NameSpan name, bool reference) {
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    DxilIrFunction *view = function->view;
+    DxilIrExpr expression = {.category = DXIL_IR_EXPR_REF};
+    for (uint32_t n = function->scope_count; n != 0u; --n) {
+        uint32_t local = function->scope[n - 1u];
+        if (local >= view->local_count ||
+            !source_spans_equal(&bridge->source, name, function->local_names[local])) continue;
+        expression.kind = DXIL_IR_EXPR_LOCAL_REF;
+        expression.ty = view->locals[local].ty;
+        expression.index = local;
+        return value_expr(bridge, function,
+            dxil_source_native_push_expr(bridge, function, expression), reference);
+    }
+    for (uint32_t i = 0u; i < view->param_count; ++i) {
+        if (!name_equal(&bridge->source, name, view->params[i].name)) continue;
+        expression.kind = DXIL_IR_EXPR_PARAM_REF;
+        expression.ty = view->params[i].ty;
+        expression.index = i;
+        return value_expr(bridge, function,
+            dxil_source_native_push_expr(bridge, function, expression), reference);
+    }
+    for (uint32_t i = 0u; i < bridge->module->global_count; ++i) {
+        const DxilIrGlobal *global = &bridge->module->globals[i];
+        if (!name_equal(&bridge->source, name, global->name)) continue;
+        expression.kind = DXIL_IR_EXPR_GLOBAL_REF;
+        expression.ty = global->ty;
+        expression.index = i;
+        if (global->ty >= bridge->module->type_count) break;
+        DxilIrTypeKind kind = bridge->module->types[global->ty].kind;
+        bool handle = kind >= DXIL_IR_TYPE_SAMPLER && kind <= DXIL_IR_TYPE_STORAGE_TEXTURE_2D;
+        if (global->class == DXIL_IR_GLOBAL_CONST || handle) expression.category = DXIL_IR_EXPR_VALUE;
+        return value_expr(bridge, function,
+            dxil_source_native_push_expr(bridge, function, expression), reference);
+    }
+    (void)dxil_source_native_fail(bridge, name.offset, DXIL_INVALID_IR,
+        "typed source identity has no native DXIL projection binding");
+    return DXIL_IR_INVALID_ID;
+}
+
+static bool constructor(const DxilSourceBridge *bridge, const Expression *expression) {
+    NameSpan name = expression->value.call.callee;
+    if (source_span_is(&bridge->source, name, "bitcast")) return false;
+    if (expression->kind == EXPRESSION_CONSTRUCT ||
+        expression->value.call.type.offset != NO_ID ||
+        sema_find_type_alias(&bridge->source, name) != NO_ID ||
+        sema_find_struct(&bridge->source, name) != NO_ID) return true;
+    if (source_span_is(&bridge->source, name, "array") ||
+        source_span_is(&bridge->source, name, "bool") ||
+        source_span_is(&bridge->source, name, "i32") ||
+        source_span_is(&bridge->source, name, "u32") ||
+        source_span_is(&bridge->source, name, "f32") ||
+        source_span_is(&bridge->source, name, "f16")) return true;
+    uint32_t columns, rows;
+    if (type_matrix_name(&bridge->source, name, &columns, &rows)) return true;
+    const char *text = bridge->source.source + name.offset;
+    return (name.length == 4u || name.length == 5u) &&
+        memcmp(text, "vec", 3u) == 0 && text[3] >= '2' && text[3] <= '4';
+}
+
+static bool binary(ExpressionKind kind, Comparison comparison, DxilIrBinaryOp *out) {
+    switch (kind) {
+        case EXPRESSION_ADD: *out = DXIL_IR_BINARY_ADD; return true;
+        case EXPRESSION_SUBTRACT: *out = DXIL_IR_BINARY_SUB; return true;
+        case EXPRESSION_MULTIPLY: *out = DXIL_IR_BINARY_MUL; return true;
+        case EXPRESSION_DIVIDE: *out = DXIL_IR_BINARY_DIV; return true;
+        case EXPRESSION_REMAINDER: *out = DXIL_IR_BINARY_REM; return true;
+        case EXPRESSION_BIT_AND: *out = DXIL_IR_BINARY_BIT_AND; return true;
+        case EXPRESSION_BIT_OR: *out = DXIL_IR_BINARY_BIT_OR; return true;
+        case EXPRESSION_BIT_XOR: *out = DXIL_IR_BINARY_BIT_XOR; return true;
+        case EXPRESSION_SHIFT_LEFT: *out = DXIL_IR_BINARY_SHIFT_LEFT; return true;
+        case EXPRESSION_SHIFT_RIGHT: *out = DXIL_IR_BINARY_SHIFT_RIGHT; return true;
+        case EXPRESSION_AND: *out = DXIL_IR_BINARY_LOGICAL_AND; return true;
+        case EXPRESSION_OR: *out = DXIL_IR_BINARY_LOGICAL_OR; return true;
+        case EXPRESSION_COMPARE:
+            switch (comparison) {
+                case COMPARE_EQUAL: *out = DXIL_IR_BINARY_EQUAL; return true;
+                case COMPARE_NOT_EQUAL: *out = DXIL_IR_BINARY_NOT_EQUAL; return true;
+                case COMPARE_LESS: *out = DXIL_IR_BINARY_LESS; return true;
+                case COMPARE_LESS_EQUAL: *out = DXIL_IR_BINARY_LESS_EQUAL; return true;
+                case COMPARE_GREATER: *out = DXIL_IR_BINARY_GREATER; return true;
+                case COMPARE_GREATER_EQUAL: *out = DXIL_IR_BINARY_GREATER_EQUAL; return true;
+            }
+            return false;
+        case EXPRESSION_LOAD: case EXPRESSION_INTEGER: case EXPRESSION_DECIMAL:
+        case EXPRESSION_NAME: case EXPRESSION_MEMBER: case EXPRESSION_MAX:
+        case EXPRESSION_ABSTRACT_INTEGER: case EXPRESSION_BOOLEAN:
+        case EXPRESSION_NOT: case EXPRESSION_LITERAL: case EXPRESSION_NEGATE:
+        case EXPRESSION_COMPLEMENT: case EXPRESSION_CONSTRUCT:
+        case EXPRESSION_BITCAST: case EXPRESSION_CALL:
+        case EXPRESSION_ADDRESS: case EXPRESSION_DEREFERENCE: return false;
+    }
+    return false;
+}
+
+/* Retained IR stores an f64 token payload even for f32/f16-typed literals.
+ * Parse the unsuffixed token with the canonical numeric owner, not strtod or
+ * a second WGSL lexer. Semantic validation already admitted the original. */
+static bool literal(DxilSourceBridge *bridge, NameSpan span, NumericValue *value) {
+    if (!numeric_parse_literal(&bridge->source, span, value)) return false;
+    if (value->type != IR_F32 && value->type != IR_F16) return true;
+    const char *text = bridge->source.source + span.offset;
+    size_t length = span.length;
+    if (length != 0u && (text[length - 1u] == 'f' || text[length - 1u] == 'h')) --length;
+    bool hexadecimal = length > 1u && text[0] == '0' && (text[1] == 'x' || text[1] == 'X');
+    bool float_syntax = false;
+    for (size_t i = 0u; i < length; ++i) {
+        if (text[i] == '.' || (hexadecimal ? text[i] == 'p' || text[i] == 'P'
+                : text[i] == 'e' || text[i] == 'E')) float_syntax = true;
+    }
+    char *normalized = malloc(length + 3u);
+    if (normalized == NULL) return dxil_source_native_fail(bridge, span.offset,
+        DXIL_OUT_OF_MEMORY, "native DXIL literal projection allocation failed");
+    memcpy(normalized, text, length);
+    if (!float_syntax) { normalized[length++] = '.'; normalized[length++] = '0'; }
+    normalized[length] = '\0';
+    Source input = bridge->source;
+    input.source = normalized;
+    input.length = length;
+    bool ok = numeric_parse_literal(&input, (NameSpan){0u, (uint32_t)length}, value);
+    free(normalized);
+    return ok;
+}
+
+static bool reserve_arguments(DxilSourceBridge *bridge, DxilSourceFunction *function,
+    uint32_t count, uint32_t offset, DxilIrRange *range) {
+    if (bridge->status != DXIL_OK) return false;
+    DxilIrFunction *view = function->view;
+    if (count > DXIL_IR_MAX_EXPR_ARGS - view->expr_arg_count) {
+        return dxil_source_native_fail(bridge, offset, DXIL_OUTPUT_TOO_LARGE,
+            "native DXIL argument projection capacity exceeded");
+    }
+    *range = (DxilIrRange){view->expr_arg_count, count};
+    view->expr_arg_count += count;
+    return true;
+}
+
+static uint32_t member_index(DxilSourceBridge *bridge, DxilIrTypeId type,
+    NameSpan name, const char *text) {
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    if (type >= bridge->module->type_count) {
+        (void)dxil_source_native_fail(bridge, name.offset, DXIL_INVALID_IR,
+            "typed member base type is invalid");
+        return DXIL_IR_INVALID_ID;
+    }
+    const DxilIrType *base = &bridge->module->types[type];
+    if (base->kind == DXIL_IR_TYPE_STRUCT && base->struct_id < bridge->module->struct_count) {
+        const DxilIrStructDef *structure = &bridge->module->structs[base->struct_id];
+        for (uint32_t i = 0u; i < structure->field_count; ++i) {
+            if (strcmp(structure->fields[i].name, text) == 0) return i;
+        }
+    } else if (base->kind == DXIL_IR_TYPE_VECTOR && name.length != 0u) {
+        const char *component = strchr("xyzw", text[0]);
+        if (component != NULL) return (uint32_t)(component - "xyzw");
+        component = strchr("rgba", text[0]);
+        if (component != NULL) return (uint32_t)(component - "rgba");
+    }
+    char detail[160];
+    (void)snprintf(detail, sizeof(detail),
+        "typed member `%s` has no native DXIL field projection for type %u (kind %u)",
+        text, type, (unsigned)base->kind);
+    (void)dxil_source_native_fail(bridge, name.offset, DXIL_INVALID_IR, detail);
+    return DXIL_IR_INVALID_ID;
+}
+
+/* Canonical reference-path resolution does not cache resolved_type on every
+ * intermediate syntax node. Read the already-resolved aggregate relationship
+ * instead of treating that unused syntax word as a semantic type identity. */
+static DxilIrTypeId access_type(DxilSourceBridge *bridge, DxilIrTypeId base,
+    bool member, uint32_t field, uint32_t width, uint32_t offset) {
+    if (base >= bridge->module->type_count) return DXIL_IR_INVALID_ID;
+    const DxilIrType *type = &bridge->module->types[base];
+    if (member && type->kind == DXIL_IR_TYPE_STRUCT && type->struct_id < bridge->module->struct_count) {
+        const DxilIrStructDef *structure = &bridge->module->structs[type->struct_id];
+        if (field < structure->field_count) return structure->fields[field].ty;
+    } else if (type->kind == DXIL_IR_TYPE_VECTOR) {
+        if (!member || width == 1u) return type->elem;
+        for (uint32_t i = 0u; i < bridge->module->type_count; ++i) {
+            const DxilIrType *candidate = &bridge->module->types[i];
+            if (candidate->kind == DXIL_IR_TYPE_VECTOR && candidate->elem == type->elem &&
+                candidate->len == width) return i;
+        }
+    } else if (!member && type->kind == DXIL_IR_TYPE_ARRAY) return type->elem;
+    else if (!member && type->kind == DXIL_IR_TYPE_MATRIX) {
+        for (uint32_t i = 0u; i < bridge->module->type_count; ++i) {
+            const DxilIrType *candidate = &bridge->module->types[i];
+            if (candidate->kind == DXIL_IR_TYPE_VECTOR && candidate->elem == type->elem &&
+                candidate->len == type->rows) return i;
+        }
+    }
+    (void)dxil_source_native_fail(bridge, offset, DXIL_INVALID_IR,
+        "typed aggregate access has no native DXIL result identity");
+    return DXIL_IR_INVALID_ID;
+}
+
+uint32_t dxil_source_native_expr(DxilSourceBridge *bridge,
+    DxilSourceFunction *function, uint32_t id, bool reference, unsigned depth) {
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    if (id >= bridge->compiler->expression_count || depth >= DXIL_IR_MAX_EXPRS) {
+        (void)dxil_source_native_fail(bridge, 0u, DXIL_OUTPUT_TOO_LARGE,
+            "native DXIL expression traversal exceeded its explicit bound");
+        return DXIL_IR_INVALID_ID;
+    }
+    const Expression *expression = &bridge->compiler->expressions[id];
+    DxilIrFunction *view = function->view;
+    DxilIrExpr output = {.ty = dxil_source_native_type(bridge, expression->resolved_type),
+        .category = DXIL_IR_EXPR_VALUE};
+    if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+    DxilIrBinaryOp operation;
+    const bool is_binary = binary(expression->kind, expression->value.comparison, &operation);
+    /* The retained rewrite only folds concrete scalar integer arithmetic, not
+     * abstract arithmetic, comparisons or floating-point trees. Ask the shared
+     * constant owner for its validated value; never duplicate numeric rules. */
+    if (!reference && (expression->resolved_type == IR_U32 || expression->resolved_type == IR_I32) &&
+        (is_binary || expression->kind == EXPRESSION_NEGATE || expression->kind == EXPRESSION_COMPLEMENT)) {
+        ConstantValue constant;
+        bool known = false;
+        if (!dxil_source_native_constant_if_known(bridge, function, id, &constant, &known))
+            return DXIL_IR_INVALID_ID;
+        if (known && (constant.flags & CONSTANT_AGGREGATE) == 0u) {
+            output.kind = DXIL_IR_EXPR_INT_LIT;
+            output.uint_value = constant.bits;
+            return dxil_source_native_push_expr(bridge, function, output);
+        }
+    }
+    if (is_binary) {
+        output.kind = DXIL_IR_EXPR_BINARY;
+        output.binary_op = operation;
+        output.lhs = dxil_source_native_expr(bridge, function, expression->left, false, depth + 1u);
+        output.rhs = dxil_source_native_expr(bridge, function, expression->right, false, depth + 1u);
+    } else switch (expression->kind) {
+        case EXPRESSION_NAME:
+            return dxil_source_native_root(bridge, function, expression->value.name, reference);
+        case EXPRESSION_BOOLEAN:
+            output.kind = DXIL_IR_EXPR_BOOL_LIT;
+            output.bool_value = expression->value.integer != 0u;
+            break;
+        case EXPRESSION_LITERAL: {
+            NumericValue value;
+            if (!literal(bridge, expression->value.name, &value)) {
+                (void)dxil_source_native_fail(bridge, expression->source_offset, DXIL_INVALID_IR,
+                    "typed literal payload could not be projected to native DXIL");
+                return DXIL_IR_INVALID_ID;
+            }
+            if (value.type == IR_ABSTRACT_FLOAT || value.type == IR_F32 || value.type == IR_F16) {
+                output.kind = DXIL_IR_EXPR_FLOAT_LIT;
+                if (value.type == IR_ABSTRACT_FLOAT) memcpy(&output.float_value, &value.bits, sizeof(double));
+                else if (value.type == IR_F32) {
+                    uint32_t bits = (uint32_t)value.bits;
+                    float number;
+                    memcpy(&number, &bits, sizeof(number));
+                    output.float_value = number;
+                } else output.float_value = numeric_half_value(value.bits);
+            } else { output.kind = DXIL_IR_EXPR_INT_LIT; output.uint_value = value.bits; }
+            break;
+        }
+        case EXPRESSION_INTEGER: case EXPRESSION_ABSTRACT_INTEGER:
+            output.kind = DXIL_IR_EXPR_INT_LIT; output.uint_value = expression->value.integer; break;
+        case EXPRESSION_DECIMAL: {
+            uint32_t bits = expression->value.integer;
+            float value;
+            memcpy(&value, &bits, sizeof(value));
+            output.kind = DXIL_IR_EXPR_FLOAT_LIT; output.float_value = value; break;
+        }
+        case EXPRESSION_MEMBER: case EXPRESSION_LOAD: {
+            uint32_t base = expression->left == NO_ID
+                ? dxil_source_native_root(bridge, function, expression->kind == EXPRESSION_MEMBER
+                    ? expression->value.member.object : expression->value.reference.storage, true)
+                : dxil_source_native_expr(bridge, function, expression->left, true, depth + 1u);
+            if (base == DXIL_IR_INVALID_ID) return base;
+            output.base = base;
+            output.category = view->exprs[base].category;
+            if (expression->kind == EXPRESSION_LOAD) {
+                output.kind = DXIL_IR_EXPR_INDEX;
+                output.ty = access_type(bridge, view->exprs[base].ty, false, 0u, 0u,
+                    expression->source_offset);
+                output.index_expr = dxil_source_native_expr(bridge, function,
+                    expression->value.reference.index, false, depth + 1u);
+            } else {
+                output.kind = DXIL_IR_EXPR_MEMBER;
+                output.field_name = dxil_source_native_name(bridge, expression->value.member.member);
+                output.field_index = member_index(bridge, view->exprs[base].ty,
+                    expression->value.member.member, output.field_name);
+                if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+                output.ty = access_type(bridge, view->exprs[base].ty, true, output.field_index,
+                    expression->value.member.member.length, expression->source_offset);
+                if (bridge->module->types[view->exprs[base].ty].kind == DXIL_IR_TYPE_VECTOR &&
+                    expression->value.member.member.length > 1u) {
+                    output.category = DXIL_IR_EXPR_VALUE;
+                    output.base = value_expr(bridge, function, base, false);
+                }
+            }
+            uint32_t projected = dxil_source_native_push_expr(bridge, function, output);
+            if (expression->kind == EXPRESSION_LOAD) projected = dxil_source_native_bound_index(
+                bridge, function, projected, expression->value.reference.index);
+            return value_expr(bridge, function, projected, reference);
+        }
+        case EXPRESSION_NOT: case EXPRESSION_NEGATE: case EXPRESSION_COMPLEMENT:
+            output.kind = DXIL_IR_EXPR_UNARY;
+            output.unary_op = expression->kind == EXPRESSION_NOT ? DXIL_IR_UNARY_NOT
+                : expression->kind == EXPRESSION_NEGATE ? DXIL_IR_UNARY_NEG : DXIL_IR_UNARY_BIT_NOT;
+            output.operand = dxil_source_native_expr(bridge, function, expression->left, false, depth + 1u);
+            break;
+        case EXPRESSION_CALL: case EXPRESSION_CONSTRUCT: case EXPRESSION_BITCAST: {
+            bool is_constructor = constructor(bridge, expression);
+            output.kind = is_constructor ? DXIL_IR_EXPR_CONSTRUCT : DXIL_IR_EXPR_CALL;
+            output.name = dxil_source_native_name(bridge, expression->value.call.callee);
+            if (bridge->status != DXIL_OK || output.name == NULL) return DXIL_IR_INVALID_ID;
+            output.call_kind = DXIL_IR_CALL_BUILTIN;
+            output.construct_ty = output.ty;
+            for (uint32_t i = 0u; i < bridge->compiler->function_count; ++i) {
+                if (source_spans_equal(&bridge->source, expression->value.call.callee,
+                        bridge->compiler->functions[i].name)) output.call_kind = DXIL_IR_CALL_USER;
+            }
+            if (!reserve_arguments(bridge, function, expression->right,
+                    expression->source_offset, &output.args)) return DXIL_IR_INVALID_ID;
+            uint32_t cursor = expression->left;
+            for (uint32_t i = 0u; i < expression->right; ++i) {
+                if (cursor >= bridge->compiler->argument_count) {
+                    (void)dxil_source_native_fail(bridge, expression->source_offset, DXIL_INVALID_IR,
+                        "typed call argument chain is invalid");
+                    return DXIL_IR_INVALID_ID;
+                }
+                uint32_t argument = bridge->compiler->arguments[cursor].expression;
+                bool ref_argument = !is_constructor && output.call_kind == DXIL_IR_CALL_BUILTIN &&
+                    i == 0u && (strncmp(output.name, "atomic", 6u) == 0 || strcmp(output.name, "arrayLength") == 0);
+                if (ref_argument && argument < bridge->compiler->expression_count &&
+                    bridge->compiler->expressions[argument].kind == EXPRESSION_ADDRESS)
+                    argument = bridge->compiler->expressions[argument].left;
+                view->expr_args[output.args.start + i] = dxil_source_native_expr(bridge,
+                    function, argument, ref_argument, depth + 1u);
+                cursor = bridge->compiler->arguments[cursor].next;
+            }
+            if (bridge->status != DXIL_OK) return DXIL_IR_INVALID_ID;
+            if (!is_constructor && output.call_kind == DXIL_IR_CALL_BUILTIN &&
+                strcmp(output.name, "ldexp") == 0 && output.args.len == 2u) {
+                uint32_t first = view->expr_args[output.args.start];
+                DxilIrTypeId type = view->exprs[first].ty;
+                if (bridge->module->types[type].kind == DXIL_IR_TYPE_VECTOR)
+                    type = bridge->module->types[type].elem;
+                if (bridge->module->types[type].kind == DXIL_IR_TYPE_SCALAR &&
+                    bridge->module->types[type].scalar == DXIL_IR_SCALAR_ABSTRACT_INT) {
+                    DxilIrRange arguments;
+                    if (!reserve_arguments(bridge, function, 1u, expression->source_offset, &arguments)) return DXIL_IR_INVALID_ID;
+                    view->expr_args[arguments.start] = first;
+                    view->expr_args[output.args.start] = dxil_source_native_push_expr(bridge, function,
+                        (DxilIrExpr){.kind = DXIL_IR_EXPR_CONSTRUCT, .ty = output.ty,
+                            .category = DXIL_IR_EXPR_VALUE, .construct_ty = output.ty, .args = arguments});
+                }
+            }
+            if (!is_constructor && output.call_kind == DXIL_IR_CALL_BUILTIN) {
+                const NumericBuiltin *builtin = builtin_named(&bridge->source,
+                    expression->value.call.callee);
+                if (builtin != NULL && builtin->family == BUILTIN_PACKED_INTEGER) {
+                    /* Retained packed lowering materializes abstract scalar
+                     * arguments before expansion. Reuse canonical constant
+                     * evaluation, including lexical const bindings. */
+                    uint32_t argument_cursor = expression->left;
+                    for (uint32_t i = 0u; !packed_pack(builtin->kind) && i < output.args.len; ++i) {
+                        uint32_t projected = view->expr_args[output.args.start + i];
+                        DxilIrTypeId type = view->exprs[projected].ty;
+                        if (bridge->module->types[type].kind == DXIL_IR_TYPE_SCALAR &&
+                            bridge->module->types[type].scalar == DXIL_IR_SCALAR_ABSTRACT_INT) {
+                            ConstantValue value, materialized;
+                            uint32_t original = bridge->compiler->arguments[argument_cursor].expression;
+                            if (!dxil_source_native_constant(bridge, function, original, &value) ||
+                                !constant_materialize(&bridge->source, expression->source_offset,
+                                    value, IR_U32, &materialized)) {
+                                (void)dxil_source_native_fail(bridge, expression->source_offset, DXIL_INVALID_IR,
+                                    "packed argument constant could not be materialized");
+                                return DXIL_IR_INVALID_ID;
+                            }
+                            view->expr_args[output.args.start + i] = dxil_source_native_push_expr(bridge, function,
+                                (DxilIrExpr){.kind = DXIL_IR_EXPR_INT_LIT,
+                                    .ty = dxil_source_native_type(bridge, IR_U32),
+                                    .category = DXIL_IR_EXPR_VALUE, .uint_value = materialized.bits});
+                        }
+                        argument_cursor = bridge->compiler->arguments[argument_cursor].next;
+                    }
+                    return dxil_source_native_packed(bridge, function, builtin->kind, &output);
+                }
+            }
+            break;
+        }
+        case EXPRESSION_ADDRESS: case EXPRESSION_DEREFERENCE:
+            output.kind = expression->kind == EXPRESSION_ADDRESS ? DXIL_IR_EXPR_ADDRESS_OF : DXIL_IR_EXPR_DEREF;
+            output.inner = dxil_source_native_expr(bridge, function, expression->left,
+                expression->kind == EXPRESSION_ADDRESS, depth + 1u);
+            if (expression->kind == EXPRESSION_DEREFERENCE) {
+                output.category = DXIL_IR_EXPR_REF;
+                return value_expr(bridge, function,
+                    dxil_source_native_push_expr(bridge, function, output), reference);
+            }
+            break;
+        case EXPRESSION_MAX:
+            output.kind = DXIL_IR_EXPR_CALL;
+            output.name = dxil_source_native_text(bridge, "max");
+            output.call_kind = DXIL_IR_CALL_BUILTIN;
+            if (!reserve_arguments(bridge, function, 2u, expression->source_offset, &output.args)) return DXIL_IR_INVALID_ID;
+            view->expr_args[output.args.start] = dxil_source_native_expr(bridge, function, expression->left, false, depth + 1u);
+            view->expr_args[output.args.start + 1u] = dxil_source_native_expr(bridge, function, expression->right, false, depth + 1u);
+            break;
+        case EXPRESSION_ADD: case EXPRESSION_SUBTRACT: case EXPRESSION_MULTIPLY:
+        case EXPRESSION_COMPARE: case EXPRESSION_AND: case EXPRESSION_OR:
+        case EXPRESSION_DIVIDE: case EXPRESSION_REMAINDER: case EXPRESSION_BIT_AND:
+        case EXPRESSION_BIT_OR: case EXPRESSION_BIT_XOR: case EXPRESSION_SHIFT_LEFT:
+        case EXPRESSION_SHIFT_RIGHT:
+            (void)dxil_source_native_fail(bridge, expression->source_offset, DXIL_INVALID_IR,
+                "typed binary operation has no native DXIL projection");
+            return DXIL_IR_INVALID_ID;
+    }
+    return dxil_source_native_push_expr(bridge, function, output);
+}
diff --git a/runtime/c/compiler/src/dxil/dxil_source_native_globals.c b/runtime/c/compiler/src/dxil/dxil_source_native_globals.c
new file mode 100644
index 000000000..6b94ac290
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/dxil_source_native_globals.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "dxil_source_native_internal.h"
+#include <string.h>
+
+static bool scalar_constant(ConstantValue value, DxilIrConstant *out) {
+    out->ty = value.type;
+    if (value.type == IR_BOOL) {
+        out->kind = DXIL_IR_CONST_BOOL; out->bool_value = value.bits != 0u;
+    } else if (value.type == IR_F32 || value.type == IR_F16 || value.type == IR_ABSTRACT_FLOAT) {
+        out->kind = DXIL_IR_CONST_FLOAT;
+        if (value.type == IR_ABSTRACT_FLOAT) memcpy(&out->float_value, &value.bits, sizeof(out->float_value));
+        else if (value.type == IR_F16) out->float_value = numeric_half_value(value.bits);
+        else {
+            const uint32_t bits = (uint32_t)value.bits;
+            float scalar;
+            memcpy(&scalar, &bits, sizeof(scalar));
+            out->float_value = scalar;
+        }
+    } else if (value.type == IR_U32 || value.type == IR_I32 || value.type == IR_ABSTRACT_INT) {
+        out->kind = DXIL_IR_CONST_INT; out->int_value = value.bits;
+    } else return false;
+    return true;
+}
+static bool constant_tree(DxilSourceBridge *b, ConstantValue value, uint32_t *id, unsigned depth) {
+    DxilIrModule *module = b->module;
+    if (depth > DXIL_IR_MAX_TYPES || module->constant_count == DXIL_IR_MAX_CONSTANTS)
+        return dxil_source_native_fail(b, 0u, DXIL_OUTPUT_TOO_LARGE, "native DXIL initializer tree capacity exceeded");
+    *id = module->constant_count++;
+    DxilIrConstant *out = &module->constants[*id];
+    out->ty = dxil_source_native_type(b, value.type);
+    if ((value.flags & CONSTANT_AGGREGATE) == 0u) {
+        if (!scalar_constant(value, out))
+            return dxil_source_native_fail(b, 0u, DXIL_INVALID_IR, "invalid typed scalar initializer");
+        return true;
+    }
+    const uint32_t count = type_children(b->compiler, value.type);
+    if (count > DXIL_IR_MAX_CONSTANTS - module->constant_child_count)
+        return dxil_source_native_fail(b, 0u, DXIL_OUTPUT_TOO_LARGE, "native DXIL initializer edge capacity exceeded");
+    out->composite = true;
+    out->children = (DxilIrRange){module->constant_child_count, count};
+    module->constant_child_count += count;
+    for (uint32_t i = 0u; i < count; ++i) {
+        ConstantValue element;
+        if (!constant_project(&b->source, value, i, &element) ||
+            !constant_tree(b, element, &module->constant_children[out->children.start + i], depth + 1u)) return false;
+    }
+    return b->status == DXIL_OK;
+}
+static bool initializer(DxilSourceBridge *b, DxilIrGlobal *global, ConstantValue value) {
+    if (!constant_tree(b, value, &global->init_tree, 0u)) return false;
+    global->has_initializer = true;
+    global->has_init_tree = true;
+    const DxilIrConstant *constant = &b->module->constants[global->init_tree];
+    if (!constant->composite) {
+        global->init_kind = constant->kind; global->init_bool = constant->bool_value;
+        global->init_int = constant->int_value; global->init_float = constant->float_value;
+    }
+    return true;
+}
+bool dxil_source_native_globals(DxilSourceBridge *b) {
+    CompilerWorkspace *c = b->compiler;
+    uint32_t count = c->resource_count + c->workgroup_count;
+    for (uint32_t i = 0u; i < c->constant_decl_count; ++i)
+        if (c->constant_decls[i].expression != NO_ID) ++count;
+    if (count > DXIL_IR_MAX_GLOBALS)
+        return dxil_source_native_fail(b, 0u, DXIL_OUTPUT_TOO_LARGE, "native DXIL global capacity exceeded");
+    for (uint32_t i = 0u; i < c->resource_count; ++i) {
+        const ResourceRecord *r = &c->resources[i];
+        const bool handle = type_handle(c, r->type);
+        DxilIrGlobal *g = &b->module->globals[b->module->global_count++];
+        *g = (DxilIrGlobal){.name = dxil_source_native_name(b, r->name), .ty = r->type,
+            .class = DXIL_IR_GLOBAL_VAR, .has_addr_space = true,
+            .addr_space = handle ? DXIL_IR_ADDR_HANDLE : r->kind == DOE_COMPILER_UNIFORM_BUFFER ? DXIL_IR_ADDR_UNIFORM : DXIL_IR_ADDR_STORAGE,
+            .has_access = !handle && r->kind != DOE_COMPILER_UNIFORM_BUFFER,
+            .access = r->access == DOE_COMPILER_READ_WRITE ? DXIL_IR_ACCESS_READ_WRITE : DXIL_IR_ACCESS_READ,
+            .has_binding = true, .binding = {r->group, r->binding}};
+    }
+    for (uint32_t i = 0u; i < c->workgroup_count; ++i) {
+        const WorkgroupRoot *r = &c->workgroups[i];
+        if (r->state.resolved.address_space != MODULE_PRIVATE && r->state.resolved.address_space != MODULE_WORKGROUP)
+            return dxil_source_native_fail(b, r->name.offset, DXIL_UNSUPPORTED_CONSTRUCT, "module space is outside retained native DXIL IR");
+        DxilIrGlobal *g = &b->module->globals[b->module->global_count++];
+        *g = (DxilIrGlobal){.name = dxil_source_native_name(b, r->name), .ty = r->type,
+            .class = DXIL_IR_GLOBAL_VAR, .has_addr_space = true,
+            .addr_space = r->state.resolved.address_space == MODULE_PRIVATE ? DXIL_IR_ADDR_PRIVATE : DXIL_IR_ADDR_WORKGROUP};
+        if (r->state.resolved.initializer != NO_ID &&
+            !initializer(b, g, c->constant_edges[r->state.resolved.initializer])) return false;
+    }
+    for (uint32_t i = 0u; i < c->constant_decl_count; ++i) {
+        const ConstantSyntax *declaration = &c->constant_decls[i];
+        if (declaration->expression == NO_ID) continue;
+        DxilIrGlobal *g = &b->module->globals[b->module->global_count++];
+        *g = (DxilIrGlobal){.name = dxil_source_native_name(b, declaration->name),
+            .ty = declaration->type, .class = DXIL_IR_GLOBAL_CONST};
+        if ((declaration->state & DECLARATION_OVERRIDE) != 0u) {
+            OverrideRecord *record = override_declaration(&b->source, i);
+            if (record == NULL) return dxil_source_native_fail(b, declaration->name.offset, DXIL_INVALID_IR, "missing canonical override record");
+            g->class = DXIL_IR_GLOBAL_OVERRIDE;
+            g->has_override_id = (record->flags & DOE_COMPILER_OVERRIDE_HAS_ID) != 0u;
+            g->override_id = record->id;
+        }
+        if (declaration->expression != OVERRIDE_NO_INITIALIZER &&
+            (declaration->state & DECLARATION_OVERRIDE) != 0u &&
+            (declaration->state & DECLARATION_KNOWN) == 0u)
+            return dxil_source_native_fail(b, declaration->name.offset, DXIL_UNSUPPORTED_CONSTRUCT,
+                "native DXIL override initializer has no resolved default value");
+        if (declaration->expression != OVERRIDE_NO_INITIALIZER &&
+            !initializer(b, g, (ConstantValue){declaration->type,
+                (declaration->state & 16u) != 0u ? CONSTANT_AGGREGATE : 0u, declaration->value.bits})) return false;
+    }
+    return b->status == DXIL_OK;
+}
