+#if !defined(_WIN32)
+static void check_closed_standard_streams(const char *executable,
+    const char *directory) {
+    for (unsigned close_input = 0u; close_input < 2u; ++close_input) {
+        pid_t child = fork();
+        CHECK(child >= 0);
+        if (child < 0) return;
+        if (child == 0) {
+            uint8_t out[1024];
+            size_t written = 73u;
+            DxilDiagnostic diagnostic;
+            const DxilToolchainConfig config = {
+                executable, DXIL_DISCOVERY_EXPLICIT_CONFIG
+            };
+            const DxilLoweredModule entry = {
+                DXIL_STAGE_COMPUTE, "noisy", {1u, 1u, 1u}, 6u, 0u, false
+            };
+            if (close_input != 0u) (void)close(STDIN_FILENO);
+            (void)close(STDOUT_FILENO);
+            (void)close(STDERR_FILENO);
+            memset(out, 0xa5, sizeof(out));
+            DxilStatus status = dxil_emit_hlsl_toolchain(&entry, hlsl_input,
+                sizeof(hlsl_input) - 1u, out, sizeof(out), &config, directory,
+                &written, &diagnostic);
+            if (status != DXIL_INVALID_IR || written != 73u ||
+                strstr(diagnostic.message, "intentional noisy child failure")
+                    == NULL) _exit(73);
+            for (size_t i = 0u; i < sizeof(out); ++i) {
+                if (out[i] != 0xa5) _exit(74);
+            }
+            _exit(0);
+        }
+        int wait_status = 0;
+        pid_t waited;
+        do { waited = waitpid(child, &wait_status, 0); }
+        while (waited < 0 && errno == EINTR);
+        CHECK(waited == child);
+        CHECK(WIFEXITED(wait_status) && WEXITSTATUS(wait_status) == 0);
+    }
+}
+#endif
+
+static int run_tests(int argc, char **argv) {
+    char directory[256];
+    char occupied[320];
+    char marker[384];
+    FILE *file = NULL;
+    if (argc > 1) return fake_child(argc, argv);
+    check_first_error();
+    (void)snprintf(directory, sizeof(directory),
+        "dxil io & \xe9\x9b\xaa-%lu", dxil_files_process_id());
+    (void)snprintf(occupied, sizeof(occupied), "%s/doe_wgsl_dxil_%lu_0",
+        directory, dxil_files_process_id());
+    (void)snprintf(marker, sizeof(marker), "%s/untouched", occupied);
+    CHECK(dxil_files_mkdir(directory) == 0);
+    CHECK(dxil_files_mkdir(occupied) == 0);
+    file = dxil_files_create(marker);
+    CHECK(file != NULL);
+    if (file == NULL) return 1;
+    CHECK(fputs("owned by someone else", file) >= 0);
+    CHECK(fclose(file) == 0);
+    file = dxil_files_create(marker);
+    CHECK(file == NULL);
+    CHECK(errno == EEXIST);
+    if (file != NULL) (void)fclose(file);
+    check_case(argv[0], directory, "valid", 1024u, DXIL_OK, NULL);
+    check_maximum(argv[0], directory);
+    check_case(argv[0], directory, "missing", 1024u, DXIL_INVALID_IR,
+        "did not write");
+    check_case(argv[0], directory, "malformed", 1024u, DXIL_INVALID_IR,
+        "structurally invalid DXIL container");
+    check_case(argv[0], directory, "oversized", 1024u, DXIL_OUTPUT_TOO_LARGE,
+        "exceeded the 262144-byte contract");
+    check_case(argv[0], directory, "failure", 1024u, DXIL_INVALID_IR,
+        "intentional controlled-child failure");
+    check_case(argv[0], directory, "noisy", 1024u, DXIL_INVALID_IR,
+        "intentional noisy child failure");
+    check_case(argv[0], directory, "valid", 1u, DXIL_OUTPUT_TOO_LARGE, NULL);
+    check_case("definitely-no-such-dxc-executable", directory, "valid", 1024u,
+        DXIL_SHADER_TOOLCHAIN_UNAVAILABLE, NULL);
+    check_source(argv[0], directory);
+#if !defined(_WIN32)
+    check_closed_standard_streams(argv[0], directory);
+#endif
+    /* A child-created extra file makes cleanup fail without synthetic I/O
+     * hooks. No output may publish, and an earlier child error must win. */
+    for (unsigned i = 0u; i < 2u; ++i) {
+        char extra[384];
+        char temporary[320];
+        check_case(argv[0], directory, i == 0u ? "cleanup" : "failure_cleanup",
+            1024u, DXIL_INVALID_IR, i == 0u
+                ? "remove DXIL temporary directory"
+                : "intentional controlled-child failure");
+        (void)snprintf(temporary, sizeof(temporary), "%s/doe_wgsl_dxil_%lu_1",
+            directory, dxil_files_process_id());
+        (void)snprintf(extra, sizeof(extra), "%s/output.dxil.extra", temporary);
+        CHECK(dxil_files_remove(extra) == 0);
+        CHECK(dxil_files_rmdir(temporary) == 0);
+    }
+    file = dxil_files_read(marker);
+    CHECK(file != NULL);
+    if (file != NULL) {
+        char content[32] = {0};
+        CHECK(fread(content, 1u, sizeof(content), file) == 21u);
+        CHECK(strcmp(content, "owned by someone else") == 0);
+        CHECK(fclose(file) == 0);
+    }
+    CHECK(dxil_files_remove(marker) == 0);
+    CHECK(dxil_files_rmdir(occupied) == 0);
+    /* Removing the root succeeds only if every owned temporary directory and
+     * both artifact names were removed after successes and every failure. */
+    CHECK(dxil_files_rmdir(directory) == 0);
+#if defined(_WIN32)
+    check_case(argv[0], "\xff", "valid", 1024u, DXIL_INVALID_IR, NULL);
+#endif
+    TEST_SUMMARY("test_dxil_io (controlled child; no DXC qualification)");
+}
+
+#if defined(_WIN32)
+int wmain(int argc, wchar_t **wide_argv);
+int wmain(int argc, wchar_t **wide_argv) {
+    char text[9][DXIL_FILES_PATH_CAP];
+    char *argv[9];
+    if (argc > 9) return 90;
+    for (int i = 0; i < argc; ++i) {
+        if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide_argv[i], -1,
+                text[i], (int)sizeof(text[i]), NULL, NULL) == 0) return 90;
+        argv[i] = text[i];
+    }
+    return run_tests(argc, argv);
+}
+#else
+int main(int argc, char **argv) {
+    return run_tests(argc, argv);
+}
+#endif
diff --git a/runtime/c/compiler/src/dxil/tests/test_dxil_native_opt.c b/runtime/c/compiler/src/dxil/tests/test_dxil_native_opt.c
new file mode 100644
index 000000000..dcf007949
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/tests/test_dxil_native_opt.c
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "test_util.h"
+#include "dxil_source_native_opt.h"
+#include "../numeric.h"
+#include <stdlib.h>
+
+static DxilIrModule module;
+static DxilSourceBridge bridge;
+static DxilSourceFunction function;
+static DoeCompilerDiagnostic source_diagnostic;
+
+static void fixture(unsigned which) {
+    memset(&module, 0, sizeof(module));
+    memset(&bridge, 0, sizeof(bridge));
+    memset(&function, 0, sizeof(function));
+    memset(&source_diagnostic, 0, sizeof(source_diagnostic));
+    bridge.source.diagnostic = &source_diagnostic;
+    bridge.module = &module;
+    function.view = &module.functions[0];
+    module.function_count = 1u;
+    module.type_count = 3u;
+    module.types[0] = (DxilIrType){.kind = DXIL_IR_TYPE_SCALAR, .scalar = DXIL_IR_SCALAR_U32};
+    module.types[1] = (DxilIrType){.kind = DXIL_IR_TYPE_SCALAR, .scalar = DXIL_IR_SCALAR_I32};
+    module.types[2] = (DxilIrType){.kind = DXIL_IR_TYPE_SCALAR, .scalar = DXIL_IR_SCALAR_BOOL};
+    const uint32_t ty = which == 4u || which == 5u ? 2u : which == 10u || which == 12u || which == 14u ? 1u : 0u;
+    DxilIrFunction *f = function.view;
+    f->expr_count = 3u;
+    f->exprs[0] = (DxilIrExpr){.kind = DXIL_IR_EXPR_INT_LIT, .ty = ty, .uint_value = 64u};
+    f->exprs[1] = (DxilIrExpr){.kind = DXIL_IR_EXPR_INT_LIT, .ty = ty, .uint_value = 2u};
+    f->exprs[2] = (DxilIrExpr){.kind = DXIL_IR_EXPR_BINARY, .ty = ty,
+        .binary_op = DXIL_IR_BINARY_MUL, .lhs = 0u, .rhs = 1u};
+    if (which == 0u || which == 7u) {
+        f->local_count = 1u;
+        f->locals[0] = (DxilIrLocal){.name = "alias", .ty = ty, .mutable = which == 7u};
+        f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_LOCAL_DECL,
+            .local = 0u, .is_const = which == 0u, .has_initializer = true, .initializer = 0u};
+        f->exprs[3] = (DxilIrExpr){.kind = DXIL_IR_EXPR_LOCAL_REF, .ty = ty, .index = 0u};
+        f->expr_count = 4u;
+        f->exprs[2].lhs = 3u;
+    } else if (which == 1u) {
+        module.global_count = 1u;
+        module.globals[0] = (DxilIrGlobal){.class = DXIL_IR_GLOBAL_CONST, .has_initializer = true,
+            .init_kind = DXIL_IR_CONST_INT, .init_int = 7u};
+        f->exprs[0].kind = DXIL_IR_EXPR_GLOBAL_REF;
+        f->exprs[1].uint_value = 4u;
+        f->exprs[2].binary_op = DXIL_IR_BINARY_ADD;
+    } else if (which >= 2u && which <= 6u) {
+        f->exprs[0].kind = which == 6u ? DXIL_IR_EXPR_CALL : DXIL_IR_EXPR_PARAM_REF;
+        f->exprs[0].name = "effect";
+        f->exprs[1].uint_value = which == 3u ? 1u : 0u;
+        f->exprs[2].binary_op = which == 2u ? DXIL_IR_BINARY_ADD : DXIL_IR_BINARY_MUL;
+        if (which == 4u || which == 5u) {
+            f->exprs[1].kind = DXIL_IR_EXPR_BOOL_LIT;
+            f->exprs[1].bool_value = which == 4u;
+            f->exprs[2].binary_op = which == 4u ? DXIL_IR_BINARY_LOGICAL_AND : DXIL_IR_BINARY_LOGICAL_OR;
+        }
+    } else if (which == 8u) {
+        f->exprs[0].kind = DXIL_IR_EXPR_PARAM_REF;
+        f->exprs[0].category = DXIL_IR_EXPR_REF;
+        f->exprs[1].uint_value = 0u;
+        f->exprs[2].binary_op = DXIL_IR_BINARY_ADD;
+    } else if (which == 9u || which == 10u) {
+        f->exprs[0].uint_value = which == 10u ? UINT32_C(0x80000000) : 7u;
+        f->exprs[1].uint_value = which == 10u ? UINT32_MAX : 0u;
+        f->exprs[2].binary_op = DXIL_IR_BINARY_DIV;
+    } else if (which == 11u) {
+        f->exprs[0].uint_value = UINT32_MAX;
+        f->exprs[2].binary_op = DXIL_IR_BINARY_ADD;
+    } else if (which == 12u) {
+        f->exprs[0].uint_value = UINT32_C(0x80000000);
+        f->exprs[2].kind = DXIL_IR_EXPR_UNARY;
+        f->exprs[2].unary_op = DXIL_IR_UNARY_NEG;
+        f->exprs[2].operand = 0u;
+    } else if (which >= 13u) {
+        f->exprs[0].uint_value = which == 13u ? 7u : UINT32_C(0x80000000);
+        f->exprs[1].ty = 0u;
+        f->exprs[1].uint_value = which == 13u ? 32u : which == 14u ? 33u : 1u;
+        f->exprs[2].binary_op = which == 14u ? DXIL_IR_BINARY_SHIFT_RIGHT : DXIL_IR_BINARY_SHIFT_LEFT;
+    }
+    f->root_stmt = f->stmt_count;
+    f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_RETURN,
+        .has_return_value = true, .return_value = 2u};
+}
+static const DxilIrExpr *result(void) {
+    return &function.view->exprs[function.view->stmts[function.view->root_stmt].return_value];
+}
+static void cases(void) {
+    const DxilIrExprKind kinds[] = {DXIL_IR_EXPR_INT_LIT, DXIL_IR_EXPR_INT_LIT,
+        DXIL_IR_EXPR_PARAM_REF, DXIL_IR_EXPR_PARAM_REF, DXIL_IR_EXPR_PARAM_REF, DXIL_IR_EXPR_PARAM_REF,
+        DXIL_IR_EXPR_BINARY, DXIL_IR_EXPR_BINARY, DXIL_IR_EXPR_BINARY, DXIL_IR_EXPR_BINARY,
+        DXIL_IR_EXPR_BINARY, DXIL_IR_EXPR_INT_LIT, DXIL_IR_EXPR_INT_LIT, DXIL_IR_EXPR_INT_LIT,
+        DXIL_IR_EXPR_INT_LIT, DXIL_IR_EXPR_INT_LIT};
+    const uint64_t values[] = {128u, 11u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 1u,
+        UINT32_C(0x80000000), 7u, UINT32_C(0xc0000000), 0u};
+    for (unsigned i = 0u; i < 16u; ++i) {
+        fixture(i);
+        CHECK(dxil_source_native_optimize(&bridge, &function));
+        CHECK(result()->kind == kinds[i]);
+        if (kinds[i] == DXIL_IR_EXPR_INT_LIT) CHECK(result()->uint_value == values[i]);
+    }
+}
+static void numeric_contract(void) {
+    DoeCompilerDiagnostic diagnostic = {0};
+    Source source = {.diagnostic = &diagnostic};
+    const NumericValue sentinel = {.bits = 123u, .type = IR_F32};
+    NumericValue out = sentinel;
+    CHECK(!numeric_runtime_integer_binary(&source, EXPRESSION_DIVIDE,
+        (NumericValue){7u, IR_U32}, (NumericValue){0u, IR_U32}, &out));
+    CHECK(out.bits == sentinel.bits && out.type == sentinel.type);
+    CHECK(!numeric_runtime_integer_binary(&source, EXPRESSION_ADD,
+        (NumericValue){7u, IR_U32}, (NumericValue){1u, IR_I32}, &out));
+    CHECK(out.bits == sentinel.bits && out.type == sentinel.type);
+    CHECK(!numeric_runtime_integer_binary(&source, EXPRESSION_COMPARE,
+        (NumericValue){7u, IR_U32}, (NumericValue){1u, IR_U32}, &out));
+    CHECK(out.bits == sentinel.bits && out.type == sentinel.type);
+    const Source original = source;
+    CHECK(numeric_runtime_integer_binary(&source, EXPRESSION_SHIFT_LEFT,
+        (NumericValue){7u, IR_U32}, (NumericValue){32u, IR_U32}, &out));
+    CHECK(out.bits == 7u && memcmp(&source, &original, sizeof(source)) == 0);
+    out = sentinel;
+    CHECK(!numeric_binary(&source, 0u, EXPRESSION_SHIFT_LEFT, COMPARE_EQUAL,
+        (NumericValue){7u, IR_U32}, (NumericValue){32u, IR_U32}, &out));
+    CHECK(out.bits == sentinel.bits && out.type == sentinel.type);
+}
+static void nested_effects(void) {
+    for (unsigned op = 0u; op < 2u; ++op) for (unsigned side = 0u; side < 2u; ++side) {
+        fixture(6u);
+        DxilIrFunction *f = function.view;
+        f->exprs[3] = f->exprs[2];
+        f->exprs[2] = f->exprs[1];
+        f->exprs[1] = (DxilIrExpr){.kind = DXIL_IR_EXPR_CONSTRUCT, .ty = 0u, .args = {0u, 1u}};
+        f->expr_args[0] = 0u;
+        f->expr_arg_count = 1u;
+        f->expr_count = 4u;
+        f->exprs[3].binary_op = op == 0u ? DXIL_IR_BINARY_MUL : DXIL_IR_BINARY_BIT_AND;
+        f->exprs[3].lhs = side == 0u ? 1u : 2u;
+        f->exprs[3].rhs = side == 0u ? 2u : 1u;
+        f->stmts[f->root_stmt].return_value = 3u;
+        CHECK(dxil_source_native_optimize(&bridge, &function));
+        CHECK(f->stmts[f->root_stmt].return_value == 3u);
+        CHECK(result()->kind == DXIL_IR_EXPR_BINARY);
+    }
+}
+static void references_and_failures(void) {
+    fixture(2u);
+    DxilIrFunction *f = function.view;
+    f->expr_args[0] = 2u;
+    f->expr_arg_count = 1u;
+    f->exprs[3] = (DxilIrExpr){.kind = DXIL_IR_EXPR_CONSTRUCT, .ty = 0u, .args = {0u, 1u}};
+    f->exprs[4] = (DxilIrExpr){.kind = DXIL_IR_EXPR_UNARY, .ty = 0u,
+        .unary_op = DXIL_IR_UNARY_BIT_NOT, .operand = 2u};
+    f->expr_count = 5u;
+    f->switch_selectors[0] = 2u;
+    f->switch_selector_count = 1u;
+    f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_IF, .cond = 2u};
+    f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_LOOP, .has_cond = true, .cond = 2u};
+    f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_SWITCH, .switch_expr = 2u};
+    f->stmts[f->stmt_count++] = (DxilIrStmt){.kind = DXIL_IR_STMT_ASSIGN, .assign_lhs = 0u, .assign_rhs = 2u};
+    CHECK(dxil_source_native_optimize(&bridge, &function));
+    CHECK(f->expr_args[0] == 0u && f->exprs[4].operand == 0u && f->switch_selectors[0] == 0u);
+    CHECK(f->stmts[1].cond == 0u && f->stmts[2].cond == 0u &&
+        f->stmts[3].switch_expr == 0u && f->stmts[4].assign_rhs == 0u);
+    fixture(2u);
+    function.view->exprs[2].lhs = DXIL_IR_MAX_EXPRS;
+    CHECK(!dxil_source_native_optimize(&bridge, &function));
+    CHECK(bridge.status == DXIL_INVALID_IR);
+    fixture(2u);
+    function.view->exprs[2].kind = DXIL_IR_EXPR_CONSTRUCT;
+    function.view->exprs[2].args = (DxilIrRange){UINT32_MAX, 1u};
+    CHECK(!dxil_source_native_optimize(&bridge, &function));
+    CHECK(bridge.status == DXIL_INVALID_IR);
+    fixture(2u);
+    bridge.status = DXIL_UNSUPPORTED_CONSTRUCT;
+    const DxilIrExpr before = function.view->exprs[2];
+    CHECK(!dxil_source_native_optimize(&bridge, &function));
+    CHECK(memcmp(&before, &function.view->exprs[2], sizeof(before)) == 0);
+}
+static void real_source(void) {
+    const char source[] = "@compute @workgroup_size(1) fn main(){let base=64u;let second=base;let result=second*2u;}";
+    char names[4096]; DxilDiagnostic diagnostic; DxilDiagKind error;
+    CHECK_MSG(dxil_analyze(source, strlen(source), &module, names, sizeof(names), &diagnostic, &error), "%s", diagnostic.message);
+    const DxilIrFunction *f = &module.functions[0];
+    bool found = false;
+    for (uint32_t i = 0u; i < f->stmt_count; ++i) {
+        const DxilIrStmt *s = &f->stmts[i];
+        if (s->kind == DXIL_IR_STMT_LOCAL_DECL && s->has_initializer &&
+            strcmp(f->locals[s->local].name, "result") == 0) {
+            const DxilIrExpr *e = &f->exprs[s->initializer];
+            CHECK(e->kind == DXIL_IR_EXPR_INT_LIT && e->uint_value == 128u);
+            found = true;
+        }
+    }
+    CHECK(found);
+}
+int main(int argc, char **argv) {
+    if (argc == 3 && strcmp(argv[1], "--case") == 0) {
+        unsigned which = (unsigned)strtoul(argv[2], NULL, 10);
+        if (which >= 16u) return 2;
+        fixture(which);
+        if (!dxil_source_native_optimize(&bridge, &function)) return 1;
+        const DxilIrExpr *e = result();
+        printf("%s %llu\n", e->kind == DXIL_IR_EXPR_INT_LIT ? "int_lit" :
+            e->kind == DXIL_IR_EXPR_PARAM_REF ? "param_ref" : "binary",
+            (unsigned long long)(e->kind == DXIL_IR_EXPR_INT_LIT ? e->uint_value : 0u));
+        return 0;
+    }
+    if (argc != 1) return 2;
+    cases(); numeric_contract(); nested_effects(); references_and_failures(); real_source();
+    TEST_SUMMARY("dxil_native_opt");
+}
diff --git a/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection.c b/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection.c
new file mode 100644
index 000000000..3f0e2b4e2
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection.c
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "test_util.h"
+#include "dxil_analyze.h"
+#include "dxil_emit.h"
+#include "dxil_hlsl.h"
+#include "dxil_translate.h"
+#if !defined(_WIN32)
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#endif
+#include <errno.h>
+
+static DxilIrModule module;
+static char names[65536];
+static bool analyze(const char *source) {
+    DxilDiagnostic diagnostic;
+    DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+    const bool ok = dxil_analyze(source, strlen(source), &module, names, sizeof(names), &diagnostic, &error);
+    CHECK_MSG(ok, "%s", diagnostic.message);
+    return ok;
+}
+static const DxilIrGlobal *global(const char *name) {
+    for (uint32_t i = 0u; i < module.global_count; ++i)
+        if (strcmp(module.globals[i].name, name) == 0) return &module.globals[i];
+    CHECK(false); return NULL;
+}
+static void declarations(void) {
+    if (!analyze("const offset=vec2i(-2,3)+vec2i(1,2); @id(7) override amount:u32=3u;"
+        "override derived:u32=amount+1u;"
+        "var<private> state:Later=Later(9u);"
+        "@compute @workgroup_size(1) fn main(){let x=Later(amount); _=x.value;}"
+        "struct Later{value:u32,}")) return;
+    const DxilIrGlobal *offset = global("offset"), *amount = global("amount"), *state = global("state");
+    if (offset != NULL) {
+        CHECK(offset->has_initializer && offset->has_init_tree);
+        const DxilIrConstant *tree = &module.constants[offset->init_tree];
+        CHECK(tree->composite && tree->children.len == 2u);
+        CHECK((uint32_t)module.constants[module.constant_children[tree->children.start]].int_value == UINT32_MAX);
+        CHECK(module.constants[module.constant_children[tree->children.start + 1u]].int_value == 5u);
+    }
+    if (amount != NULL) {
+        CHECK(amount->has_override_id && amount->override_id == 7u);
+        CHECK(amount->has_initializer && amount->init_int == 3u);
+    }
+    const DxilIrGlobal *derived = global("derived");
+    if (derived != NULL) CHECK(derived->has_initializer && derived->init_int == 4u);
+    if (state != NULL) {
+        CHECK(state->has_init_tree && module.constants[state->init_tree].composite);
+        CHECK(module.constants[module.constant_children[module.constants[state->init_tree].children.start]].int_value == 9u);
+    }
+    static char hlsl[65536]; size_t written = 0u;
+    CHECK_STATUS(dxil_hlsl_emit(&module, hlsl, sizeof(hlsl), &written), DXIL_OK);
+    CHECK(written != 0u);
+}
+static void controls(void) {
+    if (!analyze("@compute @workgroup_size(1) fn main(){var sum=0u;"
+        "for(var i=0u;i<4u;i+=1u){switch i {case 0u,1u:{sum+=i;} default:{sum+=2u;}}}"
+        "loop {let previous=sum; continuing {sum=previous+1u;break if sum>8u;}}}")) return;
+    const DxilIrFunction *f = &module.functions[0];
+    unsigned loops = 0u, switches = 0u;
+    for (uint32_t i = 0u; i < f->stmt_count; ++i) {
+        const DxilIrStmt *s = &f->stmts[i];
+        if (s->kind == DXIL_IR_STMT_LOOP) {
+            ++loops; CHECK(s->body < f->stmt_count);
+            CHECK(s->has_continuing && s->continuing < f->stmt_count);
+            if (s->loop_kind == DXIL_IR_LOOP_FOR) CHECK(s->has_init && s->has_cond);
+        }
+        if (s->kind == DXIL_IR_STMT_SWITCH) {
+            ++switches; CHECK(s->cases.len == 2u);
+            CHECK(f->switch_cases[s->cases.start].selectors.len == 2u);
+            CHECK(f->switch_cases[s->cases.start + 1u].is_default);
+            for (uint32_t j = 0u; j < s->cases.len; ++j)
+                CHECK(f->switch_cases[s->cases.start + j].body < f->stmt_count);
+        }
+    }
+    CHECK(loops == 2u && switches == 1u);
+    static uint8_t output[65536]; size_t written = 0u;
+    CHECK_STATUS(dxil_emit(&module, output, sizeof(output), &written, NULL), DXIL_OK);
+    CHECK(written > 32u);
+    uint8_t small[16], original[16];
+    memset(small, 0xa5, sizeof(small)); memcpy(original, small, sizeof(small));
+    written = 73u;
+    CHECK_STATUS(dxil_emit(&module, small, sizeof(small), &written, NULL), DXIL_OUTPUT_TOO_LARGE);
+    CHECK(written == 73u && memcmp(small, original, sizeof(small)) == 0);
+}
+static void graphics(void) {
+    if (!analyze("struct Out{@builtin(position) position:vec4f,@location(0) uv:vec2f,}"
+        "@vertex fn vertex_main(@builtin(vertex_index) index:u32)->Out{return Out(vec4f(f32(index),0,0,1),vec2f(0));}"
+        "@fragment fn fragment_main(@location(0) uv:vec2f)->@location(0) vec4f{return vec4f(uv,0,1);}")) return;
+    CHECK(module.entry_point_count == 2u);
+    CHECK(module.functions[0].stage == DXIL_IR_STAGE_VERTEX && module.functions[0].param_count == 1u);
+    CHECK(module.functions[0].params[0].io.builtin == DXIL_IR_BUILTIN_VERTEX_INDEX);
+    CHECK(module.functions[1].stage == DXIL_IR_STAGE_FRAGMENT && module.functions[1].param_count == 1u);
+    CHECK(module.functions[1].params[0].has_io && module.functions[1].params[0].io.has_location);
+    CHECK(module.functions[1].has_return_io && module.functions[1].return_io.location == 0u);
+    CHECK(module.structs[0].fields[0].io.builtin == DXIL_IR_BUILTIN_POSITION);
+    CHECK(module.structs[0].fields[1].io.has_location);
+}
+static void assignment_types(void) {
+    if (!analyze("struct S{m:mat2x2f,v:vec2u,} @compute @workgroup_size(1) fn main(){"
+        "var s:S;s.m[0]=vec2f(1);s.v.x=2u;}")) return;
+    const DxilIrFunction *f = &module.functions[0];
+    unsigned assignments = 0u;
+    for (uint32_t i = 0u; i < f->stmt_count; ++i) if (f->stmts[i].kind == DXIL_IR_STMT_ASSIGN) {
+        const DxilIrExpr *lhs = &f->exprs[f->stmts[i].assign_lhs];
+        CHECK(lhs->category == DXIL_IR_EXPR_REF);
+        CHECK(lhs->ty < module.type_count);
+        if (lhs->ty < module.type_count) {
+            const DxilIrType *type = &module.types[lhs->ty];
+            if (assignments == 0u) CHECK(type->kind == DXIL_IR_TYPE_VECTOR && type->len == 2u &&
+                module.types[type->elem].scalar == DXIL_IR_SCALAR_F32);
+            else CHECK(type->kind == DXIL_IR_TYPE_SCALAR && type->scalar == DXIL_IR_SCALAR_U32);
+        }
+        ++assignments;
+    }
+    CHECK(assignments == 2u);
+}
+static void constant_folding(void) {
+    if (!analyze("@compute @workgroup_size(1) fn main(){let n=2u+3u;let m=~6u;"
+        "const factor=7u;let k=factor*6u;let f=2.0f+3.0f;}")) return;
+    const DxilIrFunction *function = &module.functions[0];
+    const uint64_t values[] = {5u, UINT32_MAX - 6u, 7u, 42u};
+    unsigned index = 0u;
+    for (uint32_t i = 0u; i < function->stmt_count; ++i) {
+        const DxilIrStmt *s = &function->stmts[i];
+        if (s->kind != DXIL_IR_STMT_LOCAL_DECL || !s->has_initializer) continue;
+        const DxilIrExpr *expression = &function->exprs[s->initializer];
+        if (index < 4u) {
+            CHECK(expression->kind == DXIL_IR_EXPR_INT_LIT);
+            CHECK(expression->uint_value == values[index]);
+        } else CHECK(expression->kind == DXIL_IR_EXPR_BINARY);
+        ++index;
+    }
+    CHECK(index == 5u);
+}
+static void bounded_stack(void) {
+#if !defined(_WIN32)
+    const pid_t child = fork();
+    CHECK(child >= 0);
+    if (child < 0) return;
+    if (child == 0) {
+        const struct rlimit limit = {1024u * 1024u, 1024u * 1024u};
+        if (setrlimit(RLIMIT_STACK, &limit) != 0) _exit(3);
+        uint8_t output[4096];
+        size_t written = 0u;
+        DxilDiagnostic diagnostic;
+        DxilTranslateStatus status;
+        const char source[] = "@compute @workgroup_size(1) fn main(){let n=2u+3u;}";
+        errno = ERANGE;
+        const bool ok = dxil_translate_with_diagnostic(source, sizeof(source) - 1u,
+            output, sizeof(output), &written, &diagnostic, &status);
+        _exit(ok && written > 32u && errno == ERANGE ? 0 : 4);
+    }
+    int status = 0;
+    CHECK(waitpid(child, &status, 0) == child);
+    CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+#endif
+}
+static void diagnostics(void) {
+    static const struct {const char *source; DxilDiagKind kind;} cases[] = {
+        {"@compute @workgroup_size(1) fn main(){let x=absent;}", DXIL_DIAG_UNKNOWN_IDENTIFIER},
+        {"fn helper(x:Absent){}", DXIL_DIAG_UNKNOWN_TYPE},
+        {"fn same(){} fn same(){}", DXIL_DIAG_DUPLICATE_SYMBOL},
+        {"@compute @workgroup_size(1) fn main(){let x:u32=true;}", DXIL_DIAG_TYPE_MISMATCH},
+        {"@id(4) override a=1u; @id(4) override b=2u;", DXIL_DIAG_INVALID_ATTRIBUTE},
+        {"fn main( {", DXIL_DIAG_UNEXPECTED_TOKEN}
+    };
+    for (size_t i = 0u; i < sizeof(cases)/sizeof(cases[0]); ++i) {
+        DxilDiagnostic diagnostic; DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+        CHECK(!dxil_analyze(cases[i].source, strlen(cases[i].source), &module,
+            names, sizeof(names), &diagnostic, &error));
+        CHECK_MSG(error == cases[i].kind, "unexpected category: %s", diagnostic.message);
+        CHECK(diagnostic.has_kind && diagnostic.context_len != 0u);
+        CHECK(module.function_count == 0u && module.global_count == 0u);
+    }
+    CHECK(analyze("@compute @workgroup_size(1) fn main(){}"));
+}
+int main(void) {
+    errno = ERANGE;
+    declarations(); controls(); graphics(); assignment_types(); constant_folding(); bounded_stack(); diagnostics();
+    CHECK(errno == ERANGE);
+    TEST_SUMMARY("native typed projection");
+}
diff --git a/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection_expr.c b/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection_expr.c
new file mode 100644
index 000000000..5b6f67272
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/tests/test_dxil_native_projection_expr.c
@@ -0,0 +1,314 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+/* Typed-view controls, not native DXIL semantic or device qualification. */
+#include "dxil_analyze.h"
+#include "test_util.h"
+#include <errno.h>
+#include <fenv.h>
+
+static DxilIrModule module;
+static char names[65536];
+
+static bool analyze(const char *source) {
+    DxilDiagnostic diagnostic;
+    DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+    bool ok = dxil_analyze(source, strlen(source), &module, names, sizeof(names),
+        &diagnostic, &error);
+    CHECK_MSG(ok, "canonical projection failed: %s; source: %.80s", diagnostic.message, source);
+    return ok;
+}
+
+static DxilIrFunction *function_named(const char *name) {
+    for (uint32_t i = 0u; i < module.function_count; ++i) {
+        if (strcmp(module.functions[i].name, name) == 0) return &module.functions[i];
+    }
+    CHECK(false);
+    return NULL;
+}
+
+static void check_ranges(void) {
+    for (uint32_t f = 0u; f < module.function_count; ++f) {
+        const DxilIrFunction *function = &module.functions[f];
+        for (uint32_t i = 0u; i < function->expr_count; ++i) {
+            const DxilIrExpr *expression = &function->exprs[i];
+            CHECK(expression->ty < module.type_count);
+            if (expression->kind != DXIL_IR_EXPR_CALL &&
+                expression->kind != DXIL_IR_EXPR_CONSTRUCT) continue;
+            CHECK(expression->args.start <= function->expr_arg_count);
+            CHECK(expression->args.len <= function->expr_arg_count - expression->args.start);
+            for (uint32_t a = 0u; a < expression->args.len; ++a) {
+                CHECK(function->expr_args[expression->args.start + a] < function->expr_count);
+            }
+        }
+    }
+}
+
+static void check_nested_arguments(void) {
+    if (!analyze("fn make(x:u32)->vec2u { return vec2<u32>(max(x,3u),min(4u,5u)); }"
+        "@compute @workgroup_size(1) fn main(){let v=make(7u);}")) return;
+    DxilIrFunction *function = function_named("make");
+    if (function == NULL) return;
+    unsigned constructors = 0u;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind != DXIL_IR_EXPR_CONSTRUCT) continue;
+        ++constructors;
+        CHECK(expression->args.len == 2u);
+        const DxilIrExpr *left = &function->exprs[function->expr_args[expression->args.start]];
+        const DxilIrExpr *right = &function->exprs[function->expr_args[expression->args.start + 1u]];
+        CHECK(left->kind == DXIL_IR_EXPR_CALL && strcmp(left->name, "max") == 0);
+        CHECK(right->kind == DXIL_IR_EXPR_CALL && strcmp(right->name, "min") == 0);
+        CHECK(left->args.len == 2u && right->args.len == 2u);
+    }
+    CHECK(constructors == 1u);
+    function = function_named("main");
+    if (function == NULL) return;
+    unsigned users = 0u;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_CALL && strcmp(expression->name, "make") == 0) {
+            CHECK(expression->call_kind == DXIL_IR_CALL_USER);
+            ++users;
+        }
+    }
+    CHECK(users == 1u);
+    check_ranges();
+}
+
+static void check_shadowing(void) {
+    if (!analyze("fn project(x:u32)->u32 {var y=x; {let x=9u; y=x;} return y;}"
+        "@compute @workgroup_size(1) fn main(){let result=project(1u);}")) return;
+    DxilIrFunction *function = function_named("project");
+    if (function == NULL) return;
+    CHECK(function->local_count == 2u);
+    bool shadow = false, parameter = false;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_LOCAL_REF && expression->index == 1u) shadow = true;
+        if (expression->kind == DXIL_IR_EXPR_PARAM_REF && expression->index == 0u) parameter = true;
+    }
+    CHECK(shadow && parameter);
+    check_ranges();
+}
+
+static void check_operators(void) {
+    if (!analyze("fn calculate(a:u32,b:u32)->bool {"
+        "let arithmetic=((a+b)-(a*b))/(b+1u)%(b+2u);"
+        "let bits=((a&b)|(a^b))<<(b%32u); let shifted=bits>>(a%32u);"
+        "let negative=-i32(a); let complement=~a;"
+        "return (!(a==b)&&(a!=b))||(a<b)||(a<=b)||(a>b)||(a>=b); }"
+        "@compute @workgroup_size(1) fn main(){let result=calculate(3u,4u);}")) return;
+    DxilIrFunction *function = function_named("calculate");
+    if (function == NULL) return;
+    bool binary_seen[DXIL_IR_BINARY_LOGICAL_OR + 1] = {false};
+    bool unary_seen[DXIL_IR_UNARY_BIT_NOT + 1] = {false};
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_BINARY) binary_seen[expression->binary_op] = true;
+        if (expression->kind == DXIL_IR_EXPR_UNARY) unary_seen[expression->unary_op] = true;
+    }
+    for (size_t i = 0u; i < sizeof(binary_seen) / sizeof(binary_seen[0]); ++i) CHECK(binary_seen[i]);
+    for (size_t i = 0u; i < sizeof(unary_seen) / sizeof(unary_seen[0]); ++i) CHECK(unary_seen[i]);
+    check_ranges();
+}
+
+static void check_access_categories(void) {
+    if (!analyze("struct S {v:vec4f,m:mat2x2f}"
+        "@compute @workgroup_size(1) fn main(){var s:S; let pair=s.v.xy;"
+        "let element=s.v.z; let column=s.m[1u]; let lane=s.m[1u][0u];}")) return;
+    DxilIrFunction *function = function_named("main");
+    if (function == NULL) return;
+    bool pair = false, scalar = false, column = false, lane = false;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_MEMBER && strcmp(expression->field_name, "xy") == 0) {
+            pair = true;
+            CHECK(expression->category == DXIL_IR_EXPR_VALUE);
+            CHECK(function->exprs[expression->base].kind == DXIL_IR_EXPR_LOAD);
+        }
+        if (expression->kind == DXIL_IR_EXPR_MEMBER && strcmp(expression->field_name, "z") == 0) {
+            scalar = true;
+            CHECK(expression->category == DXIL_IR_EXPR_REF && expression->field_index == 2u);
+        }
+        if (expression->kind == DXIL_IR_EXPR_INDEX) {
+            const DxilIrType *type = &module.types[expression->ty];
+            column = column || (type->kind == DXIL_IR_TYPE_VECTOR && type->len == 2u);
+            lane = lane || (type->kind == DXIL_IR_TYPE_SCALAR && type->scalar == DXIL_IR_SCALAR_F32);
+        }
+    }
+    CHECK(pair && scalar && column && lane);
+    check_ranges();
+}
+
+static void check_pointer_arguments(void) {
+    if (!analyze("var<workgroup> counter:atomic<u32>;"
+        "@group(0) @binding(0) var<storage,read_write> data:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){let old=atomicAdd(&counter,1u);"
+        "let count=arrayLength(&data); var x=1u; let p=&x; *p=2u; let z=*p;}")) return;
+    DxilIrFunction *function = function_named("main");
+    if (function == NULL) return;
+    unsigned reference_calls = 0u, addresses = 0u, dereferences = 0u;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_CALL &&
+            (strcmp(expression->name, "atomicAdd") == 0 || strcmp(expression->name, "arrayLength") == 0)) {
+            const DxilIrExpr *argument = &function->exprs[function->expr_args[expression->args.start]];
+            CHECK(argument->kind == DXIL_IR_EXPR_GLOBAL_REF);
+            CHECK(argument->category == DXIL_IR_EXPR_REF);
+            ++reference_calls;
+        }
+        if (expression->kind == DXIL_IR_EXPR_ADDRESS_OF) ++addresses;
+        if (expression->kind == DXIL_IR_EXPR_DEREF) {
+            ++dereferences;
+            CHECK(expression->category == DXIL_IR_EXPR_REF);
+        }
+    }
+    CHECK(reference_calls == 2u && addresses == 1u && dereferences == 2u);
+    check_ranges();
+}
+
+static void check_literals_and_conversions(void) {
+    int saved_round = fegetround();
+    CHECK(fesetround(FE_DOWNWARD) == 0);
+    errno = ERANGE;
+    bool ok = analyze("enable f16; @compute @workgroup_size(1) fn main(){"
+        "let x=0.1000000001f; let h=0.3333h; let bits=bitcast<u32>(x); let y=ldexp(2,3);}");
+    CHECK(errno == ERANGE);
+    CHECK(fegetround() == FE_DOWNWARD);
+    CHECK(fesetround(saved_round) == 0);
+    if (!ok) return;
+    DxilIrFunction *function = function_named("main");
+    if (function == NULL) return;
+    bool floating = false, half = false, conversion = false, bitcast = false;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_FLOAT_LIT) {
+            floating = floating || expression->float_value == 0.1000000001;
+            half = half || expression->float_value == 0.3333;
+        }
+        if (expression->kind == DXIL_IR_EXPR_CALL && strcmp(expression->name, "ldexp") == 0) {
+            const DxilIrExpr *first = &function->exprs[function->expr_args[expression->args.start]];
+            conversion = first->kind == DXIL_IR_EXPR_CONSTRUCT && first->ty == expression->ty;
+        }
+        if (expression->kind == DXIL_IR_EXPR_CALL && strcmp(expression->name, "bitcast") == 0)
+            bitcast = module.types[expression->ty].scalar == DXIL_IR_SCALAR_U32;
+    }
+    CHECK(floating && half && conversion && bitcast);
+    check_ranges();
+}
+
+static void check_packed_lowering(void) {
+    if (!analyze("@compute @workgroup_size(1) fn main(){const word=1+2;"
+        "let a=unpack4xU8(word); let b=unpack4xI8(0xFFFFFFFF);"
+        "let c=pack4xU8(vec4u(1u,2u,3u,4u));"
+        "let d=pack4xI8Clamp(vec4i(-200,2,3,400)); let e=dot4U8Packed(word,4);}")) return;
+    DxilIrFunction *function = function_named("main");
+    if (function == NULL) return;
+    unsigned dots = 0u, masks = 0u;
+    bool materialized = false;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_CALL) {
+            CHECK(strncmp(expression->name, "pack4x", 6u) != 0);
+            CHECK(strncmp(expression->name, "unpack4x", 8u) != 0);
+            CHECK(strncmp(expression->name, "dot4", 4u) != 0);
+            if (strcmp(expression->name, "dot") == 0) ++dots;
+        }
+        if (expression->kind == DXIL_IR_EXPR_BINARY && expression->binary_op == DXIL_IR_BINARY_BIT_AND) ++masks;
+        if (expression->kind == DXIL_IR_EXPR_INT_LIT && expression->uint_value == 3u &&
+            module.types[expression->ty].kind == DXIL_IR_TYPE_SCALAR &&
+            module.types[expression->ty].scalar == DXIL_IR_SCALAR_U32) materialized = true;
+    }
+    CHECK(dots == 3u && masks >= 3u && materialized);
+    check_ranges();
+}
+
+static void check_bounds_graph(void) {
+    if (!analyze("@group(0) @binding(0) var<storage,read> data:array<u32>;"
+        "@group(0) @binding(1) var<storage,read> fixed:array<u32,4>;"
+        "@compute @workgroup_size(1) fn main(@builtin(global_invocation_id) gid:vec3u){"
+        "var local:array<u32,4>; let a=local[1u]; let b=local[gid.x];"
+        "let c=data[gid.x]; let d=fixed[1u];}")) return;
+    DxilIrFunction *function = function_named("main");
+    if (function == NULL) return;
+    unsigned clamped = 0u, unclamped = 0u, runtime = 0u;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind != DXIL_IR_EXPR_INDEX) continue;
+        const DxilIrExpr *index = &function->exprs[expression->index_expr];
+        if (index->kind != DXIL_IR_EXPR_CALL) { ++unclamped; continue; }
+        ++clamped;
+        CHECK(strcmp(index->name, "min") == 0 && index->robustness_generated);
+        CHECK(index->args.len == 2u);
+        const DxilIrExpr *maximum = &function->exprs[function->expr_args[index->args.start + 1u]];
+        if (maximum->kind == DXIL_IR_EXPR_BINARY) {
+            ++runtime;
+            CHECK(maximum->binary_op == DXIL_IR_BINARY_SUB);
+            const DxilIrExpr *length = &function->exprs[maximum->lhs];
+            CHECK(length->kind == DXIL_IR_EXPR_CALL && strcmp(length->name, "arrayLength") == 0);
+            CHECK(length->args.len == 1u && function->expr_args[length->args.start] == expression->base);
+            CHECK(function->exprs[maximum->rhs].kind == DXIL_IR_EXPR_INT_LIT &&
+                function->exprs[maximum->rhs].uint_value == 1u);
+        } else CHECK(maximum->kind == DXIL_IR_EXPR_INT_LIT && maximum->uint_value == 3u);
+    }
+    CHECK(clamped == 3u && unclamped == 1u && runtime == 1u);
+    check_ranges();
+}
+
+static unsigned clamp_count(const DxilIrFunction *function) {
+    unsigned count = 0u;
+    for (uint32_t i = 0u; i < function->expr_count; ++i) {
+        const DxilIrExpr *expression = &function->exprs[i];
+        if (expression->kind == DXIL_IR_EXPR_INDEX &&
+            function->exprs[expression->index_expr].kind == DXIL_IR_EXPR_CALL &&
+            function->exprs[expression->index_expr].robustness_generated) ++count;
+    }
+    return count;
+}
+static void check_guarded_bounds(void) {
+    if (analyze("@compute @workgroup_size(1) fn main(){var values:array<u32,4>;"
+        "for(var i=0u;i<4u;i++){let n=values[i];}"
+        "for(var j=0u;3u>=j;j+=1u){let n=values[j];}"
+        "var k=0u;for(k=1u;k<=3u;k=k+1u){let n=values[k];}}")) {
+        DxilIrFunction *function = function_named("main");
+        if (function != NULL) CHECK(clamp_count(function) == 0u);
+        check_ranges();
+    }
+    if (analyze("@compute @workgroup_size(1) fn main(){var values:array<u32,4>;"
+        "for(var i=0u;i<4u;i++){i=9u;let n=values[i];}"
+        "for(var j=0u;j<4u;j++){let j=8u;let n=values[j];}"
+        "for(var k=0u;k<5u;k++){let n=values[k];}}")) {
+        DxilIrFunction *function = function_named("main");
+        if (function != NULL) CHECK(clamp_count(function) == 3u);
+        check_ranges();
+    }
+    if (analyze("@compute @workgroup_size(1) fn main(){var values:array<u32,4>;"
+        "var i=0u;let p=&i;for(i=0u;i<4u;i++){*p=8u;let n=values[i];}}")) {
+        DxilIrFunction *function = function_named("main");
+        if (function != NULL) CHECK(clamp_count(function) == 1u);
+        check_ranges();
+    }
+    if (analyze("const N=100u;@compute @workgroup_size(1) fn main(){var values:array<u32,4>;"
+        "for(var i=0u;i<N;i++){const N=4u;let n=values[i];}}")) {
+        DxilIrFunction *function = function_named("main");
+        if (function != NULL) CHECK(clamp_count(function) == 1u);
+    }
+    if (analyze("@compute @workgroup_size(1) fn main(){var values:array<u32,4>;"
+        "var i=1u;let p=&i;let n=values[*p];}")) {
+        DxilIrFunction *function = function_named("main");
+        if (function != NULL) CHECK(clamp_count(function) == 1u);
+    }
+}
+
+int main(void) {
+    check_nested_arguments();
+    check_shadowing();
+    check_operators();
+    check_access_categories();
+    check_pointer_arguments();
+    check_literals_and_conversions();
+    check_packed_lowering();
+    check_bounds_graph();
+    check_guarded_bounds();
+    TEST_SUMMARY("test_dxil_native_projection_expr");
+}
diff --git a/runtime/c/compiler/src/dxil/tests/test_dxil_source.c b/runtime/c/compiler/src/dxil/tests/test_dxil_source.c
new file mode 100644
index 000000000..be75b888c
--- /dev/null
+++ b/runtime/c/compiler/src/dxil/tests/test_dxil_source.c
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Doe contributors */
+#include "test_util.h"
+#include "dxil_source.h"
+#include <errno.h>
+#include <fenv.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static bool contains(const DxilSourceHlsl *result, const char *needle) {
+    size_t n = strlen(needle);
+    if (n > result->text_length) return false;
+    for (size_t i = 0u; i <= result->text_length - n; ++i)
+        if (memcmp(result->text + i, needle, n) == 0) return true;
+    return false;
+}
+
+static void accepted(const char *label, const char *source, DxilStage stage,
+    const char *marker) {
+    DxilSourceHlsl result;
+    DxilDiagnostic diagnostic;
+    DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+    const bool ok = dxil_source_hlsl(source, strlen(source), &result, &diagnostic, &error);
+    if (!ok) fprintf(stderr, "%s: %s\n", label, diagnostic.message);
+    CHECK(ok);
+    if (!ok) return;
+    CHECK(result.text != NULL && result.text_length != 0u);
+    CHECK(result.entry.stage == stage);
+    CHECK(result.entry.name == result.entry_name);
+    CHECK(strcmp(result.entry.name, "main") == 0);
+    CHECK(result.entry.shader_model_major == 6u);
+    if (marker != NULL) CHECK(contains(&result, marker));
+    if (stage == DXIL_STAGE_COMPUTE) CHECK(result.entry.workgroup_size[0] == 1u);
+    dxil_source_hlsl_free(&result);
+    CHECK(result.text == NULL && result.text_length == 0u && result.entry.name == NULL);
+    dxil_source_hlsl_free(&result);
+}
+
+static void source_forms(void) {
+    accepted("for", "@group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){for(var i=0u;i<4u;i+=1u){output[i]=i;}}",
+        DXIL_STAGE_COMPUTE, "RWStructuredBuffer");
+    accepted("forward struct", "@compute @workgroup_size(1) fn main(){let x=Later(3u); _=x.value;}"
+        "struct Later{value:u32,}", DXIL_STAGE_COMPUTE, NULL);
+    accepted("global expression", "const offset=vec2i(-2,3)+vec2i(1,2);"
+        "@group(0) @binding(0) var<storage,read_write> output:array<i32>;"
+        "@compute @workgroup_size(1) fn main(){output[0]=offset.x;}", DXIL_STAGE_COMPUTE, NULL);
+    accepted("matrix index", "@group(0) @binding(0) var<storage,read_write> output:array<f32>;"
+        "@compute @workgroup_size(1) fn main(){var m=mat2x2f(1,2,3,4);output[0]=m[1].x;}",
+        DXIL_STAGE_COMPUTE, NULL);
+    accepted("override id/default", "@id(7) override amount:u32=3u; override unused:u32;"
+        "@group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){output[0]=amount;}", DXIL_STAGE_COMPUTE, NULL);
+    accepted("vertex", "@vertex fn main(@builtin(vertex_index) index:u32)->@builtin(position) vec4f"
+        "{return vec4f(f32(index),0,0,1);}", DXIL_STAGE_VERTEX, "SV_Position");
+    accepted("fragment", "@fragment fn main()->@location(0) vec4f{return vec4f(0,1,0,1);}",
+        DXIL_STAGE_FRAGMENT, "SV_Target");
+    accepted("atomic", "@group(0) @binding(0) var<storage,read_write> output:array<atomic<u32>>;"
+        "@compute @workgroup_size(1) fn main(){_=atomicAdd(&output[0],1u);}",
+        DXIL_STAGE_COMPUTE, "InterlockedAdd");
+    accepted("packed", "requires packed_4x8_integer_dot_product;"
+        "@group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){output[0]=pack4xU8(vec4u(1,2,3,4));}",
+        DXIL_STAGE_COMPUTE, NULL);
+    accepted("pointer local", "@group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){let destination=&output[0];*destination=7u;}",
+        DXIL_STAGE_COMPUTE, NULL);
+    accepted("runtime array write guard", "@group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(@builtin(global_invocation_id) gid:vec3u){output[gid.x]=7u;}",
+        DXIL_STAGE_COMPUTE, "if (offset <= bytes && 4u <= bytes - offset)");
+    accepted("first entry", "@compute @workgroup_size(1) fn main(){}"
+        "@vertex fn later()->@builtin(position) vec4f{return vec4f(0,0,0,1);}",
+        DXIL_STAGE_COMPUTE, NULL);
+}
+
+static void rejected(void) {
+    static const char *const sources[] = {
+        "@compute @workgroup_size(1) fn main(){let x:u32=true;}",
+        "@group(0) @binding(0) var<storage,read_write> a:array<u32>;"
+        "@group(0) @binding(0) var<storage,read_write> b:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){a[0]=b[0];}",
+        "@compute @workgroup_size(1) fn main(){} fn unused(){missing();}",
+        "@id(7) override a:u32=1u; @id(7) override b:u32=2u;"
+        "@compute @workgroup_size(1) fn main(){}",
+        "override a:u32; @group(0) @binding(0) var<storage,read_write> output:array<u32>;"
+        "@compute @workgroup_size(1) fn main(){output[0]=a;}",
+        "fn no_entry(){}"
+    };
+    for (size_t i = 0u; i < sizeof(sources) / sizeof(sources[0]); ++i) {
+        DxilSourceHlsl result;
+        DxilDiagnostic diagnostic;
+        DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+        CHECK(!dxil_source_hlsl(sources[i], strlen(sources[i]), &result, &diagnostic, &error));
+        CHECK(result.text == NULL && result.entry.name == NULL);
+        CHECK(diagnostic.has_kind && diagnostic.message_len != 0u);
+        dxil_source_hlsl_free(&result);
+    }
+}
+
+static void grown_pools(void) {
+    /* Cross the old native adapter's function/local/statement bounds and the
+     * host adapter's initial token/expression/statement pools. This must reuse
+     * the canonical typed pool reports, not retry arbitrary semantic failures. */
+    char source[65536];
+    size_t used = 0u;
+    for (unsigned i = 0u; i < 80u; ++i) {
+        int n = snprintf(source + used, sizeof(source) - used,
+            "fn helper%u()->u32{return %uu;}\n", i, i);
+        CHECK(n > 0 && (size_t)n < sizeof(source) - used);
+        if (n <= 0 || (size_t)n >= sizeof(source) - used) return;
+        used += (size_t)n;
+    }
+    int n = snprintf(source + used, sizeof(source) - used,
+        "@compute @workgroup_size(1) fn main(){\n");
+    CHECK(n > 0 && (size_t)n < sizeof(source) - used);
+    if (n <= 0 || (size_t)n >= sizeof(source) - used) return;
+    used += (size_t)n;
+    for (unsigned i = 0u; i < 600u; ++i) {
+        n = snprintf(source + used, sizeof(source) - used,
+            "let local%u=helper%u()+%uu;\n", i, i % 80u, i);
+        CHECK(n > 0 && (size_t)n < sizeof(source) - used);
+        if (n <= 0 || (size_t)n >= sizeof(source) - used) return;
+        used += (size_t)n;
+    }
+    source[used++] = '}';
+    source[used] = '\0';
+    accepted("grown pools", source, DXIL_STAGE_COMPUTE, NULL);
+}
+
+static void failure_ownership(void) {
+    static const char embedded_nul[] = "@compute\0 @workgroup_size(1) fn main(){}";
+    DxilSourceHlsl result;
+    DxilDiagnostic diagnostic;
+    DxilDiagKind error = DXIL_DIAG_INVALID_IR;
+    CHECK(!dxil_source_hlsl(embedded_nul, sizeof(embedded_nul) - 1u,
+        &result, &diagnostic, &error));
+    CHECK(result.text == NULL && result.entry.name == NULL);
+    CHECK(diagnostic.has_kind && diagnostic.context_len != 0u);
+    CHECK(!dxil_source_hlsl(NULL, 1u, &result, &diagnostic, &error));
+    CHECK(result.text == NULL && result.entry.name == NULL);
+    CHECK(!dxil_source_hlsl("", 0u, NULL, &diagnostic, &error));
+    CHECK(!dxil_source_hlsl("", 0u, &result, &diagnostic, &error));
+    CHECK(result.text == NULL && result.entry.name == NULL);
+    CHECK(!dxil_source_hlsl("", 2u * 1024u * 1024u + 1u,
+        &result, NULL, NULL));
+    CHECK(result.text == NULL && result.entry.name == NULL);
+    dxil_source_hlsl_free(NULL);
+}
+
+static void native_half_metadata(void) {
+    static const char source[] = "enable f16;"
+        "@group(0) @binding(0) var<storage,read_write> output:array<f16>;"
+        "@compute @workgroup_size(1) fn main(){output[0]=1.0h;}";
+    DxilSourceHlsl result;
+    DxilDiagnostic diagnostic;
+    CHECK(dxil_source_hlsl(source, sizeof(source) - 1u, &result, &diagnostic, NULL));
+    CHECK(result.entry.native16);
+    CHECK(result.entry.shader_model_major == 6u && result.entry.shader_model_minor == 2u);
+    CHECK(contains(&result, "float16_t"));
+    dxil_source_hlsl_free(&result);
+}
+
+int main(void) {
+    errno = ERANGE;
+    CHECK(fesetround(FE_DOWNWARD) == 0);
+    CHECK(feraiseexcept(FE_INVALID) == 0);
+    source_forms();
+    rejected();
+    grown_pools();
+    failure_ownership();
+    native_half_metadata();
+    CHECK(errno == ERANGE);
+    CHECK(fegetround() == FE_DOWNWARD);
+    CHECK((fetestexcept(FE_INVALID) & FE_INVALID) != 0);
+    CHECK(fesetround(FE_TONEAREST) == 0);
+    CHECK(feclearexcept(FE_ALL_EXCEPT) == 0);
+    TEST_SUMMARY("shared DXIL source");
+}
