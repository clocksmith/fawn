@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Exercise public source-to-DXC publication using a controlled child, not a GPU."""
+from __future__ import annotations
+
+import argparse
+import ctypes
+from pathlib import Path
+import struct
+import tempfile
+
+
+class Buffer(ctypes.Structure):
+    _fields_ = [("data", ctypes.c_void_p), ("size", ctypes.c_size_t)]
+
+
+class Diagnostic(ctypes.Structure):
+    _fields_ = [("domain", ctypes.c_uint32), ("code", ctypes.c_uint32),
+                ("line", ctypes.c_uint32), ("column", ctypes.c_uint32),
+                ("system_error", ctypes.c_int32), ("stage", ctypes.c_char * 48),
+                ("message", ctypes.c_char * 256)]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--library", required=True, type=Path,
+                        help="Built public host companion")
+    parser.add_argument("--child", required=True, type=Path,
+                        help="Built test_dxil_io controlled child executable")
+    parser.add_argument("--real-dxc", type=Path,
+                        help="Also exercise an explicitly selected actual DXC")
+    args = parser.parse_args()
+    library = ctypes.CDLL(str(args.library.resolve()))
+    translate = library.doe_compiler_host_dxil
+    translate.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_size_t,
+                          ctypes.c_char_p, ctypes.c_char_p,
+                          ctypes.POINTER(Buffer), ctypes.c_size_t,
+                          ctypes.POINTER(Diagnostic), ctypes.c_size_t]
+    translate.restype = ctypes.c_int
+    release = library.doe_compiler_host_release
+    release.argtypes = [ctypes.POINTER(Buffer)]
+    release.restype = None
+    child = str(args.child.resolve()).encode()
+    with tempfile.TemporaryDirectory(prefix="doe public host DXIL ") as name:
+        scratch = Path(name)
+
+        def invoke(source: bytes, executable: bytes = child) -> tuple[int, bytes, Diagnostic]:
+            output = Buffer()
+            diagnostic = Diagnostic()
+            status = translate(1, source, len(source), executable,
+                               str(scratch).encode(), ctypes.byref(output),
+                               ctypes.sizeof(output), ctypes.byref(diagnostic),
+                               ctypes.sizeof(diagnostic))
+            try:
+                if status != 0:
+                    assert not output.data and output.size == 0, "failed publication"
+                    return status, b"", diagnostic
+                assert output.data and output.size > 0
+                return status, ctypes.string_at(output.data, output.size), diagnostic
+            finally:
+                release(ctypes.byref(output))
+                assert not output.data and output.size == 0
+                release(ctypes.byref(output))
+
+        def shader(entry: str) -> bytes:
+            return ("@compute @workgroup_size(1) fn " + entry + "() {}").encode()
+
+        status, binary, _ = invoke(shader("valid"))
+        assert status == 0 and binary[:4] == b"DXBC"
+        assert struct.unpack_from("<I", binary, 24)[0] == len(binary)
+        assert len(binary) < 256
+        assert list(scratch.iterdir()) == [], "successful call leaked temporary files"
+        for entry, expected, detail in (
+            ("missing", 7, b"DXC reported success"),
+            ("failure", 7, b"DXC failed"),
+            ("malformed", 7, b""),
+            ("oversized", 5, b""),
+        ):
+            status, _, diagnostic = invoke(shader(entry))
+            assert status == expected, (entry, status, bytes(diagnostic.message))
+            assert diagnostic.domain == 2
+            assert 0 < len(diagnostic.message) <= 255
+            assert detail in diagnostic.message, (entry, diagnostic.message)
+            assert list(scratch.iterdir()) == [], entry + " leaked temporary files"
+            # A failed request must not poison the next ordinary successful one.
+            assert invoke(shader("valid"))[0] == 0
+        status, _, diagnostic = invoke(shader("valid"), b"/absent-doe-dxc")
+        assert status == 8 and diagnostic.domain == 2
+        status, _, diagnostic = invoke(b"@compute fn broken( {}")
+        assert status == 7 and diagnostic.domain == 2 and diagnostic.message
+        assert list(scratch.iterdir()) == []
+        if args.real_dxc is not None:
+            status, binary, diagnostic = invoke(shader("valid"),
+                str(args.real_dxc.resolve()).encode())
+            assert status == 0, (status, diagnostic.message)
+            assert binary[:4] == b"DXBC"
+            assert struct.unpack_from("<I", binary, 24)[0] == len(binary)
+            assert list(scratch.iterdir()) == []
+            print("PASS: public source-to-DXIL ABI with explicitly selected actual DXC")
+    print("PASS: public DXIL ABI source/child/validation, failure atomicity, cleanup and retry")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/runtime/c/compiler/tools/test_host_install.py b/runtime/c/compiler/tools/test_host_install.py
new file mode 100644
index 000000000..fd7b30644
--- /dev/null
+++ b/runtime/c/compiler/tools/test_host_install.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Compile ordinary consumers using only a moved host artifact and public header."""
+from __future__ import annotations
+
+import argparse
+import json
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import shlex
+import subprocess
+import struct
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+REPOSITORY = ROOT.parents[2]
+
+
+def invoke(command: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
+    environment = dict(os.environ)
+    environment.pop("LD_LIBRARY_PATH", None)
+    environment.pop("DYLD_LIBRARY_PATH", None)
+    return subprocess.run(command, cwd=cwd, env=environment, check=True,
+                          capture_output=True, text=True, timeout=120)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default="cc", help="C compiler command")
+    parser.add_argument("--cxx", default="c++", help="C++ compiler command")
+    parser.add_argument("--library", required=True, type=Path,
+                        help="Built allocating host companion")
+    args = parser.parse_args()
+    library = args.library.resolve()
+    with tempfile.TemporaryDirectory(prefix="doe-host-install-") as directory:
+        work = Path(directory)
+        original = work / "first staging location"
+        for name in ("include", "lib", "bin"):
+            (original / name).mkdir(parents=True)
+        shutil.copy2(ROOT / "include/doe_compiler_host.h", original / "include")
+        shutil.copy2(library, original / "lib")
+        for name in ("doe-tsir-bootstrap-manifest-inputs-c", "doe-tsir-bootstrap-oracle-c"):
+            shutil.copy2(ROOT / "build" / name, original / "bin")
+        # No old location survives: loader success cannot come from that path.
+        moved = work / "moved host artifact"
+        original.rename(moved)
+        rpath = "@loader_path/../lib" if sys.platform == "darwin" else "$ORIGIN/../lib"
+        for filename, compiler, standard in (
+            ("test_compiler_host.c", args.cc, "-std=c11"),
+            ("test_compiler_host.cpp", args.cxx, "-std=c++17"),
+        ):
+            source = work / filename
+            shutil.copy2(ROOT / "tests" / filename, source)
+            binary = moved / "bin" / ("consumer-cpp" if filename.endswith(".cpp") else "consumer-c")
+            command = [*shlex.split(compiler), standard, "-Wall", "-Wextra", "-Wpedantic", "-Werror",
+                       "-I" + str(moved / "include"), str(source),
+                       str(moved / "lib" / library.name), "-Wl,-rpath," + rpath,
+                       "-o", str(binary)]
+            invoke(command, work)
+            arguments = [str(binary)]
+            if filename.endswith(".c"):
+                arguments.append(str(REPOSITORY))
+            print(invoke(arguments, work).stdout, end="")
+        manifest = moved / "bin/doe-tsir-bootstrap-manifest-inputs-c"
+        rows = json.loads(invoke([str(manifest)], REPOSITORY).stdout)
+        expected = {(kernel, backend) for kernel in ("fused_gemv", "rms_norm", "gather")
+                    for backend in ("webgpu-generic", "msl", "spir-v")}
+        actual = {(row["kernelRef"].removeprefix("doe.tsir.bootstrap."), row["backend"])
+                  for row in rows}
+        assert len(rows) == 9 and actual == expected
+        inputs = work / "gather.json"
+        inputs.write_text(json.dumps({"kernel": "gather", "inputs": {
+            "indices": {"elem": "u32", "shape": [2], "values": [1, 0]},
+            "table": {"elem": "f32", "shape": [2, 2], "values": [1, 2, 3, 4]},
+        }}), encoding="utf-8")
+        oracle = moved / "bin/doe-tsir-bootstrap-oracle-c"
+        result = json.loads(invoke([str(oracle), "--kernel", "gather",
+                                   "--inputs", str(inputs)], work).stdout)
+        assert result["status"] == "pass"
+        assert result["referenceHash"] == hashlib.sha256(
+            struct.pack("<4f", 3, 4, 1, 2)).hexdigest()
+        print("PASS: moved public C/C++ host artifact and native manifest/oracle CLIs, no loader override")
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
