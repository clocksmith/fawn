-    if (dxil_parse_is_kw(parser, "fn")) {
-        return parse_function_decl(parser, attrs, attr_count);
-    }
-    dxil_parse_fail_tok(parser, DXIL_DIAG_UNEXPECTED_TOKEN,
-        DXIL_DIAG_STAGE_PARSER);
-    return false;
-}
