diff --git a/runtime/c/native/src/shader_cache.c b/runtime/c/native/src/shader_cache.c
new file mode 100644
index 000000000..b5c4f34f3
--- /dev/null
+++ b/runtime/c/native/src/shader_cache.c
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: MIT */
+#include "shader_cache.h"
+
+/* At most 16 MiB of direct cached allocations per device. Specialized artifacts
+ * may retain an independently bounded module; no device reference cycle exists. */
+static const size_t cache_entry_limit = 1024u * 1024u;
+
+bool native_shader_cache_admits(const doe_shader *shader)
+{
+    return shader && doe_shader_owned_bytes(shader) <= cache_entry_limit;
+}
+
+doe_shader *native_shader_cache_module(native_shader_cache *cache, const doe_shader_options *options,
+    const char *source, size_t size)
+{
+    if (!cache || !options) return NULL;
+    for (size_t i = 0; i < NATIVE_SHADER_CACHE_SLOTS; ++i) {
+        doe_shader *entry = cache->entries[i];
+        if (doe_shader_module_matches(entry,options->target,options->semantic_flags,source,size,
+                options->compiler_identity,options->compiler_identity_size) && doe_shader_retain(entry) == DOE_SHADER_OK)
+            return entry;
+    }
+    return NULL;
+}
+
+doe_shader *native_shader_cache_stage(native_shader_cache *cache, const doe_shader *module,
+    const DoeCompilerEntrySelectionV5 *selection, const DoeCompilerOverrideValueV13 *values, size_t count,
+    const DoeCompilerMetalPipelineOptionsV15 *pipeline)
+{
+    if (!cache || !native_shader_cache_admits(module)) return NULL;
+    for (size_t i = 0; i < NATIVE_SHADER_CACHE_SLOTS; ++i) {
+        doe_shader *entry = cache->entries[i];
+        bool matches = pipeline ? doe_shader_metal_pipeline_matches(entry,module,selection,values,count,pipeline) :
+            doe_shader_specialization_matches(entry,module,selection,values,count);
+        if (matches && doe_shader_retain(entry) == DOE_SHADER_OK) return entry;
+    }
+    return NULL;
+}
+
+doe_shader *native_shader_cache_insert(native_shader_cache *cache, doe_shader *shader)
+{
+    if (!cache || !native_shader_cache_admits(shader)) return NULL;
+    for (size_t i = 0; i < NATIVE_SHADER_CACHE_SLOTS; ++i)
+        if (cache->entries[i] == shader) return NULL;
+    if (doe_shader_retain(shader) != DOE_SHADER_OK) return NULL;
+    doe_shader *old = cache->entries[cache->next];
+    cache->entries[cache->next] = shader;
+    cache->next = (cache->next + 1) % NATIVE_SHADER_CACHE_SLOTS;
+    return old;
+}
+
+void native_shader_cache_clear(native_shader_cache *cache)
+{
+    if (!cache) return;
+    for (size_t i = 0; i < NATIVE_SHADER_CACHE_SLOTS; ++i) {
+        doe_shader_release(cache->entries[i]);
+        cache->entries[i] = NULL;
+    }
+    cache->next = 0;
+}
diff --git a/runtime/c/native/src/shader_cache.h b/runtime/c/native/src/shader_cache.h
new file mode 100644
index 000000000..a8da5cdb2
--- /dev/null
+++ b/runtime/c/native/src/shader_cache.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef DOE_NATIVE_SHADER_CACHE_H
+#define DOE_NATIVE_SHADER_CACHE_H
+#include "doe_shader.h"
+
+enum { NATIVE_SHADER_CACHE_SLOTS = 16 };
+/* One cache per native device. Caller serializes lookup/insertion; successful
+ * lookup owns a shader reference. No native calls or allocator callbacks under
+ * that lock: insertion returns the displaced owner for release after unlocking. */
+typedef struct native_shader_cache {
+    doe_shader *entries[NATIVE_SHADER_CACHE_SLOTS];
+    size_t next;
+    uint8_t image_identity[32];
+    bool image_identity_ready;
+} native_shader_cache;
+doe_shader *native_shader_cache_module(native_shader_cache *, const doe_shader_options *, const char *, size_t);
+doe_shader *native_shader_cache_stage(native_shader_cache *, const doe_shader *,
+    const DoeCompilerEntrySelectionV5 *, const DoeCompilerOverrideValueV13 *, size_t,
+    const DoeCompilerMetalPipelineOptionsV15 *);
+doe_shader *native_shader_cache_insert(native_shader_cache *, doe_shader *);
+bool native_shader_cache_admits(const doe_shader *);
+void native_shader_cache_clear(native_shader_cache *);
+#endif
diff --git a/runtime/c/native/src/shader_cache_identity.c b/runtime/c/native/src/shader_cache_identity.c
new file mode 100644
index 000000000..01d011c1e
--- /dev/null
+++ b/runtime/c/native/src/shader_cache_identity.c
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "shader_cache_identity.h"
+#include "doe_compiler.h"
+#include "../../shader/include/doe_shader_artifact.h"
+#include "../../common/include/doe_sha256.h"
+
+#include <limits.h>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#elif defined(__APPLE__)
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#elif defined(__linux__)
+#include <link.h>
+#endif
+
+typedef DoeCompilerStatus (*compiler_entry)(uint32_t, const char *, size_t,
+    uint32_t *, size_t, DoeCompilerResult *, size_t);
+#if defined(_WIN64)
+/* The canonical x64 Windows native builder links the separate audited compiler
+ * import library. A plain &function can name a local thunk without dllimport;
+ * the IAT slot instead contains the exact loaded implementation address. */
+extern compiler_entry __imp_doe_compiler_compile;
+#endif
+
+enum { IMAGE_LIMIT = 512 * 1024 * 1024 };
+typedef struct image_hash {
+    uint8_t digest[32];
+    size_t bytes;
+    size_t spans;
+} image_hash;
+
+static void little64(uint8_t out[8], uint64_t value)
+{
+    for (size_t i = 0; i < 8; ++i) out[i] = (uint8_t)(value >> (i * 8));
+}
+
+/* A domain-separated sequence of position/length/content hashes; the common
+ * SHA-256 implementation streams each span in constant space. No second hash
+ * implementation or image-sized allocation lives in the native adapter. */
+static bool span_bytes(image_hash *hash, uintptr_t base, uintptr_t address,
+    const void *bytes, size_t size)
+{
+    uint8_t record[88] = {0};
+    if (!size) return true;
+    if (address < base || size > IMAGE_LIMIT - hash->bytes) return false;
+    memcpy(record, "DOE-IMAGE-SPAN-v1", 17);
+    memcpy(record + 24, hash->digest, 32);
+    little64(record + 56, (uint64_t)(address - base));
+    little64(record + 64, (uint64_t)size);
+    /* The content digest joins a separately delimited metadata digest. */
+    uint8_t combined[64];
+    doe_common_sha256(record, sizeof(record), combined);
+    doe_common_sha256(bytes, size, combined + 32);
+    doe_common_sha256(combined, sizeof(combined), hash->digest);
+    hash->bytes += size;
+    hash->spans++;
+    return true;
+}
+
+static bool span(image_hash *hash, uintptr_t base, uintptr_t address, size_t size)
+{
+    return span_bytes(hash, base, address, (const void *)address, size);
+}
+
+#if defined(__linux__)
+/* A linker build ID binds relocation-bearing tables/configuration without
+ * hashing loader addresses. Require it: code/rodata alone is not the whole
+ * artifact identity. These notes are read from the loaded image, never disk. */
+static bool elf_build_id(const struct dl_phdr_info *info, image_hash *hash)
+{
+    const uintptr_t base = (uintptr_t)info->dlpi_addr;
+    for (size_t i = 0; i < info->dlpi_phnum; ++i) {
+        const ElfW(Phdr) *p = &info->dlpi_phdr[i];
+        if (p->p_type != PT_NOTE) continue;
+        if (p->p_vaddr > UINTPTR_MAX - base || p->p_memsz > IMAGE_LIMIT) return false;
+        uintptr_t address = base + p->p_vaddr;
+        size_t offset = 0;
+        while (offset < p->p_memsz) {
+            if (p->p_memsz - offset < sizeof(ElfW(Nhdr))) return false;
+            ElfW(Nhdr) note;
+            memcpy(&note, (const void *)(address + offset), sizeof(note));
+            offset += sizeof(note);
+            size_t name = (size_t)note.n_namesz;
+            size_t data = (size_t)note.n_descsz;
+            if (name > SIZE_MAX - 3 || data > SIZE_MAX - 3) return false;
+            name = (name + 3) & ~(size_t)3;
+            data = (data + 3) & ~(size_t)3;
+            if (name > p->p_memsz - offset || data > p->p_memsz - offset - name) return false;
+            if (note.n_type == NT_GNU_BUILD_ID && note.n_namesz == 4 &&
+                memcmp((const void *)(address + offset), "GNU", 4) == 0 &&
+                note.n_descsz >= 16 && note.n_descsz <= 64)
+                return span(hash, base, address + offset + name, note.n_descsz);
+            offset += name + data;
+        }
+    }
+    return false;
+}
+
+typedef struct elf_search {
+    uintptr_t anchor;
+    image_hash hash;
+    bool found;
+    bool valid;
+} elf_search;
+
+static int elf_image(struct dl_phdr_info *info, size_t size, void *opaque)
+{
+    elf_search *search = opaque;
+    (void)size;
+    const uintptr_t base = (uintptr_t)info->dlpi_addr;
+    for (size_t i = 0; i < info->dlpi_phnum; ++i) {
+        const ElfW(Phdr) *p = &info->dlpi_phdr[i];
+        if (p->p_type != PT_LOAD || p->p_vaddr > UINTPTR_MAX - base) continue;
+        uintptr_t start = base + p->p_vaddr;
+        if (search->anchor >= start && search->anchor - start < p->p_memsz)
+            search->found = true;
+    }
+    if (!search->found) return 0;
+    if (!elf_build_id(info, &search->hash)) return 1;
+    search->valid = true;
+    for (size_t i = 0; i < info->dlpi_phnum; ++i) {
+        const ElfW(Phdr) *p = &info->dlpi_phdr[i];
+        bool readonly = p->p_type == PT_LOAD && (p->p_flags & PF_R) && !(p->p_flags & PF_W);
+        if (!readonly) continue;
+        if (p->p_vaddr > UINTPTR_MAX - base || p->p_memsz > SIZE_MAX) {
+            search->valid = false;
+            return 1;
+        }
+        uintptr_t start = base + p->p_vaddr;
+        size_t length = (size_t)p->p_memsz;
+        if (length > UINTPTR_MAX - start) {
+            search->valid = false;
+            return 1;
+        }
+        if (!span(&search->hash, base, start, length)) {
+            search->valid = false;
+            return 1;
+        }
+    }
+    return 1;
+}
+
+static bool loaded_image(uintptr_t anchor, image_hash *hash)
+{
+    elf_search search = {.anchor = anchor};
+    (void)dl_iterate_phdr(elf_image, &search);
+    if (!search.found || !search.valid || !search.hash.spans) return false;
+    *hash = search.hash;
+    return true;
+}
+#elif defined(_WIN32)
+static bool loaded_image(uintptr_t anchor, image_hash *hash)
+{
+    HMODULE module = NULL;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+            (LPCWSTR)anchor, &module)) return false;
+    const uint8_t *image = (const uint8_t *)module;
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)image;
+    bool valid = false;
+    if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < 0 ||
+        dos->e_lfanew > 1024 * 1024) goto done;
+    const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)(image + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || !nt->OptionalHeader.SizeOfImage ||
+        nt->OptionalHeader.SizeOfImage > IMAGE_LIMIT) goto done;
+    const uintptr_t base = (uintptr_t)module;
+    const uintptr_t end = base + nt->OptionalHeader.SizeOfImage;
+    if (end < base) goto done;
+    for (uintptr_t address = base; address < end;) {
+        MEMORY_BASIC_INFORMATION region;
+        if (VirtualQuery((const void *)address, &region, sizeof(region)) != sizeof(region) ||
+            region.AllocationBase != module || region.RegionSize == 0 ||
+            region.RegionSize > UINTPTR_MAX - (uintptr_t)region.BaseAddress) goto done;
+        uintptr_t next = (uintptr_t)region.BaseAddress + region.RegionSize;
+        if (next > end) next = end;
+        if (next <= address) goto done;
+        DWORD access = region.Protect & 0xffu;
+        bool readonly = access == PAGE_READONLY || access == PAGE_EXECUTE_READ;
+        if (region.State == MEM_COMMIT && readonly && !(region.Protect & PAGE_GUARD) &&
+            !span(hash, base, address, (size_t)(next - address))) goto done;
+        address = next;
+    }
+    valid = hash->spans != 0;
+done:
+    (void)FreeLibrary(module);
+    return valid;
+}
+#elif defined(__APPLE__)
+static bool loaded_image(uintptr_t anchor, image_hash *hash)
+{
+    Dl_info owner;
+    if (!dladdr((const void *)anchor, &owner) || !owner.dli_fbase) return false;
+    const struct mach_header_64 *header = owner.dli_fbase;
+    if (header->magic != MH_MAGIC_64 || header->sizeofcmds > 16u * 1024u * 1024u)
+        return false;
+    intptr_t slide = 0;
+    bool found = false;
+    for (uint32_t i = 0; i < _dyld_image_count(); ++i) {
+        if (_dyld_get_image_header(i) == (const struct mach_header *)header) {
+            slide = _dyld_get_image_vmaddr_slide(i);
+            found = true;
+            break;
+        }
+    }
+    if (!found) return false;
+    const uint8_t *commands = (const uint8_t *)(header + 1);
+    size_t offset = 0;
+    for (uint32_t i = 0; i < header->ncmds; ++i) {
+        if (offset > header->sizeofcmds || header->sizeofcmds - offset < sizeof(struct load_command))
+            return false;
+        const struct load_command *command = (const struct load_command *)(commands + offset);
+        if (command->cmdsize < sizeof(*command) || command->cmdsize > header->sizeofcmds - offset)
+            return false;
+        if (command->cmd == LC_SEGMENT_64) {
+            if (command->cmdsize < sizeof(struct segment_command_64)) return false;
+            const struct segment_command_64 *segment = (const struct segment_command_64 *)command;
+            if (segment->initprot & VM_PROT_READ) {
+                uintptr_t address = (uintptr_t)segment->vmaddr + (uintptr_t)slide;
+                if (segment->vmsize > UINTPTR_MAX - address) return false;
+                uintptr_t end = address + (uintptr_t)segment->vmsize;
+                while (address < end) {
+                    mach_vm_address_t region_address = address;
+                    mach_vm_size_t region_size = 0;
+                    vm_region_basic_info_data_64_t info;
+                    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+                    mach_port_t object = MACH_PORT_NULL;
+                    kern_return_t result = mach_vm_region(mach_task_self(), &region_address,
+                        &region_size, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &object);
+                    if (object != MACH_PORT_NULL) (void)mach_port_deallocate(mach_task_self(), object);
+                    if (result != KERN_SUCCESS || region_address > address ||
+                        region_size > UINTPTR_MAX - region_address) return false;
+                    uintptr_t next = (uintptr_t)(region_address + region_size);
+                    if (next > end) next = end;
+                    if (next <= address) return false;
+                    if ((info.protection & VM_PROT_READ) && !(info.protection & VM_PROT_WRITE) &&
+                        !span(hash, (uintptr_t)header, address, (size_t)(next - address))) return false;
+                    address = next;
+                }
+            }
+        }
+        offset += command->cmdsize;
+    }
+    return hash->spans != 0;
+}
+#else
+static bool loaded_image(uintptr_t anchor, image_hash *hash)
+{
+    (void)anchor;
+    (void)hash;
+    return false;
+}
+#endif
+
+bool native_shader_cache_identity(uint8_t digest[32])
+{
+    if (!digest) return false;
+    uintptr_t native_address = 0;
+    uintptr_t compiler_address = 0;
+    uintptr_t shader_address = 0;
+    bool (*native_function)(uint8_t *) = native_shader_cache_identity;
+#if defined(_WIN64)
+    compiler_entry compiler_function = __imp_doe_compiler_compile;
+#elif defined(_WIN32)
+    compiler_entry compiler_function = NULL; /* No unverified x86 thunk guess. */
+#else
+    compiler_entry compiler_function = doe_compiler_compile;
+#endif
+    doe_shader_status (*shader_function)(const doe_shader *,
+        const DoeCompilerEntrySelectionV5 *, const DoeCompilerOverrideValueV13 *, size_t,
+        const DoeCompilerMetalPipelineOptionsV15 *, const void *, size_t, doe_shader **) =
+        doe_shader_artifact_read;
+    _Static_assert(sizeof(shader_function) == sizeof(shader_address), "shader function address size");
+    _Static_assert(sizeof(native_function) == sizeof(native_address), "native function address size");
+    _Static_assert(sizeof(compiler_function) == sizeof(compiler_address), "compiler function address size");
+    memcpy(&native_address, &native_function, sizeof(native_address));
+    if (!compiler_function) return false;
+    memcpy(&compiler_address, &compiler_function, sizeof(compiler_address));
+    memcpy(&shader_address, &shader_function, sizeof(shader_address));
+    image_hash native = {0};
+    image_hash compiler = {0};
+    image_hash shader = {0};
+    if (!loaded_image(native_address, &native) || !loaded_image(compiler_address, &compiler) ||
+        !loaded_image(shader_address, &shader))
+        return false;
+    uint8_t combined[120] = {0};
+    memcpy(combined, "DOE-LOADED-OWNERS-v2", 20);
+    memcpy(combined + 24, native.digest, 32);
+    memcpy(combined + 56, compiler.digest, 32);
+    memcpy(combined + 88, shader.digest, 32);
+    doe_common_sha256(combined, sizeof(combined), digest);
+    return true;
+}
diff --git a/runtime/c/native/src/shader_cache_identity.h b/runtime/c/native/src/shader_cache_identity.h
new file mode 100644
index 000000000..df949aa9f
--- /dev/null
+++ b/runtime/c/native/src/shader_cache_identity.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef DOE_NATIVE_SHADER_CACHE_IDENTITY_H
+#define DOE_NATIVE_SHADER_CACHE_IDENTITY_H
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Hash the live native/compiler/shader-owner images' executable and immutable data
+ * mappings, not a pathname which may have been replaced after loading. Images
+ * stay resident under the native owner contract. Call outside device locks.
+ * ELF requires the mapped linker build ID and hashes originally read-only
+ * payload; the build ID binds relocation-bearing data without process pointers.
+ * Windows x64 follows the canonical compiler DLL IAT import (not a thunk);
+ * the shader owner is statically composed by the native Windows source list.
+ * Other formats hash current read-only mappings; ASLR/loader fixups can
+ * conservatively prevent cross-process reuse. Unsupported
+ * image enumeration fails closed, preserving digest; there is no disk fallback.
+ * Runtime options/device/pipeline inputs must be independently bound by caller.
+ */
+bool native_shader_cache_identity(uint8_t digest[32]);
+#endif
diff --git a/runtime/c/native/src/shader_disk_cache.c b/runtime/c/native/src/shader_disk_cache.c
new file mode 100644
index 000000000..da91e8c9b
--- /dev/null
+++ b/runtime/c/native/src/shader_disk_cache.c
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: MIT */
+#include "shader_disk_cache.h"
+#include "../../common/include/doe_sha256.h"
+#include "../../backends/vulkan/src/cache_file.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Reuse the existing bounded cross-platform cache-file owner (atomic replace,
+ * UTF-8 Windows paths, bounded reads); do not introduce another persistence
+ * engine. Native driver pipeline data and compiler artifacts remain separate. */
+static char *cache_path(const uint8_t image_identity[32], const doe_shader *module,
+    const DoeCompilerEntrySelectionV5 *selection, const DoeCompilerOverrideValueV13 *values, size_t count,
+    const DoeCompilerMetalPipelineOptionsV15 *pipeline, bool create)
+{
+    uint8_t key[32], combined[64];
+    if (!image_identity || !doe_shader_artifact_key(module,selection,values,count,pipeline,key)) return NULL;
+    memcpy(combined,image_identity,32); memcpy(combined+32,key,32);
+    doe_common_sha256(combined,sizeof(combined),key);
+    char hex[65]; doe_common_sha256_hex(key,hex);
+    const char *override = getenv("DOE_SHADER_CACHE_DIR");
+    const char *home = getenv("HOME");
+    const char *root = override ? override : home && *home ? home : "cache";
+    if (!*root) return NULL; /* Explicit empty override disables persistence. */
+    const char *suffix = override ? "" : home && *home ? "/.cache/doe/c_shader_translation_cache_v1" : "/doe/c_shader_translation_cache_v1";
+    size_t length = strlen(root), extra = strlen(suffix);
+    if (length > 32768 || extra > SIZE_MAX-length-1) return NULL;
+    size_t directory_size = length+extra;
+    char *path = malloc(directory_size+1+64+5);
+    if (!path) return NULL;
+    memcpy(path,root,length); memcpy(path+length,suffix,extra+1);
+    if (create && !doe_vk_cache_directory(path)) { free(path); return NULL; }
+    memcpy(path+directory_size,"/",1); memcpy(path+directory_size+1,hex,64);
+    memcpy(path+directory_size+65,".bin",5);
+    return path;
+}
+
+doe_shader *native_shader_disk_lookup(const uint8_t image_identity[32], const doe_shader *module,
+    const DoeCompilerEntrySelectionV5 *selection, const DoeCompilerOverrideValueV13 *values, size_t count,
+    const DoeCompilerMetalPipelineOptionsV15 *pipeline)
+{
+    char *path = cache_path(image_identity,module,selection,values,count,pipeline,false);
+    if (!path) return NULL;
+    uint8_t *bytes = NULL; size_t size = 0;
+    doe_shader *shader = NULL;
+    if (doe_vk_cache_read(path,&bytes,&size))
+        (void)doe_shader_artifact_read(module,selection,values,count,pipeline,bytes,size,&shader);
+    free(bytes); free(path);
+    return shader;
+}
+
+void native_shader_disk_store(const uint8_t image_identity[32], const doe_shader *module,
+    const DoeCompilerEntrySelectionV5 *selection, const DoeCompilerOverrideValueV13 *values, size_t count,
+    const DoeCompilerMetalPipelineOptionsV15 *pipeline, const doe_shader *shader)
+{
+    size_t size = doe_shader_artifact_size(shader);
+    if (!size) return;
+    /* Refuse mismatched caller metadata even if the artifact itself is valid. */
+    bool matches = pipeline ? doe_shader_metal_pipeline_matches(shader,module,selection,values,count,pipeline) :
+        doe_shader_specialization_matches(shader,module,selection,values,count);
+    if (!matches) return;
+    uint8_t *bytes = malloc(size);
+    if (!bytes) return;
+    if (doe_shader_artifact_write(shader,bytes,size)) {
+        char *path = cache_path(image_identity,module,selection,values,count,pipeline,true);
+        if (path) (void)doe_vk_cache_replace(path,bytes,size);
+        free(path);
+    }
+    free(bytes);
+}
