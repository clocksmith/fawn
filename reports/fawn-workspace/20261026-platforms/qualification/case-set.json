    "researchFindingTitles": ["Vulkan memory model", "Vulkan synchronization"]
  },
  "workflows": {
    "research": {
      "intent": "research:read",
      "actionKinds": ["navigate", "click"],
      "effectActionSuffix": "-open-0",
      "effectRequest": { "server": "main", "method": "GET", "path": "/research/vulkan-memory.html" },
      "task": { "indexPath": "/research/", "topics": ["vulkan"], "maxDocuments": 5 }
    },
    "form": {
      "intent": "form:contact",
      "actionKinds": ["navigate", "fill", "submit"],
      "effectActionSuffix": "-submit",
      "effectRequest": { "server": "main", "method": "POST", "path": "/form/submit" },
      "task": {
        "formPath": "/form",
        "subjectPrefix": "Ada",
        "email": "ada@example.test",
        "completedWhen": [{ "kind": "element-present", "selector": "#receipt" }],
        "failedWhen": [{ "kind": "element-present", "selector": "#error" }],
        "submissionsPath": "/submissions",
        "submissionsSelector": "#submissions"
      }
    },
    "export": {
      "intent": "export:report",
      "actionKinds": ["navigate", "download"],
      "effectActionSuffix": "-download",
      "effectRequest": { "server": "main", "method": "GET", "path": "/export/report.csv" },
      "task": { "exportPath": "/export", "linkText": "Download report" }
    }
  },
