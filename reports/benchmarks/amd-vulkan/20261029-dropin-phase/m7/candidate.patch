+
+static doe_vk_status descriptor_pool(doe_vk_commands *commands,
+    doe_vk_pipeline *pipeline, doe_vk_dispatch_use *use, VkDescriptorSet *sets) {
+    if (pipeline->group_count == 0) return DOE_VK_OK;
