+        doe_vk_buffer_release(copy->staging); /* The recording keeps its own leases. */
+        doe_vk_buffer_release(copy->destination);
+    }
+    device->staged_count = 0;
+    return first;
+}
+
 void native_release_initialization(native_device *device)
 {
+    /* Never submitted: staged writes are unobservable without a submission. */
+    for (uint32_t i = 0; i < device->staged_count; ++i) {
+        doe_vk_buffer_release(device->staged[i].staging);
+        doe_vk_buffer_release(device->staged[i].destination);
+    }
+    device->staged_count = 0;
+    for (unsigned i = 0; i < NATIVE_UPLOAD_STAGING; ++i) {
+        doe_vk_buffer_release(device->upload_staging[i]);
+        device->upload_staging[i] = NULL;
+    }
     if (!device->init_batch) return;
     /* Never submitted: its textures are unobservable without a submission. */
     if (doe_vk_commands_release(device->init_batch) != DOE_VK_OK) abort();
