diff --git a/runtime/c/backends/vulkan/src/commands.c b/runtime/c/backends/vulkan/src/commands.c
index 2bae76b08..c296ea8f7 100644
--- a/runtime/c/backends/vulkan/src/commands.c
+++ b/runtime/c/backends/vulkan/src/commands.c
@@ -33,8 +33,23 @@ doe_vk_status doe_vk_use_buffer(doe_vk_commands *commands, doe_vk_buffer *buffer
         return status;
     }
     ++buffer->recorded_uses;
-    *use = (doe_vk_buffer_use){ buffer, commands->buffers };
+    *use = (doe_vk_buffer_use){ buffer, commands->buffers, false };
     commands->buffers = use;
+    if (buffer->zero_pending) {
+        /* First use: nothing else has accessed the allocation. A reusable
+         * recording would refill on every replay, so it zeroes on the host;
+         * a one-shot recording fills ahead of this use. A word tail that the
+         * fill cannot reach is zeroed on the host. */
+        buffer->zero_pending = false;
+        const size_t whole = (size_t)(buffer->size & ~UINT64_C(3));
+        if (commands->reusable || whole == 0) memset(buffer->mapped, 0, (size_t)buffer->size);
+        else {
+            memset((uint8_t *)buffer->mapped + whole, 0, (size_t)buffer->size - whole);
+            commands->context->vk.vkCmdFillBuffer(commands->command, buffer->buffer, 0, whole, 0);
+            doe_vk_barrier(commands);
+            use->zero_fill = true;
+        }
+    }
     return DOE_VK_OK;
 }
 
@@ -510,6 +525,9 @@ doe_vk_status doe_vk_commands_release(doe_vk_commands *commands) {
         doe_vk_buffer_use *use = commands->buffers;
         commands->buffers = use->next;
         if (commands->uses_active) --use->buffer->recorded_uses;
+        /* A fill that never reached the queue leaves zeros owed. */
+        if (use->zero_fill && (commands->state == DOE_VK_RECORDING || commands->state == DOE_VK_POISONED))
+            use->buffer->zero_pending = true;
         doe_vk_buffer_release(use->buffer);
         free(use);
     }
diff --git a/runtime/c/backends/vulkan/src/internal.h b/runtime/c/backends/vulkan/src/internal.h
index d9ce9d3cb..edcecbc36 100644
--- a/runtime/c/backends/vulkan/src/internal.h
+++ b/runtime/c/backends/vulkan/src/internal.h
@@ -84,6 +84,10 @@ struct doe_vk_buffer {
     VkBuffer buffer;
     VkDeviceMemory memory;
     void *mapped;
+    /* Host buffers are zeroed lazily: a full host write makes zeros
+     * unobservable, other host access zeroes on the host first, and the first
+     * recorded GPU use fills zeros ahead of itself (see commands.c). */
+    bool zero_pending;
 };
 struct doe_vk_pipeline {
     doe_vk_context *context;
@@ -117,6 +121,7 @@ struct doe_vk_pipeline {
 typedef struct doe_vk_buffer_use {
     doe_vk_buffer *buffer;
     struct doe_vk_buffer_use *next;
+    bool zero_fill; /* This recording carries the buffer's deferred zero fill. */
 } doe_vk_buffer_use;
 typedef struct doe_vk_dispatch_use {
     doe_vk_pipeline *pipeline;
diff --git a/runtime/c/backends/vulkan/src/resources.c b/runtime/c/backends/vulkan/src/resources.c
index 914a40742..295ae7317 100644
--- a/runtime/c/backends/vulkan/src/resources.c
+++ b/runtime/c/backends/vulkan/src/resources.c
@@ -98,7 +98,9 @@ doe_vk_status doe_vk_buffer_create(doe_vk_context *context, uint64_t size,
     const VkBufferCreateInfo create = {
         .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
         .size = size,
-        .usage = usage
+        /* Transfer destination for the deferred zero fill; admission still
+         * uses the requested usage. */
+        .usage = kind == DOE_VK_MEMORY_HOST ? usage | DOE_VK_BUFFER_COPY_DST : usage
     };
     status = doe_vk_result(context, context->vk.vkCreateBuffer(context->device, &create, NULL, &buffer->buffer), "vkCreateBuffer", error);
     if (status != DOE_VK_OK) goto failed;
@@ -133,7 +135,7 @@ doe_vk_status doe_vk_buffer_create(doe_vk_context *context, uint64_t size,
             status = doe_vk_fail(DOE_VK_NATIVE_FAILURE, "null mapped buffer", error);
             goto failed;
         }
-        memset(buffer->mapped, 0, (size_t)size);
+        buffer->zero_pending = true;
     }
     *out = buffer;
     return doe_vk_fail(DOE_VK_OK, "buffer ready", error);
@@ -182,6 +184,8 @@ doe_vk_status doe_vk_buffer_write(doe_vk_buffer *buffer, uint64_t offset,
     if (status != DOE_VK_OK) return status;
     if (buffer->content_status != DOE_VK_OK && (offset != 0 || size != buffer->size))
         return buffer->content_status;
+    if (buffer->zero_pending && (offset != 0 || size != buffer->size)) memset(buffer->mapped, 0, (size_t)buffer->size);
+    buffer->zero_pending = false;
     if (size != 0) memcpy((uint8_t *)buffer->mapped + (size_t)offset, bytes, size);
     if (offset == 0 && size == buffer->size) buffer->content_status = DOE_VK_OK;
     return DOE_VK_OK;
@@ -193,6 +197,8 @@ doe_vk_status doe_vk_buffer_host_range(doe_vk_buffer *buffer, uint64_t offset,
     doe_vk_status status = host_access(buffer, offset, size);
     if (status != DOE_VK_OK) return status;
     if (buffer->content_status != DOE_VK_OK) return buffer->content_status;
+    if (buffer->zero_pending) memset(buffer->mapped, 0, (size_t)buffer->size);
+    buffer->zero_pending = false;
     *out = (const uint8_t *)buffer->mapped + (size_t)offset;
     return DOE_VK_OK;
 }
diff --git a/runtime/c/native/Makefile b/runtime/c/native/Makefile
index 6103a92aa..c20ad0774 100644
