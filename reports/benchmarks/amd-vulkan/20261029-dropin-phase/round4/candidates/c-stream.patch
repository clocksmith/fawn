+/* Host writes into uncached (write-combined) mappings use 16-byte non-temporal
+ * stores; the closing fence orders them before any later submission. */
+static void host_store(void *destination, const void *source, size_t size, bool streaming) {
+#if defined(__x86_64__) || defined(_M_X64)
+    if (streaming && size >= 128) {
+        uint8_t *out = destination;
+        const uint8_t *in = source;
+        const size_t head = (16 - ((uintptr_t)out & 15)) & 15;
+        if (source != NULL) memcpy(out, in, head);
+        else memset(out, 0, head);
+        size_t i = head;
+        const __m128i zero = _mm_setzero_si128();
+        for (; i + 16 <= size; i += 16)
+            _mm_stream_si128((__m128i *)(void *)(out + i),
+                source != NULL ? _mm_loadu_si128((const __m128i *)(const void *)(in + i)) : zero);
+        if (source != NULL) memcpy(out + i, in + i, size - i);
+        else memset(out + i, 0, size - i);
+        _mm_sfence();
+        return;
+    }
+#else
+    (void)streaming;
+#endif
+    if (source != NULL) memcpy(destination, source, size);
+    else memset(destination, 0, size);
+}
