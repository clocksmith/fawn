+/* SPDX-License-Identifier: MIT
+ * Host clears and recording ownership only; no simulated GPU execution. */
+#include "mock_native.h"
+#include "../src/query_internal.h"
+#include "../src/texture_internal.h"
+#include "../src/render_internal.h"
+#include "../include/doe_metal_indirect.h"
+#include <assert.h>
+#include <stdio.h>
+
+static doe_mtl_context *context_new(mock_native *mock) {
+    doe_mtl_context *context = NULL;
+    assert(doe_mtl_context_open(mock_driver(mock), &context, NULL) == DOE_MTL_OK);
+    return context;
+}
+static doe_mtl_buffer *buffer_new(doe_mtl_context *context, size_t size) {
+    doe_mtl_buffer *buffer = NULL;
+    assert(doe_mtl_buffer_create(context, size, DOE_MTL_SHARED, &buffer, NULL) == DOE_MTL_OK);
+    return buffer;
+}
+static doe_mtl_commands *commands_new(doe_mtl_context *context) {
+    doe_mtl_commands *commands = NULL;
+    assert(doe_mtl_commands_create(context, &commands, NULL) == DOE_MTL_OK);
+    return commands;
+}
+/* Inspect the existing hostile 0xa5 allocator fixture directly, without causing
+ * the host-read API to clear it and mask an early or missing clear. */
+static void bytes_are(doe_mtl_buffer *buffer, unsigned char value) {
+    doe_mtl_native *native = &buffer->context->native;
+    const unsigned char *bytes = native->contents(native->userdata, buffer->native);
+    assert(bytes != NULL);
+    for (size_t i = 0; i < buffer->size; ++i) assert(bytes[i] == value);
+}
+static void readable_zero(doe_mtl_buffer *buffer) {
+    unsigned char bytes[64];
+    assert(buffer->size == sizeof(bytes));
+    assert(doe_mtl_buffer_read(buffer, 0, bytes, sizeof(bytes)) == DOE_MTL_OK);
+    for (size_t i = 0; i < sizeof(bytes); ++i) assert(bytes[i] == 0);
+}
+
+static void host_access(void) {
+    mock_native mock;
+    doe_mtl_context *context = context_new(&mock);
+    doe_mtl_buffer *read = buffer_new(context, 64), *partial = buffer_new(context, 64);
+    doe_mtl_buffer *full = buffer_new(context, 64);
+    bytes_are(read, 0xa5);
+    const void *range = NULL;
+    assert(doe_mtl_buffer_host_range(read, 16, 4, &range) == DOE_MTL_OK && range != NULL);
+    bytes_are(read, 0);
+    unsigned char input[64], output[64];
+    memset(input, 0x37, sizeof(input));
+    assert(doe_mtl_buffer_write(partial, 4, input, 4) == DOE_MTL_OK);
+    assert(doe_mtl_buffer_read(partial, 0, output, sizeof(output)) == DOE_MTL_OK);
+    for (size_t i = 0; i < sizeof(output); ++i) assert(output[i] == (i >= 4 && i < 8 ? 0x37 : 0));
+    assert(doe_mtl_buffer_write(full, 0, input, sizeof(input)) == DOE_MTL_OK);
+    bytes_are(full, 0x37);
+    doe_mtl_buffer_release(read);
+    doe_mtl_buffer_release(partial);
+    doe_mtl_buffer_release(full);
+    doe_mtl_context_release(context);
+    mock_assert_closed(&mock);
+}
+
+static void fills_copies_and_abandonment(void) {
+    mock_native mock;
+    doe_mtl_context *context = context_new(&mock);
+    doe_mtl_buffer *source = buffer_new(context, 64), *destination = buffer_new(context, 64);
+    doe_mtl_buffer *partial = buffer_new(context, 64);
+    doe_mtl_commands *commands = commands_new(context);
+    assert(doe_mtl_commands_copy(commands, source, 0, destination, 0, 64, NULL) == DOE_MTL_OK);
+    bytes_are(source, 0);
+    bytes_are(destination, 0xa5);
+    assert(!destination->initialized && doe_mtl_buffer_initialized(commands, destination));
+    /* A prior full overwrite is sufficient inside this command: later partial
+     * writes and reads must not CPU-clear over its future GPU result. */
+    unsigned queries = mock.content_queries;
+    mock.fail = MOCK_CONTENTS;
+    assert(doe_mtl_commands_fill(commands, destination, 4, 4, 0x42, NULL) == DOE_MTL_OK);
+    assert(doe_mtl_commands_copy(commands, destination, 0, source, 0, 64, NULL) == DOE_MTL_OK);
+    assert(mock.content_queries == queries);
+    mock.fail = MOCK_NONE;
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+    readable_zero(destination); /* Uncommitted copy never changed public bytes. */
+    commands = commands_new(context);
+    assert(doe_mtl_commands_fill(commands, partial, 4, 4, 1, NULL) == DOE_MTL_OK);
+    bytes_are(partial, 0);
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+    readable_zero(partial);
+    doe_mtl_buffer_release(source);
+    doe_mtl_buffer_release(destination);
+    doe_mtl_buffer_release(partial);
+    doe_mtl_context_release(context);
+    mock_assert_closed(&mock);
+}
+
+static void pending_failure_and_recovery(void) {
+    mock_native mock;
+    doe_mtl_context *context = context_new(&mock);
+    doe_mtl_buffer *buffer = buffer_new(context, 64);
+    doe_mtl_commands *commands = commands_new(context);
+    assert(doe_mtl_commands_fill(commands, buffer, 0, 64, 1, NULL) == DOE_MTL_OK);
+    bytes_are(buffer, 0xa5);
+    assert(doe_mtl_commands_submit(commands, NULL) == DOE_MTL_OK);
+    mock_command_result(commands->native, 0, 0);
+    assert(doe_mtl_commands_poll(commands, NULL) == DOE_MTL_COMPLETION_UNKNOWN);
+    assert(!buffer->initialized && buffer->owner == commands);
+    unsigned char output[64], input[64];
+    memset(output, 0x91, sizeof(output));
+    memset(input, 0x27, sizeof(input));
+    assert(doe_mtl_buffer_read(buffer, 0, output, sizeof(output)) == DOE_MTL_BUSY);
+    assert(doe_mtl_buffer_write(buffer, 0, input, sizeof(input)) == DOE_MTL_BUSY);
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_BUSY);
+    bytes_are(buffer, 0xa5);
+    mock_command_result(commands->native, 5, -71);
+    assert(doe_mtl_commands_poll(commands, NULL) == DOE_MTL_EXECUTION_FAILED);
+    assert(doe_mtl_buffer_read(buffer, 0, output, sizeof(output)) == DOE_MTL_EXECUTION_FAILED);
+    for (size_t i = 0; i < sizeof(output); ++i) assert(output[i] == 0x91);
+    assert(doe_mtl_buffer_write(buffer, 4, input, 4) == DOE_MTL_EXECUTION_FAILED);
+    bytes_are(buffer, 0xa5);
+    assert(doe_mtl_buffer_write(buffer, 0, input, sizeof(input)) == DOE_MTL_OK);
+    bytes_are(buffer, 0x27);
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+    doe_mtl_buffer_release(buffer);
+    doe_mtl_context_release(context);
+    mock_assert_closed(&mock);
+}
+
+static void compute_and_contents_failure(void) {
+    mock_native mock;
+    doe_mtl_context *context = context_new(&mock);
+    doe_mtl_pipeline *pipeline = NULL;
+    const doe_mtl_pipeline_desc desc = {"kernel", 6, "main", {1, 1, 1}, UINT32_MAX};
+    assert(doe_mtl_pipeline_create(context, &desc, &pipeline, NULL) == DOE_MTL_OK);
+    doe_mtl_buffer *buffer = buffer_new(context, 64), *failed = buffer_new(context, 64);
+    doe_mtl_buffer_binding binding = {0, buffer, 0, 64};
+    doe_mtl_commands *commands = commands_new(context);
+    assert(doe_mtl_commands_dispatch(commands, pipeline, &binding, 1,
+        (doe_mtl_dimensions){1, 1, 1}, 1, NULL) == DOE_MTL_OK);
+    bytes_are(buffer, 0);
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+    commands = commands_new(context);
+    binding.buffer = failed;
+    mock.fail = MOCK_CONTENTS;
+    assert(doe_mtl_commands_dispatch(commands, pipeline, &binding, 1,
+        (doe_mtl_dimensions){1, 1, 1}, 1, NULL) == DOE_MTL_NATIVE_FAILURE);
+    assert(mock.dispatches == 1 && failed->owner == commands && !failed->initialized);
+    assert(doe_mtl_commands_submit(commands, NULL) == DOE_MTL_NATIVE_FAILURE);
+    assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+    mock.fail = MOCK_NONE;
+    bytes_are(failed, 0xa5);
+    readable_zero(failed);
+    doe_mtl_pipeline_release(pipeline);
+    doe_mtl_buffer_release(buffer);
+    doe_mtl_buffer_release(failed);
+    doe_mtl_context_release(context);
+    mock_assert_closed(&mock);
+}
