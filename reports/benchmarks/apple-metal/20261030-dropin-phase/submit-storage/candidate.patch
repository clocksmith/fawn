diff --git a/runtime/c/backends/metal/tests/test_lifetime.c b/runtime/c/backends/metal/tests/test_lifetime.c
index 4aac86af2..87e05293e 100644
--- a/runtime/c/backends/metal/tests/test_lifetime.c
+++ b/runtime/c/backends/metal/tests/test_lifetime.c
@@ -423,6 +423,59 @@ static void test_unknown_commit_and_reference_overflow(void) {
     mock_assert_closed(&mock);
 }
 
+/* Cross the small-recording storage capacity and repeat each resource use.
+ * Retirement must handle inline and overflow leases identically, including
+ * unknown completion, failed completion and an abandoned native recording. */
+static void test_many_resource_leases(void) {
+    for (unsigned outcome = 0; outcome < 3; ++outcome) {
+        mock_native mock;
+        doe_mtl_context *context = context_create(&mock);
+        doe_mtl_commands *commands = command_create(context);
+        doe_mtl_buffer *buffers[12];
+        doe_mtl_pipeline *pipelines[4];
+        for (size_t i = 0; i < 12; ++i) {
+            buffers[i] = buffer_create(context, DOE_MTL_PRIVATE);
+            for (unsigned repeat = 0; repeat < 2; ++repeat)
+                assert(doe_mtl_commands_fill(commands, buffers[i], 0, 64, 0, NULL) == DOE_MTL_OK);
+            assert(buffers[i]->references == 2 && !buffers[i]->initialized);
+            assert(doe_mtl_buffer_initialized(commands, buffers[i]));
+        }
+        for (size_t i = 0; i < 4; ++i) {
+            pipelines[i] = pipeline_create(context);
+            doe_mtl_buffer_binding binding = {0, buffers[i], 0, 64};
+            for (unsigned repeat = 0; repeat < 2; ++repeat)
+                assert(doe_mtl_commands_dispatch(commands, pipelines[i], &binding, 1,
+                    (doe_mtl_dimensions){1, 1, 1}, 1, NULL) == DOE_MTL_OK);
+            assert(pipelines[i]->references == 2);
+        }
+        if (outcome != 0) {
+            mock.unknown_commit = true;
+            assert(doe_mtl_commands_submit(commands, NULL) == DOE_MTL_OK);
+            assert(doe_mtl_commands_poll(commands, NULL) == DOE_MTL_COMPLETION_UNKNOWN);
+            assert(doe_mtl_commands_release(commands) == DOE_MTL_BUSY);
+            for (size_t i = 0; i < 12; ++i)
+                assert(buffers[i]->owner == commands && buffers[i]->references == 2);
+            mock_result(&mock, outcome == 1 ? 4 : 5, -8765);
+            assert(doe_mtl_commands_poll(commands, NULL) ==
+                (outcome == 1 ? DOE_MTL_OK : DOE_MTL_EXECUTION_FAILED));
+        }
+        assert(doe_mtl_commands_release(commands) == DOE_MTL_OK);
+        for (size_t i = 0; i < 12; ++i) {
+            assert(buffers[i]->owner == NULL && buffers[i]->use == NULL);
+            assert(buffers[i]->references == 1);
+            assert(buffers[i]->initialized == (outcome == 1));
+            assert(buffers[i]->poisoned == (outcome == 2));
+            doe_mtl_buffer_release(buffers[i]);
+        }
+        for (size_t i = 0; i < 4; ++i) {
+            assert(pipelines[i]->references == 1);
+            doe_mtl_pipeline_release(pipelines[i]);
+        }
+        doe_mtl_context_release(context);
+        mock_assert_closed(&mock);
+    }
+}
+
 int main(void) {
     test_acquisition_failures();
     test_host_access();
@@ -434,6 +487,7 @@ int main(void) {
     test_recording_failures();
     test_validation_and_empty_work();
     test_unknown_commit_and_reference_overflow();
-    puts("Metal developer controls: 10 scenario groups passed; mocked calls, no GPU execution");
+    test_many_resource_leases();
+    puts("Metal developer controls: 11 scenario groups passed; mocked calls, no GPU execution");
     return 0;
 }
