{
  "schemaVersion": 4,
  "artifactKind": "external-project-harness",
  "actorId": "wgsl-fns",
  "harnessId": "wgsl-compilation-suite",
  "upstream": {
    "repositoryUrl": "https://github.com/koole/wgsl-fns",
    "commit": "e1068da8c1ad213842c6332440fe1308def091cc",
    "license": {
      "identifier": "MIT",
      "evidenceUrl": "https://github.com/koole/wgsl-fns/blob/e1068da8c1ad213842c6332440fe1308def091cc/package.json"
    }
  },
  "providerSubstitution": {
    "baselineProvider": "dawn-node-webgpu",
    "comparisonProvider": "doe-gpu",
    "seam": "A Node ESM loader redirects only the upstream test's exact webgpu package import to the selected provider wrapper; upstream tests, generated WGSL, function corpus, dependency resolution, compilation-info checks, and cleanup remain unchanged.",
    "patchPaths": []
  },
  "fallbackPolicy": {
    "requireHardware": true,
    "prohibitedFallbacks": ["cpu", "mock", "software-renderer", "unknown-provider"],
    "providerIdentityAssertion": "The selected wrapper and child-process provider probe must name the requested module, expose an adapter identity, reject software renderers, and bind an accessible physical render node before evidence is comparable."
  },
  "workload": {
    "command": ["node", "bench/external-projects/wgsl-fns/run-suite.mjs", "--require-all-pass"],
    "immutableInputRefs": [
      "bench/external-projects/wgsl-fns/oracle.md",
      "bench/external-projects/wgsl-fns/provider-loader.mjs"
    ],
    "oracle": {
      "kind": "independent-replacement",
      "path": "bench/external-projects/wgsl-fns/oracle.md",
      "reviewStatus": "reviewed"
    },
    "sameWorkPolicy": "Both providers execute the same pinned 13-assertion upstream test file over the same generated 110-function corpus; the parent additionally rejects native compiler diagnostics that getCompilationInfo failed to expose.",
    "completionBoundary": "A clean-process sample ends only after the Node test parent and worker exit, the 13-assertion summary is captured, provider-native compiler diagnostics are classified, and cleanup completes without a timeout."
  },
  "requiredMeasurements": [
    "clean-process-success",
    "crashes",
    "hangs",
    "timeouts",
    "peak-memory-bytes",
    "cold-p50",
    "cold-p95",
    "cold-p99",
    "warm-p50",
    "warm-p95",
    "warm-p99",
    "receipt-overhead"
  ],
  "requiredReceiptFields": [
    "provider-identity",
    "adapter-identity",
    "driver-identity",
    "shader-hashes",
    "dispatch-shape",
    "synchronization",
    "readback",
    "output-identity"
  ],
  "installation": {
    "substitutionMode": "other",
    "productionStatus": "harness-only",
    "applicationSourceUnchanged": true,
    "shaderSourceUnchanged": true,
    "installSteps": [
      {
        "id": "upstream-dependencies",
        "command": ["npm", "ci"],
        "workingDirectory": { "scope": "upstream", "path": "." },
        "timeoutSeconds": 1800
      }
    ],
    "validationCommand": ["node", "bench/external-projects/wgsl-fns/run-suite.mjs", "--require-all-pass"],
    "timeoutSeconds": 1800
  },
  "reproduction": {
    "providerModulePath": "packages/doe-gpu/src/index.js",
    "arguments": ["--run-id", "{runId}"],
    "evidenceFiles": [
      { "id": "raw-suite", "path": "raw-suite.json" },
      { "id": "receipt-summary", "path": "receipt-summary.json" }
    ]
  },
  "supportTargets": [],
  "reliabilityPolicy": {
    "cleanProcessRunsPerProvider": 3,
    "concurrencyLevel": 1,
    "concurrencyRunsPerProvider": 0,
    "teardownCyclesPerProvider": 0,
    "stressIterationsPerProvider": 0,
    "processTimeoutSeconds": 120,
    "memoryGrowthBoundaryBytes": 0,
    "requireZeroCrashes": true,
    "requireZeroHangs": true,
    "requireZeroTimeouts": true
  },
  "performancePolicy": {
    "timingScope": "complete clean-process Node test execution of the pinned 13-assertion upstream suite plus native-diagnostic classification",
    "coldSamplesPerProvider": 3,
    "warmupSamplesPerProvider": 0,
    "warmSamplesPerProvider": 1,
    "requiredPercentiles": ["p50", "p95", "p99"],
    "throughputMetric": "oracle-passing complete WGSL compilation suites per second",
    "minimumMaterialSpeedupRatio": 1.1,
    "maximumRegressionRatio": 1.05
  },
  "receiptPolicy": {
    "captureRequired": true,
    "replayRequired": false,
    "runtimeBuildIdentityRequired": true,
    "preparationReceiptRequired": true
  },
  "releasePolicy": {
    "promotionState": "not-promoted",
    "blocking": false,
    "command": ["node", "bench/external-projects/wgsl-fns/run-suite.mjs", "--require-all-pass"],
    "promotionReportIds": []
  }
}
