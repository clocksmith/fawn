{
  "schemaVersion": 4,
  "artifactKind": "external-project-harness",
  "actorId": "umap-gpu",
  "harnessId": "sgd-output-correctness",
  "upstream": {
    "repositoryUrl": "https://github.com/Achuttarsing/umap-gpu",
    "commit": "7884b287f49bc057df7e0856c5539f130a20e0ad",
    "license": {
      "identifier": "MIT",
      "evidenceUrl": "https://github.com/Achuttarsing/umap-gpu/blob/7884b287f49bc057df7e0856c5539f130a20e0ad/LICENSE"
    }
  },
  "providerSubstitution": {
    "baselineProvider": "dawn-node-webgpu",
    "comparisonProvider": "doe-gpu",
    "seam": "An external Vitest config aliases only the existing webgpu package import to the selected provider module; upstream tests, TypeScript, WGSL, inputs, thresholds, synchronization, and readback are unchanged.",
    "patchPaths": []
  },
  "fallbackPolicy": {
    "requireHardware": true,
    "prohibitedFallbacks": ["cpu", "mock", "software-renderer", "unknown-provider"],
    "providerIdentityAssertion": "The selected module path and child-process provider probe must name the requested provider, expose an adapter identity, reject software renderers, and bind an accessible physical render node before evidence is comparable."
  },
  "workload": {
    "command": ["node", "bench/external-projects/umap-gpu/run-suite.mjs", "--require-all-pass"],
    "immutableInputRefs": [
      "bench/external-projects/umap-gpu/oracle.md",
      "bench/external-projects/umap-gpu/vitest-provider.config.mjs"
    ],
    "oracle": {
      "kind": "upstream",
      "path": "bench/external-projects/umap-gpu/oracle.md",
      "reviewStatus": "reviewed"
    },
    "sameWorkPolicy": "Both providers execute the same pinned eight-assertion upstream GPU output suite through the same Vitest process configuration, input construction, two WGSL shaders, epoch counts, queue waits, mapAsync readback, and structural thresholds.",
    "completionBoundary": "A clean-process sample ends only after both shaders have executed across the upstream epoch loops, queue completion and mapAsync readback have completed, and all eight upstream structural assertions have passed."
  },
  "requiredMeasurements": [
    "clean-process-success",
    "crashes",
    "hangs",
    "timeouts",
    "peak-memory-bytes",
    "cold-p50",
    "cold-p95",
    "cold-p99",
    "warm-p50",
    "warm-p95",
    "warm-p99",
    "receipt-overhead"
  ],
  "requiredReceiptFields": [
    "provider-identity",
    "adapter-identity",
    "driver-identity",
    "shader-hashes",
    "dispatch-shape",
    "synchronization",
    "readback",
    "output-identity"
  ],
  "installation": {
    "substitutionMode": "other",
    "productionStatus": "harness-only",
    "applicationSourceUnchanged": true,
    "shaderSourceUnchanged": true,
    "installSteps": [
      {
        "id": "upstream-dependencies",
        "command": ["npm", "ci"],
        "workingDirectory": { "scope": "upstream", "path": "." },
        "timeoutSeconds": 1800
      }
    ],
    "validationCommand": ["node", "bench/external-projects/umap-gpu/run-suite.mjs", "--require-all-pass"],
    "timeoutSeconds": 1800
  },
  "reproduction": {
    "providerModulePath": "packages/doe-gpu/src/index.js",
    "arguments": ["--run-id", "{runId}"],
    "evidenceFiles": [
      { "id": "raw-suite", "path": "raw-suite.json" },
      { "id": "receipt-summary", "path": "receipt-summary.json" }
    ]
  },
  "supportTargets": [
    {
      "id": "linux-x64-radeon-8060s-radv-26-0-3",
      "os": "linux",
      "arch": "x86_64",
      "runtime": "node-22",
      "adapter": "Radeon 8060S Graphics",
      "driver": "Mesa 26.0.3",
      "status": "validated"
    }
  ],
  "reliabilityPolicy": {
    "cleanProcessRunsPerProvider": 3,
    "concurrencyLevel": 1,
    "concurrencyRunsPerProvider": 0,
    "teardownCyclesPerProvider": 0,
    "stressIterationsPerProvider": 0,
    "processTimeoutSeconds": 120,
    "memoryGrowthBoundaryBytes": 0,
    "requireZeroCrashes": true,
    "requireZeroHangs": true,
    "requireZeroTimeouts": true
  },
  "performancePolicy": {
    "timingScope": "complete clean-process Vitest execution of the eight-assertion upstream SGD output suite",
    "coldSamplesPerProvider": 3,
    "warmupSamplesPerProvider": 0,
    "warmSamplesPerProvider": 1,
    "requiredPercentiles": ["p50", "p95", "p99"],
    "throughputMetric": "oracle-passing upstream output suites per second",
    "minimumMaterialSpeedupRatio": 1.1,
    "maximumRegressionRatio": 1.05
  },
  "receiptPolicy": {
    "captureRequired": true,
    "replayRequired": false,
    "runtimeBuildIdentityRequired": true,
    "preparationReceiptRequired": true
  },
  "releasePolicy": {
    "promotionState": "not-promoted",
    "blocking": false,
    "command": ["node", "bench/external-projects/umap-gpu/run-suite.mjs", "--require-all-pass"],
    "promotionReportIds": []
  }
}
