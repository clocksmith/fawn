{
  "schemaVersion": 4,
  "artifactKind": "external-project-harness",
  "actorId": "holoscript-snn-webgpu",
  "harnessId": "tropical-spmv",
  "upstream": {
    "repositoryUrl": "https://github.com/brianonbased-dev/HoloScript",
    "commit": "337a39a869a552c814933c587fe65b34a0a2c95d",
    "license": {
      "identifier": "MIT",
      "evidenceUrl": "https://github.com/brianonbased-dev/HoloScript/blob/337a39a869a552c814933c587fe65b34a0a2c95d/LICENSE"
    }
  },
  "providerSubstitution": {
    "baselineProvider": "dawn-node-webgpu",
    "comparisonProvider": "doe-gpu",
    "seam": "A Node ESM loader resolves only the upstream package's dynamic import of webgpu to the selected provider module; upstream workload source is unchanged.",
    "patchPaths": []
  },
  "runtimeOwnershipPlan": {
    "claimedProperty": "independent-correction",
    "incumbentLimitation": "The application depends on entry-point-scoped layout and labeled-pass behavior whose release cadence and diagnostics are controlled by the incumbent runtime.",
    "applicationConsequence": "A provider defect can reject or misexecute the unchanged tropical-SpMV workload until an upstream release or local patch arrives.",
    "materialOutcome": {
      "metric": "exact oracle-passing workload coverage and first-failure localization under the unchanged application",
      "decisionRule": "Promote DoeRuntime only if D0 passes the frozen workload and provides a durable correction advantage over W0 and the smallest reviewable P0 patch."
    },
    "lanes": {
      "I0": { "requirement": "required", "construction": "Unmodified ambient Node WebGPU incumbent." },
      "I1": { "requirement": "required", "construction": "Pinned packaged Dawn Node WebGPU binary." },
      "W0": { "requirement": "required", "construction": "I1 under the same DoeProof oracle, receipt, replay, and release policy." },
      "D0": { "requirement": "required", "construction": "DoeRuntime under the same provider seam and DoeProof contract." },
      "P0": { "requirement": "required", "construction": "W0 plus the smallest reviewable incumbent correction for the observed provider defect." }
    },
    "ownershipCosts": [
      "owned-source-surface",
      "webgpu-compatibility",
      "platform-driver-matrix",
      "native-security",
      "release-packaging",
      "upstream-ingestion",
      "application-exceptions",
      "regression-support"
    ]
  },
  "fallbackPolicy": {
    "requireHardware": true,
    "prohibitedFallbacks": ["cpu", "mock", "software-renderer", "unknown-provider"],
    "providerIdentityAssertion": "The provider wrapper ID and adapter vendor must match the requested provider, and adapter plus host Vulkan evidence must reject software rendering before evidence can become comparable."
  },
  "workload": {
    "command": ["node", "bench/external-projects/holoscript-snn-webgpu/run-matrix.mjs"],
    "immutableInputRefs": [
      "bench/external-projects/holoscript-snn-webgpu/inputs.json"
    ],
    "oracle": {
      "kind": "upstream",
      "path": "bench/external-projects/holoscript-snn-webgpu/oracle.md",
      "reviewStatus": "reviewed"
    },
    "sameWorkPolicy": "Both providers execute the same pinned HoloScript TropicalShortestPaths.tropicalSpmv implementation over the same seeded graph sequence, source vector, tolerance, warmup count, and measured iteration count.",
    "completionBoundary": "Each sample includes command encoding, submit, queue.onSubmittedWorkDone, staging-buffer copy, mapAsync readback, and Float32Array materialization before timing stops."
  },
  "requiredMeasurements": [
    "clean-process-success",
    "crashes",
    "hangs",
    "timeouts",
    "peak-memory-bytes",
    "cold-p50",
    "cold-p95",
    "cold-p99",
    "warm-p50",
    "warm-p95",
    "warm-p99",
    "receipt-overhead"
  ],
  "requiredReceiptFields": [
    "provider-identity",
    "adapter-identity",
    "driver-identity",
    "shader-hashes",
    "dispatch-shape",
    "synchronization",
    "readback",
    "output-identity"
  ],
  "installation": {
    "substitutionMode": "esm-loader",
    "productionStatus": "harness-only",
    "applicationSourceUnchanged": true,
    "shaderSourceUnchanged": true,
    "installSteps": [
      {
        "id": "upstream-dependencies",
        "command": ["corepack", "pnpm", "install", "--frozen-lockfile"],
        "workingDirectory": { "scope": "upstream", "path": "." },
        "timeoutSeconds": 1800
      },
      {
        "id": "upstream-core-build",
        "command": ["corepack", "pnpm", "--filter", "@holoscript/core", "exec", "tsup"],
        "workingDirectory": { "scope": "upstream", "path": "." },
        "timeoutSeconds": 1800
      },
      {
        "id": "upstream-core-declarations",
        "command": ["node", "scripts/generate-types.mjs"],
        "workingDirectory": { "scope": "upstream", "path": "packages/core" },
        "timeoutSeconds": 1800
      },
      {
        "id": "upstream-snn-webgpu-build",
        "command": ["corepack", "pnpm", "--filter", "@holoscript/snn-webgpu", "exec", "tsup"],
        "workingDirectory": { "scope": "upstream", "path": "." },
        "timeoutSeconds": 1800
      }
    ],
    "validationCommand": ["node", "bench/external-projects/holoscript-snn-webgpu/run-matrix.mjs"],
    "timeoutSeconds": 1800
  },
  "reproduction": {
    "providerModulePath": "packages/doe-gpu/src/index.js",
    "arguments": ["{runRoot}/raw-matrix.json"],
    "evidenceFiles": [
      { "id": "raw-matrix", "path": "raw-matrix.json" },
      { "id": "receipt-summary", "path": "receipt-summary.json" }
    ]
  },
  "supportTargets": [
    {
      "id": "linux-x64-radeon-8060s-radv-26-0-3",
      "os": "linux",
      "arch": "x86_64",
      "runtime": "node-22",
      "adapter": "Radeon 8060S Graphics",
      "driver": "Mesa 26.0.3",
      "status": "validated"
    }
  ],
  "reliabilityPolicy": {
    "cleanProcessRunsPerProvider": 3,
    "concurrencyLevel": 1,
    "concurrencyRunsPerProvider": 0,
    "teardownCyclesPerProvider": 0,
    "stressIterationsPerProvider": 192,
    "processTimeoutSeconds": 120,
    "memoryGrowthBoundaryBytes": 0,
    "requireZeroCrashes": true,
    "requireZeroHangs": true,
    "requireZeroTimeouts": true
  },
  "performancePolicy": {
    "timingScope": "GPU command encoding through completed readback and Float32Array materialization",
    "coldSamplesPerProvider": 12,
    "warmupSamplesPerProvider": 48,
    "warmSamplesPerProvider": 576,
    "requiredPercentiles": ["p50", "p95", "p99"],
    "throughputMetric": "completed tropical SpMV dispatches per second",
    "minimumMaterialSpeedupRatio": 1.1,
    "maximumRegressionRatio": 1.05
  },
  "receiptPolicy": {
    "captureRequired": true,
    "replayRequired": false,
    "runtimeBuildIdentityRequired": true,
    "preparationReceiptRequired": true
  },
  "releasePolicy": {
    "promotionState": "not-promoted",
    "blocking": false,
    "command": ["node", "bench/external-projects/holoscript-snn-webgpu/run-matrix.mjs"],
    "promotionReportIds": []
  }
}
