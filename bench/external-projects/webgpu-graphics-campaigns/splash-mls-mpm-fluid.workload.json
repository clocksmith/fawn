  "buildSteps": [
    {
      "id": "npm-ci",
      "argv": ["npm", "ci", "--ignore-scripts"],
      "cwdRel": ".",
      "timeoutSeconds": 300
    },
    {
      "id": "vite-build",
      "argv": ["npm", "run", "build"],
      "cwdRel": ".",
      "timeoutSeconds": 300
    }
  ],
  "servedRoot": "dist",
  "entryHtmlPath": "/index.html",
  "canvasSelector": "#fluidCanvas",
  "viewport": {
    "width": 1920,
    "height": 1080,
    "deviceScaleFactor": 1
  },
  "captureFrames": {
    "warmupFrames": 6,
    "sampleFrames": 180,
    "pinnedFrameNumbers": [30, 90, 180],
    "deterministicClockHz": 60
  },
  "launchPolicy": {
    "headless": false,
    "sandbox": "enabled",
    "displayedSurfaceRequired": true,
    "commonBrowserArgs": [
      "--enable-unsafe-webgpu",
      "--ignore-gpu-blocklist"
    ],
    "platformBrowserArgs": {
      "linux": [
        "--use-angle=vulkan",
        "--enable-features=Vulkan"
      ],
      "darwin": [
        "--use-angle=metal"
      ]
    },
    "forbiddenBrowserArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-vulkan-surface",
      "--headless",
      "--headless=new"
    ]
  },
  "pinnedModuleRoutes": []
