{
  "schemaVersion": 2,
  "artifactKind": "external-project-harness",
  "actorId": "electronicarts-gigi",
  "harnessId": "generated-webgpu-suite",
  "upstream": {
    "repositoryUrl": "https://github.com/electronicarts/gigi",
    "commit": "401386cfd7c6e39e549d939e44d99bd5b49cd14d",
    "license": {
      "identifier": "LicenseRef-EA-BSD-3-Clause-With-Marks",
      "evidenceUrl": "https://github.com/electronicarts/gigi/blob/401386cfd7c6e39e549d939e44d99bd5b49cd14d/LICENSE.txt"
    }
  },
  "providerSubstitution": {
    "baselineProvider": "dawn-node-webgpu",
    "comparisonProvider": "doe-gpu",
    "seam": "A Node ESM loader resolves only Gigi's imports of webgpu to the selected provider module; generated workloads, shaders, assets, and validation logic are unchanged.",
    "patchPaths": []
  },
  "fallbackPolicy": {
    "requireHardware": true,
    "prohibitedFallbacks": ["cpu", "mock", "software-renderer", "unknown-provider"],
    "providerIdentityAssertion": "A provider probe records the exact selected module and adapter identity before any case; software adapters make the run diagnostic and promotion-ineligible."
  },
  "workload": {
    "command": ["node", "bench/external-projects/electronicarts-gigi/run-suite.mjs"],
    "immutableInputRefs": [
      "bench/external-projects/electronicarts-gigi/oracle.md"
    ],
    "oracle": {
      "kind": "upstream",
      "path": "bench/external-projects/electronicarts-gigi/oracle.md",
      "reviewStatus": "reviewed"
    },
    "sameWorkPolicy": "Both providers execute every selected generated index.js from the pinned suite in a clean Node process, from the original case directory, against the same generated modules, assets, shaders, and upstream validation logic.",
    "completionBoundary": "A case ends only when its Node process exits after queue completion, readback, and upstream validation, or when the governed timeout terminates it."
  },
  "requiredMeasurements": [
    "clean-process-success",
    "crashes",
    "hangs",
    "timeouts",
    "peak-memory-bytes",
    "cold-p50",
    "cold-p95",
    "cold-p99",
    "warm-p50",
    "warm-p95",
    "warm-p99",
    "receipt-overhead"
  ],
  "requiredReceiptFields": [
    "provider-identity",
    "adapter-identity",
    "driver-identity",
    "shader-hashes",
    "dispatch-shape",
    "synchronization",
    "readback",
    "output-identity"
  ],
  "installation": {
    "substitutionMode": "esm-loader",
    "productionStatus": "harness-only",
    "applicationSourceUnchanged": true,
    "shaderSourceUnchanged": true,
    "installCommand": ["npm", "install", "webgpu", "pngjs"],
    "validationCommand": ["node", "bench/external-projects/electronicarts-gigi/run-suite.mjs"]
  },
  "supportTargets": [],
  "reliabilityPolicy": {
    "cleanProcessRunsPerProvider": 50,
    "concurrencyLevel": 1,
    "concurrencyRunsPerProvider": 0,
    "teardownCyclesPerProvider": 50,
    "stressIterationsPerProvider": 50,
    "processTimeoutSeconds": 120,
    "memoryGrowthBoundaryBytes": 0,
    "requireZeroCrashes": true,
    "requireZeroHangs": true,
    "requireZeroTimeouts": true
  },
  "performancePolicy": {
    "timingScope": "clean Node process start through upstream validation and process exit",
    "coldSamplesPerProvider": 50,
    "warmupSamplesPerProvider": 0,
    "warmSamplesPerProvider": 50,
    "requiredPercentiles": ["p50", "p95", "p99"],
    "throughputMetric": "oracle-passing generated cases per second",
    "minimumMaterialSpeedupRatio": 1.1,
    "maximumRegressionRatio": 1.05
  },
  "receiptPolicy": {
    "captureRequired": true,
    "replayRequired": false,
    "runtimeBuildIdentityRequired": true
  },
  "releasePolicy": {
    "promotionState": "not-promoted",
    "blocking": false,
    "command": ["node", "bench/external-projects/electronicarts-gigi/run-suite.mjs", "--require-all-pass"],
    "promotionReportIds": []
  }
}
