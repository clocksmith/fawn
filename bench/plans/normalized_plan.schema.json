{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe normalized benchmark plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planKind",
    "workloadId",
    "irPath",
    "irScenario",
    "commandCount",
    "bufferWriteCount",
    "dispatchCount",
    "sourceIrSha256",
    "compatibilityCommandsSha256",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "planKind": {
      "type": "string",
      "minLength": 1
    },
    "workloadId": {
      "type": "string",
      "minLength": 1
    },
    "irPath": {
      "type": "string",
      "minLength": 1
    },
    "irScenario": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "planPath": {
      "type": "string",
      "minLength": 1
    },
    "commandsPath": {
      "type": "string",
      "minLength": 1
    },
    "matmulGemvVariant": {
      "type": "string",
      "enum": [
        "row2_helper_exact"
      ]
    },
    "commandCount": {
      "type": "integer",
      "minimum": 0
    },
    "bufferWriteCount": {
      "type": "integer",
      "minimum": 0
    },
    "bufferLoadCount": {
      "type": "integer",
      "minimum": 0
    },
    "dispatchCount": {
      "type": "integer",
      "minimum": 0
    },
    "sourceIrSha256": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityCommandsSha256": {
      "type": "string",
      "minLength": 1
    },
    "planSha256": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind"
        ],
        "properties": {
          "output_oracle": {
            "$ref": "#/$defs/outputOracle"
          }
        }
      }
    }
  },
  "$defs": {
    "outputOracle": {
      "oneOf": [
        { "$ref": "#/$defs/outputOracleV1" },
        { "$ref": "#/$defs/outputOracleV2" },
        { "$ref": "#/$defs/outputOracleV3" }
      ]
    },
    "outputOracleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "initialization",
        "binding_group",
        "binding",
        "dispatch_count",
        "expected_sha256",
        "reference_id"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "sha256_exact_v1" },
        "initialization": { "type": "string", "const": "zero_fill_v1" },
        "binding_group": { "type": "integer", "minimum": 0 },
        "binding": { "type": "integer", "minimum": 0 },
        "dispatch_count": { "type": "integer", "minimum": 1 },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_id": { "type": "string", "minLength": 1 }
      }
    },
    "outputOracleV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "reference_class",
        "kind",
        "initialization",
        "binding_group",
        "binding",
        "dispatch_count",
        "expected_sha256",
        "reference_id"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 2 },
        "scope": { "type": "string", "const": "command_graph" },
        "reference_class": {
          "type": "string",
          "enum": ["independent_v1", "cross_runtime_consensus_v1"]
        },
        "kind": { "type": "string", "const": "sha256_exact_v1" },
        "initialization": { "type": "string", "const": "zero_fill_v1" },
        "binding_group": { "type": "integer", "minimum": 0 },
        "binding": { "type": "integer", "minimum": 0 },
        "dispatch_count": { "type": "integer", "minimum": 1 },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_id": { "type": "string", "minLength": 1 }
      }
    },
    "outputOracleV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "reference_class",
        "kind",
        "initialization",
        "binding_group",
        "binding",
        "dispatch_count",
        "reference_sha256",
        "reference_id",
        "reference_path",
        "absolute_tolerance",
        "relative_tolerance"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 3 },
        "scope": { "type": "string", "const": "command_graph" },
        "reference_class": { "type": "string", "const": "independent_v1" },
        "kind": { "type": "string", "const": "float32_reference_tolerance_v1" },
        "initialization": { "type": "string", "const": "zero_fill_v1" },
        "binding_group": { "type": "integer", "minimum": 0 },
        "binding": { "type": "integer", "minimum": 0 },
        "dispatch_count": { "type": "integer", "minimum": 1 },
        "reference_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_id": { "type": "string", "minLength": 1 },
        "reference_path": { "type": "string", "minLength": 1 },
        "absolute_tolerance": { "type": "number", "minimum": 0 },
        "relative_tolerance": { "type": "number", "minimum": 0 }
      }
    }
  }
}
