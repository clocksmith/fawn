{
  "schemaVersion": 1,
  "workdir": "bench/vendor/dawn/third_party/webgpu-cts",
  "commandTemplate": "node tools/run_node --gpu-provider {repo_root}/bench/cts/fawn-node-gpu-provider.cjs {query}",
  "requireTextSummary": true,
  "identityProbe": {
    "commandTemplate": "node {repo_root}/bench/cts/probe-fawn-node-adapter.cjs",
    "required": true
  },
  "requiredPaths": [
    "node_modules/ts-node",
    "node_modules/typescript"
  ],
  "requirementsNote": "The pinned WebGPU CTS submodule and its npm dependencies must be materialized.",
  "queries": [
    {
      "id": "subgroup_add_uniform_u32",
      "bucket": "subgroup_execution",
      "query": "webgpu:shader,execution,expression,call,builtin,subgroupAdd:data_types:type=%22u32%22",
      "notes": "Uniform integer reduction and scan execution across the CTS workgroup-size matrix."
    },
    {
      "id": "subgroup_add_predicated",
      "bucket": "subgroup_execution",
      "query": "webgpu:shader,execution,expression,call,builtin,subgroupAdd:compute,split:*",
      "notes": "Active-invocation semantics for subgroup reductions and scans."
    }
  ]
}
