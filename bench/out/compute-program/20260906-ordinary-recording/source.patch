diff --git a/runtime/zig/src/contracts/command_recording.zig b/runtime/zig/src/contracts/command_recording.zig
new file mode 100644
index 000000000..bcdff899e
--- /dev/null
+++ b/runtime/zig/src/contracts/command_recording.zig
@@ -0,0 +1,13 @@
+pub const Failure = error{ OutOfMemory, InvalidState, InvalidArgument };
+
+pub const State = union(enum) {
+    open,
+    failed: Failure,
+    finished,
+
+    pub fn fail(self: *State, cause: Failure) bool {
+        if (self.* == .failed) return false;
+        self.* = .{ .failed = cause };
+        return true;
+    }
+};
