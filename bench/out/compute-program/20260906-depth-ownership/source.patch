+    parent.generation = 1;
+    parent.image = 1;
+    var view = parent;
+    view.parent_handle = 2;
+    view.parent_generation = parent.generation;
+    try std.testing.expect(texture_view_matches_parent(view, 2, parent));
+    try std.testing.expect(!texture_view_matches_parent(view, 3, parent));
+    parent.generation += 1;
+    try std.testing.expect(!texture_view_matches_parent(view, 2, parent));
+    view.parent_generation = parent.generation;
+    parent.image += 1;
+    try std.testing.expect(!texture_view_matches_parent(view, 2, parent));
