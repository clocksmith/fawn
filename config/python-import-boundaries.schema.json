{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe Python import boundaries",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protectedPaths", "legacyDirectScriptRoots"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legacyDirectScriptRoots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
