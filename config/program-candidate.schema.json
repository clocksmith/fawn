{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded compute program candidate job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "program",
    "candidateShaderId",
    "reference",
    "dependencies",
    "cases",
    "oracle",
    "limits",
    "sampling",
    "performance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidateShaderId": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputs",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "hash"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absoluteTolerance",
        "relativeTolerance",
        "expectedFormat",
        "outputFormat"
      ],
      "properties": {
        "absoluteTolerance": {
          "type": "number",
          "minimum": 0
        },
        "relativeTolerance": {
          "type": "number",
          "minimum": 0
        },
        "expectedFormat": {
          "const": "float64-le"
        },
        "outputFormat": {
          "const": "float32-le"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobTimeoutMs",
        "requestTimeoutMs",
        "maximumShaderBytes",
        "maximumDeclaredBufferBytes",
        "maximumWorkgroups",
        "maximumDispatches",
        "maximumHeapMiB",
        "maximumProcessOutputBytes",
        "maximumFixtureBytes"
      ],
      "properties": {
        "jobTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumShaderBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumDeclaredBufferBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumWorkgroups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumDispatches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumHeapMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumProcessOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumFixtureBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmupRuns",
        "timedRuns",
        "percentileMethod"
      ],
      "properties": {
        "warmupRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "timedRuns": {
          "type": "integer",
          "minimum": 20,
          "maximum": 9007199254740991
        },
        "percentileMethod": {
          "const": "nearest-rank"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumP50Ratio",
        "minimumP95Ratio",
        "maximumPreparationRecoveryRuns"
      ],
      "properties": {
        "minimumP50Ratio": {
          "type": "number",
          "minimum": 1
        },
        "minimumP95Ratio": {
          "type": "number",
          "minimum": 1
        },
        "maximumPreparationRecoveryRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
