{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "inventory"
        ]
      }
    }
  ],
  "properties": {
    "comparisonViews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "minLength": 1,
            "type": "string"
          },
          "comparison": {
            "minLength": 1,
            "type": "string"
          },
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "providerSet": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "providerSet",
          "displayName",
          "baseline",
          "comparison"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "hostProfiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "arch": {
            "minLength": 1,
            "type": "string"
          },
          "backend": {
            "minLength": 1,
            "type": "string"
          },
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "gpuVendor": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "os": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "os",
          "arch"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "inventory": {
      "additionalProperties": false,
      "properties": {
        "adapterSections": {
          "additionalProperties": false,
          "properties": {
            "application": {
              "items": {
                "enum": [
                  "application",
                  "compiler"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "browser-fresh-launch": {
              "items": {
                "enum": [
                  "browser-integration"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "compare-report": {
              "items": {
                "enum": [
                  "native-runtime",
                  "application",
                  "browser-integration"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "native-catalog": {
              "items": {
                "enum": [
                  "native-runtime"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "phase-cohort": {
              "items": {
                "enum": [
                  "native-runtime"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "workspace": {
              "items": {
                "enum": [
                  "workspace"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "native-catalog",
            "phase-cohort",
            "browser-fresh-launch",
            "workspace",
            "compare-report",
            "application"
          ],
          "type": "object"
        },
        "adapters": {
          "additionalProperties": false,
          "properties": {
            "application": {
              "const": 1
            },
            "browser-fresh-launch": {
              "const": 1
            },
            "compare-report": {
              "const": 1
            },
            "native-catalog": {
              "const": 1
            },
            "phase-cohort": {
              "const": 1
            },
            "workspace": {
              "const": 1
            }
          },
          "required": [
            "native-catalog",
            "phase-cohort",
            "browser-fresh-launch",
            "workspace",
            "compare-report",
            "application"
          ],
          "type": "object"
        },
        "catalogClassification": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "comparisonTypes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "currentSelection": {
          "additionalProperties": false,
          "properties": {
            "currentSource": {
              "const": "exact-source-and-known-binary-only"
            },
            "latestMeasured": {
              "const": "all-recorded-executions-including-failures"
            },
            "latestQualified": {
              "const": "explicit-scope-bound-passing-qualification"
            },
            "tieBreak": {
              "const": "explicit-supersession-then-stable-row-id"
            },
            "timestamp": {
              "const": "executedAt"
            },
            "unknownDates": {
              "const": "retain-without-recency"
            }
          },
          "required": [
            "timestamp",
            "unknownDates",
            "latestMeasured",
            "latestQualified",
            "tieBreak",
            "currentSource"
          ],
          "type": "object"
        },
        "currentSourcePaths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "grouping": {
          "additionalProperties": false,
          "properties": {
            "artifactFields": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "seriesFields": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "unknownContractRule": {
              "const": "isolate-by-registration"
            },
            "unknownMachineRule": {
              "const": "isolate-by-registration-and-execution"
            }
          },
          "required": [
            "seriesFields",
            "artifactFields",
            "unknownMachineRule",
            "unknownContractRule"
          ],
          "type": "object"
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "schemaVersion",
        "adapters",
        "comparisonTypes",
        "grouping",
        "currentSelection",
        "currentSourcePaths",
        "catalogClassification",
        "adapterSections"
      ],
      "type": "object"
    },
    "products": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "products": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "surface": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "surface",
          "displayName",
          "products"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "providerSets": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "backend_native_providers",
                    "direct_plan_providers"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "sourceRegistryPath"
              ]
            }
          }
        ],
        "oneOf": [
          {
            "required": [
              "providers"
            ]
          },
          {
            "required": [
              "sourceRegistryPath"
            ]
          }
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "providers": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "sourceRegistryPath": {
            "const": "config/implementation-peers.json",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "enum": [
        2,
        3
      ]
    },
    "surfaces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "defaultMissingStatus": {
            "enum": [
              "unsupported",
              "unimplemented",
              "diagnostic",
              "comparable",
              "claimable"
            ],
            "type": "string"
          },
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "expectedHostProfiles": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "maturity": {
            "enum": [
              "primary",
              "secondary",
              "prototype"
            ],
            "type": "string"
          },
          "notes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "primarySupport": {
            "enum": [
              "backend",
              "node",
              "bun"
            ],
            "type": "string"
          },
          "products": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "workloadIdOverrides": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "propertyNames": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "workloadSets": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "id",
          "displayName",
          "maturity",
          "primarySupport",
          "defaultMissingStatus",
          "expectedHostProfiles",
          "products",
          "workloadSets",
          "notes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "workloadSets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "domains": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "domains"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "hostProfiles",
    "products",
    "surfaces",
    "workloadSets"
  ],
  "title": "Fawn Benchmark Cube Policy",
  "type": "object"
}
