{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fawn WebGPU CTS Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "lastUpdated",
    "ctsSource",
    "ctsRevision",
    "claimPolicy",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "artifactKind": { "type": "string", "const": "webgpu_cts_evidence" },
    "lastUpdated": { "type": "string" },
    "ctsSource": { "type": "string", "minLength": 1 },
    "ctsRevision": { "type": "string", "minLength": 1 },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "artifactKind",
        "claimLanguage",
        "diagnosticLanguage",
        "promotionRequirements",
        "allowedClaimStates"
      ],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "artifactKind": {
          "type": "string",
          "const": "webgpu_cts_conformance_claim_policy"
        },
        "claimLanguage": {
          "type": "string",
          "const": "diagnostic_until_full_published_pass_ledger"
        },
        "diagnosticLanguage": { "type": "string", "minLength": 1 },
        "promotionRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publishedSubsetReceipt",
            "backendSpecificPassLedger",
            "noFailingRequiredRows",
            "backendIdentityRequired",
            "artifactPathsRequired"
          ],
          "properties": {
            "publishedSubsetReceipt": { "type": "boolean", "const": true },
            "backendSpecificPassLedger": { "type": "boolean", "const": true },
            "noFailingRequiredRows": { "type": "boolean", "const": true },
            "backendIdentityRequired": { "type": "boolean", "const": true },
            "artifactPathsRequired": { "type": "boolean", "const": true }
          }
        },
        "allowedClaimStates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "allowed", "requirements"],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "diagnostic",
                  "subset_conformance",
                  "replacement_conformance"
                ]
              },
              "allowed": { "type": "boolean" },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "publishedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PublishedArtifact" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "bucket", "status", "surface", "host", "os", "backend", "artifactPath"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "bucket": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "not_run"]
          },
          "surface": {
            "type": "string",
            "enum": ["compute", "full", "browser", "package", "native"]
          },
          "host": { "type": "string", "minLength": 1 },
          "os": { "type": "string", "minLength": 1 },
          "backend": { "type": "string", "minLength": 1 },
          "artifactPath": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 2 } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["publishedArtifacts"] }
    }
  ],
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "AdapterInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "device", "description"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string" },
        "device": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "isFallbackAdapter": { "type": "boolean" },
        "subgroupMinSize": { "type": "integer", "minimum": 0 },
        "subgroupMaxSize": { "type": "integer", "minimum": 0 },
        "subgroupMatrixConfigs": { "type": "array" },
        "vendorID": { "type": "integer", "minimum": 0 },
        "deviceID": { "type": "integer", "minimum": 0 },
        "driverVersion": { "type": ["integer", "string"] }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactKind", "provider", "adapterInfo"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "artifactKind": {
          "type": "string",
          "const": "webgpu_cts_adapter_identity"
        },
        "provider": { "type": "string", "minLength": 1 },
        "adapterInfo": { "$ref": "#/$defs/AdapterInfo" }
      }
    },
    "PublishedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "identity"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Hash" },
        "identity": { "$ref": "#/$defs/Identity" }
      }
    }
  }
}
