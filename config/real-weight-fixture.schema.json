{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe real-weight fixture contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "artifactKind",
    "modelId",
    "bundle"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactKind": {
      "type": "string",
      "const": "doe_real_weight_fixture_contract"
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "bundle": {
      "type": "object"
    }
  }
}
