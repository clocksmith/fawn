{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe external project reproduction policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "upstreamRootTemplate",
    "runRootTemplate",
    "sourceCommandTimeoutSeconds",
    "workloadCommandTimeoutSeconds",
    "versionCommands",
    "hardwareProbes",
    "doePreparation",
    "gateCommands"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "policyId": { "$ref": "#/$defs/id" },
    "upstreamRootTemplate": {
      "type": "string",
      "const": "bench/out/external-projects/{actorId}/upstream"
    },
    "runRootTemplate": {
      "type": "string",
      "const": "bench/out/external-projects/{actorId}/{runId}"
    },
    "sourceCommandTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "workloadCommandTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "versionCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "hardwareProbes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "darwin", "win32"],
      "properties": {
        "linux": { "$ref": "#/$defs/hardwareProbe" },
        "darwin": { "$ref": "#/$defs/hardwareProbe" },
        "win32": { "$ref": "#/$defs/hardwareProbe" }
      }
    },
    "doePreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commonCommands", "platformCommands", "commonArtifacts", "platformArtifacts"],
      "properties": {
        "commonCommands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "platformCommands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "darwin", "win32"],
          "properties": {
            "linux": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/command" }
            },
            "darwin": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/command" }
            },
            "win32": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/command" }
            }
          }
        },
        "commonArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "platformArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "darwin", "win32"],
          "properties": {
            "linux": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/artifact" }
            },
            "darwin": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/artifact" }
            },
            "win32": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    },
    "gateCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^{}]+$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "workingDirectory", "timeoutSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "workingDirectory": { "$ref": "#/$defs/repoPath" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "hardwareProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "requiredPatterns", "prohibitedPatterns"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "requiredPatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/repoPath" }
      }
    }
  }
}
