{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.local/schemas/doe-product-strategy.schema.json",
  "title": "Doe technical strategy contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "strategyVersion", "artifactKind", "authority", "independenceBoundary", "surfaces", "comparisonLaw", "evidenceSpine", "platformSequence", "roadmapProofs", "claimBoundary", "reusableProgram", "developmentEffectiveness", "fawnWorkspace"],
  "properties": {
    "$schema": { "type": "string", "const": "doe-product-strategy.schema.json" },
    "schemaVersion": { "type": "integer", "const": 15 },
    "strategyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifactKind": { "type": "string", "const": "doe-product-strategy" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "strategy", "runtimeOwnership", "support", "currentClaims"],
      "properties": {
        "goals": { "$ref": "#/$defs/path" },
        "strategy": { "$ref": "#/$defs/path" },
        "runtimeOwnership": { "$ref": "#/$defs/path" },
        "support": { "$ref": "#/$defs/path" },
        "currentClaims": { "$ref": "#/$defs/path" }
      }
    },
    "developmentEffectiveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "start",
        "stop",
        "recordingRule",
        "engineeringRule"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "const": "reproduction-to-verified-improvement"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "stop": {
          "type": "string",
          "minLength": 1
        },
        "recordingRule": {
          "type": "string",
          "minLength": 1
        },
        "engineeringRule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "independenceBoundary": { "$ref": "#/$defs/independenceBoundary" },
    "surfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/surface" },
      "allOf": [
        {
          "contains": {
            "properties": { "id": { "const": "doecompiler" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": { "const": "doeruntime" }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": { "const": "doeproof" }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": { "const": "fawn" }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": { "const": "doelab" }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "comparisonLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityPath",
        "lanes",
        "selectionOutcomes",
        "measurementAuthorityPath",
        "classes",
        "categories"
      ],
      "properties": {
        "authorityPath": {
          "$ref": "#/$defs/path"
        },
        "lanes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/comparisonLane"
          }
        },
        "selectionOutcomes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "doe-runtime",
              "incumbent",
              "dual"
            ]
          }
        },
        "measurementAuthorityPath": {
          "$ref": "#/$defs/path"
        },
        "classes": {
          "const": [
            "unchanged-application-replacement",
            "fixed-operation-or-shader"
          ]
        },
        "categories": {
          "description": "Provider attribution and complete-system alternatives are separate comparisons; only the first can isolate the provider.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": false,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "comparison", "authorityPath", "isolatesProvider"],
              "properties": {
                "id": { "const": "provider-attribution" },
                "comparison": { "const": "Doppler+Doe versus Doppler+Dawn" },
                "authorityPath": { "const": "docs/runtime-ownership-decision.md" },
                "isolatesProvider": { "const": true }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "comparison", "authorityPath", "isolatesProvider"],
              "properties": {
                "id": { "const": "alternative-complete-system" },
                "comparison": { "type": "string", "minLength": 1 },
                "authorityPath": { "const": "config/browser-product-comparison-policy.json#alternativeCompleteSystem" },
                "isolatesProvider": { "const": false }
              }
            }
          ]
        }
      }
    },
    "fawnWorkspace": { "$ref": "#/$defs/fawnWorkspace" },
    "evidenceSpine": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/evidencePrimitive" }
    },
    "platformSequence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/platformLane" }
    },
    "roadmapProofs": {
      "description": "The final objective and the three proofs that select current technical work.",
      "type": "object",
      "additionalProperties": false,
      "required": ["finalObjective", "currentStatement", "selectionRule", "proofs"],
      "properties": {
        "finalObjective": { "type": "string", "minLength": 1 },
        "currentStatement": { "type": "string", "minLength": 1 },
        "selectionRule": { "type": "string", "minLength": 1 },
        "proofs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": false,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/roadmapProof" }, { "properties": { "id": { "const": "current-doe-versus-dawn-initial-target" }, "order": { "const": 1 } } }] },
            { "allOf": [{ "$ref": "#/$defs/roadmapProof" }, { "properties": { "id": { "const": "current-metal-confirmation" }, "order": { "const": 2 } } }] },
            {
              "allOf": [
                { "$ref": "#/$defs/roadmapProof" },
                {
                  "required": ["arms", "claimRule", "contractPath"],
                  "properties": {
                    "id": { "const": "integrated-fawn-doe-versus-stock-chromium-dawn" },
                    "contractPath": { "const": "config/fawn-doe-integrated-comparison.json" },
                    "order": { "const": 3 },
                    "arms": { "const": ["stock-chromium-with-dawn", "fawn-workspace-with-dawn", "fawn-workspace-with-doe"] }
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbiddenInferences", "currentStateAuthority"],
      "properties": {
        "forbiddenInferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentStateAuthority": { "$ref": "#/$defs/path" }
      }
    },
    "reusableProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "descriptorSchemaPath",
        "evaluationPolicyPath",
        "initialScope",
        "demonstrationGate",
        "adoptionBoundary"
      ],
      "properties": {
        "contractPath": {
          "type": "string",
          "minLength": 1
        },
        "descriptorSchemaPath": {
          "type": "string",
          "minLength": 1
        },
        "evaluationPolicyPath": {
          "type": "string",
          "minLength": 1
        },
        "initialScope": {
          "type": "string",
          "minLength": 1
        },
        "demonstrationGate": {
          "type": "string",
          "minLength": 1
        },
        "adoptionBoundary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "roadmapProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "outcome", "requiredEvidence", "currentAssessment"],
      "properties": {
        "order": { "type": "integer" },
        "id": { "type": "string" },
        "outcome": { "type": "string", "minLength": 1 },
        "arms": { "type": "array", "items": { "type": "string" } },
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "claimRule": { "type": "string", "minLength": 1 },
        "contractPath": { "type": "string", "minLength": 1 },
        "currentAssessment": {
          "description": "Establishing a proof needs bound evidence and a schema change, never a label edit.",
          "const": "unestablished"
        }
      }
    },
    "fawnWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "statusPath",
        "charterPath",
        "implementationPath",
        "developmentTestsPath",
        "qualificationEvidence",
        "differentiationEvidence",
        "strongerControlEvidence",
        "compatibilityEvidence",
        "implementationStatus",
        "currentAssessment",
        "requiresNativeRuntimeWins",
        "initialIntegration",
        "releaseAdmission",
        "steps"
      ],
      "properties": {
        "contractPath": {
          "const": "docs/fawn-workspace-contract.md"
        },
        "statusPath": {
          "const": "docs/status/fawn-workspace.md"
        },
        "charterPath": {
          "const": "browser/workspace/CATSCAN.md"
        },
        "implementationPath": {
          "const": "browser/workspace/src"
        },
        "developmentTestsPath": {
          "const": "browser/workspace/test"
        },
        "qualificationEvidence": {
          "description": "Admitted evidence the step assessments are bound to. bench/tests/test_fawn_workspace_strategy.py requires every requirement of an established step to be established in the admitted verdict for the named commit.",
          "type": "object",
          "additionalProperties": false,
          "required": ["caseSetPath", "validatorPath", "admittedVerdictPath", "comparisonPath", "sourceCommit", "comparisonSourceCommit", "scope"],
          "properties": {
            "caseSetPath": { "const": "config/fawn-workspace-qualification.json" },
            "validatorPath": { "const": "browser/workspace/qualification/validate.js" },
            "admittedVerdictPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/qualification/verdict\\.json$" },
            "comparisonPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/comparison/comparison\\.json$" },
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "comparisonSourceCommit": {
              "description": "Commit the scripted comparison ran; it stays bound to step 5's evidence when the service is requalified on later source.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "scope": {
              "description": "Admission covers the frozen case set on the recorded browser binary and host; it is not release qualification.",
              "const": "frozen-case-set-on-recorded-browser-and-host"
            }
          }
        },
        "differentiationEvidence": {
          "description": "The frozen differentiation result step 5 is bound to. The policy tests require a full result for the named commit whose frozen product-advantage rule passed, with no regression in the suite or the scripted comparison it names.",
          "type": "object",
          "additionalProperties": false,
          "required": ["suitePath", "resultPath", "scriptedComparisonPath", "sourceCommit", "scope"],
          "properties": {
            "suitePath": { "const": "config/browser-product-comparison-policy.json#workspaceComparison.differentiation" },
            "resultPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/differentiation/differentiation\\.json$" },
            "scriptedComparisonPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/comparison/comparison\\.json$" },
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "scope": {
              "description": "Advantage over Playwright agent tooling on the frozen workbench suite only; not broad product superiority, compatibility beyond the fixture or release qualification.",
              "const": "frozen-differentiation-suite-against-playwright-agent-tooling"
            }
          }
        },
        "strongerControlEvidence": {
          "description": "The second frozen suite: a different application against Playwright agent tooling that revalidates decisions before mutating and cancels pending calls on human takeover. It records which areas survive that control; it narrows, never widens, step 5's scope.",
          "type": "object",
          "additionalProperties": false,
          "required": ["suitePath", "resultPath", "sourceCommit", "scope"],
          "properties": {
            "suitePath": { "const": "config/browser-product-comparison-policy.json#workspaceComparison.revalidatedDifferentiation" },
            "resultPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/revalidated-differentiation/differentiation\\.json$" },
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "scope": { "const": "second-application-against-revalidating-playwright-agent-tooling" }
          }
        },
        "compatibilityEvidence": {
          "description": "Admitted runs of the frozen case set on further browser builds; compatibility evidence, not release qualification.",
          "type": "object",
          "additionalProperties": false,
          "required": ["builds", "scope"],
          "properties": {
            "builds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["channel", "headless", "verdictPath", "sourceCommit"],
                "properties": {
                  "channel": { "enum": ["chromium", "chrome"] },
                  "headless": { "type": "boolean" },
                  "verdictPath": { "type": "string", "pattern": "^reports/fawn-workspace/[0-9]{8}-[a-z0-9-]+/compatibility-[a-z-]+/verdict\\.json$" },
                  "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
                }
              }
            },
            "scope": { "const": "frozen-case-set-on-recorded-builds-not-release-qualification" }
          }
        },
        "implementationStatus": {
          "description": "Behavioral gates pass on admitted evidence for steps 1-4; product value and deeper capabilities are not established, and release admission stays blocked.",
          "const": "partially-implemented-behavior-qualified"
        },
        "currentAssessment": {
          "const": "unestablished"
        },
        "requiresNativeRuntimeWins": {
          "const": false
        },
        "initialIntegration": {
          "const": "stock-chromium-cdp-playwright"
        },
        "releaseAdmission": {
          "const": "blocked-until-implemented-and-independently-qualified"
        },
        "steps": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": false,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 1
                },
                "id": {
                  "const": "shared-workspace-service"
                },
                "dependsOn": {
                  "const": []
                },
                "implementationStatus": {
                  "const": "implemented-behavior-qualified"
                },
                "currentAssessment": {
                  "const": "established-on-frozen-case-set"
                },
                "requiredEvidence": {
                  "const": [
                    "persistent-workspace-identity",
                    "persistent-authorization",
                    "persistent-ownership-generation",
                    "persistent-observation-versions",
                    "persistent-action-records",
                    "narrow-cdp-playwright-adapters",
                    "workflow-logic-outside-shared-service"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 2
                },
                "id": {
                  "const": "observation-action-binding"
                },
                "dependsOn": {
                  "const": [
                    "shared-workspace-service"
                  ]
                },
                "implementationStatus": {
                  "const": "implemented-behavior-qualified"
                },
                "currentAssessment": {
                  "const": "established-on-frozen-case-set"
                },
                "requiredEvidence": {
                  "const": [
                    "versioned-observations-and-page-changes",
                    "workspace-owner-intent-target-observation-preconditions",
                    "dispatch-time-authorization-and-preconditions",
                    "reject-stale-or-unauthorized-actions",
                    "disclose-nonatomic-browser-external-boundary"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 3
                },
                "id": {
                  "const": "durable-ownership"
                },
                "dependsOn": {
                  "const": [
                    "observation-action-binding"
                  ]
                },
                "implementationStatus": {
                  "const": "implemented-behavior-qualified"
                },
                "currentAssessment": {
                  "const": "established-on-frozen-case-set"
                },
                "requiredEvidence": {
                  "const": [
                    "all-fawn-automated-mutations-through-dispatcher",
                    "serialize-handoff-admission-dispatch",
                    "durably-advance-generation-before-admission",
                    "invalidate-old-owner-queue",
                    "reject-stale-generation-after-restart",
                    "restore-authority-before-command-admission",
                    "handoff-outstanding-action-records",
                    "disclose-in-flight-external-effects"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 4
                },
                "id": {
                  "const": "uncertainty-recovery"
                },
                "dependsOn": {
                  "const": [
                    "durable-ownership"
                  ]
                },
                "implementationStatus": {
                  "const": "implemented-behavior-qualified"
                },
                "currentAssessment": {
                  "const": "established-on-frozen-case-set"
                },
                "requiredEvidence": {
                  "const": [
                    "persist-intent-before-dispatch",
                    "completed-failed-unknown-outcomes",
                    "prove-never-dispatched-separately",
                    "missing-completion-never-authorizes-resubmission",
                    "preserve-unknown-across-restart",
                    "reconcile-state-or-external-idempotency-or-human-review",
                    "local-action-id-is-not-external-idempotency"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 5
                },
                "id": {
                  "const": "reuse-and-product-value"
                },
                "dependsOn": {
                  "const": [
                    "uncertainty-recovery"
                  ]
                },
                "implementationStatus": {
                  "const": "implemented-compared"
                },
                "currentAssessment": {
                  "const": "advantaged-on-frozen-differentiation-suite"
                },
                "requiredEvidence": {
                  "const": [
                    "shared-service-document-research-form-submission-artifact-export",
                    "failure-before-dispatch-after-submission-before-acknowledgment",
                    "handoff-races-stale-queues-restart-outstanding-requests",
                    "identical-stale-rejection-and-unknown-preservation-for-every-adapter",
                    "competent-stock-chromium-playwright-baseline",
                    "task-success-incorrect-actions-recovery-observation-volume-latency-overhead-integration-effort"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "id",
                "dependsOn",
                "implementationStatus",
                "currentAssessment",
                "requiredEvidence"
              ],
              "properties": {
                "order": {
                  "const": 6
                },
                "id": {
                  "const": "selective-deeper-capabilities"
                },
                "dependsOn": {
                  "const": [
                    "reuse-and-product-value"
                  ]
                },
                "implementationStatus": {
                  "const": "not-implemented"
                },
                "currentAssessment": {
                  "const": "unestablished"
                },
                "requiredEvidence": {
                  "const": [
                    "chromium-hooks-and-runtime-integration-require-measured-benefits-justifying-compatibility-and-maintenance-costs",
                    "doppler-owns-model-semantics",
                    "doeruntime-explicit-integration-independent-qualification",
                    "doelab-offline-improvements",
                    "doeproof-adoption-evidence",
                    "fawn-remains-integrated-product"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "independenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "requiredEvidence"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "requiredEvidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "job", "promotionGate", "authorityPaths"],
      "properties": {
        "id": { "type": "string", "enum": ["doecompiler","doeproof","doeruntime","fawn","doelab"] },
        "job": { "type": "string", "minLength": 1 },
        "promotionGate": { "type": "string", "minLength": 1 },
        "authorityPaths": { "$ref": "#/$defs/pathList" }
      }
    },
    "comparisonLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executor", "governance", "conditional"],
      "properties": {
        "id": { "type": "string", "enum": ["I0","I1","W0","D0","P0"] },
        "executor": { "type": "string", "minLength": 1 },
        "governance": { "type": "string", "minLength": 1 },
        "conditional": { "type": "boolean" }
      }
    },
    "evidencePrimitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalJob", "ownerPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "canonicalJob": { "type": "string", "minLength": 1 },
        "ownerPaths": { "$ref": "#/$defs/pathList" }
      }
    },
    "platformLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "purpose", "supportAuthorityPath", "inheritsPromotion"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "id": { "type": "string", "enum": ["amd-vulkan","apple-metal","windows-d3d12"] },
        "purpose": { "type": "string", "minLength": 1 },
        "supportAuthorityPath": { "$ref": "#/$defs/path" },
        "inheritsPromotion": { "type": "boolean", "const": false },
        "initialQualificationTarget": { "$ref": "#/$defs/initialQualificationTarget" }
      }
    },
    "initialQualificationTarget": {
      "description": "One frozen machine selected as the initial engineering target; never a qualified or supported configuration by itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "hostProfileId", "hostProfilePath", "hostRecordPath", "qualificationState", "existingEvidenceScope", "memoryAccounting"],
      "properties": {
        "label": { "const": "initial qualification target" },
        "hostProfileId": { "type": "string", "minLength": 1 },
        "hostProfilePath": { "const": "config/vulkan-host-profiles.json" },
        "hostRecordPath": { "$ref": "#/$defs/path" },
        "qualificationState": { "const": "unqualified-until-applicable-acceptance-passes" },
        "existingEvidenceScope": { "const": "recorded-coverage-only" },
        "memoryAccounting": { "const": ["system-ram", "gpu-allocation-limits", "measured-residency"] }
      }
    }
  }
}
