{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.local/schemas/doe-product-strategy.schema.json",
  "title": "Doe product strategy contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "strategyVersion",
    "artifactKind",
    "authority",
    "positioning",
    "surfaces",
    "commercialOffer",
    "comparisonLaw",
    "evidenceSpine",
    "customerEvidencePolicy",
    "platformSequence",
    "milestones",
    "claimBoundary"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "doe-product-strategy.schema.json" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "strategyVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifactKind": { "type": "string", "const": "doe-product-strategy" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "strategy", "runtimeOwnership", "support", "currentClaims"],
      "properties": {
        "goals": { "$ref": "#/$defs/path" },
        "strategy": { "$ref": "#/$defs/path" },
        "runtimeOwnership": { "$ref": "#/$defs/path" },
        "support": { "$ref": "#/$defs/path" },
        "currentClaims": { "$ref": "#/$defs/path" }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "promise", "governingQuestion", "operatingLaw"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "governingQuestion": { "type": "string", "minLength": 1 },
        "operatingLaw": { "type": "string", "minLength": 1 }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/surface" }
    },
    "commercialOffer": { "$ref": "#/$defs/commercialOffer" },
    "comparisonLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityPath", "lanes", "selectionOutcomes"],
      "properties": {
        "authorityPath": { "$ref": "#/$defs/path" },
        "lanes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/comparisonLane" }
        },
        "selectionOutcomes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["doe-runtime", "incumbent", "dual"]
          }
        }
      }
    },
    "evidenceSpine": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/evidencePrimitive" }
    },
    "customerEvidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultRule", "classes"],
      "properties": {
        "defaultRule": { "type": "string", "minLength": 1 },
        "classes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/evidenceClass" }
        }
      }
    },
    "platformSequence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/platformLane" }
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/milestone" }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbiddenInferences", "currentStateAuthority"],
      "properties": {
        "forbiddenInferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentStateAuthority": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "portfolioRole", "marketRole", "job", "promotionGate", "authorityPaths"],
      "properties": {
        "id": { "type": "string", "enum": ["doeproof", "doeruntime", "fawn", "doelab"] },
        "portfolioRole": {
          "type": "string",
          "enum": ["product-vector", "enabling-capability", "operating-model"]
        },
        "marketRole": {
          "type": "string",
          "enum": ["commercial-wedge", "selective-execution", "breakout-distribution", "learning-loop"]
        },
        "job": { "type": "string", "minLength": 1 },
        "promotionGate": { "type": "string", "minLength": 1 },
        "authorityPaths": { "$ref": "#/$defs/pathList" }
      }
    },
    "commercialOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "deliveryMode",
        "promise",
        "buyers",
        "intake",
        "deliverables",
        "acceptance",
        "ciDecision",
        "requalificationTriggers",
        "commercialPromotionGate"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "deliveryMode": { "type": "string", "const": "shadow-governance-first" },
        "promise": { "type": "string", "minLength": 1 },
        "buyers": { "$ref": "#/$defs/stringList" },
        "intake": { "$ref": "#/$defs/stringList" },
        "deliverables": { "$ref": "#/$defs/stringList" },
        "acceptance": { "$ref": "#/$defs/stringList" },
        "ciDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "outcomes", "failureBehavior"],
          "properties": {
            "mode": { "type": "string", "const": "blocking" },
            "outcomes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["qualify", "reject", "requalify"] }
            },
            "failureBehavior": { "type": "string", "minLength": 1 }
          }
        },
        "requalificationTriggers": { "$ref": "#/$defs/stringList" },
        "commercialPromotionGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredOutcome", "currentAssessment"],
          "properties": {
            "requiredOutcome": { "type": "string", "minLength": 1 },
            "currentAssessment": { "type": "string", "const": "unestablished" }
          }
        }
      }
    },
    "comparisonLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executor", "governance", "conditional"],
      "properties": {
        "id": { "type": "string", "enum": ["I0", "I1", "W0", "D0", "P0"] },
        "executor": { "type": "string", "minLength": 1 },
        "governance": { "type": "string", "minLength": 1 },
        "conditional": { "type": "boolean" }
      }
    },
    "evidencePrimitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalJob", "ownerPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "canonicalJob": { "type": "string", "minLength": 1 },
        "ownerPaths": { "$ref": "#/$defs/pathList" }
      }
    },
    "evidenceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "crossProductRule"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "customer-content",
            "customer-derived",
            "sanitized-runtime-failure",
            "reproducible-backend-defect"
          ]
        },
        "crossProductRule": {
          "type": "string",
          "enum": ["never-by-default", "explicit-authorization", "sanitized-only", "reproducible-evidence-only"]
        }
      }
    },
    "platformLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "purpose", "supportAuthorityPath", "inheritsPromotion"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "id": { "type": "string", "enum": ["amd-vulkan", "apple-metal", "windows-d3d12"] },
        "purpose": { "type": "string", "minLength": 1 },
        "supportAuthorityPath": { "$ref": "#/$defs/path" },
        "inheritsPromotion": { "type": "boolean", "const": false }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "outcome", "requiredEvidence", "currentAssessment", "stateAuthorityPaths"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "id": {
          "type": "string",
          "enum": ["release-passport-v1", "owned-capability-v1", "fawn-agent-compute-v1"]
        },
        "outcome": { "type": "string", "minLength": 1 },
        "requiredEvidence": { "$ref": "#/$defs/stringList" },
        "currentAssessment": { "type": "string", "enum": ["unestablished", "diagnostic", "claimable"] },
        "stateAuthorityPaths": { "$ref": "#/$defs/pathList" }
      }
    }
  }
}
