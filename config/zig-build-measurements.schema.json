{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zig build edit measurements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildStep",
    "optimize",
    "snapshotRoots",
    "edits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "buildStep": {
      "type": "string",
      "minLength": 1
    },
    "optimize": {
      "enum": [
        "Debug",
        "ReleaseSafe",
        "ReleaseFast",
        "ReleaseSmall"
      ]
    },
    "snapshotRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
