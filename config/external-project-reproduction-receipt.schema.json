{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe external project reproduction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "generatedAt",
    "actorId",
    "harnessId",
    "runId",
    "status",
    "evidenceMaturity",
    "failure",
    "contracts",
    "preparation",
    "workload",
    "evidence",
    "gates",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": {
      "type": "string",
      "const": "external-project-reproduction-receipt"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "actorId": { "$ref": "#/$defs/id" },
    "harnessId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/runId" },
    "status": { "type": "string", "enum": ["passed", "failed", "unavailable"] },
    "evidenceMaturity": { "type": "string", "enum": ["diagnostic", "claimable-candidate"] },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "contracts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "claimEligible"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "type": "string", "enum": ["passed", "failed", "unavailable"] },
        "claimEligible": { "type": "boolean" }
      }
    },
    "workload": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/process" }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/process" }
    },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1 },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "sizeBytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "workingDirectory",
        "exitCode",
        "elapsedNs",
        "stdoutPath",
        "stdoutSha256",
        "stderrPath",
        "stderrSha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "workingDirectory": { "$ref": "#/$defs/path" },
        "exitCode": { "type": "integer" },
        "elapsedNs": { "type": "integer", "minimum": 0 },
        "stdoutPath": { "$ref": "#/$defs/path" },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrPath": { "$ref": "#/$defs/path" },
        "stderrSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
