{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fawn://config/browser-release-artifact-bundle.schema.json",
  "title": "Browser release artifact bundle",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["releaseStatus"],
        "properties": {
          "releaseStatus": { "const": "release_candidate" }
        }
      },
      "then": {
        "required": [
          "releaseArchive",
          "browserProduct",
          "platform",
          "packageInputs",
          "browserExecutableArchivePath",
          "browserAppMetadataArchivePath",
          "doeRuntimeArchivePath",
          "dawnFallbackRuntimeArchivePath",
          "dawnFallbackRuntime",
          "releaseArchiveManifest",
          "proofSurface",
          "proofSurfaceCheck",
          "publicDownloadReceipt",
          "browserLaunchReceipt",
          "chromiumSourceCheckout",
          "runtimeFrontierBundle"
        ],
        "properties": {
          "releaseArchive": {
            "allOf": [
              { "$ref": "#/$defs/Artifact" },
              { "required": ["downloadUrl"] }
            ]
          },
          "browserProduct": {
            "allOf": [
              { "$ref": "#/$defs/BrowserProduct" },
              {
                "properties": {
                  "channel": { "const": "release_candidate" }
                }
              }
            ]
          },
          "platform": {
            "oneOf": [
              {
                "properties": {
                  "os": { "const": "macos" },
                  "arch": { "const": "arm64" },
                  "packageFormat": { "const": "zip" }
                }
              },
              {
                "properties": {
                  "os": { "const": "linux" },
                  "arch": { "const": "x64" },
                  "packageFormat": { "const": "zip" }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "artifactKind",
    "bundleId",
    "releaseStatus",
    "browserBinary",
    "doeRuntime",
    "shaderCompiler",
    "contracts",
    "claimReports",
    "promotionReceipts",
    "policies",
    "failureCodes"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "browser_release_artifact_bundle" },
    "bundleId": { "type": "string", "minLength": 1 },
    "releaseStatus": { "enum": ["diagnostic", "release_candidate"] },
    "releaseArchive": { "$ref": "#/$defs/Artifact" },
    "browserProduct": { "$ref": "#/$defs/BrowserProduct" },
    "platform": { "$ref": "#/$defs/Platform" },
    "packageInputs": {
      "allOf": [
        { "$ref": "#/$defs/Artifact" },
        {
          "properties": {
            "kind": { "const": "browser_release_package_inputs_check" }
          }
        }
      ]
    },
    "browserExecutableArchivePath": { "type": "string", "minLength": 1 },
    "browserAppMetadataArchivePath": { "type": "string", "minLength": 1 },
    "doeRuntimeArchivePath": { "type": "string", "minLength": 1 },
    "dawnFallbackRuntimeArchivePath": { "type": "string", "minLength": 1 },
    "releaseArchiveManifest": { "$ref": "#/$defs/Artifact" },
    "browserBinary": { "$ref": "#/$defs/Artifact" },
    "doeRuntime": { "$ref": "#/$defs/Artifact" },
    "dawnFallbackRuntime": { "$ref": "#/$defs/Artifact" },
    "shaderCompiler": { "$ref": "#/$defs/Artifact" },
    "proofSurface": { "$ref": "#/$defs/Artifact" },
    "proofSurfaceCheck": { "$ref": "#/$defs/Artifact" },
    "publicDownloadReceipt": { "$ref": "#/$defs/Artifact" },
    "browserLaunchReceipt": { "$ref": "#/$defs/Artifact" },
    "chromiumSourceCheckout": { "$ref": "#/$defs/Artifact" },
    "runtimeFrontierBundle": { "$ref": "#/$defs/Artifact" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Artifact" }
    },
    "claimReports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Artifact" }
    },
    "promotionReceipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Artifact" }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Artifact" }
    },
    "failureCodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/Failure" }
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Hash" },
        "kind": { "type": "string", "minLength": 1 },
        "downloadUrl": { "$ref": "#/$defs/PublicHttpsUrl" }
      }
    },
    "PublicHttpsUrl": {
      "type": "string",
      "pattern": "^https://[^/?#]+\\.[^/?#]+",
      "not": {
        "anyOf": [
          { "pattern": "^https://localhost(?::|/|$)" },
          { "pattern": "^https://(?:127\\.0\\.0\\.1|0\\.0\\.0\\.0|10\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.)(?::|/|$)" },
          { "pattern": "^https://\\[::1\\](?::|/|$)" },
          { "pattern": "^https://[^/?#]*\\.(?:local|localhost|test|example|invalid)(?::|/|$)" },
          { "pattern": "^https://(?:example\\.com|example\\.net|example\\.org)(?::|/|$)" }
        ]
      }
    },
    "Platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "packageFormat"],
      "properties": {
        "os": { "enum": ["macos", "linux", "windows"] },
        "arch": { "enum": ["arm64", "x64"] },
        "packageFormat": { "enum": ["zip"] }
      }
    },
    "BrowserProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "displayName", "version", "channel"],
      "properties": {
        "productId": { "enum": ["doe-browser", "fawn-doe"] },
        "displayName": { "enum": ["Doe Browser", "Fawn Doe"] },
        "version": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["diagnostic", "release_candidate", "release"] }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
