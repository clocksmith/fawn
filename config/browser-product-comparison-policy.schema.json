{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.local/schemas/browser-product-comparison-policy.schema.json",
  "title": "Browser product comparison policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyId",
    "authority",
    "noRegretTrunk",
    "internalCausalLanes",
    "externalComparators",
    "suites",
    "independenceTests",
    "forkAuthorities",
    "stopConditions",
    "evidenceReferences",
    "claimBoundary",
    "workspaceComparison",
    "alternativeCompleteSystem"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "browser-product-comparison-policy.schema.json" },
    "schemaVersion": { "type": "integer", "const": 9 },
    "policyId": { "type": "string", "const": "fawn-external-product-comparison-v9" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategyPath", "browserLanePath", "milestonePath", "claimStatePath"],
      "properties": {
        "strategyPath": { "$ref": "#/$defs/path" },
        "browserLanePath": { "$ref": "#/$defs/path" },
        "milestonePath": { "$ref": "#/$defs/path" },
        "claimStatePath": { "$ref": "#/$defs/path" }
      }
    },
    "noRegretTrunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "workItems"],
      "properties": {
        "definition": { "$ref": "#/$defs/text" },
        "workItems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workItem" }
        }
      }
    },
    "internalCausalLanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/internalLane" }
    },
    "externalComparators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/externalComparator" }
    },
    "suites": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/suite" }
    },
    "independenceTests": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/independenceTest" }
    },
    "forkAuthorities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/forkAuthority" }
    },
    "stopConditions": { "$ref": "#/$defs/stringList" },
    "evidenceReferences": { "$ref": "#/$defs/pathList" },
    "workspaceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "strategyPath",
        "control",
        "treatment",
        "scope",
        "requiresNativeRuntimeWins",
        "comparisonVersion",
        "runnerPath",
        "controlImplementationPath",
        "fixtureSitePath",
        "browserRuntime",
        "controlCapabilities",
        "equalOpportunities",
        "scenarios",
        "excludedScenarios",
        "measures",
        "criteria",
        "differentiation",
        "revalidatedDifferentiation",
        "modelDrivenDifferentiation"
      ],
      "properties": {
        "contractPath": {
          "const": "docs/fawn-workspace-contract.md"
        },
        "strategyPath": {
          "const": "config/doe-product-strategy.json#fawnWorkspace"
        },
        "control": {
          "const": "competent-stock-chromium-playwright"
        },
        "treatment": {
          "const": "same-browser-and-runtime-with-fawn-workspace-service"
        },
        "scope": {
          "const": "Prospective independent workflow comparison; existing A/B/C/D and K0 receipts retain their meanings and cannot satisfy it."
        },
        "requiresNativeRuntimeWins": {
          "const": false
        },
        "comparisonVersion": { "type": "string", "minLength": 1 },
        "runnerPath": { "const": "browser/workspace/qualification/compare.js" },
        "controlImplementationPath": { "const": "browser/workspace/qualification/baseline" },
        "fixtureSitePath": { "const": "browser/workspace/qualification/fixture-site.js" },
        "browserRuntime": {
          "description": "Treatment and control drive the same browser binary through the same driver.",
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "browser", "treatmentAdapter", "headless"],
          "properties": {
            "driver": { "const": "playwright-core" },
            "browser": { "const": "chromium-headless-shell" },
            "treatmentAdapter": { "const": "playwright" },
            "headless": { "type": "boolean" }
          }
        },
        "controlCapabilities": {
          "description": "Reasonable state handling the control keeps; removing one would cripple the baseline.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "allOf": [
            { "contains": { "const": "persistent-profile" } },
            { "contains": { "const": "durable-progress-file" } },
            { "contains": { "const": "origin-allowlist-including-form-actions" } },
            { "contains": { "const": "application-idempotency-reference" } },
            { "contains": { "const": "application-state-check-before-resubmission" } }
          ]
        },
        "equalOpportunities": { "$ref": "#/$defs/stringList" },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "workflow", "fault", "oracle", "repetitions"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "workflow": { "enum": ["research", "form", "export"] },
              "fault": { "enum": ["none", "kill-while-effect-held", "background-settle", "replace-target"] },
              "pagePath": { "type": "string", "pattern": "^/" },
              "treatmentRegions": { "$ref": "#/$defs/stringList" },
              "oracle": { "enum": ["research-findings", "single-receipt", "report-artifact", "no-replaced-artifact"] },
              "repetitions": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "excludedScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "measures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "taskSuccess",
              "incorrectActions",
              "recovery",
              "observationBytes",
              "completeTaskLatencyMs",
              "serviceOverheadMs",
              "integrationLines"
            ]
          },
          "minItems": 7
        },
        "criteria": {
          "description": "Frozen before execution. Success, safety and recovery differ materially whenever their counts differ; latency uses the median rule; the rest is reported, never decisive.",
          "type": "object",
          "additionalProperties": false,
          "required": ["latency", "materialWhenDifferent", "informativeOnly"],
          "properties": {
            "latency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statistic", "regressionRatio", "advantageRatio", "minimumDeltaMs"],
              "properties": {
                "statistic": { "const": "median" },
                "regressionRatio": { "type": "number", "exclusiveMinimum": 1 },
                "advantageRatio": { "type": "number", "exclusiveMaximum": 1, "exclusiveMinimum": 0 },
                "minimumDeltaMs": { "type": "integer", "minimum": 0 }
              }
            },
            "materialWhenDifferent": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["taskSuccess", "incorrectActions", "recovery"] },
              "minItems": 3
            },
            "informativeOnly": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["observationBytes", "serviceOverheadMs", "integrationLines"] }
            }
          }
        },
        "differentiation": { "$ref": "#/$defs/workspaceDifferentiation" },
        "revalidatedDifferentiation": { "$ref": "#/$defs/revalidatedDifferentiation" },
        "modelDrivenDifferentiation": { "$ref": "#/$defs/modelDrivenDifferentiation" }
      }
    },
    "alternativeCompleteSystem": {
      "description": "Ordinary Chromium plus a native inference engine as a complete-system alternative. It is separate from component comparisons and cannot attribute results to Doe's compiler or runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categoryId",
        "strategyPath",
        "treatment",
        "control",
        "separateFrom",
        "initialTargetPath",
        "matchedConditions",
        "recordedDifferences",
        "isolatesDoeCompiler",
        "isolatesDoeRuntime",
        "alternatives",
        "claimBoundary"
      ],
      "properties": {
        "categoryId": { "const": "alternative-complete-system" },
        "strategyPath": { "const": "config/doe-product-strategy.json#comparisonLaw" },
        "treatment": { "$ref": "#/$defs/text" },
        "control": { "const": "ordinary-chromium-plus-native-inference-engine" },
        "separateFrom": { "const": ["A", "B", "C", "D", "K0", "provider-attribution"] },
        "initialTargetPath": { "const": "config/doe-product-strategy.json#platformSequence/0/initialQualificationTarget" },
        "matchedConditions": {
          "const": ["task-quality", "context", "output-requirements", "concurrency", "resource-budgets"]
        },
        "recordedDifferences": { "const": ["quantization", "model-format", "backend", "engine-build"] },
        "isolatesDoeCompiler": { "const": false },
        "isolatesDoeRuntime": { "const": false },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/pinnedNativeEngine" },
              { "$ref": "#/$defs/candidateNativeEngine" }
            ]
          }
        },
        "claimBoundary": { "$ref": "#/$defs/text" }
      }
    },
    "claimBoundary": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "modelDrivenDifferentiation": {
      "description": "Frozen before implementation: one model drives both sides through identical tools on familiar and held-out applications, with inference cost counted. Prompts, tool descriptions and held-out specifications are pinned by hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteVersion", "status", "purpose", "runnerPath", "frozenArtifacts", "agent", "browserBinary", "control", "treatment",
        "sharedConditions", "repetitions", "workflows", "measures", "measurement", "improvementRequirements",
        "productAdvantageRule", "runPrerequisites", "knownControlLimits"
      ],
      "properties": {
        "suiteVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["frozen-before-implementation", "implemented-not-run", "run"] },
        "purpose": { "type": "string", "minLength": 1 },
        "runnerPath": { "const": "browser/workspace/qualification/differentiate.js" },
        "frozenArtifacts": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^browser/workspace/qualification/model-agent/[a-z-]+\\.(md|json)$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "sampling", "extendedThinking", "maxOutputTokensPerTurn", "maxTurnsPerTask",
            "maxInputTokensPerTask", "budgetExceeded", "identicalOnBothSides"],
          "properties": {
            "provider": { "const": "anthropic-messages-api" },
            "model": { "type": "string", "pattern": "^claude-[a-z0-9-]+$" },
            "sampling": {
              "type": "object",
              "additionalProperties": false,
              "required": ["temperature"],
              "properties": { "temperature": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "extendedThinking": { "type": "boolean" },
            "maxOutputTokensPerTurn": { "type": "integer", "minimum": 1 },
            "maxTurnsPerTask": { "type": "integer", "minimum": 1 },
            "maxInputTokensPerTask": { "type": "integer", "minimum": 1 },
            "budgetExceeded": { "const": "task-failure" },
            "identicalOnBothSides": {
              "type": "array",
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "model" } },
                { "contains": { "const": "tool-descriptions" } },
                { "contains": { "const": "token-budget" } }
              ]
            }
          }
        },
        "browserBinary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "version", "sha256"],
          "properties": {
            "channel": { "enum": ["chromium-headless-shell", "chromium", "chrome"] },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "observation", "actions", "revalidation", "takeover", "capabilities", "pendingEffects"],
          "properties": {
            "id": { "const": "playwright-agent-tooling-with-revalidation" },
            "observation": { "type": "string", "minLength": 1 },
            "actions": { "const": "aria-ref-locators-from-the-latest-snapshot" },
            "revalidation": { "type": "string", "minLength": 1 },
            "takeover": { "type": "string", "minLength": 1 },
            "capabilities": {
              "type": "array",
              "items": { "type": "string" },
              "allOf": [
                { "contains": { "const": "revalidate-decision-inputs-with-a-fresh-snapshot-before-every-mutation" } },
                { "contains": { "const": "cancel-pending-calls-and-observe-again-after-human-control" } }
              ]
            },
            "pendingEffects": { "type": "string", "minLength": 1 }
          }
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "observation", "actions", "takeover", "pendingEffects"],
          "properties": {
            "id": { "const": "fawn-workspace-service" },
            "observation": { "type": "string", "minLength": 1 },
            "actions": { "type": "string", "minLength": 1 },
            "takeover": { "const": "owner-handoff-to-the-human-and-back" },
            "pendingEffects": { "type": "string", "minLength": 1 }
          }
        },
        "sharedConditions": { "$ref": "#/$defs/stringList" },
        "repetitions": { "type": "integer", "minimum": 1 },
        "workflows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "heldOut"],
          "properties": {
            "development": { "type": "object", "additionalProperties": { "type": "string" } },
            "heldOut": { "const": "browser/workspace/qualification/model-agent/held-out-workflows.json" }
          }
        },
        "measures": { "$ref": "#/$defs/stringList" },
        "measurement": { "type": "object", "additionalProperties": { "type": "string" } },
        "improvementRequirements": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "kind", "scenarios", "treatmentBar"],
            "properties": {
              "area": { "enum": ["interruption-recovery", "incremental-observation", "held-out-generalization", "built-in-guarantees"] },
              "kind": { "enum": ["advantage", "non-inferiority"] },
              "scenarios": { "$ref": "#/$defs/stringList" },
              "treatmentBar": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["boolean", "number"] } },
              "materialImprovement": { "type": "object" },
              "reporting": { "type": "string", "minLength": 1 }
            }
          }
        },
        "productAdvantageRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiresAreasMet", "requiresNonInferiority", "latencyRegressionRule", "maximumTotalInferenceCostRatio", "doesNotEstablish"],
          "properties": {
            "requiresAreasMet": { "const": ["interruption-recovery", "incremental-observation"] },
            "requiresNonInferiority": { "const": ["held-out-generalization", "built-in-guarantees"] },
            "latencyRegressionRule": { "const": "workspaceComparison.criteria.latency" },
            "maximumTotalInferenceCostRatio": { "type": "number", "exclusiveMinimum": 0 },
            "doesNotEstablish": { "$ref": "#/$defs/stringList" }
          }
        },
        "runPrerequisites": { "$ref": "#/$defs/stringList" },
        "knownControlLimits": { "$ref": "#/$defs/stringList" }
      }
    },
    "workspaceDifferentiation": {
      "description": "Frozen before implementation: agent-workflow scenarios, the strongest generic Playwright agent control, measurable improvement requirements per target area and the rule that would establish scoped product advantage.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteVersion", "status", "purpose", "runnerPath", "fixtureSitePath", "agentPolicyPath", "task", "control",
        "treatment", "sharedConditions", "thinkTimeMs", "targetAreas", "scenarios", "measures", "oracle",
        "improvementRequirements", "productAdvantageRule", "knownControlLimits"
      ],
      "properties": {
        "suiteVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["frozen-before-implementation", "implemented-not-run", "run"] },
        "purpose": { "type": "string", "minLength": 1 },
        "runnerPath": { "const": "browser/workspace/qualification/differentiate.js" },
        "fixtureSitePath": { "const": "browser/workspace/qualification/workbench-site.js" },
        "agentPolicyPath": { "const": "browser/workspace/qualification/agents/procurement-policy.js" },
        "task": { "type": "string", "minLength": 1 },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "observation", "actions", "browserLifetime", "capabilities", "humanControlSemantics"],
          "properties": {
            "id": { "const": "playwright-agent-tooling" },
            "observation": { "const": "page-wide-playwright-agent-snapshot-with-incremental-tracking" },
            "actions": { "const": "aria-ref-locators-from-the-latest-snapshot" },
            "browserLifetime": { "const": "browser-host-outlives-the-agent-process" },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 },
              "allOf": [
                { "contains": { "const": "durable-agent-checkpoint-before-and-after-each-tool-call" } },
                { "contains": { "const": "application-idempotency-reference-when-offered" } },
                { "contains": { "const": "application-state-check-before-resubmission" } },
                { "contains": { "const": "current-page-check-after-an-interrupted-call" } },
                { "contains": { "const": "cooperative-pause-during-human-control" } }
              ]
            },
            "humanControlSemantics": { "const": "pause-then-resume-the-pending-tool-call" }
          }
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "agentProcess", "humanControlSemantics"],
          "properties": {
            "id": { "const": "fawn-workspace-service" },
            "agentProcess": { "const": "separate-client-of-a-workspace-that-outlives-it" },
            "humanControlSemantics": { "const": "owner-handoff-to-the-human-and-back" }
          }
        },
        "sharedConditions": { "$ref": "#/$defs/stringList" },
        "thinkTimeMs": { "type": "integer", "minimum": 1 },
        "targetAreas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
          "minItems": 4
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "area", "perturbation", "repetitions"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "area": { "enum": ["none", "changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
              "perturbation": { "type": "string", "minLength": 1 },
              "application": { "type": "string", "minLength": 1 },
              "repetitions": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "measures": { "$ref": "#/$defs/stringList" },
        "oracle": { "type": "string", "minLength": 1 },
        "improvementRequirements": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "scenario", "treatmentBar", "materialImprovement"],
            "properties": {
              "area": { "enum": ["changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
              "scenario": { "type": "string", "minLength": 1 },
              "treatmentBar": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": ["boolean", "integer"] }
              },
              "materialImprovement": {
                "type": "object",
                "additionalProperties": false,
                "required": ["measure"],
                "properties": {
                  "measure": { "type": "string", "minLength": 1 },
                  "treatmentBelowControl": { "const": true },
                  "statistic": { "const": "median" },
                  "maximumTreatmentToControlRatio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
                }
              }
            }
          }
        },
        "productAdvantageRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumAreasMet", "everyRepetition", "noMaterialRegressionIn", "latencyRegressionRule", "doesNotEstablish"],
          "properties": {
            "minimumAreasMet": { "type": "integer", "minimum": 2, "maximum": 4 },
            "everyRepetition": { "const": true },
            "noMaterialRegressionIn": { "$ref": "#/$defs/stringList" },
            "latencyRegressionRule": { "const": "workspaceComparison.criteria.latency" },
            "doesNotEstablish": { "$ref": "#/$defs/stringList" }
          }
        },
        "knownControlLimits": { "$ref": "#/$defs/stringList" }
      }
    },
    "revalidatedDifferentiation": {
      "description": "Frozen before implementation: the second comparison on a different application against Playwright agent tooling that revalidates decisions before mutating and cancels pending calls on human takeover; a model-driven stage needs its own later freeze.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteVersion", "status", "purpose", "runnerPath", "fixtureSitePath", "agentPolicyPath", "task", "control",
        "treatment", "sharedConditions", "thinkTimeMs", "targetAreas", "scenarios", "measures", "oracle",
        "improvementRequirements", "productAdvantageRule", "knownControlLimits", "modelDrivenStage"
      ],
      "properties": {
        "suiteVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["frozen-before-implementation", "implemented-not-run", "run"] },
        "purpose": { "type": "string", "minLength": 1 },
        "runnerPath": { "const": "browser/workspace/qualification/differentiate.js" },
        "fixtureSitePath": { "const": "browser/workspace/qualification/helpdesk-site.js" },
        "agentPolicyPath": { "const": "browser/workspace/qualification/agents/helpdesk-policy.js" },
        "task": { "type": "string", "minLength": 1 },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "observation", "actions", "browserLifetime", "capabilities", "humanControlSemantics"],
          "properties": {
            "id": { "const": "playwright-agent-tooling-with-revalidation" },
            "observation": { "const": "page-wide-playwright-agent-snapshot-with-incremental-tracking" },
            "actions": { "const": "aria-ref-locators-from-the-latest-snapshot" },
            "browserLifetime": { "const": "browser-host-outlives-the-agent-process" },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 },
              "allOf": [
                { "contains": { "const": "durable-agent-checkpoint-before-and-after-each-tool-call" } },
                { "contains": { "const": "application-idempotency-reference-when-offered" } },
                { "contains": { "const": "application-state-check-before-resubmission" } },
                { "contains": { "const": "current-page-check-after-an-interrupted-call" } },
                { "contains": { "const": "cooperative-pause-during-human-control" } },
                { "contains": { "const": "revalidate-decision-inputs-with-a-fresh-snapshot-before-every-mutation" } },
                { "contains": { "const": "cancel-pending-calls-and-observe-again-after-human-control" } }
              ]
            },
            "humanControlSemantics": { "const": "cancel-the-pending-tool-call-then-observe-again" }
          }
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "agentProcess", "humanControlSemantics"],
          "properties": {
            "id": { "const": "fawn-workspace-service" },
            "agentProcess": { "const": "separate-client-of-a-workspace-that-outlives-it" },
            "humanControlSemantics": { "const": "owner-handoff-to-the-human-and-back" }
          }
        },
        "sharedConditions": { "$ref": "#/$defs/stringList" },
        "thinkTimeMs": { "type": "integer", "minimum": 1 },
        "targetAreas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
          "minItems": 4
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "area", "perturbation", "repetitions"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "area": { "enum": ["none", "changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
              "perturbation": { "type": "string", "minLength": 1 },
              "application": { "type": "string", "minLength": 1 },
              "repetitions": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "measures": { "$ref": "#/$defs/stringList" },
        "oracle": { "type": "string", "minLength": 1 },
        "improvementRequirements": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "scenario", "treatmentBar", "materialImprovement"],
            "properties": {
              "area": { "enum": ["changing-content", "incremental-observation", "human-handoff", "interruption-recovery"] },
              "scenario": { "type": "string", "minLength": 1 },
              "treatmentBar": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": ["boolean", "integer"] }
              },
              "materialImprovement": {
                "type": "object",
                "additionalProperties": false,
                "required": ["measure"],
                "properties": {
                  "measure": { "type": "string", "minLength": 1 },
                  "treatmentBelowControl": { "const": true },
                  "statistic": { "const": "median" },
                  "maximumTreatmentToControlRatio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
                }
              }
            }
          }
        },
        "productAdvantageRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumAreasMet", "everyRepetition", "noMaterialRegressionIn", "latencyRegressionRule", "doesNotEstablish"],
          "properties": {
            "minimumAreasMet": { "type": "integer", "minimum": 2, "maximum": 4 },
            "everyRepetition": { "const": true },
            "noMaterialRegressionIn": { "$ref": "#/$defs/stringList" },
            "latencyRegressionRule": { "const": "workspaceComparison.criteria.latency" },
            "doesNotEstablish": { "$ref": "#/$defs/stringList" }
          }
        },
        "knownControlLimits": { "$ref": "#/$defs/stringList" },
        "modelDrivenStage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requirement"],
          "properties": {
            "status": { "enum": ["planned-requires-its-own-freeze"] },
            "requirement": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pinnedNativeEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternativeId",
        "engine",
        "admissionState",
        "browser",
        "engineSource",
        "model",
        "treatmentModelPath",
        "treatmentQuantization"
      ],
      "properties": {
        "alternativeId": { "type": "string", "pattern": "^N[0-9]+$" },
        "engine": { "$ref": "#/$defs/text" },
        "admissionState": { "const": "pinned-not-run" },
        "browser": { "$ref": "#/$defs/text" },
        "engineSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "describe", "buildType", "backend", "buildOptions"],
          "properties": {
            "repository": { "type": "string", "format": "uri" },
            "commit": { "$ref": "#/$defs/sha1" },
            "describe": { "$ref": "#/$defs/text" },
            "buildType": { "$ref": "#/$defs/text" },
            "backend": { "$ref": "#/$defs/text" },
            "buildOptions": { "$ref": "#/$defs/stringList" }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "file", "sha256", "bytes", "quantization"],
          "properties": {
            "repository": { "$ref": "#/$defs/text" },
            "revision": { "$ref": "#/$defs/sha1" },
            "file": { "$ref": "#/$defs/text" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 },
            "quantization": { "$ref": "#/$defs/text" }
          }
        },
        "treatmentModelPath": { "type": "string", "pattern": "^(?!/).+$" },
        "treatmentQuantization": { "$ref": "#/$defs/text" }
      }
    },
    "candidateNativeEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternativeId", "engine", "admissionState", "admissionRequirement"],
      "properties": {
        "alternativeId": { "type": "string", "pattern": "^N[0-9]+$" },
        "engine": { "$ref": "#/$defs/text" },
        "admissionState": { "const": "candidate-unassessed" },
        "admissionRequirement": { "$ref": "#/$defs/text" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredOutcome", "authorityPath"],
      "properties": {
        "id": { "type": "string", "const": "fawn-durable-workspace" },
        "requiredOutcome": { "$ref": "#/$defs/text" },
        "authorityPath": { "$ref": "#/$defs/path" }
      }
    },
    "internalLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laneId", "browser", "runtime", "isolates"],
      "properties": {
        "laneId": { "type": "string", "enum": ["A","B","C","D"] },
        "browser": { "$ref": "#/$defs/text" },
        "runtime": { "$ref": "#/$defs/text" },
        "isolates": { "$ref": "#/$defs/text" }
      }
    },
    "externalComparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparatorId",
        "product",
        "owner",
        "componentSubstitution",
        "currentState",
        "lastVerifiedAt",
        "freshnessRule",
        "officialSources",
        "executorPath",
        "admissionPolicyPath",
        "claimBoundary"
      ],
      "properties": {
        "comparatorId": { "type": "string", "const": "K0" },
        "product": { "type": "string", "const": "Cloudflare Browser Run plus Kitesurf" },
        "owner": { "type": "string", "const": "Cloudflare" },
        "componentSubstitution": { "type": "boolean", "const": false },
        "currentState": { "type": "string", "const": "external-beta" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "freshnessRule": { "$ref": "#/$defs/text" },
        "officialSources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "executorPath": { "$ref": "#/$defs/path" },
        "admissionPolicyPath": { "$ref": "#/$defs/path" },
        "claimBoundary": { "$ref": "#/$defs/text" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId", "purpose", "tasks", "requiredObservations"],
      "properties": {
        "suiteId": { "type": "string", "enum": ["shared-agent-browser-tasks","fawn-differentiation-tasks"] },
        "purpose": { "$ref": "#/$defs/text" },
        "tasks": { "$ref": "#/$defs/stringList" },
        "requiredObservations": { "$ref": "#/$defs/stringList" }
      }
    },
    "independenceTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "comparison", "requiredInterpretation", "forbiddenInference"],
      "properties": {
        "id": { "type": "string", "enum": ["doeproof-incumbent-value","fawn-shell-value","doeruntime-browser-value","direct-protocol-value","external-comparator-separation"] },
        "comparison": { "$ref": "#/$defs/text" },
        "requiredInterpretation": { "$ref": "#/$defs/text" },
        "forbiddenInference": { "$ref": "#/$defs/text" }
      }
    },
    "forkAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forkId", "decisionAuthorityPath", "fundWhen", "stopWhen"],
      "properties": {
        "forkId": { "type": "string", "enum": ["doeproof-feature","fawn-product","doeruntime-browser","fawn-direct-protocol"] },
        "decisionAuthorityPath": { "$ref": "#/$defs/path" },
        "fundWhen": { "$ref": "#/$defs/text" },
        "stopWhen": { "$ref": "#/$defs/text" }
      }
    }
  }
}
