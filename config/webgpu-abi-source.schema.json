{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.dev/schema/webgpu-abi-source.schema.json",
  "title": "Doe WebGPU ABI source policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "ownership", "generationPolicy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "repository", "commit", "licensePath"],
      "properties": {
        "kind": { "const": "vendored-pinned-header" },
        "path": { "const": "runtime/zig/vendor/webgpu-headers/webgpu.h" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repository": { "const": "https://chromium.googlesource.com/external/github.com/webgpu-native/webgpu-headers" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "licensePath": { "const": "runtime/zig/vendor/webgpu-headers/LICENSE" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamDefinitions", "doeExtensions", "exportedSymbolContract"],
      "properties": {
        "upstreamDefinitions": { "const": "vendored-pinned-header" },
        "doeExtensions": { "type": "string", "minLength": 1 },
        "exportedSymbolContract": { "type": "string", "minLength": 1 }
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "generatedDomains", "manualUpstreamDefinitionsAllowed"],
      "properties": {
        "status": { "const": "required-for-upstream-definitions" },
        "generatedDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["callbacks", "capabilities", "enums", "loader-metadata", "proc-tables", "proc-types", "records"]
          }
        },
        "manualUpstreamDefinitionsAllowed": { "const": false }
      }
    }
  }
}
