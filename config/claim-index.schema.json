{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe public claim index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "description", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "doe-claim-index" },
    "description": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "backend",
        "comparison",
        "metricDirection",
        "claimState"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "surface": {
          "type": "string",
          "enum": ["package", "native", "node-ort", "bun-ort", "browser-ort", "browser-chromium", "drop-in"]
        },
        "runtimeHost": {
          "type": "string",
          "enum": ["node", "bun", "browser", "deno"]
        },
        "backend": {
          "type": "string",
          "enum": ["apple-metal", "amd-vulkan", "d3d12", "dxil", "vulkan", "metal"]
        },
        "comparison": {
          "type": "string",
          "enum": ["doe-vs-dawn", "doe-vs-node-webgpu", "doe-vs-bun-webgpu", "doe-vs-deno-webgpu"]
        },
        "metricDirection": {
          "type": "string",
          "enum": ["lower-is-better", "higher-is-better", "status-only"]
        },
        "claimState": {
          "type": "string",
          "enum": ["claim-indexed", "diagnostic", "status-only", "scaffolded"]
        },
        "comparisonStatus": {
          "type": "string",
          "enum": ["comparable", "diagnostic", "not-evaluated"]
        },
        "claimStatus": {
          "type": "string",
          "enum": ["claimable", "diagnostic", "not-evaluated"]
        },
        "reportPath": { "$ref": "#/$defs/repoJsonPath" },
        "claimPath": { "$ref": "#/$defs/repoJsonPath" },
        "browserRelease": { "$ref": "#/$defs/browserRelease" },
        "blocker": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "surface": { "const": "browser-chromium" } },
            "required": ["surface"]
          },
          "then": {
            "required": ["runtimeHost", "browserRelease"],
            "properties": {
              "runtimeHost": { "const": "browser" }
            }
          }
        },
        {
          "if": {
            "required": ["browserRelease"]
          },
          "then": {
            "properties": {
              "surface": { "const": "browser-chromium" }
            }
          }
        },
        {
          "if": {
            "properties": { "claimState": { "const": "claim-indexed" } },
            "required": ["claimState"]
          },
          "then": {
            "required": ["comparisonStatus", "claimStatus", "reportPath", "claimPath"],
            "properties": {
              "comparisonStatus": { "const": "comparable" },
              "claimStatus": { "const": "claimable" }
            }
          }
        },
        {
          "if": {
            "properties": { "claimState": { "const": "diagnostic" } },
            "required": ["claimState"]
          },
          "then": {
            "required": ["comparisonStatus", "claimStatus", "reportPath"],
            "not": {
              "properties": { "claimStatus": { "const": "claimable" } },
              "required": ["claimStatus"]
            }
          }
        },
        {
          "if": {
            "properties": { "claimState": { "const": "status-only" } },
            "required": ["claimState"]
          },
          "then": {
            "properties": {
              "metricDirection": { "const": "status-only" },
              "comparisonStatus": { "const": "not-evaluated" },
              "claimStatus": { "const": "not-evaluated" }
            }
          }
        },
        {
          "if": {
            "properties": { "claimState": { "const": "scaffolded" } },
            "required": ["claimState"]
          },
          "then": {
            "required": ["blocker"],
            "properties": {
              "metricDirection": { "const": "status-only" },
              "comparisonStatus": { "const": "not-evaluated" },
              "claimStatus": { "const": "not-evaluated" }
            }
          }
        },
        {
          "if": {
            "properties": { "claimStatus": { "const": "claimable" } },
            "required": ["claimStatus"]
          },
          "then": {
            "properties": { "claimState": { "const": "claim-indexed" } },
            "required": ["claimPath"]
          }
        }
      ]
    },
    "repoJsonPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/][^\\\\]*\\.json$"
    },
    "repoZipPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/][^\\\\]*\\.zip$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicHttpsUrl": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https://"
    },
    "browserRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeFrontierBundlePath",
        "releaseArtifactBundlePath",
        "releaseArchivePath",
        "releaseArchiveSha256",
        "releaseArchiveManifestPath",
        "releaseArchiveManifestSha256",
        "downloadUrl",
        "packageInputsPath",
        "provenanceReportPath",
        "publicDownloadReceiptPath",
        "proofSurfacePath",
        "proofSurfaceCheckPath",
        "browserLaunchReceiptPath",
        "finalizerReportPath",
        "finalizerCheckPath",
        "readinessReportPath"
      ],
      "properties": {
        "runtimeFrontierBundlePath": { "$ref": "#/$defs/repoJsonPath" },
        "releaseArtifactBundlePath": { "$ref": "#/$defs/repoJsonPath" },
        "releaseArchivePath": { "$ref": "#/$defs/repoZipPath" },
        "releaseArchiveSha256": { "$ref": "#/$defs/hash" },
        "releaseArchiveManifestPath": { "$ref": "#/$defs/repoJsonPath" },
        "releaseArchiveManifestSha256": { "$ref": "#/$defs/hash" },
        "downloadUrl": { "$ref": "#/$defs/publicHttpsUrl" },
        "packageInputsPath": { "$ref": "#/$defs/repoJsonPath" },
        "provenanceReportPath": { "$ref": "#/$defs/repoJsonPath" },
        "publicDownloadReceiptPath": { "$ref": "#/$defs/repoJsonPath" },
        "proofSurfacePath": { "$ref": "#/$defs/repoJsonPath" },
        "proofSurfaceCheckPath": { "$ref": "#/$defs/repoJsonPath" },
        "browserLaunchReceiptPath": { "$ref": "#/$defs/repoJsonPath" },
        "finalizerReportPath": { "$ref": "#/$defs/repoJsonPath" },
        "finalizerCheckPath": { "$ref": "#/$defs/repoJsonPath" },
        "readinessReportPath": { "$ref": "#/$defs/repoJsonPath" }
      }
    }
  }
}
