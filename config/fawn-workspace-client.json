{
  "$schema": "fawn-workspace-client.schema.json",
  "schemaVersion": 1,
  "host": "127.0.0.1",
  "port": 4870,
  "pollMs": 1500,
  "maxBodyBytes": 1048576,
  "maxEvidenceBytes": 200000,
  "maxRepositoryFiles": 1000,
  "maxTurns": 20,
  "maxInputBytes": 200000,
