{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fawn://config/browser-release-launch-receipt.schema.json",
  "title": "Browser release launch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "receiptId",
    "observedAt",
    "launchSource",
    "browserProduct",
    "platform",
    "releaseArchive",
    "releaseArchiveManifest",
    "proofSurface",
    "browserExecutableArchivePath",
    "browserAppMetadataArchivePath",
    "doeRuntimeArchivePath",
    "dawnFallbackRuntimeArchivePath",
    "runtimeMode",
    "activeRuntime",
    "activeBackend",
    "hiddenFallbackAllowed",
    "hiddenFallbackUsed",
    "webgpuAvailable",
    "proofPage",
    "galleryPage",
    "comparisonReceipt",
    "observedReceiptIds"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "browser_release_launch_receipt" },
    "receiptId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "minLength": 1 },
    "launchSource": { "type": "string", "const": "release_archive" },
    "browserProduct": { "$ref": "#/$defs/BrowserProduct" },
    "platform": { "$ref": "#/$defs/Platform" },
    "releaseArchive": { "$ref": "#/$defs/Artifact" },
    "releaseArchiveManifest": { "$ref": "#/$defs/Artifact" },
    "proofSurface": { "$ref": "#/$defs/Artifact" },
    "cleanInstallCheck": {
      "allOf": [
        { "$ref": "#/$defs/Artifact" },
        { "properties": { "kind": { "const": "browser_release_clean_install_check" } } }
      ]
    },
    "browserExecutableArchivePath": { "type": "string", "minLength": 1 },
    "browserAppMetadataArchivePath": { "type": "string", "minLength": 1 },
    "doeRuntimeArchivePath": { "type": "string", "minLength": 1 },
    "dawnFallbackRuntimeArchivePath": { "type": "string", "minLength": 1 },
    "runtimeMode": { "type": "string", "const": "doe" },
    "activeRuntime": { "type": "string", "const": "doe" },
    "activeBackend": { "type": "string", "minLength": 1 },
    "hiddenFallbackAllowed": { "type": "boolean", "const": false },
    "hiddenFallbackUsed": { "type": "boolean", "const": false },
    "webgpuAvailable": { "type": "boolean", "const": true },
    "proofPage": { "$ref": "#/$defs/ProofPageLaunch" },
    "galleryPage": { "$ref": "#/$defs/GalleryPageLaunch" },
    "comparisonReceipt": { "$ref": "#/$defs/ComparisonLaunch" },
    "observedReceiptIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "browserProduct": {
            "properties": { "channel": { "enum": ["release_candidate", "release"] } },
            "required": ["channel"]
          }
        },
        "required": ["browserProduct"]
      },
      "then": { "required": ["cleanInstallCheck"] }
    }
  ],
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "PublicHttpsUrl": {
      "type": "string",
      "pattern": "^https://[^/?#]+\\.[^/?#]+",
      "not": {
        "anyOf": [
          { "pattern": "^https://localhost(?::|/|$)" },
          { "pattern": "^https://(?:127\\.0\\.0\\.1|0\\.0\\.0\\.0|10\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.)(?::|/|$)" },
          { "pattern": "^https://\\[::1\\](?::|/|$)" },
          { "pattern": "^https://[^/?#]*\\.(?:local|localhost|test|example|invalid)(?::|/|$)" },
          { "pattern": "^https://(?:example\\.com|example\\.net|example\\.org)(?::|/|$)" }
        ]
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Hash" },
        "kind": { "type": "string", "minLength": 1 },
        "downloadUrl": { "$ref": "#/$defs/PublicHttpsUrl" }
      }
    },
    "BrowserProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "displayName", "version", "channel"],
      "properties": {
        "productId": { "enum": ["doe-browser", "fawn-doe"] },
        "displayName": { "enum": ["Doe Browser", "Fawn Doe"] },
        "version": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["diagnostic", "release_candidate", "release"] }
      }
    },
    "Platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "packageFormat"],
      "properties": {
        "os": { "enum": ["macos", "linux", "windows"] },
        "arch": { "enum": ["arm64", "x64"] },
        "packageFormat": { "enum": ["zip"] }
      }
    },
    "ProofPageLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "loaded", "artifactPath", "receiptId"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "loaded": { "type": "boolean", "const": true },
        "artifactPath": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 }
      }
    },
    "GalleryPageLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "loaded", "category", "artifactPath", "receiptId"],
      "properties": {
        "url": { "$ref": "#/$defs/PublicHttpsUrl" },
        "loaded": { "type": "boolean", "const": true },
        "category": { "enum": ["compute", "rendering", "tensor", "shader_edge", "benchmark_trace"] },
        "artifactPath": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 }
      }
    },
    "ComparisonLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparisonId",
        "workloadId",
        "pageArtifactPath",
        "loaded",
        "executionScope",
        "modes",
        "emitsSideBySideReceipts",
        "comparisonArtifactPath",
        "dawnReceiptId",
        "doeReceiptId"
      ],
      "properties": {
        "comparisonId": { "type": "string", "minLength": 1 },
        "workloadId": { "type": "string", "minLength": 1 },
        "pageArtifactPath": { "type": "string", "minLength": 1 },
        "loaded": { "type": "boolean", "const": true },
        "executionScope": { "type": "string", "const": "same_page" },
        "modes": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "dawn" },
            { "type": "string", "const": "doe" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "emitsSideBySideReceipts": { "type": "boolean", "const": true },
        "comparisonArtifactPath": { "type": "string", "minLength": 1 },
        "dawnReceiptId": { "type": "string", "minLength": 1 },
        "doeReceiptId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
