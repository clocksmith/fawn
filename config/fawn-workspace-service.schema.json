{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.local/schemas/fawn-workspace-service.schema.json",
  "title": "Fawn workspace service configuration",
  "description": "Tunables and protocol coverage for the Fawn shared observation, action and recovery service in browser/workspace. Implementation existence does not qualify the service; docs/fawn-workspace-contract.md owns acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "configVersion",
    "protocolVersion",
    "contractPath",
    "journal",
    "credentials",
    "observation",
    "dispatch",
    "browser",
    "actionKinds",
    "observationScopes",
    "observationViews",
    "conditionKinds",
    "reconciliationMethods"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "fawn-workspace-service.schema.json" },
    "schemaVersion": { "type": "integer", "const": 4 },
    "configVersion": { "type": "string", "minLength": 1 },
    "protocolVersion": {
      "type": "integer",
      "const": 3,
      "description": "Protocol 3 adds region groups, the outline view with deltas against a base version, and handle targets; protocol 2 added regions-scoped actions and link destinations. Earlier journals replay unchanged; their observations carry no handles, and protocol 1 observations cannot authorize link-following actions."
    },
    "contractPath": { "type": "string", "const": "docs/fawn-workspace-contract.md" },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "lockFileName", "hashAlgorithm"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "lockFileName": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "hashAlgorithm": { "type": "string", "enum": ["sha256"] }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretBytes"],
      "properties": {
        "secretBytes": { "type": "integer", "minimum": 32, "maximum": 64 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgeMs", "maxTextChars", "maxElements", "maxRegions"],
      "properties": {
        "maxAgeMs": { "type": "integer", "minimum": 1000 },
        "maxTextChars": { "type": "integer", "minimum": 1 },
        "maxElements": { "type": "integer", "minimum": 1 },
        "maxRegions": { "type": "integer", "minimum": 1 }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionTimeoutMs", "completionTimeoutMs", "completionPollMs"],
      "properties": {
        "actionTimeoutMs": { "type": "integer", "minimum": 1 },
        "completionTimeoutMs": { "type": "integer", "minimum": 1 },
        "completionPollMs": { "type": "integer", "minimum": 1 }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "transport",
        "channel",
        "headless",
        "persistentProfiles"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "chromium"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "pipe"
          ],
          "description": "The service launches Chromium over a private pipe so no remote-debugging endpoint bypasses dispatch."
        },
        "channel": {
          "type": "string",
          "enum": [
            "chromium-headless-shell",
            "chromium",
            "chrome",
            "fawn"
          ],
          "description": "Installed stock channel, or an explicitly identified Fawn build with a forced runtime."
        },
        "headless": {
          "type": "boolean"
        },
        "persistentProfiles": {
          "type": "boolean",
          "const": true
        },
        "fawnBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "dependencies",
            "runtime"
          ],
          "properties": {
            "executable": {
              "$ref": "#/$defs/fileArtifact"
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/fileArtifact"
              }
            },
            "runtime": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "library"
                  ],
                  "properties": {
                    "mode": {
                      "const": "doe-c"
                    },
                    "library": {
                      "$ref": "#/$defs/fileArtifact"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "dawn"
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "runtime": {
                    "properties": {
                      "mode": {
                        "const": "doe-c"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "dependencies": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "fawn"
              }
            }
          },
          "then": {
            "required": [
              "fawnBuild"
            ]
          },
          "else": {
            "not": {
              "required": [
                "fawnBuild"
              ]
            }
          }
        }
      ]
    },
    "actionKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["navigate", "click", "fill", "select", "submit", "download"]
      }
    },
    "observationScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "page binds an action to the whole cited page; regions binds it to the cited observation's URL and named regions, with target identity still checked.",
      "items": { "type": "string", "enum": ["page", "regions"] }
    },
    "observationViews": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "full returns elements, text and digests; outline returns compact region outlines with stable handles, and only changed regions relative to a base version.",
      "items": { "type": "string", "enum": ["full", "outline"] }
    },
    "conditionKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "url-equals",
          "url-not-equals",
          "url-prefix",
          "element-present",
          "element-absent",
          "element-text-includes",
          "element-text-excludes",
          "input-value-equals"
        ]
      }
    },
    "reconciliationMethods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["application-state", "external-idempotency", "human-review"]
      }
    }
  },
  "$defs": {
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
