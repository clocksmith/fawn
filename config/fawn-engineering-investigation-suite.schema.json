{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fawn engineering investigation qualification suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suiteVersion",
    "status",
    "purpose",
    "runnerPath",
    "fixtureSitePath",
    "agentPolicyPath",
    "task",
    "control",
    "treatment",
    "sharedConditions",
    "thinkTimeMs",
    "targetAreas",
    "scenarios",
    "measures",
    "oracle",
    "improvementRequirements",
    "productAdvantageRule"
  ],
  "properties": {
    "suiteVersion": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/suiteVersion"},
    "status": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/status"},
    "purpose": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/purpose"},
    "runnerPath": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/runnerPath"},
    "fixtureSitePath": {"const": "browser/workspace/qualification/investigation-site.js"},
    "agentPolicyPath": {"const": "browser/workspace/qualification/agents/investigation-policy.js"},
    "task": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/task"},
    "control": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/control"},
    "treatment": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/treatment"},
    "sharedConditions": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/sharedConditions"},
    "thinkTimeMs": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/thinkTimeMs"},
    "targetAreas": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/targetAreas"},
    "scenarios": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/scenarios"},
    "measures": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/measures"},
    "oracle": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/oracle"},
    "improvementRequirements": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/improvementRequirements"},
    "productAdvantageRule": {"$ref": "browser-product-comparison-policy.schema.json#/$defs/revalidatedDifferentiation/properties/productAdvantageRule"}
  }
}
