{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime GLSL instruction mapping correctness; no performance claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "performanceClaim",
    "identity",
    "shaderSha256",
    "providerModuleSha256",
    "librarySha256",
    "loadedLibraries",
    "results",
    "passed"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "performanceClaim": {
      "const": false
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "device",
        "architecture",
        "description"
      ],
      "properties": {
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "shaderSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerModuleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "librarySha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "loadedLibraries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "passed",
          "failure"
        ],
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "exponents": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "exact": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "type": "number"
            }
          },
          "observed": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 32,
                "maxItems": 32,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        }
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 3,
            "items": {
              "required": [
                "values",
                "exponents",
                "exact",
                "expected",
                "observed"
              ],
              "properties": {
                "passed": {
                  "const": true
                },
                "failure": {
                  "type": "null"
                },
                "observed": {
                  "type": "array",
                  "minItems": 32,
                  "maxItems": 32,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
