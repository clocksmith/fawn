{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe upstream finding review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "findingId",
    "findingInputHash",
    "decision",
    "reviewer",
    "reason",
    "reviewedAt",
    "runtimeMutationAuthorized"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "pattern": "^upstream-review-[0-9a-f]{20}$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^dawn-cl-[0-9]+$"
    },
    "findingInputHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeMutationAuthorized": {
      "type": "boolean",
      "const": false
    }
  }
}
