{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.dev/schema/wgsl-compiler-coverage-ledger.schema.json",
  "title": "Doe WGSL compiler coverage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "ledgerId",
    "claimScope",
    "generatedAtUtc",
    "sourcePlan",
    "supportStatus",
    "fullSupportAllowed",
    "summary",
    "testCommands",
    "spirvValidation",
    "admittedShaders",
    "ctsReports",
    "workarounds",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "wgsl_compiler_coverage_ledger" },
    "ledgerId": { "$ref": "#/$defs/id" },
    "claimScope": { "const": "amd_vulkan_gemma270m_admitted_compute" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "sourcePlan": { "$ref": "#/$defs/artifactRef" },
    "supportStatus": { "enum": ["full", "partial"] },
    "fullSupportAllowed": { "type": "boolean" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkCount", "passCount", "failCount"],
      "properties": {
        "checkCount": { "type": "integer", "minimum": 1 },
        "passCount": { "type": "integer", "minimum": 0 },
        "failCount": { "type": "integer", "minimum": 0 }
      }
    },
    "testCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandResult" }
    },
    "spirvValidation": {
      "allOf": [
        { "$ref": "#/$defs/checkResult" },
        {
          "type": "object",
          "required": ["report", "emitter", "validator"],
          "properties": {
            "report": { "$ref": "#/$defs/artifactRef" },
            "emitter": { "$ref": "#/$defs/artifactRef" },
            "validator": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "admittedShaders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/checkResult" },
          {
            "type": "object",
            "required": ["id", "source", "artifact"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "source": { "$ref": "#/$defs/artifactRef" },
              "artifact": { "$ref": "#/$defs/artifactRef" }
            }
          }
        ]
      }
    },
    "ctsReports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/checkResult" },
          {
            "type": "object",
            "required": ["lane", "report", "queryIds", "adapterIdentity"],
            "properties": {
              "lane": { "enum": ["W0", "D0"] },
              "report": { "$ref": "#/$defs/artifactRef" },
              "queryIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "adapterIdentity": { "type": "object" }
            }
          }
        ]
      }
    },
    "workarounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/checkResult" },
          {
            "type": "object",
            "required": ["id", "forbiddenPattern", "searchPaths", "matches"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "forbiddenPattern": { "type": "string", "minLength": 1 },
              "searchPaths": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "matches": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "checkResult": {
      "type": "object",
      "required": ["pass", "reason"],
      "properties": {
        "pass": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "commandResult": {
      "allOf": [
        { "$ref": "#/$defs/checkResult" },
        {
          "type": "object",
          "required": ["id", "workdir", "command", "exitCode", "stdoutTail", "stderrTail"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "workdir": { "type": "string", "minLength": 1 },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "exitCode": { "type": "integer" },
            "stdoutTail": { "type": "array", "items": { "type": "string" } },
            "stderrTail": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
