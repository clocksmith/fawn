        {
          "area": "human-handoff",
          "scenario": "human-takes-control-at-checkout",
          "treatmentBar": {
            "taskSuccessEveryRepetition": true,
            "incorrectActions": 0,
            "mutationsDuringHumanControl": 0
          },
          "materialImprovement": { "measure": "incorrectActions", "treatmentBelowControl": true }
        },
        {
          "area": "interruption-recovery",
          "scenario": "agent-killed-during-order-transient-confirmation",
          "treatmentBar": { "taskSuccessEveryRepetition": true, "duplicateOrders": 0, "humanReviews": 0 },
          "materialImprovement": {
            "measure": "humanReviewsPlusDuplicateOrders",
            "treatmentBelowControl": true
          }
        }
      ],
      "productAdvantageRule": {
        "minimumAreasMet": 2,
        "everyRepetition": true,
        "noMaterialRegressionIn": [
