{
  "$schema": "browser-product-comparison-policy.schema.json",
  "schemaVersion": 10,
  "policyId": "fawn-external-product-comparison-v10",
  "authority": {
    "strategyPath": "docs/thesis.md",
    "browserLanePath": "docs/browser-lane.md",
    "milestonePath": "browser/chromium/bench/workflows/browser-milestones.json",
    "claimStatePath": "reports/claim-index.json"
  },
  "noRegretTrunk": {
    "definition": "The selected Fawn product starts with shared durable browser work above Chromium. Independent native application adoption remains a separate product track; neither is a prerequisite for the other.",
    "workItems": [
      {
        "id": "fawn-durable-workspace",
        "requiredOutcome": "The shared service passes durable authority and uncertain-action recovery acceptance across reusable workflows, then establishes complete-task value against competent stock Chromium/Playwright. Native runtime wins are not a prerequisite.",
        "authorityPath": "docs/fawn-workspace-contract.md"
      }
    ]
  },
  "internalCausalLanes": [
    { "laneId": "A", "browser": "stock Chromium with Playwright", "runtime": "Dawn", "isolates": "incumbent browser and runtime control" },
    { "laneId": "B", "browser": "Fawn with Playwright", "runtime": "Dawn", "isolates": "legacy Fawn shell build and agent-facing browser behavior" },
    { "laneId": "C", "browser": "Fawn with Playwright", "runtime": "DoeRuntime", "isolates": "DoeRuntime beneath the same Fawn surface" },
    { "laneId": "D", "browser": "Fawn Direct Protocol", "runtime": "DoeRuntime", "isolates": "Direct Protocol beyond the Fawn plus DoeRuntime control" }
  ],
  "externalComparators": [
    {
      "comparatorId": "K0",
      "product": "Cloudflare Browser Run plus Kitesurf",
      "owner": "Cloudflare",
      "componentSubstitution": false,
      "currentState": "external-beta",
      "lastVerifiedAt": "2026-08-24T00:00:00Z",
      "freshnessRule": "Reverify both official sources before every funded fork decision or published comparison.",
      "officialSources": [
        "https://blog.cloudflare.com/kitesurf/",
        "https://developers.cloudflare.com/browser-run/kitesurf/",
        "https://developers.cloudflare.com/browser-run/quick-actions/"
      ],
      "executorPath": "bench/fawn_matrix/k0_cli.py",
      "admissionPolicyPath": "config/fawn-k0-workloads.json",
      "claimBoundary": "Cloudflare product documentation establishes comparator scope only; it is not Doe, Fawn workspace or legacy Fawn shell build execution evidence."
    }
  ],
  "suites": [
    {
      "suiteId": "shared-agent-browser-tasks",
      "purpose": "Compare substitutable product outcomes without treating K0 as an internal component lane.",
      "tasks": ["HTML extraction", "screenshots", "navigation", "automation success"],
      "requiredObservations": ["task oracle", "wall time", "tokens", "memory", "cost", "compatibility failures", "unsupported features", "retries", "recovery behavior", "total task outcome"]
    },
    {
      "suiteId": "fawn-differentiation-tasks",
      "purpose": "Test whether persistent local browser operation creates customer value outside Kitesurf's documented fit.",
      "tasks": ["persistent authentication", "restart recovery", "offline local operation", "WebGL", "WebGPU", "private state", "long-running sessions"],
      "requiredObservations": ["task oracle", "state continuity", "privacy boundary", "compatibility failures", "unsupported features", "retries", "recovery behavior", "total task outcome"]
    }
  ],
  "independenceTests": [
    {
      "id": "doeproof-incumbent-value",
      "comparison": "I1 to W0",
      "requiredInterpretation": "DoeProof records independent evidence for the incumbent as a supporting feature; W0 value alone does not establish primary-product adoption.",
      "forbiddenInference": "DoeProof value grants DoeRuntime ownership."
    },
    {
      "id": "fawn-shell-value",
      "comparison": "B to A",
      "requiredInterpretation": "Only a B-over-A application outcome grants legacy Fawn shell build value.",
      "forbiddenInference": "Legacy Fawn shell build value grants DoeRuntime or Direct Protocol value."
    },
    {
      "id": "doeruntime-browser-value",
      "comparison": "C to B",
      "requiredInterpretation": "Only a C-over-B application outcome grants DoeRuntime browser value for the measured tuple.",
      "forbiddenInference": "A DoeRuntime result generalizes across applications, hardware, operating systems, drivers, or providers."
    },
    {
      "id": "direct-protocol-value",
      "comparison": "D to C",
      "requiredInterpretation": "Only a D-over-C total task outcome funds the Direct Protocol for the measured workload.",
      "forbiddenInference": "Lower token count alone grants Direct Protocol value."
    },
    {
      "id": "external-comparator-separation",
      "comparison": "K0 beside A/B/C/D",
      "requiredInterpretation": "K0 compares external product outcomes and never changes the causal meaning of A/B/C/D.",
      "forbiddenInference": "A K0 result identifies the value of a legacy Fawn shell build or DoeRuntime component."
    }
  ],
  "forkAuthorities": [
    {
      "forkId": "doeproof-feature",
      "decisionAuthorityPath": "config/doe-product-strategy.json",
      "fundWhen": "Independent qualification and replay make incumbent and DoeRuntime evidence comparable without changing execution.",
      "stopWhen": "Observation interferes with execution, hides fallback, or is treated as a substitute for runtime adoption."
    },
    {
      "forkId": "fawn-product",
      "decisionAuthorityPath": "docs/fawn-workspace-contract.md",
      "fundWhen": "Implement and independently qualify the selected shared workspace service above stock Chromium, then compare complete workflows against competent Chromium/Playwright; native runtime wins are not prerequisites.",
      "stopWhen": "Unsafe authority or recovery blocks acceptance; failure to improve complete workflows rejects product-value claims. K0 outcomes retain their external-comparator scope."
    },
    {
      "forkId": "doeruntime-browser",
      "decisionAuthorityPath": "docs/runtime-ownership-decision.md",
      "fundWhen": "C beats B materially, the exact D0 tuple also beats W0 and every authorized P0, and the measured benefit justifies the integration's compatibility and maintenance costs.",
      "stopWhen": "C does not beat B or a governed incumbent meets the application outcome at lower durable cost."
    },
    {
      "forkId": "fawn-direct-protocol",
      "decisionAuthorityPath": "docs/browser-lane.md",
      "fundWhen": "D beats C on the complete task outcome under the same oracle and lifecycle scope, and the measured benefit justifies the hook's compatibility and maintenance costs.",
      "stopWhen": "D does not beat C or reduces tokens while worsening the customer's declared total task outcome."
    }
  ],
  "stopConditions": [
    "Reject the measured shell-product claim when K0 wins shared tasks and customers do not value differentiation; workspace acceptance remains independently governed.",
    "Do not grant legacy Fawn shell build value unless B beats A.",
    "Do not grant DoeRuntime browser ownership unless C beats B for the exact measured tuple.",
    "Do not continue Direct Protocol funding unless D beats C on the declared total task outcome.",
    "Do not add Chromium hooks or browser-runtime integration unless measured benefits justify their compatibility and maintenance costs."
  ],
  "evidenceReferences": [
    "browser/chromium/bench/workflows/browser-milestones.json",
    "bench/fawn_matrix/config/matrix-workloads.json",
    "config/fawn-k0-workloads.json",
    "config/fawn-k0-bindings.schema.json",
    "config/fawn-k0-result.schema.json",
    "bench/fawn_matrix/k0.py",
    "bench/fawn_matrix/k0_cli.py",
    "bench/tests/test_fawn_k0_connector.py",
    "reports/claim-index.json",
    "docs/status/runtime-backends-and-bench.md",
    "docs/fawn-workspace-contract.md",
    "docs/status/fawn-workspace.md"
  ],
  "workspaceComparison": {
    "contractPath": "docs/fawn-workspace-contract.md",
    "strategyPath": "config/doe-product-strategy.json#fawnWorkspace",
    "control": "competent-stock-chromium-playwright",
    "treatment": "same-browser-and-runtime-with-fawn-workspace-service",
    "scope": "Prospective independent workflow comparison; existing A/B/C/D and K0 receipts retain their meanings and cannot satisfy it.",
    "requiresNativeRuntimeWins": false,
    "comparisonVersion": "2026-10-14-workspace-comparison-v1",
    "runnerPath": "browser/workspace/qualification/compare.js",
    "controlImplementationPath": "browser/workspace/qualification/baseline",
    "fixtureSitePath": "browser/workspace/qualification/fixture-site.js",
    "browserRuntime": {
      "driver": "playwright-core",
      "browser": "chromium-headless-shell",
      "treatmentAdapter": "playwright",
      "headless": true
    },
    "controlCapabilities": [
      "persistent-profile",
      "durable-progress-file",
      "origin-allowlist-including-form-actions",
      "exact-accessible-name-locators-resolved-at-action-time",
      "application-idempotency-reference",
      "application-state-check-before-resubmission"
    ],
    "equalOpportunities": [
      "same-fixture-site-and-inputs",
      "same-browser-binary-and-driver",
      "same-granted-origins",
      "same-action-timeout",
      "same-process-and-ipc-shape",
      "same-submissions-page-for-recovery"
    ],
    "scenarios": [
      {
        "id": "clean-research",
        "workflow": "research",
        "fault": "none",
        "oracle": "research-findings",
        "repetitions": 5
      },
      {
        "id": "clean-form",
        "workflow": "form",
        "fault": "none",
        "oracle": "single-receipt",
        "repetitions": 5
      },
      {
        "id": "clean-export",
        "workflow": "export",
        "fault": "none",
        "oracle": "report-artifact",
        "repetitions": 5
      },
      {
        "id": "crash-during-submission",
        "workflow": "form",
        "fault": "kill-while-effect-held",
        "oracle": "single-receipt",
        "repetitions": 3
      },
      {
        "id": "crash-during-export",
        "workflow": "export",
        "fault": "kill-while-effect-held",
        "oracle": "report-artifact",
        "repetitions": 3
      },
      {
        "id": "background-changes",
        "workflow": "export",
        "fault": "background-settle",
        "pagePath": "/live/export",
        "treatmentRegions": ["#export-panel"],
        "oracle": "report-artifact",
        "repetitions": 3
      },
      {
        "id": "target-replaced",
        "workflow": "export",
        "fault": "replace-target",
        "pagePath": "/live/export",
        "treatmentRegions": ["#export-panel"],
        "oracle": "no-replaced-artifact",
        "repetitions": 3
      }
    ],
    "excludedScenarios": [
      {
        "id": "owner-handoff",
        "reason": "The control has no owner authority; an equivalent would have to reimplement the workspace service, so handoff is qualified by the behavioral case set instead."
      }
    ],
    "measures": [
      "taskSuccess",
      "incorrectActions",
      "recovery",
      "observationBytes",
      "completeTaskLatencyMs",
      "serviceOverheadMs",
      "integrationLines"
    ],
    "criteria": {
      "latency": {
        "statistic": "median",
        "regressionRatio": 1.5,
        "advantageRatio": 0.67,
        "minimumDeltaMs": 250
      },
      "materialWhenDifferent": ["taskSuccess", "incorrectActions", "recovery"],
      "informativeOnly": ["observationBytes", "serviceOverheadMs", "integrationLines"]
    },
    "differentiation": {
      "suiteVersion": "2026-10-15-agent-workflows-v1",
      "status": "run",
      "purpose": "Material complete-task value over competent agent tooling on stock Chromium for persistent multipage agent workflows; the scripted comparison above showed parity.",
      "runnerPath": "browser/workspace/qualification/differentiate.js",
      "fixtureSitePath": "browser/workspace/qualification/workbench-site.js",
      "agentPolicyPath": "browser/workspace/qualification/agents/procurement-policy.js",
      "task": "Buy one unit of the cheapest in-stock item priced at or under the budget across every catalog page, ship it to the task address unless a human has entered one, place exactly one order and save its invoice.",
      "control": {
        "id": "playwright-agent-tooling",
        "observation": "page-wide-playwright-agent-snapshot-with-incremental-tracking",
        "actions": "aria-ref-locators-from-the-latest-snapshot",
        "browserLifetime": "browser-host-outlives-the-agent-process",
        "capabilities": [
          "persistent-profile",
          "durable-agent-checkpoint-before-and-after-each-tool-call",
          "application-idempotency-reference-when-offered",
          "application-state-check-before-resubmission",
          "current-page-check-after-an-interrupted-call",
          "cooperative-pause-during-human-control",
