      "oracle": "The fixture site's own order, cart and mutation log decides success and incorrect actions: an order of the cheapest valid item at order time, at most one order, the shipping address the task or the human set, and a saved invoice matching the order.",
      "improvementRequirements": [
        {
          "area": "changing-content",
          "scenario": "price-rises-during-think-time",
          "treatmentBar": {
            "taskSuccessEveryRepetition": true,
            "incorrectActions": 0,
            "constraintViolatingMutations": 0
          },
          "materialImprovement": { "measure": "constraintViolatingMutations", "treatmentBelowControl": true }
