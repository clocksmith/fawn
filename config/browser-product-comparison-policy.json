        {
          "id": "agent-killed-during-order-transient-confirmation",
          "area": "interruption-recovery",
          "perturbation": "the-agent-process-dies-while-the-application-holds-the-order",
          "application": "no-order-list-no-idempotency-and-a-confirmation-that-redirects-away",
          "repetitions": 3
        }
      ],
      "measures": [
