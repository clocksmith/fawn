      "thinkTimeMs": 400,
      "targetAreas": ["changing-content", "incremental-observation", "human-handoff", "interruption-recovery"],
      "scenarios": [
        { "id": "agent-clean", "area": "none", "perturbation": "none", "repetitions": 5 },
        {
          "id": "price-rises-during-think-time",
          "area": "changing-content",
          "perturbation": "the-chosen-item-price-exceeds-the-budget-after-observation-before-add",
          "repetitions": 3
        },
        {
          "id": "irrelevant-activity-churn",
          "area": "incremental-observation",
          "perturbation": "a-large-activity-panel-updates-continuously-on-every-catalog-page",
          "repetitions": 3
        },
        {
          "id": "human-takes-control-at-checkout",
          "area": "human-handoff",
          "perturbation": "a-human-enters-a-shipping-address-while-the-agent-fill-is-pending",
