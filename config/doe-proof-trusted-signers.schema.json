{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doe.dev/schemas/doe-proof-trusted-signers.schema.json",
  "title": "DoeProof trusted signer policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "policyState", "signers", "history"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "policyId": { "type": "string", "const": "doe-proof-release-signers-v1" },
    "policyState": { "type": "string", "enum": ["anchor_required", "active"] },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signerId", "identity", "publicKeySha256", "allowedReceiptKinds", "allowedSubjectKinds", "notBefore", "notAfter", "status"],
        "properties": {
          "signerId": { "type": "string", "minLength": 1 },
          "identity": { "type": "string", "minLength": 1 },
          "publicKeySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "allowedReceiptKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "allowedSubjectKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "notBefore": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
          "notAfter": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
          "status": { "type": "string", "enum": ["active", "revoked"] }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectiveAt", "action", "signerId", "reason"],
        "properties": {
          "effectiveAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
          "action": { "type": "string", "enum": ["authorized", "revoked", "replaced"] },
          "signerId": { "type": "string", "minLength": 1 },
          "replacementSignerId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
