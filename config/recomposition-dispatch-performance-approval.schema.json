{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe recomposition dispatch-seam performance approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval",
    "artifactKind",
    "classification",
    "generatedAt",
    "schemaVersion",
    "sourceMeasurement",
    "status",
    "toolchain"
  ],
  "properties": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callsPerSample",
        "characterizedLegacyMedianNs",
        "promotedMedianNs",
        "promotedNoSlower",
        "sampleCount"
      ],
      "properties": {
        "callsPerSample": { "type": "integer", "minimum": 1 },
        "characterizedLegacyMedianNs": { "type": "integer", "minimum": 1 },
        "promotedMedianNs": { "type": "integer", "minimum": 1 },
        "promotedNoSlower": { "type": "boolean", "const": true },
        "sampleCount": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactKind": {
      "type": "string",
      "const": "recomposition-dispatch-performance-approval"
    },
    "classification": { "type": "string", "const": "no-regression" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "sourceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path", "sha256", "sourceTreeSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path": {
          "type": "string",
          "const": "runtime/zig/reports/architecture/build-measurements.json"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourceTreeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "status": { "type": "string", "const": "approved" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "version"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
