{
  "$schema": "fawn-workspace-service.schema.json",
  "schemaVersion": 1,
  "configVersion": "2026-10-14-workspace-service-v1",
  "protocolVersion": 1,
  "contractPath": "docs/fawn-workspace-contract.md",
  "journal": {
    "fileName": "journal.jsonl",
    "lockFileName": "journal.lock",
    "hashAlgorithm": "sha256"
  },
  "credentials": {
    "secretBytes": 32
  },
  "observation": {
    "maxAgeMs": 120000,
    "maxTextChars": 20000,
    "maxElements": 200
  },
  "dispatch": {
    "actionTimeoutMs": 15000,
    "completionTimeoutMs": 10000,
    "completionPollMs": 50
  },
  "browser": {
    "engine": "chromium",
    "transport": "pipe",
    "headless": true,
    "persistentProfiles": true
  },
  "actionKinds": [
    "navigate",
    "click",
    "fill",
    "select",
    "submit",
    "download"
  ],
  "conditionKinds": [
    "url-equals",
    "url-prefix",
    "element-present",
    "element-absent",
    "element-text-includes",
    "input-value-equals"
  ],
  "reconciliationMethods": [
    "application-state",
    "external-idempotency",
    "human-review"
  ]
}
