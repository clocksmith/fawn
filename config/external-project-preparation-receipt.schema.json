{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe external project preparation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "generatedAt",
    "actorId",
    "harnessId",
    "runId",
    "status",
    "failure",
    "source",
    "contracts",
    "host",
    "toolVersions",
    "hardware",
    "supportTarget",
    "steps",
    "artifacts",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": {
      "type": "string",
      "const": "external-project-preparation-receipt"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "actorId": { "$ref": "#/$defs/id" },
    "harnessId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/runId" },
    "status": { "type": "string", "enum": ["passed", "failed", "unavailable"] },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "requestedCommit",
        "actualCommit",
        "originUrl",
        "upstreamRoot",
        "clean"
      ],
      "properties": {
        "repositoryUrl": { "type": "string", "format": "uri" },
        "requestedCommit": { "$ref": "#/$defs/sha1" },
        "actualCommit": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha1" }
          ]
        },
        "originUrl": { "type": ["string", "null"] },
        "upstreamRoot": { "$ref": "#/$defs/path" },
        "clean": { "type": ["boolean", "null"] }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "operatingSystem", "machine", "release", "python"],
      "properties": {
        "platform": { "type": "string", "enum": ["linux", "darwin", "win32"] },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "toolVersions": {
      "type": "array",
      "items": { "$ref": "#/$defs/process" }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredPatterns", "prohibitedPatterns", "probe"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "not-run"] },
        "requiredPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "prohibitedPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "probe": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/process" }
          ]
        }
      }
    },
    "supportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "targetId", "claimEligible"],
      "properties": {
        "status": { "type": "string", "enum": ["matched", "unmatched"] },
        "targetId": { "type": ["string", "null"] },
        "claimEligible": { "type": "boolean" }
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/process" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1 },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "sizeBytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "workingDirectory",
        "exitCode",
        "elapsedNs",
        "stdoutPath",
        "stdoutSha256",
        "stderrPath",
        "stderrSha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "workingDirectory": { "$ref": "#/$defs/path" },
        "exitCode": { "type": "integer" },
        "elapsedNs": { "type": "integer", "minimum": 0 },
        "stdoutPath": { "$ref": "#/$defs/path" },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrPath": { "$ref": "#/$defs/path" },
        "stderrSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
