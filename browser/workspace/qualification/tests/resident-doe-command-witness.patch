+/* Private diagnostic overlay. The native device mutex guards these calls.
+ * Arm once on a freshly encoded ordinary command; recording precedes admission,
+ * and only an observed submit-specific fence can confirm an accepted serial. */
+typedef enum doe_resource_vulkan_witness_state {
+    DOE_WITNESS_UNAVAILABLE = 0, DOE_WITNESS_ARMED = 1, DOE_WITNESS_ACCEPTED = 2,
+    DOE_WITNESS_CONFIRMED = 3, DOE_WITNESS_FAILED = 4
+} doe_resource_vulkan_witness_state;
+doe_resource_vulkan_witness_state doe_resource_commands_observe_vulkan(
+    doe_resource_commands *commands, bool arm, uint64_t *serial);
+void doe_resource_commands_encoded_vulkan_dispatch(doe_resource_commands *commands);
+void doe_resource_commands_accepted_vulkan(doe_resource_commands *commands, uint64_t serial);
+void doe_resource_commands_finished_vulkan(doe_resource_commands *commands, uint64_t serial, bool witnessed);
