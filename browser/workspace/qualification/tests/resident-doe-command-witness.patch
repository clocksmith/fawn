+doe_resource_vulkan_witness_state doe_resource_commands_observe_vulkan(
+    doe_resource_commands *commands, bool arm, uint64_t *serial)
+{
+    *serial = 0;
+    unsigned state = atomic_load_explicit(&commands->submission_state, memory_order_acquire);
+    if (arm) {
+        if (state != 0 || commands->vulkan_witness != DOE_WITNESS_UNAVAILABLE)
+            return DOE_WITNESS_UNAVAILABLE;
+        commands->vulkan_witness = DOE_WITNESS_ARMED;
+    } else if (commands->vulkan_witness == DOE_WITNESS_ARMED && state > 1) {
+        return DOE_WITNESS_FAILED;
+    }
+    *serial = commands->witnessed_serial;
+    return commands->vulkan_witness;
+}
+
+void doe_resource_commands_encoded_vulkan_dispatch(doe_resource_commands *commands)
+{
+    if (commands->vulkan_witness == DOE_WITNESS_ARMED) commands->witnessed_dispatch = true;
+}
+
+void doe_resource_commands_accepted_vulkan(doe_resource_commands *commands, uint64_t serial)
+{
+    if (commands->vulkan_witness != DOE_WITNESS_ARMED || !commands->witnessed_dispatch || !serial) return;
+    commands->witnessed_serial = serial;
+    commands->vulkan_witness = DOE_WITNESS_ACCEPTED;
+}
+
+void doe_resource_commands_finished_vulkan(doe_resource_commands *commands, uint64_t serial, bool witnessed)
+{
+    if (commands->vulkan_witness != DOE_WITNESS_ACCEPTED || commands->witnessed_serial != serial) return;
+    commands->vulkan_witness = witnessed ? DOE_WITNESS_CONFIRMED : DOE_WITNESS_FAILED;
+}
