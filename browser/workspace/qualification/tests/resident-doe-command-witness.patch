+uint32_t doeNativeVulkanCommandWitnessV1(WGPUQueue queue, WGPUCommandBuffer command, uint32_t arm, uint64_t *serial)
+{
+    if (!serial) return DOE_WITNESS_UNAVAILABLE;
+    *serial = 0;
+    native_device *device = (native_device *)queue;
+    doe_resource_commands *commands = (doe_resource_commands *)command;
+    if (!device || !commands || arm > 1 || device->backend.kind != WGPUBackendType_Vulkan ||
+        doe_resource_commands_device(commands) != device) return DOE_WITNESS_UNAVAILABLE;
+    native_lock(device);
+    uint32_t state = doe_resource_commands_observe_vulkan(commands, arm != 0, serial);
+    native_unlock(device);
+    return state;
+}
