{
  "name": "@doe/blitzen",
  "private": true,
  "type": "module",
  "description": "Blitzen durable browser workspace: shared observation, action, workflow-memory and recovery service above stock Chrome/Chromium (with optional hash-pinned Fawn browser integration).",
  "scripts": {
    "test": "node test/run-tests.js",
    "test:browser": "node test/run-tests.js --browser",
    "qualify": "node qualification/run.js",
    "compare": "node qualification/compare.js",
    "differentiate": "node qualification/differentiate.js",
    "start": "node src/client/main.js",
    "handoff": "node src/client/handoff-cli.js",
    "start:registry": "node src/client/workflow-registry-main.js"
  },
  "dependencies": {
    "playwright-core": "1.58.2"
  }
}
