+void CompositorFrameSinkSupport::InvalidateFawnVisualReview() {
+  if (fawn_reviewed_surface_) {
+    fawn_reviewed_surface_->InvalidateFawnVisualReview();
+    fawn_reviewed_surface_.reset();
+  }
+}
+
+uint32_t CompositorFrameSinkSupport::ArmFawnVisualReview(
+    const SurfaceId& id,
+    base::UnsafeSharedMemoryRegion state,
+    base::File owner) {
+  if (id != last_created_surface_id_ || id != last_activated_surface_id_)
+    return 0;
+  auto* surface = surface_manager_->GetSurfaceForId(id);
+  if (!surface || !surface->HasActiveFrame() || surface->HasPendingFrame() ||
+      surface->GetActiveFrameIndex() != last_frame_index_)
+    return 0;
+  const auto& meta = surface->GetActiveFrameMetadata();
+  // Child surfaces and video can change independently of this surface.
+  if (!meta.referenced_surfaces.empty() || meta.may_contain_video ||
+      meta.has_shared_element_resources ||
+      !meta.transition_directives.empty() || meta.device_scale_factor != 1.f ||
+      meta.page_scale_factor != 1.f)
+    return 0;
+  for (const auto& resource : surface->GetActiveFrame().resource_list) {
+    // Single-buffered canvas and overlays may update outside surface
+    // submission.
+    if (resource.is_empty() || resource.GetIsOverlayCandidate() ||
+        resource.shared_image()->usage().Has(
+            gpu::SHARED_IMAGE_USAGE_CONCURRENT_READ_WRITE))
+      return 0;
+  }
+  if (!surface->ArmFawnVisualReview(std::move(state), std::move(owner)))
+    return 0;
+  fawn_reviewed_surface_ = surface->GetWeakPtr();
+  return surface->GetActiveFrameIndex();
+}
