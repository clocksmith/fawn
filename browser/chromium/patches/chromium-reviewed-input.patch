+
+void CompositorFrameSinkSupport::ArmFawnVisualReview(
+    const SurfaceId& id,
+    const gfx::Rect& rect,
+    base::UnsafeSharedMemoryRegion state,
+    base::File owner,
+    base::OnceCallback<void(uint32_t, std::vector<uint8_t>)> callback) {
+  auto* surface = surface_manager_->GetSurfaceForId(id);
+  // Reviews of an earlier surface of this sink end; reviews of the same
+  // surface stay open beside the new one.
+  if (fawn_reviewed_surface_ && fawn_reviewed_surface_.get() != surface)
+    InvalidateFawnVisualReview();
+  const auto refuse = [&](uint32_t reason) {
+    if (auto mapping = state.Map(); mapping.IsValid())
+      mapping.GetMemoryAs<FawnVisualReviewGate>()->RecordRefusal(reason);
+    std::move(callback).Run(0, {});
+  };
+  if (id != last_created_surface_id_ || id != last_activated_surface_id_ ||
+      !surface) {
+    refuse(FawnVisualReviewGate::kNotCurrentSurface);
+    return;
+  }
+  if (surface->HasPendingFrame() ||
+      surface->GetActiveFrameIndex() != last_frame_index_) {
+    refuse(FawnVisualReviewGate::kFramePending);
+    return;
+  }
+  // The callback is moved into the surface only if arming succeeds.
+  auto split = base::SplitOnceCallback(std::move(callback));
+  if (!surface->ArmFawnVisualReview(std::move(state), std::move(owner), rect,
+                                    std::move(split.first))) {
+    std::move(split.second).Run(0, {});
+    return;
+  }
+  fawn_reviewed_surface_ = surface->GetWeakPtr();
+  // Draw once so the reference copy is taken from the frame active now.
+  BeginFrameAck ack;
+  ack.has_damage = true;
+  surface_manager_->SurfaceModified(
+      id, ack, SurfaceObserver::HandleInteraction::kNoChange);
+}
