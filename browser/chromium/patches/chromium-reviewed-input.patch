+    case Gate::kNoFrameSink:
+      return "no-frame-sink";
+    case Gate::kNotCurrentSurface:
+      return "not-current-surface";
+    case Gate::kFramePending:
+      return "frame-pending";
+    case Gate::kUnverifiableFrame:
+      return "unverifiable-frame";
+    case Gate::kUnsupportedScope:
+      return "unsupported-scope";
+    case Gate::kReferenceCopyFailed:
+      return "reference-copy-failed";
+    case Gate::kUnverifiableReplacement:
+      return "unverifiable-replacement";
+    case Gate::kOtherSurfaceSubmitted:
+      return "other-surface-submitted";
+    case Gate::kEnded:
+      return "ended";
+  }
+  return "unknown";
+}
