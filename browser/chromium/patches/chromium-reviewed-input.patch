+};
+
+std::string DescribeReviewedInputBarrier(const ReviewedInputBarrier& barrier,
+                                         const char* event) {
+  return base::StringPrintf(
+      "{\"event\":\"%s\",\"phase\":\"%s\",\"surface\":\"%s\","
+      "\"document\":\"%s\",\"reviewedRevision\":%u,"
+      "\"replacementRevision\":%u,\"activeRevision\":%u,"
+      "\"verifiedThrough\":%u,\"refutedAt\":%u,\"gate\":\"%s\","
+      "\"atUnixMs\":%.3f}\n",
+      event, barrier.phase.c_str(), barrier.surface.c_str(),
+      barrier.document.c_str(), barrier.reviewed_revision,
+      barrier.gate->replaced_by.load(), barrier.gate->active_frame.load(),
+      barrier.gate->verified_through.load(), barrier.gate->refuted_at.load(),
+      ReviewGateStateName(barrier.gate->state.load()),
+      base::Time::Now().InMillisecondsFSinceUnixEpoch());
+}
+
+// Runs on a pool thread. The review that owns the gate mapping is bound into
+// the reply, so the mapping outlives this task.
+void WaitAtReviewedInputBarrier(const ReviewedInputBarrier& barrier) {
+  const auto file = [&](const char* suffix) {
+    return barrier.dir.AppendASCII(barrier.phase + suffix);
+  };
+  const base::FilePath hold = barrier.dir.AppendASCII("hold-" + barrier.phase);
+  if (!base::PathExists(hold))
+    return;
+  base::DeleteFile(hold);
+  CHECK(base::WriteFile(file(".ready"),
+                        DescribeReviewedInputBarrier(barrier, "reached")));
+  const base::FilePath release = file(".release");
+  const auto deadline = base::TimeTicks::Now() + base::Seconds(20);
+  bool acknowledged = false;
+  bool refuted = false;
+  while (!base::PathExists(release) && base::TimeTicks::Now() < deadline) {
+    const uint32_t replaced = barrier.gate->replaced_by.load();
+    if (!acknowledged && base::PathExists(file(".await-activation")) &&
+        replaced) {
+      CHECK(base::WriteFile(
+          file(".viz-activation"),
+          DescribeReviewedInputBarrier(barrier, "viz-replacement-active")));
+      acknowledged = true;
+    }
+    // Viz drew a frame whose reviewed pixels differ from the reference.
+    if (!refuted && base::PathExists(file(".await-refutation")) &&
+        barrier.gate->refuted_at.load()) {
+      CHECK(base::WriteFile(
+          file(".viz-refutation"),
+          DescribeReviewedInputBarrier(barrier, "viz-pixels-refuted")));
+      refuted = true;
+    }
+    base::PlatformThread::Sleep(base::Milliseconds(1));
+  }
+  const bool released = base::PathExists(release);
+  base::DeleteFile(release);
+  CHECK(base::WriteFile(
+      file(".continued"),
+      DescribeReviewedInputBarrier(barrier, released ? "released" : "timeout")));
+}
+
+void RunAtReviewedInputBarrier(ReviewedInputBarrier barrier,
+                               base::OnceClosure continuation) {
+  barrier.dir = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      kFawnReviewedInputBarriers);
+  if (barrier.dir.empty()) {
+    std::move(continuation).Run();
+    return;
+  }
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&WaitAtReviewedInputBarrier, std::move(barrier)),
+      std::move(continuation));
+}
