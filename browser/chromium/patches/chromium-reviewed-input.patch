+// static
+bool Surface::IsFawnVerifiableFrame(const CompositorFrame& frame) {
+  const auto& meta = frame.metadata;
+  if (!meta.referenced_surfaces.empty() || meta.may_contain_video ||
+      meta.has_shared_element_resources ||
+      !meta.transition_directives.empty() || meta.device_scale_factor != 1.f ||
+      meta.page_scale_factor != 1.f)
+    return false;
+  for (const auto& resource : frame.resource_list) {
+    if (resource.is_empty() || resource.GetIsOverlayCandidate() ||
+        resource.shared_image()->usage().Has(
+            gpu::SHARED_IMAGE_USAGE_CONCURRENT_READ_WRITE))
+      return false;
+  }
+  return true;
+}
+
+Surface::FawnReview::FawnReview() = default;
+Surface::FawnReview::~FawnReview() = default;
+
+bool Surface::ArmFawnVisualReview(base::UnsafeSharedMemoryRegion state,
+                                  base::File owner,
+                                  const gfx::Rect& rect,
+                                  FawnReferenceCallback callback) {
+  if (!state.IsValid() || state.GetSize() != sizeof(FawnVisualReviewGate) ||
+      !owner.IsValid())
+    return false;
+  auto review = std::make_unique<FawnReview>();
+  review->state = state.Map();
+  if (!review->state.IsValid())
+    return false;
+  auto* gate = review->gate();
+  if (!HasActiveFrame() || rect.IsEmpty() ||
+      !gfx::Rect(GetActiveFrame().size_in_pixels()).Contains(rect)) {
+    gate->RecordRefusal(FawnVisualReviewGate::kUnsupportedScope);
+    return false;
+  }
+  if (!IsFawnVerifiableFrame(GetActiveFrame())) {
+    gate->RecordRefusal(FawnVisualReviewGate::kUnverifiableFrame);
+    return false;
+  }
+  if (!gate->Open())
+    return false;
+  // Reviews the browser has finished with make room first, then the oldest.
+  std::erase_if(fawn_reviews_, [](const std::unique_ptr<FawnReview>& r) {
+    return r->gate()->released.load();
+  });
+  if (fawn_reviews_.size() >= kMaxFawnReviews) {
+    InvalidateFawnReview(*fawn_reviews_.front(), FawnVisualReviewGate::kEnded);
+    fawn_reviews_.erase(fawn_reviews_.begin());
+  }
+  review->id = ++fawn_next_review_id_;
+  review->owner = std::move(owner);
+  review->rect = rect;
+  review->reference_callback = std::move(callback);
+  gate->active_frame.store(GetActiveFrameIndex());
+  fawn_reviews_.push_back(std::move(review));
+  return true;
+}
+
+// Invalidation means Viz can no longer verify a review. It closes the owner at
+// once, which also cancels an admitted input still waiting for a verdict. The
+// mapping stays so later activations remain attributable.
+void Surface::InvalidateFawnReview(FawnReview& review, uint32_t reason) {
+  auto* gate = review.gate();
+  if (review.verifying || gate->Open())
+    gate->RecordRefusal(reason);
+  gate->Invalidate();
+  review.owner.Close();
+  review.verifying = false;
+  review.pending_copies.clear();
+  if (review.reference_callback)
+    std::move(review.reference_callback).Run(0, {});
+}
+
+void Surface::InvalidateFawnVisualReview(uint32_t reason) {
+  for (auto& review : fawn_reviews_)
+    InvalidateFawnReview(*review, reason);
+}
+
+void Surface::ReleaseFawnVisualReview() {
+  InvalidateFawnVisualReview();
+  fawn_reviews_.clear();
+}
+
+// Called when the aggregator collects this surface's copy requests for a
+// draw, so each request is bound to the frame drawn now and forces that draw.
+// A request still on the frame when a newer one activates is dropped in
+// ActivateFrame, never carried over. Frames replaced before any draw were
+// never shown and need no verdict.
+void Surface::MaybeRequestFawnVerification() {
+  if (fawn_reviews_.empty() || !active_frame_data_)
+    return;
+  std::erase_if(fawn_reviews_, [](const std::unique_ptr<FawnReview>& r) {
+    return r->gate()->released.load();
+  });
+  const uint32_t frame_index = GetActiveFrameIndex();
+  for (auto& review : fawn_reviews_) {
+    if (!review->verifying || review->last_copied_frame == frame_index)
