+bool Surface::ArmFawnVisualReview(base::UnsafeSharedMemoryRegion state,
+                                  base::File owner) {
+  InvalidateFawnVisualReview();
+  if (!state.IsValid() || state.GetSize() != sizeof(FawnVisualReviewGate) ||
+      !owner.IsValid())
+    return false;
+  auto mapping = state.Map();
+  if (!mapping.IsValid() ||
+      !mapping.GetMemoryAs<FawnVisualReviewGate>()->Open())
+    return false;
+  fawn_visual_state_ = std::move(mapping);
+  fawn_visual_owner_ = std::move(owner);
+  return true;
+}
+
+void Surface::InvalidateFawnVisualReview() {
+  if (!fawn_visual_state_.IsValid())
+    return;
+  fawn_visual_state_.GetMemoryAs<FawnVisualReviewGate>()->Invalidate();
+  fawn_visual_owner_.Close();
+  fawn_visual_state_ = {};
+}
