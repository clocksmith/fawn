+// Binds one reviewed click to the node hit at the reviewed point of a
+// top-level document. Delivery re-checks the document and node and dispatches
+// in the same main-thread task, or cancels; it never retargets.
+class FawnReviewedInputTargetImpl : public RenderFrameObserver,
+                                    public mojom::FawnReviewedInputTarget {
+ public:
+  explicit FawnReviewedInputTargetImpl(RenderFrame* frame)
+      : RenderFrameObserver(frame) {}
+
+  void Bind(
+      mojo::PendingAssociatedReceiver<mojom::FawnReviewedInputTarget> receiver) {
+    receivers_.Add(this, std::move(receiver));
+  }
+
+  base::WeakPtr<FawnReviewedInputTargetImpl> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  void BindTarget(const blink::DocumentToken& document,
+                  const gfx::Point& point,
+                  BindTargetCallback callback) override {
+    blink::WebNode node = HitNode(document, point);
+    if (node.IsNull()) {
+      std::move(callback).Run(0);
+      return;
+    }
+    // Each review keeps its own bound node, so several reviews of one page can
+    // stay open. The oldest is dropped past a small bound.
+    bound_[++serial_] = {node, document};
+    if (bound_.size() > kMaxBoundTargets)
+      bound_.erase(bound_.begin());
+    std::move(callback).Run(serial_);
+  }
+
+  void DeliverClick(const blink::DocumentToken& document,
+                    uint64_t target,
+                    const gfx::Point& point,
+                    const gfx::PointF& screen_point,
+                    DeliverClickCallback callback) override {
+    using Result = mojom::FawnReviewedClickResult;
+    // One delivery attempt per binding, whatever the outcome.
+    Bound bound;
+    if (auto it = bound_.find(target); it != bound_.end()) {
+      bound = it->second;
+      bound_.erase(it);
+    }
+    blink::WebLocalFrame* frame =
+        render_frame() ? render_frame()->GetWebFrame() : nullptr;
+    if (!frame || frame->Parent() || !frame->FrameWidget()) {
+      std::move(callback).Run(Result::kUnsupported);
+      return;
+    }
+    if (frame->GetDocument().IsNull() ||
+        frame->GetDocument().Token() != document ||
+        (bound.document && *bound.document != document)) {
+      std::move(callback).Run(Result::kDocumentChanged);
+      return;
+    }
+    if (!target || !bound.document || bound.node.IsNull() ||
+        HitNode(document, point) != bound.node) {
+      std::move(callback).Run(Result::kTargetChanged);
+      return;
+    }
+    const gfx::PointF position(point);
+    const auto now = base::TimeTicks::Now();
+    blink::WebMouseEvent down(
+        blink::WebInputEvent::Type::kMouseDown, position, screen_point,
+        blink::WebPointerProperties::Button::kLeft, 1,
+        blink::WebInputEvent::kFromDebugger |
+            blink::WebInputEvent::kLeftButtonDown,
+        now);
+    blink::WebMouseEvent up(blink::WebInputEvent::Type::kMouseUp, position,
+                            screen_point,
+                            blink::WebPointerProperties::Button::kLeft, 1,
+                            blink::WebInputEvent::kFromDebugger, now);
+    auto self = weak_factory_.GetWeakPtr();
+    frame->FrameWidget()->HandleInputEvent(
+        blink::WebCoalescedInputEvent(down, ui::LatencyInfo()));
+    // A page handler may detach the frame; the press is already delivered.
+    if (self && render_frame() && render_frame()->GetWebFrame() == frame &&
+        frame->FrameWidget()) {
+      frame->FrameWidget()->HandleInputEvent(
+          blink::WebCoalescedInputEvent(up, ui::LatencyInfo()));
+    }
+    std::move(callback).Run(Result::kDelivered);
+  }
+
+  void OnDestruct() override { delete this; }
+
+ private:
+  blink::WebNode HitNode(const blink::DocumentToken& document,
+                         const gfx::Point& point) {
+    blink::WebLocalFrame* frame =
+        render_frame() ? render_frame()->GetWebFrame() : nullptr;
+    if (!frame || frame->Parent() || !frame->FrameWidget() ||
+        frame->GetDocument().IsNull() ||
+        frame->GetDocument().Token() != document)
+      return blink::WebNode();
+    return frame->FrameWidget()->HitTestResultAt(gfx::PointF(point)).GetNode();
+  }
+
+  struct Bound {
+    blink::WebNode node;
+    std::optional<blink::DocumentToken> document;
+  };
+  static constexpr size_t kMaxBoundTargets = 64;
+
+  mojo::AssociatedReceiverSet<mojom::FawnReviewedInputTarget> receivers_;
+  std::map<uint64_t, Bound> bound_;
+  uint64_t serial_ = 0;
+  base::WeakPtrFactory<FawnReviewedInputTargetImpl> weak_factory_{this};
+};
