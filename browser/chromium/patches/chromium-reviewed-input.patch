+module content.mojom;
+
+import "third_party/blink/public/mojom/tokens/tokens.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+enum FawnReviewedClickResult {
+  kDelivered,
+  kDocumentChanged,
+  kTargetChanged,
+  kUnsupported,
+  kRecipientGone,
+};
+
+// Renderer half of a reviewed click on a top-level frame. The browser binds
+// the node under the reviewed point before Viz is armed. After the browser
+// admits the click, the renderer checks the document and node again and
+// dispatches in the same task, so it never retargets an admitted click.
+interface FawnReviewedInputTarget {
+  // Returns 0 when the document changed or nothing is hit at `point`.
+  BindTarget(blink.mojom.DocumentToken document, gfx.mojom.Point point)
+      => (uint64 target);
+  // Consumes the binding whatever the result.
+  DeliverClick(blink.mojom.DocumentToken document, uint64 target,
+               gfx.mojom.Point point, gfx.mojom.PointF screen_point)
+      => (FawnReviewedClickResult result);
+};
