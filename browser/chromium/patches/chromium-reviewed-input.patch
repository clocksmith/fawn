+// A review is specific to one DevTools target, document, surface, region and
+// renderer hit-test target. The capture owner closes its pipe on teardown,
+// including process death.
+struct InputHandler::VisualReview : public WebContentsObserver {
+  explicit VisualReview(WebContents* contents)
+      : WebContentsObserver(contents) {}
+  void DidStartNavigation(NavigationHandle*) override {
+    valid_document = false;
+  }
+  void DidFinishNavigation(NavigationHandle*) override {
+    valid_document = false;
+  }
+  void WebContentsDestroyed() override { valid_document = false; }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    valid_document = false;
+  }
+  bool VizAlive() const {
+#if BUILDFLAG(IS_LINUX)
+    struct pollfd fd = {owner_read.GetPlatformFile(), POLLIN, 0};
+    return owner_read.IsValid() && poll(&fd, 1, 0) == 0;
+#else
+    return false;
+#endif
+  }
+
+  viz::FawnVisualReviewGate* gate() {
+    return mapping.GetMemoryAs<viz::FawnVisualReviewGate>();
+  }
+  ReviewedInputBarrier Barrier(const char* phase) {
+    ReviewedInputBarrier barrier;
+    barrier.phase = phase;
+    barrier.surface = surface.ToString();
+    barrier.document = document;
+    barrier.reviewed_revision = revision;
+    barrier.gate = gate();
+    return barrier;
+  }
+
+  std::string id = base::UnguessableToken::Create().ToString();
+  std::string document;
+  blink::DocumentToken document_token;
+  std::string digest;
+  viz::SurfaceId surface;
+  gfx::Rect rect;
+  gfx::Point target_point;
+  uint64_t target = 0;
+  uint32_t revision = 0;
+  mojo::AssociatedRemote<mojom::FawnReviewedInputTarget> renderer;
+  base::UnsafeSharedMemoryRegion pending_state;
+  base::File pending_owner;
+  base::WritableSharedMemoryMapping mapping;
+  base::File owner_read;
+  bool valid_document = true;
+  uint64_t generation = 0;
+  bool captured = false;
+};
