+bool InputHandler::CanUseVisualReview(const VisualReview& review) {
+  auto* agent_host =
+      host_ ? RenderFrameDevToolsAgentHost::GetFor(host_) : nullptr;
+  if (!agent_host)
+    return false;
+  for (auto* emulation : EmulationHandler::ForAgentHost(agent_host)) {
+    if (emulation->device_emulation_enabled())
+      return false;
+  }
+  return web_contents_ && review.valid_document &&
+         review.generation == visual_review_generation_ &&
+         host_->GetRenderWidgetHost() &&
+         !web_contents_->GetOuterWebContents() && host_->IsActive() &&
+         host_->IsRenderFrameLive() && host_->IsInPrimaryMainFrame() &&
+         host_->child_count() == 0 &&
+         !web_contents_->HasUncommittedNavigationInPrimaryMainFrame() &&
+         !ignore_input_events_ && !host_->GetRenderWidgetHost()->IsHidden() &&
+         host_->GetView() && host_->GetView()->IsShowing() &&
+         !host_->GetView()->IsPointerLocked() &&
+         host_->GetDocumentToken().ToString() == review.document &&
+         host_->GetView()->GetCurrentSurfaceId() == review.surface &&
+         host_->GetView()->GetDeviceScaleFactor() == 1.f &&
+         ScaleFactor() == 1.f &&
+         gfx::Rect(host_->GetView()->GetVisibleViewportSize())
+             .Contains(review.rect);
+}
+
+void InputHandler::CaptureVisualEvidence(
+    int x,
+    int y,
+    int width,
+    int height,
+    int target_x,
+    int target_y,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback) {
+  ++visual_review_generation_;
+  visual_review_.reset();
+#if BUILDFLAG(IS_LINUX)
+  if (!host_ || !web_contents_ || !host_->IsActive() ||
+      !host_->IsRenderFrameLive() || !host_->GetView() || x < 0 || y < 0 ||
+      width < 1 || height < 1 || width > 1024 || height > 1024 ||
+      !gfx::Rect(x, y, width, height)
+           .Contains(gfx::Point(target_x, target_y))) {
+    callback->sendFailure(
+        Response::InvalidParams("unsupported visual capture scope"));
+    return;
+  }
+  auto review = std::make_unique<VisualReview>(web_contents_);
+  review->generation = visual_review_generation_;
+  review->rect = gfx::Rect(x, y, width, height);
+  review->target_point = gfx::Point(target_x, target_y);
+  review->document_token = host_->GetDocumentToken();
+  review->document = review->document_token.ToString();
+  review->surface = host_->GetView()->GetCurrentSurfaceId();
+  if (!review->surface.is_valid() || !CanUseVisualReview(*review)) {
+    callback->sendFailure(Response::ServerError("unsupported visual surface"));
+    return;
+  }
+  auto state =
+      base::UnsafeSharedMemoryRegion::Create(sizeof(viz::FawnVisualReviewGate));
+  base::ScopedFD reader, writer;
+  if (!state.IsValid() || !base::CreatePipe(&reader, &writer, true)) {
+    callback->sendFailure(
+        Response::ServerError("visual lease allocation failed"));
+    return;
+  }
+  review->mapping = state.Map();
+  if (!review->mapping.IsValid()) {
+    callback->sendFailure(Response::ServerError("visual lease mapping failed"));
+    return;
+  }
+  new (review->mapping.GetMemoryAs<viz::FawnVisualReviewGate>())
+      viz::FawnVisualReviewGate;
+  review->owner_read = base::File(std::move(reader));
+  review->pending_state = std::move(state);
+  review->pending_owner = base::File(std::move(writer));
+  // Bind the renderer target before arming Viz. Any later change to the node
+  // under the point is caught by the renderer at delivery.
+  host_->GetRemoteAssociatedInterfaces()->GetInterface(&review->renderer);
+  const auto id = review->id;
+  const auto document = review->document_token;
+  const auto point = review->target_point;
+  visual_review_ = std::move(review);
+  visual_review_->renderer->BindTarget(
+      document, point,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnVisualReviewTargetBound,
+                         weak_factory_.GetWeakPtr(), id, std::move(callback)),
+          uint64_t{0}));
+#else
+  callback->sendFailure(
+      Response::ServerError("visual review unsupported on this platform"));
+#endif
+}
+
+void InputHandler::OnVisualReviewTargetBound(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    uint64_t target) {
+  if (!visual_review_ || visual_review_->id != id || !target ||
+      !CanUseVisualReview(*visual_review_)) {
+    callback->sendFailure(
+        Response::ServerError("visual target changed or unsupported"));
+    return;
+  }
+  visual_review_->target = target;
+  GetHostFrameSinkManager()->ArmFawnVisualReview(
+      visual_review_->surface, std::move(visual_review_->pending_state),
+      std::move(visual_review_->pending_owner),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnVisualReviewArmed,
+                         weak_factory_.GetWeakPtr(), id, std::move(callback)),
+          0u));
+}
+
+void InputHandler::OnVisualReviewArmed(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    uint32_t revision) {
+  if (!visual_review_ || visual_review_->id != id || !revision ||
+      !CanUseVisualReview(*visual_review_)) {
+    callback->sendFailure(
+        Response::ServerError("visual surface changed or unsupported"));
+    return;
+  }
+  visual_review_->revision = revision;
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputResult::Format::RGBA,
+      viz::CopyOutputResult::Destination::kSystemMemory,
+      base::BindOnce(&InputHandler::OnVisualReviewCopied,
+                     weak_factory_.GetWeakPtr(), id, revision,
+                     std::move(callback)));
+  request->set_area(visual_review_->rect);
+  request->set_result_task_runner(
+      base::SingleThreadTaskRunner::GetCurrentDefault());
+  GetHostFrameSinkManager()->RequestCopyOfOutput(
+      visual_review_->surface, std::move(request), true, base::Seconds(2));
+}
+
+void InputHandler::OnVisualReviewCopied(
+    std::string id,
+    uint32_t revision,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    std::unique_ptr<viz::CopyOutputResult> result) {
+  if (!visual_review_ || visual_review_->id != id ||
+      !CanUseVisualReview(*visual_review_)) {
+    callback->sendFailure(Response::ServerError("visual review expired"));
+    return;
+  }
+  VisualReview& review = *visual_review_;
+  auto access = result->ScopedAccessSkBitmap();
+  const SkBitmap bitmap = access.bitmap();
+  const int width = review.rect.width();
+  const int height = review.rect.height();
+  std::vector<uint8_t> rgba(4u * width * height);
+  const auto info =
+      SkImageInfo::Make(width, height, kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB());
+  if (bitmap.width() != width || bitmap.height() != height ||
+      !bitmap.readPixels(info, rgba.data(), 4u * width, 0, 0) ||
+      !review.mapping.GetMemoryAs<viz::FawnVisualReviewGate>()->Open() ||
+      !review.VizAlive()) {
+    callback->sendFailure(Response::ServerError("unstable visual copy"));
+    return;
+  }
+  review.digest = base::HexEncodeLower(crypto::hash::Sha256(rgba));
+  review.captured = true;
+  callback->sendSuccess(review.id, review.document, review.surface.ToString(),
+                        1., base::NumberToString(revision), review.digest,
+                        width, height, Binary::fromVector(std::move(rgba)));
+}
+
+void InputHandler::DispatchReviewedClick(
+    const std::string& evidence_id,
+    int x,
+    int y,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  if (!visual_review_ || visual_review_->id != evidence_id ||
+      !visual_review_->captured) {
+    callback->sendSuccess(false, false, "unknown-review");
+    return;
+  }
+  // Move the review out before yielding. It is consumed on every known result.
+  auto review = std::move(visual_review_);
+  const gfx::Point point(x, y);
+  if (point != review->target_point) {
+    callback->sendSuccess(false, false, "outside-reviewed-target");
+    return;
+  }
+  if (!review->valid_document || !host_ ||
+      host_->GetDocumentToken().ToString() != review->document) {
+    callback->sendSuccess(false, false, "stale-document");
+    return;
+  }
+  if (!review->gate()->Open() || !review->VizAlive()) {
+    callback->sendSuccess(false, false, "stale-compositor-revision");
+    return;
+  }
+  if (!CanUseVisualReview(*review)) {
+    callback->sendSuccess(false, false, "target-changed");
+    return;
+  }
+  auto hit_tested = base::BindOnce(
+      &InputHandler::OnReviewedClickHitTested, weak_factory_.GetWeakPtr(),
+      std::move(review), point, std::move(callback));
+  host_->GetRenderWidgetHost()->InsertVisualStateCallback(base::BindOnce(
+      [](base::WeakPtr<InputHandler> self, gfx::Point point,
+         base::OnceCallback<void(base::WeakPtr<RenderWidgetHostViewBase>,
+                                 std::optional<gfx::PointF>)> callback,
+         bool drained) {
+        auto* widget =
+            self && self->host_ ? self->host_->GetRenderWidgetHost() : nullptr;
+        if (!widget || !drained || !widget->GetView() || !widget->delegate() ||
+            !widget->GetInputEventRouter()) {
+          std::move(callback).Run({}, std::nullopt);
+          return;
+        }
+        widget->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+            widget->GetView(), gfx::PointF(point), std::move(callback));
+      },
+      weak_factory_.GetWeakPtr(), point, std::move(hit_tested)));
+}
+
+void InputHandler::OnReviewedClickHitTested(
+    std::unique_ptr<VisualReview> review,
+    gfx::Point point,
+    std::unique_ptr<DispatchReviewedClickCallback> callback,
+    base::WeakPtr<RenderWidgetHostViewBase> hit_view,
+    std::optional<gfx::PointF> hit_point) {
+  if (!CanUseVisualReview(*review) || !hit_view ||
+      host_->GetView() != hit_view.get() || !hit_point ||
+      *hit_point != gfx::PointF(point)) {
+    callback->sendSuccess(false, false, "target-changed");
+    return;
+  }
+  auto target = host_->GetRenderWidgetHost()->GetWeakPtr();
+  const gfx::PointF screen =
+      ConvertWidgetPointToScreenPoint(*host_->GetView(), gfx::PointF(point));
+  TRACE_EVENT_INSTANT("viz", "FawnReview.Validated", "surface",
+                      review->surface.ToString(), "document", review->document);
+  auto barrier = review->Barrier("admission");
+  RunAtReviewedInputBarrier(
+      std::move(barrier),
+      base::BindOnce(&InputHandler::AdmitReviewedClick,
+                     weak_factory_.GetWeakPtr(), std::move(review), target,
+                     point, screen, std::move(callback)));
+}
+
+void InputHandler::AdmitReviewedClick(
+    std::unique_ptr<VisualReview> review,
+    base::WeakPtr<RenderWidgetHostImpl> target,
+    gfx::Point point,
+    gfx::PointF screen,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  const bool admitted = review->gate()->Admit() && review->VizAlive();
+  TRACE_EVENT_INSTANT("viz", "FawnReview.Admission", "surface",
+                      review->surface.ToString(), "admitted", admitted);
+  if (!admitted) {
+    callback->sendSuccess(false, false, "stale-compositor-revision");
+    return;
+  }
+  auto barrier = review->Barrier("delivery");
+  RunAtReviewedInputBarrier(
+      std::move(barrier),
+      base::BindOnce(&InputHandler::DeliverReviewedClick,
+                     weak_factory_.GetWeakPtr(), std::move(review), target,
+                     point, screen, std::move(callback)));
+}
+
+void InputHandler::DeliverReviewedClick(
+    std::unique_ptr<VisualReview> review,
+    base::WeakPtr<RenderWidgetHostImpl> target,
+    gfx::Point point,
+    gfx::PointF screen,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  // Admission is final, delivery is bound: never hit-test again in the
+  // browser. Deliver only to the reviewed widget and document, else cancel.
+  if (!target || !host_ || target.get() != host_->GetRenderWidgetHost() ||
+      review->generation != visual_review_generation_ ||
+      !review->valid_document || !host_->IsActive() ||
+      !host_->IsRenderFrameLive() ||
+      host_->GetDocumentToken() != review->document_token ||
+      !review->renderer.is_connected()) {
+    callback->sendSuccess(true, false, "recipient-changed");
+    return;
+  }
+  const auto document = review->document_token;
+  const uint64_t bound = review->target;
+  auto* renderer = review->renderer.get();
+  renderer->DeliverClick(
+      document, bound, point, screen,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](std::unique_ptr<VisualReview> review,
+                 std::unique_ptr<DispatchReviewedClickCallback> callback,
+                 mojom::FawnReviewedClickResult result) {
+                using Result = mojom::FawnReviewedClickResult;
+                TRACE_EVENT_INSTANT("viz", "FawnReview.Delivery", "surface",
+                                    review->surface.ToString(), "result",
+                                    static_cast<int>(result));
+                switch (result) {
+                  case Result::kDelivered:
+                    callback->sendSuccess(true, true, "delivered");
+                    return;
+                  case Result::kDocumentChanged:
+                    callback->sendSuccess(true, false, "document-changed");
+                    return;
+                  case Result::kTargetChanged:
+                    callback->sendSuccess(true, false, "target-changed");
+                    return;
+                  case Result::kUnsupported:
+                    callback->sendSuccess(true, false,
+                                          "recipient-unsupported");
+                    return;
+                  case Result::kRecipientGone:
+                    callback->sendSuccess(true, false, "recipient-gone");
+                    return;
+                }
+              },
+              std::move(review), std::move(callback)),
+          mojom::FawnReviewedClickResult::kRecipientGone));
+}
