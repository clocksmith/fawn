+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_COMMON_SURFACES_FAWN_VISUAL_REVIEW_H_
+#define COMPONENTS_VIZ_COMMON_SURFACES_FAWN_VISUAL_REVIEW_H_
+
+#include <atomic>
+#include <cstdint>
+
+namespace viz {
+
+// One gate for one immutable browser review. Only Viz and the browser map it.
+// The admission CAS totally orders a reviewed input against Viz's pixel
+// verdicts. Viz copies the reviewed rectangle out of every frame it draws for
+// the reviewed surface and compares it with the reference copy, so frames
+// that leave the rectangle unchanged keep the review open. Nothing here comes
+// from the renderer: activation, drawing and the comparison all run in Viz.
+struct FawnVisualReviewGate {
+  enum : uint32_t { kOpen, kAdmitted, kStale };
+  // Why Viz refused or ended the review, first reason wins.
+  enum Refusal : uint32_t {
+    kNoRefusal,
+    kNoFrameSink,
+    kNotCurrentSurface,
+    kFramePending,
+    kUnverifiableFrame,
+    kUnsupportedScope,
+    kReferenceCopyFailed,
+    kUnverifiableReplacement,
+    kOtherSurfaceSubmitted,
+    kEnded,
+  };
+  std::atomic<uint32_t> state{kOpen};
+  std::atomic<uint32_t> refusal{kNoRefusal};
+  // Set by the browser when it no longer needs the review, so Viz can stop
+  // copying for it.
+  std::atomic<uint32_t> released{0};
+  // First frame Viz activated on the reviewed surface after the reference.
+  std::atomic<uint32_t> replaced_by{0};
+  // Latest frame Viz activated on the reviewed surface.
+  std::atomic<uint32_t> active_frame{0};
+  // Every frame Viz drew up to this index showed the reviewed pixels. It never
+  // advances past a refutation.
+  std::atomic<uint32_t> verified_through{0};
+  // First drawn frame whose reviewed pixels differed, or 0.
+  std::atomic<uint32_t> refuted_at{0};
+  bool Open() const { return state.load() == kOpen; }
+  bool Admit() {
+    uint32_t expected = kOpen;
+    return state.compare_exchange_strong(expected, kAdmitted);
+  }
+  void Invalidate() {
+    uint32_t expected = kOpen;
+    state.compare_exchange_strong(expected, kStale);
+  }
+  void RecordRefusal(uint32_t reason) {
+    uint32_t expected = kNoRefusal;
+    refusal.compare_exchange_strong(expected, reason);
+  }
+  void RecordReplacement(uint32_t frame_index) {
+    uint32_t expected = 0;
+    replaced_by.compare_exchange_strong(expected, frame_index);
+  }
+  void RecordActivation(uint32_t frame_index) {
+    active_frame.store(frame_index);
+    RecordReplacement(frame_index);
+  }
+  // Viz publishes verdicts in frame order: one refutation ends verification.
+  void RecordVerdict(uint32_t frame_index, bool matched) {
+    if (refuted_at.load())
+      return;
+    if (matched) {
+      verified_through.store(frame_index);
+      return;
+    }
+    refuted_at.store(frame_index);
+    Invalidate();
+  }
+  // For an input admitted while `admitted_frame` was active: deliver once Viz
+  // has verified a drawn frame at or after it, cancel once it cannot.
+  enum class Verdict { kPending, kVerified, kRefuted };
+  Verdict VerdictFor(uint32_t admitted_frame) const {
+    if (verified_through.load() >= admitted_frame)
+      return Verdict::kVerified;
+    return refuted_at.load() ? Verdict::kRefuted : Verdict::kPending;
+  }
+};
+static_assert(std::atomic<uint32_t>::is_always_lock_free);
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_COMMON_SURFACES_FAWN_VISUAL_REVIEW_H_
