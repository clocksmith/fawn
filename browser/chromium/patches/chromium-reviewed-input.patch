+  }
+  if (!review.valid_document ||
+      host_->GetDocumentToken().ToString() != review.document)
+    return "document-changed";
+  if (review.generation != visual_review_generation_)
+    return "superseded";
+  if (!host_->GetRenderWidgetHost() || web_contents_->GetOuterWebContents() ||
+      !host_->IsActive() || !host_->IsRenderFrameLive() ||
+      !host_->IsInPrimaryMainFrame())
+    return "frame-unavailable";
+  if (host_->child_count() != 0)
+    return "child-frames";
+  if (web_contents_->HasUncommittedNavigationInPrimaryMainFrame())
+    return "navigation-pending";
+  if (ignore_input_events_ || host_->GetRenderWidgetHost()->IsHidden() ||
+      !host_->GetView() || !host_->GetView()->IsShowing())
+    return "page-hidden";
+  if (host_->GetView()->IsPointerLocked())
+    return "pointer-locked";
+  if (host_->GetView()->GetDeviceScaleFactor() != 1.f || ScaleFactor() != 1.f)
+    return "scaled";
+  if (!gfx::Rect(host_->GetView()->GetVisibleViewportSize())
+           .Contains(review.rect))
+    return "outside-viewport";
+  if (host_->GetView()->GetCurrentSurfaceId() != review.surface)
+    return "surface-changed";
+  return nullptr;
+}
+
+bool InputHandler::CanUseVisualReview(const VisualReview& review) {
+  return !VisualReviewBlocker(review);
+}
+
+void InputHandler::CaptureVisualEvidence(
+    int x,
+    int y,
+    int width,
+    int height,
+    int target_x,
+    int target_y,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback) {
+  ++visual_review_generation_;
+  visual_review_.reset();
+#if BUILDFLAG(IS_LINUX)
+  if (!host_ || !web_contents_ || !host_->IsActive() ||
+      !host_->IsRenderFrameLive() || !host_->GetView() || x < 0 || y < 0 ||
+      width < 1 || height < 1 || width > 1024 || height > 1024 ||
+      !gfx::Rect(x, y, width, height)
+           .Contains(gfx::Point(target_x, target_y))) {
+    callback->sendFailure(
+        Response::InvalidParams("unsupported visual capture scope"));
+    return;
+  }
+  auto review = std::make_unique<VisualReview>(web_contents_);
+  review->generation = visual_review_generation_;
+  review->rect = gfx::Rect(x, y, width, height);
+  review->target_point = gfx::Point(target_x, target_y);
+  review->document_token = host_->GetDocumentToken();
+  review->document = review->document_token.ToString();
+  review->surface = host_->GetView()->GetCurrentSurfaceId();
+  const char* blocker = review->surface.is_valid()
+                            ? VisualReviewBlocker(*review)
+                            : "surface-changed";
+  if (blocker) {
+    callback->sendFailure(Response::ServerError(
+        std::string("unsupported visual surface (browser:") + blocker + ")"));
+    return;
+  }
+  // Bind the renderer target before arming Viz. Any later change to the node
+  // under the point is caught by the renderer at delivery.
+  host_->GetRemoteAssociatedInterfaces()->GetInterface(&review->renderer);
+  const auto id = review->id;
+  visual_review_ = std::move(review);
+  BindVisualReviewTarget(id, std::move(callback), 0);
+#else
+  callback->sendFailure(
+      Response::ServerError("visual review unsupported on this platform"));
+#endif
+}
+
+void InputHandler::BindVisualReviewTarget(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    int attempt) {
+  if (!visual_review_ || visual_review_->id != id ||
+      !visual_review_->renderer.is_connected()) {
+    callback->sendFailure(Response::ServerError(
+        "visual target changed or unsupported (browser:superseded)"));
+    return;
+  }
+  const auto document = visual_review_->document_token;
+  const auto point = visual_review_->target_point;
+  visual_review_->renderer->BindTarget(
+      document, point,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnVisualReviewTargetBound,
+                         weak_factory_.GetWeakPtr(), id, std::move(callback),
+                         attempt),
+          uint64_t{0}));
+}
+
+void InputHandler::OnVisualReviewTargetBound(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    int attempt,
+    uint64_t target) {
+  const bool same = visual_review_ && visual_review_->id == id;
+  const char* blocker = same ? VisualReviewBlocker(*visual_review_) : "superseded";
+  // A new surface is not a reason to stop: arming uses the current one.
+  if (blocker && std::string_view(blocker) == "surface-changed")
+    blocker = nullptr;
+  // The page had nothing to hit at the point yet. Nothing has been shown to a
+  // reviewer, so ask again a frame later.
+  if (same && !blocker && !target && attempt < 2) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&InputHandler::BindVisualReviewTarget,
+                       weak_factory_.GetWeakPtr(), id, std::move(callback),
+                       attempt + 1),
+        base::Milliseconds(16));
+    return;
+  }
+  if (blocker || !target) {
+    callback->sendFailure(Response::ServerError(
+        std::string("visual target changed or unsupported (browser:") +
+        (blocker ? blocker : "no-target-at-point") + ")"));
+    return;
+  }
+  visual_review_->target = target;
+  ArmVisualReview(id, std::move(callback), 0);
+}
+
+// Each attempt arms a fresh gate on the view's current surface. Nothing has
+// been shown to a reviewer before the reference returns, so an attempt Viz
+// refused because the surface was mid-update can be repeated a frame later.
+void InputHandler::ArmVisualReview(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    int attempt) {
+  const char* blocker =
+      visual_review_ && visual_review_->id == id
+          ? VisualReviewBlocker(*visual_review_)
+          : "superseded";
+  // A new surface is expected here: each attempt arms the current one.
+  if (blocker && std::string_view(blocker) != "surface-changed") {
+    callback->sendFailure(Response::ServerError(
+        std::string("visual surface changed or unsupported (browser:") +
+        blocker + ")"));
+    return;
+  }
+  VisualReview& review = *visual_review_;
+  review.surface = host_->GetView()->GetCurrentSurfaceId();
+  auto state =
+      base::UnsafeSharedMemoryRegion::Create(sizeof(viz::FawnVisualReviewGate));
+  base::ScopedFD reader, writer;
+  if (!review.surface.is_valid() || !state.IsValid() ||
+      !base::CreatePipe(&reader, &writer, true)) {
+    callback->sendFailure(
+        Response::ServerError("visual lease allocation failed"));
+    return;
+  }
+  if (review.mapping.IsValid())
+    review.gate()->released.store(1);
+  review.mapping = state.Map();
+  if (!review.mapping.IsValid()) {
+    callback->sendFailure(Response::ServerError("visual lease mapping failed"));
+    return;
+  }
+  new (review.mapping.GetMemoryAs<viz::FawnVisualReviewGate>())
+      viz::FawnVisualReviewGate;
+  review.owner_read = base::File(std::move(reader));
+  GetHostFrameSinkManager()->ArmFawnVisualReview(
+      review.surface, review.rect, std::move(state),
+      base::File(std::move(writer)),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&InputHandler::OnVisualReviewArmed,
+                         weak_factory_.GetWeakPtr(), id, std::move(callback),
+                         attempt),
+          0u, std::vector<uint8_t>()));
+}
+
+// The evidence is Viz's reference copy: the same pixels Viz compares every
+// later drawn frame against.
+void InputHandler::OnVisualReviewArmed(
+    std::string id,
+    std::unique_ptr<CaptureVisualEvidenceCallback> callback,
+    int attempt,
+    uint32_t revision,
+    const std::vector<uint8_t>& rgba) {
+  const bool same = visual_review_ && visual_review_->id == id;
+  const char* blocker = same ? VisualReviewBlocker(*visual_review_) : "superseded";
+  const bool current = !blocker;
+  const uint32_t refusal = same ? visual_review_->gate()->refusal.load() : 0;
+  // The view moved to a new surface while Viz armed the old one. Nothing has
+  // been shown to a reviewer yet, so arm again on the new surface.
+  const bool surface_moved =
+      blocker && std::string_view(blocker) == "surface-changed";
+  const std::string reason =
+      blocker ? std::string("browser:") + blocker
+              : std::string("viz:") + ReviewRefusalName(refusal);
+  TRACE_EVENT_INSTANT("viz", "FawnReview.Armed", "revision", revision,
+                      "refusal", reason, "attempt", attempt);
+  const bool transient =
+      surface_moved ||
+      (current && !revision &&
+       (refusal == viz::FawnVisualReviewGate::kFramePending ||
+        refusal == viz::FawnVisualReviewGate::kNotCurrentSurface ||
+        refusal == viz::FawnVisualReviewGate::kOtherSurfaceSubmitted));
+  if (same && transient && attempt < 2) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&InputHandler::ArmVisualReview,
+                       weak_factory_.GetWeakPtr(), id, std::move(callback),
+                       attempt + 1),
+        base::Milliseconds(16));
+    return;
+  }
+  if (!current || !revision) {
+    callback->sendFailure(Response::ServerError(
+        "visual surface changed or unsupported (" + reason + ")"));
+    return;
+  }
+  VisualReview& review = *visual_review_;
+  const int width = review.rect.width();
+  const int height = review.rect.height();
+  if (rgba.size() != 4u * width * height || !review.gate()->Open() ||
+      !review.VizAlive()) {
+    callback->sendFailure(Response::ServerError("unstable visual copy"));
+    return;
+  }
+  review.revision = revision;
+  review.digest = base::HexEncodeLower(crypto::hash::Sha256(rgba));
+  review.captured = true;
+  callback->sendSuccess(review.id, review.document, review.surface.ToString(),
+                        1., base::NumberToString(revision), review.digest,
+                        width, height, Binary::fromVector(rgba));
+}
+
+Response InputHandler::GetVisualEvidenceStatus(
+    const std::string& evidence_id,
+    bool* holds,
+    std::string* reason,
+    std::string* verified_revision) {
+  *holds = false;
+  *verified_revision = "0";
+  if (!visual_review_ || visual_review_->id != evidence_id ||
+      !visual_review_->captured) {
+    *reason = "unknown-review";
+    return Response::Success();
+  }
+  VisualReview& review = *visual_review_;
+  auto* gate = review.gate();
+  *verified_revision = base::NumberToString(gate->verified_through.load());
+  if (const char* blocker = VisualReviewBlocker(review)) {
+    *reason = std::string("browser:") + blocker;
+  } else if (gate->refuted_at.load()) {
+    *reason = "viz:pixels-changed";
+  } else if (!gate->Open() || !review.VizAlive()) {
+    *reason = std::string("viz:") + ReviewRefusalName(gate->refusal.load());
+  } else {
+    *holds = true;
+    *reason = "holds";
+  }
+  return Response::Success();
+}
+
+void InputHandler::DispatchReviewedClick(
+    const std::string& evidence_id,
+    int x,
+    int y,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  if (!visual_review_ || visual_review_->id != evidence_id ||
+      !visual_review_->captured) {
+    callback->sendSuccess(false, false, "unknown-review");
+    return;
+  }
+  // Move the review out before yielding. It is consumed on every known result.
+  auto review = std::move(visual_review_);
+  const gfx::Point point(x, y);
+  if (point != review->target_point) {
+    callback->sendSuccess(false, false, "outside-reviewed-target");
+    return;
+  }
+  if (!review->valid_document || !host_ ||
+      host_->GetDocumentToken().ToString() != review->document) {
+    callback->sendSuccess(false, false, "stale-document");
+    return;
+  }
+  if (!review->gate()->Open() || !review->VizAlive()) {
+    callback->sendSuccess(false, false, "stale-compositor-revision");
+    return;
+  }
+  if (!CanUseVisualReview(*review)) {
+    callback->sendSuccess(false, false, "target-changed");
+    return;
+  }
+  auto hit_tested = base::BindOnce(
+      &InputHandler::OnReviewedClickHitTested, weak_factory_.GetWeakPtr(),
+      std::move(review), point, std::move(callback));
+  host_->GetRenderWidgetHost()->InsertVisualStateCallback(base::BindOnce(
+      [](base::WeakPtr<InputHandler> self, gfx::Point point,
+         base::OnceCallback<void(base::WeakPtr<RenderWidgetHostViewBase>,
+                                 std::optional<gfx::PointF>)> callback,
+         bool drained) {
+        auto* widget =
+            self && self->host_ ? self->host_->GetRenderWidgetHost() : nullptr;
+        if (!widget || !drained || !widget->GetView() || !widget->delegate() ||
+            !widget->GetInputEventRouter()) {
+          std::move(callback).Run({}, std::nullopt);
+          return;
+        }
+        widget->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+            widget->GetView(), gfx::PointF(point), std::move(callback));
+      },
+      weak_factory_.GetWeakPtr(), point, std::move(hit_tested)));
+}
+
+void InputHandler::OnReviewedClickHitTested(
+    std::unique_ptr<VisualReview> review,
+    gfx::Point point,
+    std::unique_ptr<DispatchReviewedClickCallback> callback,
+    base::WeakPtr<RenderWidgetHostViewBase> hit_view,
+    std::optional<gfx::PointF> hit_point) {
+  if (!CanUseVisualReview(*review) || !hit_view ||
+      host_->GetView() != hit_view.get() || !hit_point ||
+      *hit_point != gfx::PointF(point)) {
+    callback->sendSuccess(false, false, "target-changed");
+    return;
+  }
+  auto target = host_->GetRenderWidgetHost()->GetWeakPtr();
+  const gfx::PointF screen =
+      ConvertWidgetPointToScreenPoint(*host_->GetView(), gfx::PointF(point));
+  TRACE_EVENT_INSTANT("viz", "FawnReview.Validated", "surface",
+                      review->surface.ToString(), "document", review->document);
+  auto barrier = review->Barrier("admission");
+  RunAtReviewedInputBarrier(
+      std::move(barrier),
+      base::BindOnce(&InputHandler::AdmitReviewedClick,
+                     weak_factory_.GetWeakPtr(), std::move(review), target,
+                     point, screen, std::move(callback)));
+}
+
+void InputHandler::AdmitReviewedClick(
+    std::unique_ptr<VisualReview> review,
+    base::WeakPtr<RenderWidgetHostImpl> target,
+    gfx::Point point,
+    gfx::PointF screen,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  const bool admitted = review->gate()->Admit() && review->VizAlive();
+  // Read after the CAS: every frame activated before admission is at or
+  // below this index.
+  const uint32_t admitted_frame = review->gate()->active_frame.load();
+  TRACE_EVENT_INSTANT("viz", "FawnReview.Admission", "surface",
+                      review->surface.ToString(), "admitted", admitted,
+                      "revision", admitted_frame);
+  if (!admitted) {
+    callback->sendSuccess(false, false, "stale-compositor-revision");
+    return;
+  }
+  AwaitReviewedPixels(std::move(review), target, point, screen, admitted_frame,
+                      base::TimeTicks::Now() + base::Seconds(1),
+                      std::move(callback));
+}
+
+// An admitted input is released only after Viz has drawn a frame at or after
+// the one active at admission and found the reviewed pixels unchanged in every
+// drawn frame up to it. Frames after admission cannot cancel it.
+void InputHandler::AwaitReviewedPixels(
+    std::unique_ptr<VisualReview> review,
+    base::WeakPtr<RenderWidgetHostImpl> target,
+    gfx::Point point,
+    gfx::PointF screen,
+    uint32_t admitted_frame,
+    base::TimeTicks deadline,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  using Verdict = viz::FawnVisualReviewGate::Verdict;
+  const Verdict verdict = review->gate()->VerdictFor(admitted_frame);
+  if (verdict == Verdict::kPending && review->VizAlive() &&
+      base::TimeTicks::Now() < deadline) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&InputHandler::AwaitReviewedPixels,
+                       weak_factory_.GetWeakPtr(), std::move(review), target,
+                       point, screen, admitted_frame, deadline,
+                       std::move(callback)),
+        base::Milliseconds(1));
+    return;
+  }
+  TRACE_EVENT_INSTANT("viz", "FawnReview.PixelVerdict", "surface",
+                      review->surface.ToString(), "revision", admitted_frame,
+                      "verdict", static_cast<int>(verdict));
+  if (verdict != Verdict::kVerified) {
+    callback->sendSuccess(true, false, "stale-compositor-revision");
+    return;
+  }
+  auto barrier = review->Barrier("delivery");
+  RunAtReviewedInputBarrier(
+      std::move(barrier),
+      base::BindOnce(&InputHandler::DeliverReviewedClick,
+                     weak_factory_.GetWeakPtr(), std::move(review), target,
+                     point, screen, std::move(callback)));
+}
+
+void InputHandler::DeliverReviewedClick(
+    std::unique_ptr<VisualReview> review,
+    base::WeakPtr<RenderWidgetHostImpl> target,
+    gfx::Point point,
+    gfx::PointF screen,
+    std::unique_ptr<DispatchReviewedClickCallback> callback) {
+  // Admission is final, delivery is bound: never hit-test again in the
+  // browser. Deliver only to the reviewed widget and document, else cancel.
+  if (!target || !host_ || target.get() != host_->GetRenderWidgetHost() ||
+      review->generation != visual_review_generation_ ||
+      !review->valid_document || !host_->IsActive() ||
+      !host_->IsRenderFrameLive() ||
+      host_->GetDocumentToken() != review->document_token ||
+      !review->renderer.is_connected()) {
+    callback->sendSuccess(true, false, "recipient-changed");
+    return;
+  }
+  const auto document = review->document_token;
+  const uint64_t bound = review->target;
+  auto* renderer = review->renderer.get();
+  renderer->DeliverClick(
+      document, bound, point, screen,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](std::unique_ptr<VisualReview> review,
+                 std::unique_ptr<DispatchReviewedClickCallback> callback,
+                 mojom::FawnReviewedClickResult result) {
+                using Result = mojom::FawnReviewedClickResult;
+                TRACE_EVENT_INSTANT("viz", "FawnReview.Delivery", "surface",
+                                    review->surface.ToString(), "result",
+                                    static_cast<int>(result));
+                switch (result) {
+                  case Result::kDelivered:
+                    callback->sendSuccess(true, true, "delivered");
+                    return;
+                  case Result::kDocumentChanged:
+                    callback->sendSuccess(true, false, "document-changed");
+                    return;
+                  case Result::kTargetChanged:
+                    callback->sendSuccess(true, false, "target-changed");
+                    return;
+                  case Result::kUnsupported:
+                    callback->sendSuccess(true, false,
+                                          "recipient-unsupported");
+                    return;
+                  case Result::kRecipientGone:
+                    callback->sendSuccess(true, false, "recipient-gone");
+                    return;
+                }
+              },
+              std::move(review), std::move(callback)),
+          mojom::FawnReviewedClickResult::kRecipientGone));
+}
