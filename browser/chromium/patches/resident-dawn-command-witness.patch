+namespace {
+thread_local const ResidentCommandWitness* gResidentCommand = nullptr;
+}
+ScopedResidentCommandWitness::ScopedResidentCommandWitness(const ResidentCommandWitness* context)
+    : mPrevious(gResidentCommand) {
+    gResidentCommand = context;
+}
+ScopedResidentCommandWitness::~ScopedResidentCommandWitness() {
+    gResidentCommand = mPrevious;
+}
+const ResidentCommandWitness* ConsumeResidentCommandWitness(WGPUQueue queue,
+                                                           WGPUCommandBuffer command) {
+    const auto* current = gResidentCommand;
+    if (!current || current->queue != queue || current->command != command)
+        return nullptr;
+    gResidentCommand = nullptr;
+    return current;
+}
+
 const DawnProcTable& GetProcs() {
     return GetProcsAutogen();
 }
