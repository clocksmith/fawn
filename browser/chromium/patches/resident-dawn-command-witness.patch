 namespace dawn::native::webgpu {
 
+namespace {
+// A callback may arrive synchronously, after retirement or after a failed
+// registration. Its opaque ticket carries no native handle. No callback
+// enters the backend, publishes a verdict, or touches an expired allocation.
+struct WitnessCallbacks {
+    std::mutex lock;
+    uintptr_t next = 1;
+    std::map<uintptr_t, uint32_t> status;
+};
+WitnessCallbacks& Registry() {
+    static auto* registry = new WitnessCallbacks;
+    return *registry;
+}
+uintptr_t ReserveCallback() {
+    auto& r = Registry();
+    std::lock_guard guard(r.lock);
+    if (!r.next || r.status.size() >= 256) return 0;
+    const auto id = r.next++;
+    r.status.emplace(id, 0);
+    return id;
+}
+void ObserveCallback(WGPUQueueWorkDoneStatus status, WGPUStringView, void* userdata, void*) {
+    auto& r = Registry();
+    std::lock_guard guard(r.lock);
+    auto found = r.status.find(reinterpret_cast<uintptr_t>(userdata));
+    if (found != r.status.end()) {
+        // A duplicated callback observed before retirement never qualifies.
+        found->second = found->second ? static_cast<uint32_t>(WGPUQueueWorkDoneStatus_Error)
+                                     : static_cast<uint32_t>(status);
+    }
+}
+}  // namespace
+
+class PendingResidentWitness {
+  public:
+    static std::shared_ptr<PendingResidentWitness> Arm(const ResidentCommandWitness& scope,
+            CommandWitnessProc probe, WGPUQueue queue, WGPUCommandBuffer command,
+            WGPUProcCommandBufferRelease release) {
+        if (!probe) return nullptr;
+        const auto ticket = ReserveCallback();
+        if (!ticket) return nullptr;
+        auto pending = std::shared_ptr<PendingResidentWitness>(
+            new PendingResidentWitness(scope, probe, queue, release, ticket));
+        uint64_t serial = 0;
+        if (probe(queue, command, 1, &serial) != 1) return nullptr;
+        // Transfer the encoder's original reference; keep it alive through the
+        // ordinary callback. A rejected arm never takes ownership.
+        pending->mCommand = command;
+        return pending;
+    }
+    ~PendingResidentWitness() {
+        {
+            auto& r = Registry();
+            std::lock_guard guard(r.lock);
+            r.status.erase(mTicket);
+        }
+        if (mCommand) mRelease(mCommand);
+    }
+    void* Userdata() const { return reinterpret_cast<void*>(mTicket); }
+    void Observe(bool retiring) {
+        if (!mCommand) return;
+        uint32_t raw = 0;
+        {
+            auto& r = Registry();
+            std::lock_guard guard(r.lock);
+            auto found = r.status.find(mTicket);
+            if (found != r.status.end()) raw = found->second;
+        }
+        if (!raw && !retiring) return;
+        // Query the exact retained inner command on its queue only from the
+        // outer owner's ordinary progress path and after callback delivery.
+        const auto status = static_cast<WGPUQueueWorkDoneStatus>(raw);
+        uint64_t serial = 0;
+        const uint32_t state = raw ? mProbe(mQueue, mCommand, 0, &serial) : 0;
+        mReport(mDocument.c_str(), mSubmission.c_str(), state, serial, status,
+                reinterpret_cast<uintptr_t>(mProbe));
+        mRelease(mCommand);
+        mCommand = nullptr;
+    }
+
+  private:
+    PendingResidentWitness(const ResidentCommandWitness& scope, CommandWitnessProc probe,
+                           WGPUQueue queue, WGPUProcCommandBufferRelease release, uintptr_t ticket)
+        : mDocument(scope.document), mSubmission(scope.submission), mReport(scope.report),
+          mProbe(probe), mQueue(queue), mRelease(release), mTicket(ticket) {}
+    const std::string mDocument, mSubmission;
+    const ResidentWitnessReporter mReport;
+    const CommandWitnessProc mProbe;
+    const WGPUQueue mQueue;
+    const WGPUProcCommandBufferRelease mRelease;
+    const uintptr_t mTicket;
+    WGPUCommandBuffer mCommand = nullptr;
+};
