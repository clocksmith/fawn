+// The caller sees both fresh imports and cache hits. Only a tagged original
+// wrapper in its producing isolated world can emit this private event.
+void GPUExternalTexture::TraceFawnFrameImport(VideoFrame* frame) const {
+  auto media_frame = frame->frame();
+  if (!IsActive() || !media_frame || !cache_ || !cache_->device()->GetExecutionContext())
+    return;
+  auto* isolate = cache_->device()->GetExecutionContext()->GetIsolate();
+  if (!isolate->InContext())
+    return;
+  auto context = isolate->GetCurrentContext();
+  auto* state = ScriptState::MaybeFrom(isolate, context);
+  int world = v8_inspector::V8ContextInfo::executionContextId(context);
+  if (!state || !state->World().IsIsolatedWorld() || world != frame->FawnCaptureWorld())
+    return;
+  auto* window = LocalDOMWindow::From(state);
+  auto* local = window ? window->GetFrame() : nullptr;
+  auto* loader = local ? local->Loader().GetDocumentLoader() : nullptr;
+  const auto& version = media_frame->metadata().version;
+  if (loader && version.sub_capture > 0) {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("gpu.dawn"),
+        "FawnResidentFrameImported", "context", world,
+        "component", frame->FawnCaptureComponent(), "sourceEpoch", version.source,
+        "version", version.sub_capture, "mediaTimestampUs", frame->timestamp(),
+        "frame", local->GetDevToolsFrameToken().ToString(),
+        "loader", loader->GetDevToolsNavigationToken().ToString());
+  }
+}
