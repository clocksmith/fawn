+namespace {
+
+// The token below is minted inside the browser. Never return the navigation,
+// DocumentToken or DevTools frame capability to the renderer or GPU service.
+class ResidentDocumentReceipt final
+    : public DocumentUserData<ResidentDocumentReceipt>,
+      public WebContentsObserver {
+ public:
+  explicit ResidentDocumentReceipt(RenderFrameHost* host)
+      : DocumentUserData<ResidentDocumentReceipt>(host),
+        WebContentsObserver(WebContents::FromRenderFrameHost(host)),
+        id_(base::UnguessableToken::Create().ToString()) {}
+
+  ~ResidentDocumentReceipt() override { Retire("document-destroyed"); }
+
+  void RenderFrameHostStateChanged(
+      RenderFrameHost* host,
+      RenderFrameHost::LifecycleState old_state,
+      RenderFrameHost::LifecycleState new_state) override {
+    if (host == &render_frame_host() &&
+        new_state != RenderFrameHost::LifecycleState::kActive)
+      Retire("document-inactive");
+  }
+  void RenderFrameDeleted(RenderFrameHost* host) override {
+    if (host == &render_frame_host())
+      Retire("frame-deleted");
+  }
+  void OnFrameIsCapturingMediaStreamChanged(
+      RenderFrameHost* host,
+      bool is_capturing_media_stream) override {
+    // This is an aggregate frame signal. An unrelated live microphone or
+    // video stream can keep it active after one specific capture is revoked.
+    if (host == &render_frame_host() && !is_capturing_media_stream)
+      Retire("last-media-stream-stopped");
+  }
+  const std::string& id() const { return id_; }
+
+ private:
+  void Retire(const char* reason) {
+    if (id_.empty())
+      return;
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("gpu.dawn"),
+                        "FawnResidentDocumentRetired", "binding", id_, "reason",
+                        reason);
+    id_.clear();
+  }
+  std::string id_;
+  friend DocumentUserData<ResidentDocumentReceipt>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(ResidentDocumentReceipt);
+
+}  // namespace
+
+std::string GpuProcessHost::GetResidentDocumentReceipt(
+    int32_t process_id,
+    const blink::WebGPUExecutionContextToken& token) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kResidentWebGPUProvenance) ||
+      !token.Is<blink::DocumentToken>())
+    return {};
+  auto* frame = RenderFrameHostImpl::FromDocumentToken(
+      process_id, token.GetAs<blink::DocumentToken>());
+  if (!frame || !frame->IsActive() || !frame->GetDevToolsNavigationToken())
+    return {};
+  const auto& binding =
+      ResidentDocumentReceipt::GetOrCreateForCurrentDocument(frame)->id();
+  if (!binding.empty()) {
+    TRACE_EVENT_INSTANT(
+        TRACE_DISABLED_BY_DEFAULT("gpu.dawn"), "FawnResidentDocumentValidated",
+        "binding", binding, "frame", frame->GetDevToolsFrameToken().ToString(),
+        "loader", frame->GetDevToolsNavigationToken()->ToString());
+  }
+  return binding;
+}
