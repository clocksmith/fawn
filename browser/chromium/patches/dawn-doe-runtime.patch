+bool Backend::LoadDoeWireProcTable() {
+    const auto& path = GetInstance()->GetWebGPUExternalRuntimeLibraryPath();
+    std::string error;
+    if (path.empty() || !mExternalRuntimeLib.Open(path, &error)) {
+        dawn::ErrorLog() << "runtime_artifact_load_failed: " << path << ": " << error;
+        return false;
+    }
+    mExternalCacheDisableProc = reinterpret_cast<DisablePersistentCacheProc>(
+        mExternalRuntimeLib.GetProc("doeNativeDeviceDisablePersistentCache", &error));
+    if (!mExternalCacheDisableProc) {
+        dawn::ErrorLog() << "runtime_cache_policy_unavailable: "
+                        << "doeNativeDeviceDisablePersistentCache: " << error;
+        return false;
+    }
+    // Optional accelerator: without it every device reports the store unavailable.
+    mExternalPipelineBlobProc = reinterpret_cast<ConfigurePipelineBlobStoreProc>(
+        mExternalRuntimeLib.GetProc("doeNativeDeviceConfigurePipelineBlobStore", &error));
+    mExternalPipelineCacheInfoProc = reinterpret_cast<PipelineCacheInfoProc>(
+        mExternalRuntimeLib.GetProc("doeNativeDevicePipelineCacheInfo", &error));
+    if (!mExternalPipelineBlobProc || !mExternalPipelineCacheInfoProc) {
+        dawn::ErrorLog() << "runtime_pipeline_blob_cache_unavailable: provider symbols: " << error;
+        mExternalPipelineBlobProc = nullptr;
+        mExternalPipelineCacheInfoProc = nullptr;
+    }
+    auto lookup = reinterpret_cast<WGPUProcGetProcAddress>(
+        mExternalRuntimeLib.GetProc("wgpuGetProcAddress", &error));
+    if (!lookup) {
+        dawn::ErrorLog() << "symbol_surface_incomplete: wgpuGetProcAddress: " << error;
+        return false;
+    }
+    mDawnProcs = {};
+    mDawnProcs.getProcAddress = lookup;
+    auto load = [&](auto* target, const char* name) {
+        auto proc = lookup({name, std::strlen(name)});
+        if (!proc) {
+            dawn::ErrorLog() << "wire_proc_table_incomplete: " << name;
+            return false;
+        }
+        *target = reinterpret_cast<std::remove_reference_t<decltype(*target)>>(proc);
+        return true;
+    };
+    if (!load(&mDawnProcs.adapterCreateDevice, "wgpuAdapterCreateDevice")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.adapterGetInfo, "wgpuAdapterGetInfo")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.adapterGetLimits, "wgpuAdapterGetLimits")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.adapterHasFeature, "wgpuAdapterHasFeature")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.adapterInfoFreeMembers, "wgpuAdapterInfoFreeMembers")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.adapterRelease, "wgpuAdapterRelease")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.bindGroupLayoutRelease, "wgpuBindGroupLayoutRelease")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.bindGroupRelease, "wgpuBindGroupRelease")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.bufferDestroy, "wgpuBufferDestroy")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.bufferGetConstMappedRange, "wgpuBufferGetConstMappedRange")) {
+        return false;
+    }
+    if (!load(&mDawnProcs.bufferGetMapState, "wgpuBufferGetMapState")) {
+        return false;
