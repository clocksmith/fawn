diff --git a/src/dawn/native/webgpu/InnerRuntimeDescriptor.h b/src/dawn/native/webgpu/InnerRuntimeDescriptor.h
new file mode 100644
index 000000000..d5f5e3c0d
--- /dev/null
+++ b/src/dawn/native/webgpu/InnerRuntimeDescriptor.h
@@ -0,0 +1,92 @@
+// Copyright 2026 The Doe Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
+#define SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
+
+#include <span>
+#include <vector>
+
+#include "dawn/webgpu.h"
+
+namespace dawn::native::webgpu {
+
+// Private toggles are already applied to the outer Dawn objects. Preserve
+// native-Dawn forwarding. For an external provider, consume only the leading
+// Dawn tuning/cache and fieldless WebGPU-backend routing nodes. The external
+// device must pass the mandatory cache-disable policy before publication.
+// Leave the first other
+// requirement and its complete tail borrowed and unchanged, including unknown
+// chains: the external provider must admit them or reject the request.
+inline WGPUChainedStruct* InnerRuntimeDescriptorChain(
+    WGPUDawnTogglesDescriptor* nativeToggles,
+    WGPUChainedStruct* outerChain,
+    bool externalRuntime) {
+    if (!externalRuntime) {
+        return nativeToggles ? &nativeToggles->chain : nullptr;
+    }
+    while (outerChain &&
+           (outerChain->sType == WGPUSType_DawnTogglesDescriptor ||
+            outerChain->sType == WGPUSType_DawnCacheDeviceDescriptor ||
+            outerChain->sType == WGPUSType_RequestAdapterWebGPUBackendOptions)) {
+        outerChain = outerChain->next;
+    }
+    return outerChain;
+}
+
+// TextureWGPU resolves outer Dawn internal usages into ordinary texture usage
+// bits. Preserve the exact public/unknown feature order and native-Dawn span;
+// only that consumed private feature is absent from the external request.
+inline std::span<const WGPUFeatureName> InnerRuntimeRequiredFeatures(
+    std::span<const WGPUFeatureName> required,
+    bool externalRuntime,
+    std::vector<WGPUFeatureName>& storage) {
+    if (!externalRuntime) {
+        return required;
+    }
+    bool hasPrivateFeature = false;
+    for (WGPUFeatureName feature : required) {
+        hasPrivateFeature |= feature == WGPUFeatureName_DawnInternalUsages;
+    }
+    if (!hasPrivateFeature) {
+        return required;
+    }
+    storage.clear();
+    storage.reserve(required.size());
+    for (WGPUFeatureName feature : required) {
+        if (feature != WGPUFeatureName_DawnInternalUsages) {
+            storage.push_back(feature);
+        }
+    }
+    return storage;
+}
+
+// This is a private provider requirement, not a WebGPU procedure or capability.
+using DisablePersistentCacheProc = WGPUStatus (*)(WGPUDevice);
+
+// Called before a created external device is published or used for shaders.
+// A refused policy destroys/releases only that unpublished device, then pumps
+// the existing instance owner to deliver its ready loss/failed-creation event.
+inline bool ApplyExternalDeviceCachePolicy(
+    WGPUDevice& device,
+    WGPUInstance instance,
+    DisablePersistentCacheProc disable,
+    WGPUProcDeviceDestroy destroy,
+    WGPUProcDeviceRelease release,
+    WGPUProcInstanceProcessEvents processEvents) {
+    if (device && disable && disable(device) == WGPUStatus_Success) {
+        return true;
+    }
+    if (device) {
+        destroy(device);
+        release(device);
+        device = nullptr;
+    }
+    processEvents(instance);
+    return false;
+}
+
+}  // namespace dawn::native::webgpu
+
+#endif  // SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
