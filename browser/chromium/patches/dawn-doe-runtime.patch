+// Provider-owned cache files stay disabled above; driver pipeline caches persist
+// through this device's blob cache, which the browser process writes. A missing
+// or refused store is reported and leaves pipeline creation uncached.
+void Device::ConfigureExternalPipelineBlobs() {
+    auto* backend = ToBackend(GetPhysicalDevice())->GetBackend();
+    if (!backend->GetExternalPipelineBlobProc()) {
+        dawn::ErrorLog() << "runtime_pipeline_blob_cache_unavailable: provider has no blob store";
+        return;
+    }
+    const ExternalPipelineBlobStore store = {this, &Device::LoadExternalPipelineBlob,
+                                             &Device::StoreExternalPipelineBlob};
+    ExternalPipelineCacheInfo info = {};
+    const uint32_t status = backend->GetExternalPipelineBlobProc()(
+        mInnerHandle, kExternalPipelineCacheAbiVersion, &store, sizeof(store), &info, sizeof(info));
+    mExternalPipelineBlobs = status == 0;
+    if (!mExternalPipelineBlobs) {
+        dawn::ErrorLog() << "runtime_pipeline_blob_cache_unavailable: status=" << status
+                         << " message=" << std::string(info.message, strnlen(info.message, sizeof(info.message)));
+    }
+}
