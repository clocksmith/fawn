new file mode 100644
index 000000000..6221d5ad1
--- /dev/null
+++ b/src/dawn/native/webgpu/InnerRuntimeCallbackRegistry.h
@@ -0,0 +1,97 @@
+// Copyright 2026 The Doe Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMECALLBACKREGISTRY_H_
+#define SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMECALLBACKREGISTRY_H_
+
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <utility>
+
+#include "absl/container/flat_hash_map.h"
+#include "src/dawn/common/MutexProtected.h"
+#include "src/dawn/common/Ref.h"
+
+namespace dawn::native::webgpu {
+
+// Zero is invalid. Unsigned wrap permanently exhausts the sequence, rather
+// than reusing an identity that a delayed provider callback can still carry.
+inline uintptr_t NextInnerRuntimeCallbackToken(uintptr_t& next) {
+    uintptr_t token = next;
+    if (token != 0) {
+        next = token == std::numeric_limits<uintptr_t>::max() ? 0 : token + 1;
+    }
+    return token;
+}
+
+// Loss must be marked before taking DeviceGuard: a foreign callback can be
+// waiting behind initialization while publication is being decided. No message
+// or device state is accessed without the existing recursive DeviceMutex.
+class InnerRuntimePublication {
+  public:
+    bool MarkLost() { return (mState.fetch_or(kLost) & kReady) != 0; }
+    bool Publish() {
+        unsigned pending = 0;
+        return mState.compare_exchange_strong(pending, kReady);
+    }
+    bool IsReady() const { return mState.load() == kReady; }
+    void Retire() { mState.fetch_or(kRetired); }
+  private:
+    static constexpr unsigned kReady = 1;
+    static constexpr unsigned kLost = 2;
+    static constexpr unsigned kRetired = 4;
+    std::atomic<unsigned> mState{0};
+};
+
+template <typename T>
+class InnerRuntimeCallbackRegistry {
+  public:
+    uintptr_t Insert(T* owner) {
+        return mState.Use([&](auto state) {
+            uintptr_t token = NextInnerRuntimeCallbackToken(state->next);
+            if (token != 0) {
+                state->owners.emplace(token, Ref<T>(owner));
+            }
+            return token;
+        });
+    }
+
+    Ref<T> Lookup(uintptr_t token) {
+        return mState.Use([&](auto state) -> Ref<T> {
+            auto found = state->owners.find(token);
+            if (found == state->owners.end()) {
+                return nullptr;
+            }
+            return found->second;
+        });
+    }
+
+    Ref<T> Remove(uintptr_t token) {
+        Ref<T> owner;
+        absl::flat_hash_map<uintptr_t, Ref<T>> retiredBuckets;
+        mState.Use([&](auto state) {
+            auto found = state->owners.find(token);
+            if (found != state->owners.end()) {
+                owner = std::move(found->second);
+                state->owners.erase(found);
+                if (state->owners.empty()) {
+                    state->owners.swap(retiredBuckets);
+                }
+            }
+        });
+        // Both the owner reference and the last bucket allocation are released
+        // outside the registry mutex. Device destruction can reenter callbacks.
+        return owner;
+    }
+
+  private:
+    struct State {
+        uintptr_t next = 1;
+        absl::flat_hash_map<uintptr_t, Ref<T>> owners;
+    };
+    MutexProtected<State> mState;
+};
+
+}  // namespace dawn::native::webgpu
+#endif  // SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMECALLBACKREGISTRY_H_
diff --git a/src/dawn/native/webgpu/InnerRuntimeDescriptor.h b/src/dawn/native/webgpu/InnerRuntimeDescriptor.h
new file mode 100644
index 000000000..b1a66cadd
--- /dev/null
+++ b/src/dawn/native/webgpu/InnerRuntimeDescriptor.h
@@ -0,0 +1,183 @@
+// Copyright 2026 The Doe Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
+#define SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
+
+#include <cstddef>
+#include <span>
+#include <type_traits>
+#include <vector>
+
+#include "dawn/webgpu.h"
+#if defined(_WIN32)
+#include "dawn/native/D3DBackend.h"
+#endif
+
+namespace dawn::native::webgpu {
+
+// Private toggles are already applied to the outer Dawn objects. Preserve
+// native-Dawn forwarding. For an external provider, consume only the leading
+// Dawn tuning/cache, adapter-consumption and fieldless WebGPU-backend routing
+// nodes. AdapterBase applies consumption after successful device creation using
+// the untouched outer descriptor. The external device must pass the mandatory
+// cache-disable policy before publication.
+// Leave the first other
+// requirement and its complete tail borrowed and unchanged, including unknown
+// chains: the external provider must admit them or reject the request.
+inline bool InnerRuntimeConsumedDescriptor(const WGPUChainedStruct* chain) {
+    return chain && (chain->sType == WGPUSType_DawnTogglesDescriptor ||
+                     chain->sType == WGPUSType_DawnCacheDeviceDescriptor ||
+                     chain->sType == WGPUSType_DawnConsumeAdapterDescriptor ||
+                     chain->sType == WGPUSType_RequestAdapterWebGPUBackendOptions);
+}
+
+inline WGPUChainedStruct* InnerRuntimeDescriptorChain(
+    WGPUDawnTogglesDescriptor* nativeToggles,
+    WGPUChainedStruct* outerChain,
+    bool externalRuntime) {
+    if (!externalRuntime) {
+        return nativeToggles ? &nativeToggles->chain : nullptr;
+    }
+    while (InnerRuntimeConsumedDescriptor(outerChain)) {
+        outerChain = outerChain->next;
+    }
+    return outerChain;
+}
+
+#if defined(_WIN32)
+// Use a standard-layout API record, not C++ inherited tail padding. The input
+// is the actual native type returned by UnpackedPtr::Get; only typed member
+// access reads its payload. The caller owns this storage through WaitAny.
+struct InnerRuntimeWindowsAdapterLuid {
+    WGPUChainedStruct chain{};
+    ::LUID adapterLUID{};
+};
+static_assert(std::is_standard_layout_v<InnerRuntimeWindowsAdapterLuid>);
+static_assert(offsetof(InnerRuntimeWindowsAdapterLuid, adapterLUID) == 16);
+static_assert(sizeof(InnerRuntimeWindowsAdapterLuid) == 24);
+static_assert(alignof(InnerRuntimeWindowsAdapterLuid) == 8);
+
+inline WGPUChainedStruct* InnerRuntimeWindowsPrivatePrefix(WGPUChainedStruct* first) {
+    // Stop at the first required node. In particular, never inspect an unknown
+    // requirement's tail merely to decide whether its prefix is consumable.
+    const auto advance = [](WGPUChainedStruct* chain) {
+        return InnerRuntimeConsumedDescriptor(chain) ? chain->next : nullptr;
+    };
+    auto* slow = first;
+    auto* fast = first;
+    do {
+        slow = advance(slow);
+        fast = advance(advance(fast));
+        if (slow && slow == fast) return first;  // A malformed cycle stays required.
+    } while (fast);
+    return InnerRuntimeDescriptorChain(nullptr, first, true);
+}
+
+inline WGPUChainedStruct* InnerRuntimeWindowsAdapterChain(
+    WGPUDawnTogglesDescriptor* nativeToggles,
+    WGPUChainedStruct* outerChain,
+    const d3d::RequestAdapterOptionsLUID* nativeLuid,
+    bool externalRuntime,
+    InnerRuntimeWindowsAdapterLuid& storage) {
+    if (!externalRuntime) {
+        return InnerRuntimeDescriptorChain(nativeToggles, outerChain, false);
+    }
+    auto* first = InnerRuntimeWindowsPrivatePrefix(outerChain);
+    if (!nativeLuid || !first || first->sType != WGPUSType_RequestAdapterOptionsLUID ||
+        static_cast<const void*>(first) != static_cast<const void*>(nativeLuid)) {
+        return first;
+    }
+    storage.chain.sType = WGPUSType_RequestAdapterOptionsLUID;
+    storage.chain.next = InnerRuntimeWindowsPrivatePrefix(first->next);
+    storage.adapterLUID = nativeLuid->adapterLUID;
+    return &storage.chain;
+}
+#endif  // defined(_WIN32)
+
+// TextureWGPU resolves outer Dawn internal usages into ordinary texture usage
+// bits. Preserve the exact public/unknown feature order and native-Dawn span;
+// only that consumed private feature is absent from the external request.
+inline std::span<const WGPUFeatureName> InnerRuntimeRequiredFeatures(
+    std::span<const WGPUFeatureName> required,
+    bool externalRuntime,
+    std::vector<WGPUFeatureName>& storage) {
+    if (!externalRuntime) {
+        return required;
+    }
+    bool hasPrivateFeature = false;
+    for (WGPUFeatureName feature : required) {
+        hasPrivateFeature |= feature == WGPUFeatureName_DawnInternalUsages;
+    }
+    if (!hasPrivateFeature) {
+        return required;
+    }
+    storage.clear();
+    storage.reserve(required.size());
+    for (WGPUFeatureName feature : required) {
+        if (feature != WGPUFeatureName_DawnInternalUsages) {
+            storage.push_back(feature);
+        }
+    }
+    return storage;
+}
+
+// This is a private provider requirement, not a WebGPU procedure or capability.
+using DisablePersistentCacheProc = WGPUStatus (*)(WGPUDevice);
+
+// Mirrors the provider's private DoeNativePipelineBlobStore and
+// DoeNativePipelineCacheInfo (doe_native_pipeline_cache.h, ABI version 1). The
+// outer device's blob cache owns persistence, so the browser process writes and
+// the sandboxed provider opens no cache files. Keys only locate driver caches
+// that the provider and the driver validate before use.
+struct ExternalPipelineBlobStore {
+    void* userdata;
+    void (*load)(void* userdata,
+                 const void* key,
+                 size_t keySize,
+                 void (*receive)(void* receiver, const void* value, size_t size),
+                 void* receiver);
+    void (*store)(void* userdata, const void* key, size_t keySize, const void* value, size_t size);
+};
+struct ExternalPipelineCacheInfo {
+    uint32_t status, enabled, dirty, reserved;
+    uint64_t loadAttempts, loadSuccesses, additions, additionFailures;
+    uint64_t serializations, serializationFailures;
+    int64_t nativeCode;
+    char message[256];
+};
+inline constexpr uint32_t kExternalPipelineCacheAbiVersion = 1;
+using ConfigurePipelineBlobStoreProc = uint32_t (*)(void*,
+                                                    uint32_t,
+                                                    const ExternalPipelineBlobStore*,
+                                                    size_t,
+                                                    ExternalPipelineCacheInfo*,
+                                                    size_t);
+using PipelineCacheInfoProc = uint32_t (*)(void*, uint32_t, ExternalPipelineCacheInfo*, size_t);
+
+// Called before a created external device is published or used for shaders.
+// A refused policy destroys/releases only that unpublished device, then pumps
+// the existing instance owner to deliver its ready loss/failed-creation event.
+inline bool ApplyExternalDeviceCachePolicy(
+    WGPUDevice& device,
+    WGPUInstance instance,
+    DisablePersistentCacheProc disable,
+    WGPUProcDeviceDestroy destroy,
+    WGPUProcDeviceRelease release,
+    WGPUProcInstanceProcessEvents processEvents) {
+    if (device && disable && disable(device) == WGPUStatus_Success) {
+        return true;
+    }
+    if (device) {
+        destroy(device);
+        release(device);
+        device = nullptr;
+    }
+    processEvents(instance);
+    return false;
+}
+
+}  // namespace dawn::native::webgpu
+
+#endif  // SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEDESCRIPTOR_H_
