+// Copyright 2026 The Doe Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEERROR_H_
+#define SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEERROR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "dawn/webgpu.h"
+#include "src/dawn/common/StringViewUtils.h"
+#include "src/dawn/native/Error.h"
+#include "src/dawn/native/ErrorData.h"
+
+namespace dawn::native::webgpu {
+
+inline InternalErrorType InnerRuntimeErrorType(WGPUErrorType type) {
+    switch (type) {
+        case WGPUErrorType_Validation:
+            return InternalErrorType::Validation;
+        case WGPUErrorType_OutOfMemory:
+            return InternalErrorType::OutOfMemory;
+        case WGPUErrorType_Internal:
+            return InternalErrorType::PipelineUncategorized;
+        default:
+            return InternalErrorType::Unrecoverable;
+    }
+}
+
+// Unlike an error detected by a native Dawn backend after frontend validation,
+// a separate provider can reject the request with a public validation error.
+// Preserve its runtime type through the backend ResultOrError envelope.
+inline std::unique_ptr<UnrecoverableError> MakeInnerRuntimeError(
+    WGPUErrorType type, std::string message) {
+    return UnrecoverableError::Create(
+        DAWN_MAKE_ERROR_DATA(InnerRuntimeErrorType(type), std::move(message)));
+}
+
+class InnerRuntimeErrorCapture {
+  public:
+    void Record(WGPUErrorType type, WGPUStringView message) {
+        if (type != WGPUErrorType_NoError && !mError) {
+            mError = MakeInnerRuntimeError(type, ToString(message));
+        }
+    }
+
+    MaybeError Check(bool handlePresent, const char* operation) {
+        if (mError) {
+            return std::move(mError);
+        }
+        if (!handlePresent) {
+            return DAWN_UNRECOVERABLE_ERROR(
+                "External provider returned null from %s without an error.", operation);
+        }
+        return {};
+    }
+
+  private:
+    std::unique_ptr<UnrecoverableError> mError;
+};
+
+}  // namespace dawn::native::webgpu
+#endif  // SRC_DAWN_NATIVE_WEBGPU_INNERRUNTIMEERROR_H_
