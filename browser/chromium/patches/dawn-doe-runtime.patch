+ResultOrUnknownError<FenceAndSignalValue> SharedTextureMemory::EndAccessOpaqueFD(
+    TextureBase* texture,
+    UnpackedPtr<EndAccessState>& state) {
+    DAWN_TRY(state.ValidateSubset<SharedTextureMemoryVkImageLayoutEndState>());
+    WGPUSharedTextureMemoryEndAccessState innerState =
+        WGPU_SHARED_TEXTURE_MEMORY_END_ACCESS_STATE_INIT;
+    WGPUSharedTextureMemoryVkImageLayoutEndState innerLayout =
+        WGPU_SHARED_TEXTURE_MEMORY_VK_IMAGE_LAYOUT_END_STATE_INIT;
+    innerState.nextInChain = &innerLayout.chain;
+
+    const DawnProcTable& wgpu = ToBackend(GetDevice())->wgpu.get();
+    DAWN_TRY(CheckWGPUSuccess(wgpu.sharedTextureMemoryEndAccess(
+                                  mInnerHandle, ToBackend(texture)->GetInnerHandle(), &innerState),
+                              "sharedTextureMemoryEndAccess"));
+    if (innerState.initialized) {
+        texture->SetIsSubresourceContentInitialized(true, texture->GetAllSubresources());
+    }
+    if (auto* layout = state.Get<SharedTextureMemoryVkImageLayoutEndState>()) {
+        layout->oldLayout = innerLayout.oldLayout;
+        layout->newLayout = innerLayout.newLayout;
+    }
+    // The inner release exports exactly one new SYNC_FD fence signaled after
+    // every earlier inner queue use; wrap a new reference before the inner
+    // state frees its own.
+    if (innerState.fenceCount != 1 || innerState.signaledValueCount != 1) {
+        wgpu.sharedTextureMemoryEndAccessStateFreeMembers(innerState);
+        return DAWN_UNRECOVERABLE_ERROR("The inner runtime did not export one release fence.");
+    }
+    WGPUSharedFence innerFence = innerState.fences[0];
+    uint64_t signaledValue = innerState.signaledValues[0];
+    wgpu.sharedFenceAddRef(innerFence);
+    wgpu.sharedTextureMemoryEndAccessStateFreeMembers(innerState);
+    Ref<SharedFence> fence = SharedFence::CreateFromHandle(ToBackend(GetDevice()),
+                                                           "WebGPU SyncFD release", innerFence);
+    return FenceAndSignalValue{std::move(fence), signaledValue};
+}
+
 MaybeValError SharedTextureMemory::BeginAccessImpl(
     TextureBase* textureBase,
     const UnpackedPtr<BeginAccessDescriptor>& descriptor) {
     Texture* texture = ToBackend(textureBase);
+    if (mOpaqueFD) {
+        // Begin the inner access now with the producer's fences and layouts, and
+        // mark the texture used so EndAccess always releases it: an access that
+        // records no work still ends with one inner release fence, which follows
+        // the producer fences it waited. Those fences, which the frontend also
+        // returns for an unused texture, are implied by it.
+        DAWN_TRY(descriptor.ValidateSubset<SharedTextureMemoryVkImageLayoutBeginState>());
+        auto* layout = descriptor.Get<SharedTextureMemoryVkImageLayoutBeginState>();
+        DAWN_INVALID_IF(layout == nullptr,
+                        "OPAQUE_FD access requires SharedTextureMemoryVkImageLayoutBeginState.");
+        WGPUSharedTextureMemoryVkImageLayoutBeginState innerLayout =
+            WGPU_SHARED_TEXTURE_MEMORY_VK_IMAGE_LAYOUT_BEGIN_STATE_INIT;
+        innerLayout.oldLayout = layout->oldLayout;
+        innerLayout.newLayout = layout->newLayout;
+        WGPUSharedTextureMemoryBeginAccessDescriptor innerDesc =
+            WGPU_SHARED_TEXTURE_MEMORY_BEGIN_ACCESS_DESCRIPTOR_INIT;
+        innerDesc.nextInChain = &innerLayout.chain;
+        innerDesc.concurrentRead = descriptor->concurrentRead;
+        innerDesc.initialized = descriptor->initialized;
+        std::vector<WGPUSharedFence> innerFences;
+        std::vector<uint64_t> signaledValues;
+        for (auto [i, fence] : Enumerate(descriptor->fences)) {
+            innerFences.push_back(ToBackend(fence)->GetInnerHandle());
+            signaledValues.push_back(descriptor->signaledValues[i]);
+        }
+        innerDesc.fenceCount = innerFences.size();
+        innerDesc.fences = innerFences.data();
+        innerDesc.signaledValueCount = signaledValues.size();
+        innerDesc.signaledValues = signaledValues.data();
+        const DawnProcTable& wgpu = ToBackend(GetDevice())->wgpu.get();
+        // BeginAccess reports validation only; the inner device records its own
+        // native failure detail before rejecting.
+        DAWN_INVALID_IF(wgpu.sharedTextureMemoryBeginAccess(mInnerHandle, texture->GetInnerHandle(),
+                                                            &innerDesc) != WGPUStatus_Success,
+                        "The inner runtime rejected the OPAQUE_FD access.");
+        texture->MarkSharedTextureMemoryAccessUsed();
+        return {};
+    }
     texture->SetPendingBeginAccess(descriptor->concurrentRead, descriptor->initialized);
     return {};
 }
