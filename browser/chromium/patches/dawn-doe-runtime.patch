+CacheKey Device::ExternalPipelineBlobKey(const void* key, size_t keySize) const {
+    static constexpr char kDomain[] = "doe-external-pipeline-blob-v1";
+    CacheKey cacheKey = GetCacheKey();
+    const auto* domain = reinterpret_cast<const std::byte*>(kDomain);
+    const auto* bytes = static_cast<const std::byte*>(key);
+    cacheKey.insert(cacheKey.end(), domain, domain + sizeof(kDomain));
+    cacheKey.insert(cacheKey.end(), bytes, bytes + keySize);
+    return cacheKey;
+}
