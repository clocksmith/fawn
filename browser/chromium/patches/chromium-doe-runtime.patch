new file mode 100644
index 0000000000..e2dc24cbe6
--- /dev/null
+++ b/gpu/command_buffer/service/webgpu_linux_backend_policy.h
@@ -0,0 +1,30 @@
+// Copyright 2026 The Doe Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef GPU_COMMAND_BUFFER_SERVICE_WEBGPU_LINUX_BACKEND_POLICY_H_
+#define GPU_COMMAND_BUFFER_SERVICE_WEBGPU_LINUX_BACKEND_POLICY_H_
+
+namespace gpu::webgpu {
+
+enum class LinuxWebGPURuntimeRoute {
+  kNativeDawn,
+  kForcedExternalDoe,
+};
+
+// This chooses a default backend, not adapter admission. External Doe transfers
+// shared images through the Skia staging owner, so it does not require a
+// Chromium-owned Vulkan compositor or Vulkan/GL interop context. Native Dawn
+// retains its existing context requirements. Explicit requests bypass this rule.
+constexpr bool SelectsLinuxDefaultVulkan(
+    LinuxWebGPURuntimeRoute route,
+    bool compositor_uses_vulkan,
+    bool vulkan_gl_interop,
+    bool graphite_uses_vulkan) {
+  return route == LinuxWebGPURuntimeRoute::kForcedExternalDoe ||
+         compositor_uses_vulkan || vulkan_gl_interop || graphite_uses_vulkan;
+}
+
+}  // namespace gpu::webgpu
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_WEBGPU_LINUX_BACKEND_POLICY_H_
diff --git a/gpu/command_buffer/service/webgpu_skia_fallback.h b/gpu/command_buffer/service/webgpu_skia_fallback.h
new file mode 100644
--- /dev/null
+++ b/gpu/command_buffer/service/webgpu_skia_fallback.h
@@ -0,0 +1,24 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef GPU_COMMAND_BUFFER_SERVICE_WEBGPU_SKIA_FALLBACK_H_
+#define GPU_COMMAND_BUFFER_SERVICE_WEBGPU_SKIA_FALLBACK_H_
+
+#include "components/viz/common/resources/shared_image_format_utils.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+
+namespace gpu::webgpu {
+
+// The fallback's permitted RGBA/BGRA/F16 formats map exactly to their Dawn
+// texture formats. CPU staging follows that declared layout, even when a Skia
+// backing uses another channel order. Retain dimensions, alpha and color space.
+inline SkImageInfo MakeWebGPUFallbackStagingInfo(
+    const SkImageInfo& backing_info,
+    viz::SharedImageFormat format) {
+  return backing_info.makeColorType(viz::ToClosestSkColorType(format));
+}
+
+}  // namespace gpu::webgpu
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_WEBGPU_SKIA_FALLBACK_H_
