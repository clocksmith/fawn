 bool GpuPreSandboxHook(sandbox::policy::SandboxLinux::Options options) {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->GetSwitchValueASCII(switches::kUseWebGPURuntime) == "doe" &&
+      !command_line->HasSwitch(switches::kDisableWebGPUDoe)) {
+    const auto library =
+        command_line->GetSwitchValuePath(switches::kDoeWebGPULibraryPath);
+    // Keep the selected provider mapped before the existing filesystem sandbox
+    // starts. RTLD_LOCAL preserves Dawn's independent symbol namespace.
+    void* handle = library.empty()
+                       ? nullptr
+                       : dlopen(library.value().c_str(),
+                                RTLD_NOW | RTLD_LOCAL | RTLD_NODELETE);
+    if (!handle) {
+      LOG(ERROR) << "runtime_artifact_load_failed: " << library.value();
+      return false;
+    }
+    dlclose(handle);
+  }
   sandbox::policy::SandboxLinux::GetInstance()->StartBrokerProcess(
       CommandSetForGPU(options), FilePermissionsForGpu(options), options);
 
