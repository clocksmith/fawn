+// Only the early external-runtime X11 GLX route needs desktop resources after
+// sealing. Preserve the normal policy for native Dawn, Wayland and other GL
+// implementations. The caller binds the actual serialized GPU preference.
+bool UsesEarlyExternalGlxResources(bool early_sandbox) {
+#if BUILDFLAG(IS_LINUX) && BUILDFLAG(IS_OZONE)
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!early_sandbox ||
+      command_line->GetSwitchValueASCII(switches::kUseWebGPURuntime) != "doe" ||
+      command_line->HasSwitch(switches::kDisableWebGPUDoe) ||
+      ui::OzonePlatform::GetPlatformName() != "x11") {
+    return false;
+  }
+  const auto requested =
+      gl::GetRequestedGLImplementationFromCommandLine(command_line);
+  // X11's default allowed implementation is EGL ANGLE with its GLX backend.
+  if (!requested) {
+    return true;
+  }
+  return requested->gl == gl::kGLImplementationEGLANGLE &&
+         (requested->angle == gl::ANGLEImplementation::kDefault ||
+          requested->angle == gl::ANGLEImplementation::kOpenGL ||
+          requested->angle == gl::ANGLEImplementation::kOpenGLES);
+#else
+  return false;
+#endif
+}
