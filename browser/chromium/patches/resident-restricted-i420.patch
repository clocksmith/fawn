index 0000000000000000000000000000000000000000..4e89162b8f2b68393f7c028b6f49133d04d31e18
--- /dev/null
+++ b/third_party/blink/renderer/modules/webcodecs/fawn_restricted_plane_cache.h
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBCODECS_FAWN_RESTRICTED_PLANE_CACHE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBCODECS_FAWN_RESTRICTED_PLANE_CACHE_H_
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include "base/containers/heap_array.h"
+
+#include "base/memory/ref_counted.h"
+#include "media/base/video_frame.h"
+
+namespace blink {
+
+// One bounded, owned copy of the three native planes for a browser-confirmed
+// element restriction. All accesses occur on its renderer sequence. No capture
+// buffer stays checked out while the reader waits for another frame.
+class FawnRestrictedPlaneCache
+    : public base::RefCounted<FawnRestrictedPlaneCache> {
+ public:
+  FawnRestrictedPlaneCache(int world, media::CaptureVersion version)
+      : world_(world), version_(version) {}
+
+  void Retire() {
+    active_ = false;
+    baseline_ = {};
+  }
+
+  // Zero means the caller must do a canonical RGBA read. A nonzero serial
+  // may be reused only in the same reader and after its earlier canonical
+  // digest was actually accepted. A changed native byte is never ignored.
+  uint32_t Observe(int world, const media::VideoFrame& frame) {
+    if (!active_ || !world_ || world != world_ || version_.sub_capture == 0 ||
+        frame.metadata().capture.version != version_ ||
+        frame.format() != media::PIXEL_FORMAT_I420 ||
+        frame.storage_type() != media::VideoFrame::STORAGE_SHMEM ||
+        !frame.HasDirectCpuAccess() || frame.HasSharedImage() ||
+        frame.metadata().transformation.value_or(media::VideoTransformation()) !=
+            media::VideoTransformation() ||
+        frame.hdr_metadata() != gfx::HDRMetadata() ||
+        !frame.ColorSpace().IsValid() || frame.ColorSpace().IsHDR() ||
+        frame.visible_rect() != gfx::Rect(frame.coded_size()) ||
+        frame.natural_size() != frame.coded_size()) {
+      return 0;
+    }
+    const int w = frame.coded_size().width(), h = frame.coded_size().height();
+    if (w <= 0 || h <= 0 || (w & 1) || (h & 1) ||
+        static_cast<uint64_t>(w) * h > 4u * 1024u * 1024u)
+      return 0;
+
+    std::array<base::span<const uint8_t>, 3> planes;
+    size_t total = 0;
+    for (size_t i = 0; i < planes.size(); ++i) {
+      const size_t width = i == 0 ? w : w / 2;
+      const size_t length = width * (i == 0 ? h : h / 2);
+      auto data = frame.data_span(i);
+      if (frame.stride(i) != width || data.size() < length)
+        return 0;
+      planes[i] = data.first(length);
+      total += length;
+    }
+    bool same = baseline_.size() == total && size_ == frame.coded_size() &&
+                color_ == frame.ColorSpace();
+    size_t offset = 0;
+    for (auto plane : planes) {
+      if (same && !std::ranges::equal(plane, base::span(baseline_).subspan(offset, plane.size())))
+        same = false;
+      offset += plane.size();
+    }
+    if (same)
+      return serial_;
+    if (serial_ == std::numeric_limits<uint32_t>::max()) {
+      Retire();
+      return 0;
+    }
+    if (baseline_.size() != total)
+      baseline_ = base::HeapArray<uint8_t>::Uninit(total);
+    offset = 0;
+    for (auto plane : planes) {
+      base::span(baseline_).subspan(offset, plane.size()).copy_from(plane);
+      offset += plane.size();
+    }
+    size_ = frame.coded_size();
+    color_ = frame.ColorSpace();
+    return ++serial_;
+  }
+
+ private:
+  friend class base::RefCounted<FawnRestrictedPlaneCache>;
+  ~FawnRestrictedPlaneCache() = default;
+  const int world_;
+  const media::CaptureVersion version_;
+  bool active_ = true;
+  uint32_t serial_ = 0;
+  gfx::Size size_;
+  gfx::ColorSpace color_;
+  base::HeapArray<uint8_t> baseline_;
+};
+
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBCODECS_FAWN_RESTRICTED_PLANE_CACHE_H_
