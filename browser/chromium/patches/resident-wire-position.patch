+namespace {
+struct ScopedFawnAllocation {
+  const DawnClientSerializer* owner = nullptr;
+  unsigned count = 0;
+  uint64_t generation = 0;
+  FawnWirePosition position;
+};
+// Wire serialization is synchronous. Work on another thread or another
+// channel cannot stamp this call. Ambiguous and disconnected calls stay empty.
+constinit thread_local ScopedFawnAllocation fawn_scope;
+}  // namespace
+
+bool DawnClientSerializer::BeginFawnSubmit() {
+  if (fawn_scope.owner) {
+    fawn_scope.count = 2;
+    return false;
+  }
+  fawn_scope.owner = this;
+  return true;
+}
+
+FawnWirePosition DawnClientSerializer::EndFawnSubmit() {
+  if (fawn_scope.owner != this)
+    return {};
+  const FawnWirePosition position =
+      fawn_scope.count == 1 ? fawn_scope.position : FawnWirePosition{};
+  fawn_scope = {};
+  return position;
+}
+
+void DawnClientSerializer::CaptureFawnAllocation(uint32_t offset) {
+  if (fawn_scope.owner != this)
+    return;
+  fawn_scope.count = std::min(2u, fawn_scope.count + 1);
+  fawn_scope.generation = fawn_buffer_generation_;
+  fawn_scope.position = {0, offset};
+}
