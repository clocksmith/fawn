+Vector<uint32_t> VideoFrame::fawnRestrictedPlaneTiles(
+    ScriptState* state, VideoFrame* prior, uint32_t serial, uint32_t tile_size) const {
+  auto media_frame = frame();
+  if (!media_frame || !restricted_plane_cache_ || !state->ContextIsValid() ||
+      !state->World().IsIsolatedWorld())
+    return {};
+  const int world = v8_inspector::V8ContextInfo::executionContextId(state->GetContext());
+  const auto observed = restricted_plane_cache_->Compare(
+      world, *media_frame, prior ? prior->restricted_plane_cache_.get() : nullptr, serial, tile_size);
+  if (!observed.serial)
+    return {};
+  Vector<uint32_t> result{observed.serial, observed.prior, observed.snapshot_bytes_copied};
+  for (uint32_t index : observed.dirty())
+    result.push_back(index);
+  return result;
+}
