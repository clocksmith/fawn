  "exerciseSource": "async function exercise(){\n const gpu=navigator.gpu;\n if(!gpu)return {stage:'navigator',ok:false};\n const adapter=await gpu.requestAdapter({powerPreference:'high-performance',forceFallbackAdapter:false});\n if(!adapter)return {stage:'adapter',ok:false};\n const info=Object.fromEntries(['vendor','architecture','device','description'].map(k=>[k,adapter.info[k]]));\n const device=await adapter.requestDevice();const buffers=[];let stage='device';\n try{\n  device.pushErrorScope('validation');\n  const make=(size,usage)=>{const b=device.createBuffer({size,usage});buffers.push(b);return b;};\n  const a=make(1024,GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_DST|GPUBufferUsage.COPY_SRC);\n  const read=make(1024,GPUBufferUsage.MAP_READ|GPUBufferUsage.COPY_DST);\n  device.queue.writeBuffer(a,0,Uint32Array.from({length:256},(_,i)=>i));stage='shader';\n  const module=device.createShaderModule({code:'@group(0) @binding(0) var<storage,read_write> a:array<u32>; @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id:vec3<u32>){a[id.x]=a[id.x]*3u+7u;}'});\n  const messages=(await module.getCompilationInfo()).messages.map(m=>({type:m.type,message:m.message}));\n  const pipeline=await device.createComputePipelineAsync({layout:'auto',compute:{module,entryPoint:'main'}});\n  const group=device.createBindGroup({layout:pipeline.getBindGroupLayout(0),entries:[{binding:0,resource:{buffer:a}}]});\n  const encoder=device.createCommandEncoder();const pass=encoder.beginComputePass();pass.setPipeline(pipeline);pass.setBindGroup(0,group);pass.dispatchWorkgroups(4);pass.end();encoder.copyBufferToBuffer(a,0,read,0,1024);stage='submit';\n  device.queue.submit([encoder.finish()]);await device.queue.onSubmittedWorkDone();stage='readback';await read.mapAsync(GPUMapMode.READ);\n  const values=Array.from(new Uint32Array(read.getMappedRange()));read.unmap();const error=await device.popErrorScope();\n  return {ok:!error&&values.every((x,i)=>x===i*3+7),stage:'complete',adapter:info,values,messages,validationError:error?.message??null,apiFunction:String(gpu.requestAdapter)};\n }catch(e){return {ok:false,stage,adapter:info,error:String(e)};}finally{buffers.forEach(b=>b.destroy());device.destroy();}\n}",
