{
  "manifest_version": 3,
  "name": "Reviewed click control",
  "version": "1.1",
  "description": "The strongest reviewed click an ordinary extension can offer, for comparison with browser-owned review.",
  "permissions": ["debugger", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["fence.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
  ]
}
